---
import "../styles/global.css";
import Header from "../components/Header.astro";
import ogDefault from "~/assets/og-default.png";

type Props = {
  title: string;
  ogTitle?: string;
  ogImage?: string;
};
const { title, ogTitle, ogImage } = Astro.props;
// 記事側のサムネイル未設定時はサイト共通のOG画像に落とす
const ogImageUrl = new URL(ogImage || ogDefault.src, Astro.site);
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#FFFFFF" />
    <link rel="icon" type="image/svg+xml" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />
    <link rel="expect" href="#main-content" blocking="render" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=Zen+Kaku+Gothic+New:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    <meta property="og:title" content={ogTitle ?? title} />
    <meta property="og:image" content={ogImageUrl.href} />
  </head>
  <body>
    <Header />
    <slot />
  </body>
</html>

<script>
  const absorbSkippedTransition = (event: PageRevealEvent | PageSwapEvent) => {
    void event.viewTransition?.ready.catch(() => undefined);
  };

  window.addEventListener("pageswap", absorbSkippedTransition);
  window.addEventListener("pagereveal", absorbSkippedTransition);
</script>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
