---
import { getCollection } from "astro:content";
import { Icon } from "astro-icon/components";
import BaseLayout from "~/layouts/BaseLayout.astro";
import Timeline from "~/components/Timeline.astro";
import { PUBLISHED_STATUS } from "~/constants/publishedStatus";
import { WRITING_STATUS } from "~/constants/writingStatus";
import { normalizePostSlug } from "~/utils/postSlug";

const works = [
  {
    name: "digital-clock-display",
    description: "デジタル時計の表示デザインと実装。",
    repoUrl: "https://github.com/k-ito-cat/digital-clock-display",
  },
  {
    name: "dotfiles",
    description: "chezmoi を軸にしたローカル環境の一元管理。",
    repoUrl: "https://github.com/k-ito-cat/dotfiles",
  },
  {
    name: "devcontainer-template",
    description: "再現性と安全性を重視した開発用テンプレート。",
    repoUrl: "https://github.com/k-ito-cat/devcontainer-template",
  },
];

const posts = await getCollection("posts", ({ data }) => {
  return data.status !== PUBLISHED_STATUS.PRIVATE;
});

const sorted = posts.sort((a, b) => {
  return (
    new Date(b.data.publishedAt).getTime() -
    new Date(a.data.publishedAt).getTime()
  );
});

const toIso = (date: Date) => new Date(date).toISOString().split("T")[0];

const entries = sorted.slice(0, 15).map((post) => {
  const iso = toIso(post.data.publishedAt);
  const [year, month] = iso.split("-");
  return {
    slug: normalizePostSlug(post.id),
    title: post.data.title,
    date: iso.replaceAll("-", "."),
    year,
    month,
    categories: post.data.categories.filter(
      (category) => category !== "すべて",
    ),
    wip:
      post.data.status === PUBLISHED_STATUS.DRAFT ||
      post.data.writingStatus !== WRITING_STATUS.DONE,
  };
});
---

<BaseLayout title="Note">
  <main class="stream">
    <header class="stream-intro">
      <p class="stream-eyebrow"><span class="stream-mark">¶</span> Note</p>
      <h1 class="stream-title">記録</h1>
      <p class="stream-lead">
        新しいものが上。下へ遡るほど、その時々で考えていたこと。
      </p>
    </header>

    <Timeline entries={entries} />

    <a href="/blog" class="stream-more">
      過去へさかのぼる
      <Icon name="octicon:arrow-down-16" />
    </a>

    <section class="works">
      <h2 class="works-head"><span class="works-mark">¶</span> 制作物</h2>
      <ul class="works-list">
        {
          works.map((work) => (
            <li class="works-item">
              <div class="works-item-head">
                <h3>{work.name}</h3>
                <a
                  href={work.repoUrl}
                  target="_blank"
                  rel="noreferrer"
                  class="works-repo"
                >
                  <Icon name="octicon:mark-github-16" />
                  GitHub
                </a>
              </div>
              <p class="works-desc">{work.description}</p>
            </li>
          ))
        }
      </ul>
    </section>
  </main>
</BaseLayout>

<style>
  .stream {
    width: 100%;
    max-width: 680px;
    margin: 0 auto;
    padding: 0 16px;
  }

  .stream-intro {
    padding: 56px 0 32px;
  }

  .stream-eyebrow {
    margin: 0 0 14px;
    font-size: 13px;
    letter-spacing: 0.08em;
    color: var(--text-muted);
  }

  .stream-mark {
    color: var(--accent-warm);
  }

  .stream-title {
    margin: 0;
    font-size: 32px;
    font-weight: 700;
    line-height: 1.35;
    letter-spacing: -0.02em;
    color: var(--text-primary);
  }

  .stream-lead {
    margin: 14px 0 0;
    font-size: 15px;
    line-height: 1.9;
    color: var(--text-secondary);
  }

  .stream-more {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 24px;
    padding-left: 30px;
    font-size: 13px;
    color: var(--text-secondary);
    text-decoration: none;
    transition: color 140ms ease-out;
  }

  .stream-more:hover {
    color: var(--text-primary);
  }

  .stream-more :global(svg) {
    font-size: 14px;
  }

  .works {
    margin-top: 64px;
    padding-top: 32px;
    border-top: 1px solid var(--border);
  }

  .works-head {
    display: flex;
    align-items: baseline;
    gap: 8px;
    margin: 0 0 16px;
    font-size: 16px;
    font-weight: 600;
    color: var(--text-primary);
  }

  .works-mark {
    color: var(--accent-warm);
  }

  .works-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .works-item {
    padding: 16px 0;
    border-top: 1px solid var(--border);
  }

  .works-item:first-child {
    border-top: 0;
    padding-top: 0;
  }

  .works-item-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
  }

  .works-item-head h3 {
    margin: 0;
    font-size: 15px;
    font-weight: 600;
    color: var(--text-primary);
  }

  .works-repo {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    flex: none;
    font-size: 13px;
    color: var(--text-secondary);
    text-decoration: none;
    transition: color 140ms ease-out;
  }

  .works-repo:hover {
    color: var(--text-primary);
  }

  .works-repo :global(svg) {
    font-size: 15px;
  }

  .works-desc {
    margin: 6px 0 0;
    font-size: 14px;
    line-height: 1.8;
    color: var(--text-secondary);
  }

  @media (min-width: 640px) {
    .stream {
      padding: 0 24px;
    }

    .stream-title {
      font-size: 36px;
    }
  }
</style>
