---
import { getCollection, getEntry } from "astro:content";
import { Icon } from "astro-icon/components";
import BaseLayout from "~/layouts/BaseLayout.astro";
import Card from "~/components/Card.astro";
import { PUBLISHED_STATUS } from "~/constants/publishedStatus";
import { normalizePostSlug, resolvePostEntrySlug } from "~/utils/postSlug";

const productItems = [
  {
    name: "digital-clock-display",
    description: "デジタル時計の表示デザインと実装。",
    repoUrl: "https://github.com/k-ito-cat/digital-clock-display",
  },
];

const engineeringItems = [
  {
    name: "dotfiles",
    description: "chezmoi を軸にしたローカル環境の一元管理。",
    repoUrl: "https://github.com/k-ito-cat/dotfiles",
    relatedSlugs: ["dotfiles-local-machine-settings"],
  },
  {
    name: "devcontainer-template",
    description: "再現性と安全性を重視した開発用テンプレート。",
    repoUrl: "https://github.com/k-ito-cat/devcontainer-template",
    relatedSlugs: ["devcontainer-template"],
  },
];

const posts = await getCollection("posts", ({ data }) => {
  return data.status !== PUBLISHED_STATUS.PRIVATE;
});

const sortedPosts = posts.sort((a, b) => {
  return (
    new Date(b.data.publishedAt).getTime() -
    new Date(a.data.publishedAt).getTime()
  );
});

const recentPosts = sortedPosts.slice(0, 3);

const relatedEntrySlugs = [
  ...new Set(
    engineeringItems.flatMap((item) =>
      (item.relatedSlugs ?? []).map((slug) => resolvePostEntrySlug(slug)),
    ),
  ),
];

const relatedEntries = await Promise.all(
  relatedEntrySlugs.map((slug) => getEntry("posts", slug)),
);

const relatedEntryMap = new Map(
  relatedEntries.flatMap((entry, index) =>
    entry ? [[relatedEntrySlugs[index], entry]] : [],
  ),
);

const getRelatedEntry = (slug: string) =>
  relatedEntryMap.get(resolvePostEntrySlug(slug));
---

<BaseLayout title="Home">
  <main class="home">
    <section class="intro">
      <h1 class="intro-title">Blog / Product / Engineering</h1>
      <p class="intro-lead">近況・プロダクト・技術メモのまとめ。</p>
      <a href="/blog" class="intro-link">
        記事を読む
        <Icon name="octicon:arrow-right-16" />
      </a>
    </section>

    <section id="blog" class="home-section">
      <div class="section-head">
        <div class="section-title">
          <h2>Blog</h2>
          <span class="section-note">最新3件</span>
        </div>
        <a href="/blog" class="section-more">一覧へ</a>
      </div>

      {
        recentPosts.length > 0 ? (
          <ul class="card-list">
            {recentPosts.map((post) => {
              const { title, publishedAt, categories, thumbnail, status } =
                post.data;
              return (
                <li data-title={title.toLowerCase()}>
                  <Card
                    slug={post.id}
                    title={title}
                    publishedAt={publishedAt}
                    categories={categories}
                    thumbnail={thumbnail}
                    status={status}
                  />
                </li>
              );
            })}
          </ul>
        ) : (
          <p class="section-empty">
            まだ記事がありません。最初の一本を書いたらここに並びます。
          </p>
        )
      }
    </section>

    <section id="product" class="home-section">
      <div class="section-head">
        <div class="section-title">
          <h2>Product</h2>
          <span class="section-note">作品・個人開発</span>
        </div>
      </div>
      <ul class="link-list">
        {
          productItems.map((item) => (
            <li class="link-item">
              <div class="link-item-head">
                <h3>{item.name}</h3>
                <a
                  href={item.repoUrl}
                  target="_blank"
                  rel="noreferrer"
                  class="link-item-repo"
                >
                  <Icon name="octicon:mark-github-16" />
                  GitHub
                </a>
              </div>
              <p class="link-item-desc">{item.description}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <section id="engineering" class="home-section">
      <div class="section-head">
        <div class="section-title">
          <h2>Engineering</h2>
          <span class="section-note">開発基盤・運用</span>
        </div>
      </div>
      <ul class="link-list">
        {
          engineeringItems.map((item) => {
            const relatedPosts = (item.relatedSlugs ?? [])
              .map((slug) => getRelatedEntry(slug))
              .filter((post) => Boolean(post));

            return (
              <li class="link-item">
                <div class="link-item-head">
                  <h3>{item.name}</h3>
                  <a
                    href={item.repoUrl}
                    target="_blank"
                    rel="noreferrer"
                    class="link-item-repo"
                  >
                    <Icon name="octicon:mark-github-16" />
                    GitHub
                  </a>
                </div>
                <p class="link-item-desc">{item.description}</p>
                {relatedPosts.length > 0 && (
                  <div class="link-item-related">
                    <p class="link-item-related-label">関連記事</p>
                    <ul>
                      {relatedPosts.map((post) =>
                        post ? (
                          <li>
                            <a href={`/blog/${normalizePostSlug(post.id)}`}>
                              {post.data.title}
                            </a>
                          </li>
                        ) : null,
                      )}
                    </ul>
                  </div>
                )}
              </li>
            );
          })
        }
      </ul>
    </section>
  </main>
</BaseLayout>

<style>
  .home {
    width: 100%;
    max-width: var(--max-width-content);
    margin: 0 auto;
    padding: 0 16px;
  }

  .intro {
    padding: 48px 0 8px;
  }

  .intro-title {
    margin: 0;
    max-width: 32rem;
    font-size: 30px;
    font-weight: 700;
    line-height: 1.4;
    letter-spacing: -0.01em;
    color: var(--text-primary);
  }

  .intro-lead {
    margin: 16px 0 0;
    max-width: 36rem;
    font-size: 15px;
    line-height: 1.9;
    color: var(--text-secondary);
  }

  .intro-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 22px;
    font-size: 14px;
    font-weight: 500;
    color: var(--link);
    text-decoration: none;
  }

  .intro-link:hover {
    color: var(--link-hover);
    text-decoration: none;
  }

  .home-section {
    padding: 40px 0;
    border-top: 1px solid var(--border);
  }

  .section-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 20px;
  }

  .section-title {
    display: flex;
    align-items: baseline;
    gap: 10px;
  }

  .section-title h2 {
    margin: 0;
    font-size: 20px;
    font-weight: 700;
    color: var(--text-primary);
  }

  .section-note {
    font-size: 13px;
    color: var(--text-muted);
  }

  .section-more {
    font-size: 13px;
    color: var(--text-secondary);
    text-decoration: none;
    transition: color 140ms ease-out;
  }

  .section-more:hover {
    color: var(--text-primary);
    text-decoration: none;
  }

  .section-empty {
    margin: 0;
    padding: 28px 20px;
    text-align: center;
    font-size: 14px;
    color: var(--text-secondary);
    border: 1px dashed var(--border);
    border-radius: var(--radius-card);
  }

  .card-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .card-list > li {
    min-width: 0;
  }

  .link-list {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .link-item {
    padding: 18px 0;
    border-top: 1px solid var(--border);
  }

  .link-item:first-child {
    border-top: 0;
    padding-top: 0;
  }

  .link-item-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
  }

  .link-item-head h3 {
    margin: 0;
    font-size: 17px;
    font-weight: 600;
    color: var(--text-primary);
  }

  .link-item-repo {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    flex: none;
    font-size: 13px;
    color: var(--text-secondary);
    text-decoration: none;
    transition: color 140ms ease-out;
  }

  .link-item-repo:hover {
    color: var(--text-primary);
    text-decoration: none;
  }

  .link-item-desc {
    margin: 8px 0 0;
    font-size: 14px;
    line-height: 1.8;
    color: var(--text-secondary);
  }

  .link-item-related {
    margin-top: 12px;
  }

  .link-item-related-label {
    margin: 0 0 6px;
    font-size: 13px;
    color: var(--text-muted);
  }

  .link-item-related ul {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .link-item-related a {
    font-size: 14px;
    color: var(--text-secondary);
    text-decoration: none;
    transition: color 140ms ease-out;
  }

  .link-item-related a:hover {
    color: var(--text-primary);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .intro-link :global(svg),
  .link-item-repo :global(svg) {
    font-size: 15px;
  }

  @media (min-width: 640px) {
    .home {
      padding: 0 24px;
    }

    .intro {
      padding: 64px 0 12px;
    }

    .intro-title {
      font-size: 34px;
    }
  }
</style>
