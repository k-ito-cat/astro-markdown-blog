---
import { getCollection } from "astro:content";
import { Icon } from "astro-icon/components";
import BaseLayout from "~/layouts/BaseLayout.astro";
import Timeline, { type TimelineEntry } from "~/components/Timeline.astro";
import { PUBLISHED_STATUS } from "~/constants/publishedStatus";
import { normalizePostSlug } from "~/utils/postSlug";
import { formatJapaneseDate, toIsoDate } from "~/utils/formatDate";

const works = [
  {
    name: "digital-clock-display",
    description: "デジタル時計の表示デザインと実装。",
    repoUrl: "https://github.com/k-ito-cat/digital-clock-display",
  },
  {
    name: "dotfiles",
    description: "chezmoiを軸にしたローカル環境の一元管理。",
    repoUrl: "https://github.com/k-ito-cat/dotfiles",
  },
  {
    name: "devcontainer-template",
    description: "再現性と安全性を重視した開発用テンプレート。",
    repoUrl: "https://github.com/k-ito-cat/devcontainer-template",
  },
];

const posts = await getCollection(
  "posts",
  ({ data }) => data.status !== PUBLISHED_STATUS.PRIVATE,
);

// 時系列順は年ごとの直近 ENTRIES_PER_YEAR 件まで。全件は索引ページが担う
const ENTRIES_PER_YEAR = 10;
const countsByYear = new Map<string, number>();

const entries: TimelineEntry[] = posts
  .map((post) => {
    const isRevision =
      post.data.updatedAt.getTime() > post.data.publishedAt.getTime();
    const activityDate = isRevision
      ? post.data.updatedAt
      : post.data.publishedAt;
    const isoDate = toIsoDate(activityDate);
    const [year, month] = isoDate.split("-");
    return {
      slug: normalizePostSlug(post.id),
      title: post.data.title,
      isoDate,
      displayDate: formatJapaneseDate(activityDate),
      year,
      month,
      categories: post.data.categories,
      tags: post.data.tags,
      activity: isRevision ? "改訂" : "新規",
      isWip: post.data.status === PUBLISHED_STATUS.DRAFT,
      revisionCount: post.data.revisions?.length ?? (isRevision ? 1 : 0),
    };
  })
  .sort((a, b) => b.isoDate.localeCompare(a.isoDate))
  .filter((entry) => {
    const count = (countsByYear.get(entry.year) ?? 0) + 1;
    countsByYear.set(entry.year, count);
    return count <= ENTRIES_PER_YEAR;
  });

// どの年からも、索引のその年へ送れるようにする
const yearLinks = Object.fromEntries(
  Array.from(countsByYear.keys()).map((year) => [year, `/blog?year=${year}`]),
);

// 目次は全期間同じ形にするため、年ごとに月をまとめる
const monthsByYear = Array.from(
  entries.reduce((map, entry) => {
    const months = map.get(entry.year) ?? [];
    if (!months.includes(entry.month)) months.push(entry.month);
    map.set(entry.year, months);
    return map;
  }, new Map<string, string[]>()),
);
---

<BaseLayout title="技術記録">
  <main id="main-content" class="home">
    <div class="home-layout">
      <aside class="month-trace" aria-label="表示中の時期">
        {
          monthsByYear.map(([year, months]) => (
            <>
              <span>{year}</span>
              {months.map((month) => (
                <a href={`#month-${year}-${month}`} data-month-link>
                  {Number(month)}月
                </a>
              ))}
            </>
          ))
        }
      </aside>

      <section class="record-flow" aria-labelledby="record-flow-title">
        <h1 id="record-flow-title" class="sr-only">技術理解の記録</h1>
        <Timeline entries={entries} yearLinks={yearLinks} />
        <a href="/blog" class="flow-more">
          索引からすべての記録を見る
          <Icon name="octicon:arrow-right-16" aria-hidden="true" />
        </a>
      </section>
    </div>

    <section class="works" id="works" aria-labelledby="works-title">
      <h2 id="works-title">制作物</h2>
      <ul class="works-list" aria-label="制作物">
        {
          works.map((work) => (
            <li>
              <div>
                <span class="machine">{work.name}</span>
                <p>{work.description}</p>
              </div>
              <a href={work.repoUrl} target="_blank" rel="noreferrer">
                <Icon name="octicon:mark-github-16" aria-hidden="true" />
                GitHub
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </main>
</BaseLayout>

<style>
  .home {
    width: 100%;
    max-width: var(--max-width-content);
    margin: 0 auto;
    padding: 28px 16px 72px;
  }

  .home-layout {
    display: grid;
    grid-template-columns: minmax(0, var(--layout-stream));
    justify-content: center;
  }

  .month-trace {
    display: none;
  }

  .flow-more {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin: 28px 0 0 34px;
    color: var(--color-interaction-text);
    font-size: var(--text-sm);
    text-decoration: none;
  }

  .flow-more::after {
    content: "";
    width: 0;
    height: 1px;
    background: var(--color-secondary);
    transition: width var(--duration-feedback) var(--ease-trace);
  }

  .flow-more:hover::after,
  .flow-more:focus-visible::after {
    width: 32px;
  }

  .works {
    max-width: var(--layout-stream);
    margin: 48px auto 0;
    padding-top: 28px;
  }

  .works h2 {
    margin: 0;
    color: var(--color-primary);
    font-size: var(--text-xs);
    font-weight: 700;
  }

  .works-list {
    margin: 16px 0 0;
    padding: 0;
    list-style: none;
  }

  .works-list li {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 20px;
    padding: 14px 0;
    border-top: 1px solid var(--color-border);
  }

  .works-list p {
    margin: 4px 0 0;
    color: var(--color-text-sub);
    font-size: var(--text-sm);
  }

  .works-list a {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    flex: none;
    font-size: var(--text-xs);
  }

  @media (min-width: 760px) {
    .home {
      padding: 48px 24px 96px;
    }

    .home-layout {
      grid-template-columns: 88px minmax(0, var(--layout-stream));
      gap: 32px;
    }

    .month-trace {
      position: sticky;
      top: 32px;
      align-self: start;
      display: grid;
      gap: 6px;
      padding-top: 2px;
      color: var(--color-text-muted);
      font-size: var(--text-xs);
    }

    .month-trace span {
      color: var(--color-primary);
      font-family: var(--font-machine);
      font-weight: 600;
    }

    /* 2年目以降の見出しは、前の年の月から離して束を分ける */
    .month-trace span:not(:first-child) {
      margin-top: 12px;
    }

    .month-trace a {
      color: var(--color-text-muted);
      text-decoration: none;
    }

    .month-trace a:hover,
    .month-trace a:focus-visible {
      color: var(--color-interaction-text);
    }

    /* 読んでいる位置に応じて、通過済みと現在の月を描き分ける */
    .month-trace a.is-past {
      color: var(--color-text-sub);
    }

    .month-trace a.is-current {
      color: var(--color-primary);
      font-weight: 700;
    }
  }
</style>

<script>
  const monthLinks = Array.from(
    document.querySelectorAll<HTMLAnchorElement>("[data-month-link]"),
  );
  const monthTargets = monthLinks.map((link) =>
    document.getElementById(decodeURIComponent(link.hash.slice(1))),
  );

  if (monthLinks.length > 0) {
    let updateQueued = false;

    const syncCurrentMonth = () => {
      updateQueued = false;
      // 画面上部を読み取り線とし、それを最後に越えた月を現在地とする
      const readingLine = window.innerHeight * 0.22;
      let currentIndex = 0;
      monthTargets.forEach((target, index) => {
        if (!target || target.hidden) return;
        if (target.getBoundingClientRect().top <= readingLine)
          currentIndex = index;
      });

      monthLinks.forEach((link, index) => {
        link.classList.toggle("is-past", index < currentIndex);
        link.classList.toggle("is-current", index === currentIndex);
        if (index === currentIndex) {
          link.setAttribute("aria-current", "location");
        } else {
          link.removeAttribute("aria-current");
        }
      });
    };

    const queueUpdate = () => {
      if (updateQueued) return;
      updateQueued = true;
      requestAnimationFrame(syncCurrentMonth);
    };

    window.addEventListener("scroll", queueUpdate, { passive: true });
    window.addEventListener("resize", queueUpdate);
    syncCurrentMonth();
  }
</script>
