---
import { Image } from "astro:assets";
import BaseLayout from "~/layouts/BaseLayout.astro";
import wipCat from "~/assets/wip-cat.png";

/**
 * 記事を作成・リネームした直後は、dev サーバーのコンテンツストアがまだ古い。
 * 新しい slug のルートが生成されておらず、ここへ落ちてくる。
 * 反映され次第その URL は開けるようになるため、少しの間だけ読み直して待つ。
 */
const PREVIEW_PREFIX = "/preview/posts/";
const RETRY_LIMIT = 25;
const RETRY_DELAY_MS = 400;

const retry = Number(Astro.url.searchParams.get("retry") ?? 0);
const isPreviewMiss =
  import.meta.env.DEV &&
  Astro.url.pathname.startsWith(PREVIEW_PREFIX) &&
  Number.isInteger(retry) &&
  retry < RETRY_LIMIT;

if (isPreviewMiss) {
  const next = new URL(Astro.url);
  next.searchParams.set("retry", String(retry + 1));

  const slug = Astro.url.pathname.slice(PREVIEW_PREFIX.length);
  const nextUrl = `${next.pathname}${next.search}`;

  /*
   * ここは dev サーバーのストアが追いつくまでの数百 ms しか出ない。
   * サイトの CSS を読み込む前に返すため、tokens.md の値を直接書く。
   * Motion は Line だけを使い、prefers-reduced-motion では止める。
   *
   * 待ち時間はスクリプトで測る。meta refresh の秒数は非負整数としてしか
   * 読まれず、小数を書くと 0 秒（＝即時）になって待ちが消えるため、
   * meta は JS が動かないときの保険として 1 秒で置く。
   */
  return new Response(
    `<!doctype html><html lang="ja"><head><meta charset="utf-8">` +
      `<meta name="viewport" content="width=device-width, initial-scale=1">` +
      `<title>反映を待っています</title>` +
      `<meta http-equiv="refresh" content="1;url=${nextUrl}">` +
      `<style>
        :root { color-scheme: light }
        body {
          margin: 0;
          min-height: 100dvh;
          display: grid;
          place-content: center;
          justify-items: start;
          gap: 14px;
          padding: 24px;
          color: #1f2937;
          font-family: "Zen Kaku Gothic New", system-ui, sans-serif;
        }
        .label {
          margin: 0;
          font-size: 0.875rem;
        }
        .slug {
          margin: 0;
          color: #68746f;
          font-family: "IBM Plex Mono", ui-monospace, monospace;
          font-size: 0.75rem;
          word-break: break-all;
        }
        .track {
          position: relative;
          width: min(20rem, 70vw);
          height: 1px;
          background: #d7e6da;
          overflow: hidden;
        }
        .track::after {
          content: "";
          position: absolute;
          inset: 0 auto 0 0;
          width: 40%;
          background: #14686d;
          animation: trace 900ms cubic-bezier(0.2, 0.7, 0.2, 1) infinite;
        }
        @keyframes trace {
          from { transform: translateX(-100%) }
          to { transform: translateX(250%) }
        }
        @media (prefers-reduced-motion: reduce) {
          .track::after { animation: none; width: 100% }
        }
      </style>` +
      `</head><body>` +
      `<p class="label">記録の反映を待っています</p>` +
      `<div class="track" aria-hidden="true"></div>` +
      `<p class="slug">${slug}（${retry + 1}/${RETRY_LIMIT}）</p>` +
      // 履歴を積まないよう replace で置き換える
      `<script>setTimeout(function(){location.replace(${JSON.stringify(nextUrl)})},${RETRY_DELAY_MS})</script>` +
      `</body></html>`,
    { status: 200, headers: { "content-type": "text/html; charset=utf-8" } },
  );
}
---

<BaseLayout title="記事が存在しません">
  <main id="main-content" class="notfound">
    <p class="notfound-code">404</p>
    <h1>対象の記事は存在しません。</h1>

    <Image
      class="notfound-mark"
      src={wipCat}
      alt=""
      widths={[160, 320]}
      sizes="160px"
      loading="eager"
    />

    <nav class="notfound-links" aria-label="行き先">
      <a href="/blog">索引へ</a>
      <a href="/">時間を遡る</a>
    </nav>
  </main>
</BaseLayout>

<style>
  .notfound {
    /* ヘッダー(min-height 52px / 760px以上で64px)を引いた1画面ぶんに収める */
    --notfound-cat-width: 10rem;

    display: grid;
    place-items: center;
    gap: 10px;
    width: 100%;
    max-width: var(--measure-prose);
    min-height: calc(100dvh - 52px);
    margin: 0 auto;
    padding: 32px 16px 80px;
    text-align: center;
  }

  @media (min-width: 760px) {
    .notfound {
      min-height: calc(100dvh - 64px);
    }
  }

  /* 数字を視線の起点にし、文はその説明として静かに置く。
     h1 を大きく色付きにすると、404 という状況に対して語調が強すぎる */
  .notfound-code {
    margin: 0;
    color: var(--color-secondary);
    font-family: var(--font-machine);
    font-size: var(--text-2xl);
    font-weight: 400;
    line-height: 1;
    letter-spacing: 0.08em;
  }

  .notfound h1 {
    margin: 0;
    color: var(--color-text-sub);
    font-size: var(--text-md);
    font-weight: 400;
    line-height: var(--leading-body);
  }

  .notfound-mark {
    /* 文言のすぐ下に猫を寄せ、リンクとの間で区切る */
    width: var(--notfound-cat-width);
    height: auto;
    margin: 0 0 20px;
    opacity: 0.8;
  }

  .notfound-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px 24px;
  }

  .notfound-links a {
    color: var(--color-text-sub);
    font-size: var(--text-sm);
    text-decoration: none;
    background: linear-gradient(
      transparent 58%,
      color-mix(in srgb, var(--color-accent) 58%, transparent) 58%
    );
    transition: color var(--duration-feedback) ease;
  }

  .notfound-links a:hover {
    color: var(--text-primary);
    background: linear-gradient(transparent 58%, var(--color-accent) 58%);
  }
</style>
