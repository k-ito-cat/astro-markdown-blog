---
import { getCollection } from "astro:content";
import { Icon } from "astro-icon/components";
import { PUBLISHED_STATUS } from "~/constants/publishedStatus";
import BaseLayout from "~/layouts/BaseLayout.astro";
import Card from "~/components/Card.astro";
import Pagination from "~/components/Pagination.astro";
import { type Category } from "~/constants/categories";
// import Categories from "~/components/Categories.astro";

const PAGE_SIZE = 12;
const category = Astro.url.searchParams.get("category") as Category;

/**
 * 公開または下書きのpostだけを取得
 */
const posts = await getCollection("posts", ({ data }) => {
  if (!category) {
    return data.status !== PUBLISHED_STATUS.PRIVATE;
  } else {
    return (
      data.status !== PUBLISHED_STATUS.PRIVATE &&
      data.categories.includes(category)
    );
  }
});

/**
 * 公開日時が新しい順でソート
 */
const sortedPosts = posts.sort((a, b) => {
  return (
    new Date(b.data.publishedAt).getTime() -
    new Date(a.data.publishedAt).getTime()
  );
});

const totalPosts = sortedPosts.length;
const totalPages = Math.ceil(totalPosts / PAGE_SIZE);
const pagePosts = sortedPosts.slice(0, PAGE_SIZE);
---

<BaseLayout title="記事一覧">
  <div class="blog">
    <header class="blog-head">
      <div class="blog-head-top">
        <h1 class="blog-title">記事一覧</h1>
        <span class="blog-count" id="post-count" data-total={totalPosts}>
          {totalPosts} posts
        </span>
      </div>

      <p class="blog-desc">ほぼ環境改善系の技術メモ。</p>

      <div class="blog-tools">
        <div class="search-field">
          <Icon name="octicon:search-16" class="search-icon" />
          <input
            id="post-search-input"
            type="search"
            inputmode="search"
            placeholder="タイトルで検索"
            class="search-input"
            aria-label="記事タイトル検索"
          />
          <button
            type="button"
            class="search-clear"
            data-search-clear
            aria-label="検索条件を外す"
            hidden
          >
            <Icon name="octicon:x-16" />
          </button>
        </div>
        <a
          href="/blog"
          aria-current={!category ? "page" : undefined}
          class:list={["blog-filter", { "is-active": !category }]}
        >
          すべて
        </a>
      </div>
    </header>

    <ul class="card-list" id="post-list">
      {
        pagePosts.map((post) => {
          const { title, publishedAt, categories, thumbnail, status } =
            post.data;

          return (
            <li data-title={title.toLowerCase()}>
              <Card
                slug={post.id}
                title={title}
                publishedAt={publishedAt}
                categories={categories}
                thumbnail={thumbnail}
                status={status}
              />
            </li>
          );
        })
      }
    </ul>

    <p class="blog-empty" data-search-empty hidden>
      合う記事が見つかりませんでした。
      <button type="button" class="blog-empty-clear" data-search-clear>
        条件を外す
      </button>
    </p>

    <Pagination currentPage={1} totalPages={totalPages} basePath="/blog" />
  </div>
</BaseLayout>

<style>
  .blog {
    width: 100%;
    max-width: var(--max-width-content);
    margin: 0 auto;
    padding: 40px 16px;
  }

  .blog-head {
    margin-bottom: 24px;
  }

  .blog-head-top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
  }

  .blog-title {
    margin: 0;
    font-size: 24px;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--text-primary);
  }

  .blog-count {
    flex: none;
    font-size: 13px;
    color: var(--text-muted);
  }

  .blog-desc {
    margin: 8px 0 0;
    font-size: 14px;
    line-height: 1.8;
    color: var(--text-secondary);
  }

  .blog-tools {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    margin-top: 16px;
  }

  .search-field {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    width: 100%;
    max-width: 300px;
    height: 38px;
    padding: 0 10px;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    transition: border-color 140ms ease-out;
  }

  .search-field:focus-within {
    border-color: var(--focus);
  }

  .search-input {
    flex: 1;
    min-width: 0;
    height: 100%;
    border: 0;
    background: transparent;
    color: var(--text-primary);
    font-size: 14px;
    outline: none;
  }

  .search-input::placeholder {
    color: var(--text-muted);
  }

  .search-icon {
    flex: none;
    font-size: 16px;
    color: var(--text-muted);
  }

  .search-clear {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: none;
    color: var(--text-muted);
    border: 0;
    background: transparent;
    font-size: 14px;
  }

  .search-clear:hover {
    color: var(--text-primary);
  }

  .search-clear[hidden] {
    display: none;
  }

  .blog-filter {
    flex: none;
    padding: 7px 12px;
    font-size: 13px;
    color: var(--text-secondary);
    text-decoration: none;
    background: transparent;
    border: 1px solid var(--border);
    border-radius: var(--radius-label);
    transition:
      background-color 140ms ease-out,
      color 140ms ease-out;
  }

  .blog-filter:hover {
    color: var(--text-primary);
    text-decoration: none;
  }

  .blog-filter.is-active {
    color: var(--text-primary);
    background: var(--bg-selection);
  }

  .card-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .card-list > li {
    min-width: 0;
  }

  .blog-empty {
    margin: 0;
    padding: 32px 20px;
    text-align: center;
    font-size: 14px;
    color: var(--text-secondary);
    border: 1px dashed var(--border);
    border-radius: var(--radius-card);
  }

  .blog-empty[hidden] {
    display: none;
  }

  .blog-empty-clear {
    margin-left: 8px;
    color: var(--link);
    border: 0;
    background: transparent;
    font-size: 14px;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .blog-empty-clear:hover {
    color: var(--link-hover);
  }

  @media (min-width: 640px) {
    .blog {
      padding: 48px 24px;
    }
  }
</style>

<script type="module">
  import { initPostSearch } from "~/scripts/postSearch";

  initPostSearch();
</script>
