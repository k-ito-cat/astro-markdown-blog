---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import BaseLayout from "~/layouts/BaseLayout.astro";
import Timeline, { type TimelineEntry } from "~/components/Timeline.astro";
import { PUBLISHED_STATUS } from "~/constants/publishedStatus";
import { VERIFICATION_STATUS_LABELS } from "~/constants/verificationStatus";
import { normalizePostSlug } from "~/utils/postSlug";
import leftReachingCat from "~/assets/left-reaching-cat.png";
import { formatJapaneseDate, toIsoDate } from "~/utils/formatDate";

const allPosts = await getCollection(
  "posts",
  ({ data }) => data.status !== PUBLISHED_STATUS.PRIVATE,
);

const entries: TimelineEntry[] = allPosts
  .map((post) => {
    const isRevision =
      post.data.updatedAt.getTime() > post.data.publishedAt.getTime();
    const activityDate = isRevision
      ? post.data.updatedAt
      : post.data.publishedAt;
    const isoDate = toIsoDate(activityDate);
    const [year, month] = isoDate.split("-");
    return {
      slug: normalizePostSlug(post.id),
      title: post.data.title,
      isoDate,
      displayDate: formatJapaneseDate(activityDate),
      year,
      month,
      categories: post.data.categories,
      tags: post.data.tags,
      activity: isRevision ? "改訂" : "新規",
      isWip: post.data.status === PUBLISHED_STATUS.DRAFT,
      verificationLabel: post.data.verificationStatus
        ? VERIFICATION_STATUS_LABELS[post.data.verificationStatus]
        : undefined,
      revisionCount: post.data.revisions?.length ?? (isRevision ? 1 : 0),
    };
  })
  .sort((a, b) => b.isoDate.localeCompare(a.isoDate));

const countBy = (lists: string[][]) =>
  Array.from(
    lists.reduce((map, items) => {
      items.forEach((item) => map.set(item, (map.get(item) ?? 0) + 1));
      return map;
    }, new Map<string, number>()),
  ).sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0], "ja"));

const fieldCounts = countBy(allPosts.map((post) => post.data.categories));
const tagCounts = countBy(allPosts.map((post) => post.data.tags));
---

<BaseLayout title="索引">
  <main id="main-content" class="index-page">
    <header class="index-head">
      <div class="index-title-row">
        <h1>索引</h1>
        <span id="post-count" data-total={entries.length} aria-live="polite">
          {entries.length}件の記録
        </span>
      </div>
      <p>タイトルを検索、または分野やタグから絞り込めます。</p>

      <div class="search-field">
        <div class="search-input-area">
          <Icon name="octicon:search-16" aria-hidden="true" />
          <input
            id="post-search-input"
            type="search"
            inputmode="search"
            autocomplete="off"
            placeholder="タイトル・分野・タグを検索 /"
            aria-label="タイトルと分野とタグを検索"
          />
          <button
            type="button"
            data-search-clear
            aria-label="検索条件を外す"
            hidden
          >
            <Icon name="octicon:x-16" aria-hidden="true" />
          </button>
        </div>
        <span class="search-rest" aria-hidden="true">
          <Image
            class="search-cat"
            src={leftReachingCat}
            alt=""
            widths={[112, 224]}
            sizes="112px"
            loading="eager"
          />
        </span>
      </div>
    </header>

    <nav class="fields" id="fields" aria-label="分野">
      <ul>
        {
          fieldCounts.map(([field, count]) => (
            <li>
              <a
                href={`/blog?q=${encodeURIComponent(field)}`}
                data-filter-term={field}
              >
                <>
                  <span>{field}</span>
                  <span>{count}</span>
                </>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <nav
      class="fields tags is-collapsed"
      id="tags"
      aria-label="タグ"
      data-tag-nav
    >
      <div class="tags-body">
        <ul id="tag-list">
          {
            tagCounts.map(([tag, count]) => (
              <li>
                <a
                  href={`/blog?q=${encodeURIComponent(tag)}`}
                  data-filter-term={tag}
                >
                  <>
                    <span>#{tag}</span>
                    <span>{count}</span>
                  </>
                </a>
              </li>
            ))
          }
        </ul>
        <span class="tags-veil" aria-hidden="true"></span>
      </div>
      <button
        type="button"
        class="tags-toggle"
        data-tag-toggle
        aria-expanded="true"
        aria-controls="tag-list"
        hidden
      >
        すべてのタグを表示
      </button>
    </nav>

    <section class="index-records" aria-label="記録">
      <Timeline entries={entries} variant="index" />
      <p class="index-empty" data-search-empty hidden>
        該当する記録はありません。<button type="button" data-search-clear
          >条件を外す</button
        >
      </p>
    </section>
  </main>
</BaseLayout>

<style>
  .index-page {
    width: 100%;
    max-width: var(--max-width-content);
    margin: 0 auto;
    padding: 32px 16px 80px;
  }

  .index-head,
  .fields,
  .index-records {
    max-width: var(--layout-stream);
    margin-right: auto;
    margin-left: auto;
  }

  .index-title-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 20px;
  }

  .index-title-row h1 {
    margin: 0;
    color: var(--color-primary);
    font-size: var(--text-2xl);
    line-height: 1.2;
  }

  .index-title-row span,
  .index-head > p {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .index-head > p {
    margin: 12px 0 0;
  }

  /* 下線だけを横幅いっぱいに伸ばし、入力できる範囲は 360px のまま。
     余った線の上に猫を乗せる（入力不可領域） */
  .search-field {
    --search-cat-width: 6.5rem;

    display: flex;
    align-items: flex-end;
    width: 100%;
    margin-top: 20px;
    color: var(--color-text-muted);
    border-bottom: 1px solid var(--color-border-strong);
  }

  .search-input-area {
    display: flex;
    flex: 1;
    align-items: center;
    gap: 8px;
    min-width: 0;
    min-height: 42px;
    padding: 0 2px;
  }

  /* 入力不可領域は猫1匹ぶんだけ。残りの線はすべて入力領域が使う */
  .search-rest {
    position: relative;
    flex: none;
    width: var(--search-cat-width);
    /* 猫（1355:839）が幅いっぱいになる高さ。箱の底に接地させる */
    height: calc(var(--search-cat-width) * 839 / 1355);
    pointer-events: none;
  }

  .search-cat {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: bottom center;
    opacity: 0.8;
  }

  /* 入力欄だけで幅が埋まる画面では猫を出さない */
  @media (max-width: 639px) {
    .search-rest {
      display: none;
    }
  }

  .search-field:focus-within {
    border-bottom-color: var(--color-secondary);
  }

  .search-field input {
    appearance: none;
    flex: 1;
    min-width: 0;
    border: 0;
    outline: 0;
    color: var(--color-text);
    background: transparent;
  }

  .search-field input::-webkit-search-cancel-button {
    display: none;
  }

  .search-field button,
  .index-empty button {
    min-width: 32px;
    min-height: 32px;
    color: var(--color-interaction-text);
    background: transparent;
    border: 0;
    cursor: pointer;
  }

  .fields {
    margin-top: 32px;
  }

  .fields ul {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 0 24px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .fields a {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 6px 0;
    color: var(--color-text-sub);
    font-size: var(--text-sm);
    text-decoration: none;
    border-bottom: 1px solid var(--color-border);
  }

  .fields a span:last-child {
    color: var(--color-text-muted);
    font-family: var(--font-machine);
    font-size: 11px;
  }

  .tags {
    margin-top: 24px;
  }

  .tags ul {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 16px;
  }

  .tags a {
    gap: 6px;
    padding: 4px 0;
    color: var(--color-text-muted);
    font-size: 12px;
    border-bottom: 0;
  }

  .tags a:hover {
    color: var(--color-text-sub);
  }

  .tags-body {
    position: relative;
  }

  /* 折りたたみ時は3行 + 4行目のさわりだけ見せる */
  #tag-list {
    max-height: var(--tags-expanded-height, none);
    overflow: hidden;
  }

  .tags.is-collapsed #tag-list {
    max-height: var(--tags-collapsed-height, 5.5rem);
  }

  /* 初回計測が終わってから開閉アニメーションを有効にする（読み込み時に動かさない） */
  .tags.is-animated #tag-list {
    transition: max-height var(--duration-state) ease-out;
  }

  /* JS が無い環境では開く手段が無いので、折りたたまない */
  @media (scripting: none) {
    .tags.is-collapsed #tag-list {
      max-height: none;
    }

    .tags-veil {
      display: none;
    }
  }

  /* ページ下部の timeline-mist と同じ、多段のグラデーションで裾を消す */
  .tags-veil {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 56px;
    background: linear-gradient(
      to bottom,
      transparent 0%,
      color-mix(in srgb, var(--color-background) 8%, transparent) 28%,
      color-mix(in srgb, var(--color-background) 58%, transparent) 72%,
      color-mix(in srgb, var(--color-background) 96%, transparent) 100%
    );
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--duration-feedback) ease-out;
  }

  .tags.is-collapsed .tags-veil {
    opacity: 1;
  }

  .tags-toggle {
    margin-top: 10px;
    padding: 4px 0;
    color: var(--color-primary);
    font-family: var(--font-machine);
    font-size: 11px;
    background: transparent;
    border: 0;
    cursor: pointer;
  }

  .tags-toggle:hover,
  .tags-toggle:focus-visible {
    color: var(--color-primary);
    background: linear-gradient(
      transparent 58%,
      color-mix(in srgb, var(--color-accent) 58%, transparent) 58%
    );
  }

  .index-records {
    margin-top: 44px;
  }

  .index-empty {
    margin: 28px 0;
    padding: 24px 0;
    color: var(--color-text-sub);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  @media (min-width: 640px) {
    .index-page {
      padding: 48px 24px 96px;
    }
  }
</style>

<script>
  import { initPostSearch } from "~/scripts/postSearch";
  import { initTagCollapse } from "~/scripts/tagCollapse";

  initPostSearch();
  initTagCollapse();
  document.addEventListener("astro:page-load", initTagCollapse);
</script>
