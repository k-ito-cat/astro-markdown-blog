---
import { getCollection } from "astro:content";
import { Icon } from "astro-icon/components";
import BaseLayout from "~/layouts/BaseLayout.astro";
import Timeline from "~/components/Timeline.astro";
import { PUBLISHED_STATUS } from "~/constants/publishedStatus";
import { WRITING_STATUS } from "~/constants/writingStatus";
import { normalizePostSlug } from "~/utils/postSlug";
import { type Category } from "~/constants/categories";

const category = Astro.url.searchParams.get("category") as Category | null;

const posts = await getCollection("posts", ({ data }) => {
  if (!category) {
    return data.status !== PUBLISHED_STATUS.PRIVATE;
  }
  return (
    data.status !== PUBLISHED_STATUS.PRIVATE &&
    data.categories.includes(category)
  );
});

const sorted = posts.sort((a, b) => {
  return (
    new Date(b.data.publishedAt).getTime() -
    new Date(a.data.publishedAt).getTime()
  );
});

const toIso = (date: Date) => new Date(date).toISOString().split("T")[0];

const entries = sorted.map((post) => {
  const iso = toIso(post.data.publishedAt);
  const [year, month] = iso.split("-");
  return {
    slug: normalizePostSlug(post.id),
    title: post.data.title,
    date: iso.replaceAll("-", "."),
    year,
    month,
    categories: post.data.categories.filter((c) => c !== "すべて"),
    wip:
      post.data.status === PUBLISHED_STATUS.DRAFT ||
      post.data.writingStatus !== WRITING_STATUS.DONE,
  };
});

const total = entries.length;
---

<BaseLayout title="ノート一覧">
  <div class="blog">
    <header class="blog-head">
      <div class="blog-head-top">
        <h1 class="blog-title">ノート一覧</h1>
        <span class="blog-count" id="post-count" data-total={total}>
          {total} notes
        </span>
      </div>

      {
        category && (
          <p class="blog-filter-active">
            <span class="blog-filter-mark">¶</span> {category}
            <a href="/blog" class="blog-filter-clear">
              解除
            </a>
          </p>
        )
      }

      <div class="blog-tools">
        <div class="search-field">
          <Icon name="octicon:search-16" class="search-icon" />
          <input
            id="post-search-input"
            type="search"
            inputmode="search"
            placeholder="タイトルで検索"
            class="search-input"
            aria-label="ノートのタイトル検索"
          />
          <button
            type="button"
            class="search-clear"
            data-search-clear
            aria-label="検索条件を外す"
            hidden
          >
            <Icon name="octicon:x-16" />
          </button>
        </div>
      </div>
    </header>

    <Timeline entries={entries} variant="index" />

    <p class="blog-empty" data-search-empty hidden>
      合う記事が見つかりませんでした。
      <button type="button" class="blog-empty-clear" data-search-clear>
        条件を外す
      </button>
    </p>
  </div>
</BaseLayout>

<style>
  .blog {
    width: 100%;
    max-width: 680px;
    margin: 0 auto;
    padding: 40px 16px;
  }

  .blog-head {
    margin-bottom: 28px;
  }

  .blog-head-top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
  }

  .blog-title {
    margin: 0;
    font-size: 24px;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--text-primary);
  }

  .blog-count {
    flex: none;
    font-size: 13px;
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }

  .blog-filter-active {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 14px 0 0;
    font-size: 13px;
    color: var(--text-secondary);
  }

  .blog-filter-mark {
    color: var(--accent-warm);
  }

  .blog-filter-clear {
    color: var(--link);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .blog-tools {
    margin-top: 16px;
  }

  .search-field {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    width: 100%;
    max-width: 300px;
    height: 38px;
    padding: 0 10px;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    transition: border-color 140ms ease-out;
  }

  .search-field:focus-within {
    border-color: var(--focus);
  }

  .search-input {
    flex: 1;
    min-width: 0;
    height: 100%;
    border: 0;
    background: transparent;
    color: var(--text-primary);
    font-size: 14px;
    outline: none;
  }

  .search-input::placeholder {
    color: var(--text-muted);
  }

  .search-icon {
    flex: none;
    font-size: 16px;
    color: var(--text-muted);
  }

  .search-clear {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: none;
    color: var(--text-muted);
    border: 0;
    background: transparent;
    font-size: 14px;
  }

  .search-clear:hover {
    color: var(--text-primary);
  }

  .search-clear[hidden] {
    display: none;
  }

  .blog-empty {
    margin: 28px 0 0;
    padding: 32px 20px;
    text-align: center;
    font-size: 14px;
    color: var(--text-secondary);
    border: 1px dashed var(--border);
    border-radius: var(--radius-card);
  }

  .blog-empty[hidden] {
    display: none;
  }

  .blog-empty-clear {
    margin-left: 8px;
    color: var(--link);
    border: 0;
    background: transparent;
    font-size: 14px;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .blog-empty-clear:hover {
    color: var(--link-hover);
  }

  @media (min-width: 640px) {
    .blog {
      padding: 48px 24px;
    }
  }
</style>

<script>
  import { initPostSearch } from "~/scripts/postSearch";

  initPostSearch();
</script>
