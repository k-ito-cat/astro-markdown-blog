---
import { getCollection } from "astro:content";
import { Icon } from "astro-icon/components";
import BaseLayout from "~/layouts/BaseLayout.astro";
import Timeline, { type TimelineEntry } from "~/components/Timeline.astro";
import { PUBLISHED_STATUS } from "~/constants/publishedStatus";
import { VERIFICATION_STATUS_LABELS } from "~/constants/verificationStatus";
import { normalizePostSlug } from "~/utils/postSlug";
import { formatJapaneseDate, toIsoDate } from "~/utils/formatDate";

const allPosts = await getCollection(
  "posts",
  ({ data }) => data.status !== PUBLISHED_STATUS.PRIVATE,
);

const entries: TimelineEntry[] = allPosts
  .map((post) => {
    const isRevision =
      post.data.updatedAt.getTime() > post.data.publishedAt.getTime();
    const activityDate = isRevision
      ? post.data.updatedAt
      : post.data.publishedAt;
    const isoDate = toIsoDate(activityDate);
    const [year, month] = isoDate.split("-");
    return {
      slug: normalizePostSlug(post.id),
      title: post.data.title,
      isoDate,
      displayDate: formatJapaneseDate(activityDate),
      year,
      month,
      categories: post.data.categories,
      tags: post.data.tags,
      activity: isRevision ? "改訂" : "新規",
      isWip: post.data.status === PUBLISHED_STATUS.DRAFT,
      verificationLabel: post.data.verificationStatus
        ? VERIFICATION_STATUS_LABELS[post.data.verificationStatus]
        : undefined,
      revisionCount: post.data.revisions?.length ?? (isRevision ? 1 : 0),
    };
  })
  .sort((a, b) => b.isoDate.localeCompare(a.isoDate));

const countBy = (lists: string[][]) =>
  Array.from(
    lists.reduce((map, items) => {
      items.forEach((item) => map.set(item, (map.get(item) ?? 0) + 1));
      return map;
    }, new Map<string, number>()),
  ).sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0], "ja"));

const fieldCounts = countBy(allPosts.map((post) => post.data.categories));
const tagCounts = countBy(allPosts.map((post) => post.data.tags));
---

<BaseLayout title="索引">
  <main class="index-page">
    <header class="index-head">
      <div class="index-title-row">
        <h1>索引</h1>
        <span id="post-count" data-total={entries.length} aria-live="polite">
          {entries.length}件の記録
        </span>
      </div>
      <p>
        言葉が決まっていれば検索、まだ決まっていなければ分野やタグから辿れます。
      </p>

      <div class="search-field">
        <Icon name="octicon:search-16" aria-hidden="true" />
        <input
          id="post-search-input"
          type="search"
          inputmode="search"
          autocomplete="off"
          placeholder="記録名・分野・タグを検索 /"
          aria-label="記録名と分野とタグを検索"
        />
        <button
          type="button"
          data-search-clear
          aria-label="検索条件を外す"
          hidden
        >
          <Icon name="octicon:x-16" aria-hidden="true" />
        </button>
      </div>
    </header>

    <nav class="fields" id="fields" aria-label="分野">
      <ul>
        {
          fieldCounts.map(([field, count]) => (
            <li>
              <a
                href={`/blog?q=${encodeURIComponent(field)}`}
                data-filter-term={field}
              >
                <>
                  <span>{field}</span>
                  <span>{count}</span>
                </>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <nav class="fields tags" id="tags" aria-label="タグ">
      <ul>
        {
          tagCounts.map(([tag, count]) => (
            <li>
              <a
                href={`/blog?q=${encodeURIComponent(tag)}`}
                data-filter-term={tag}
              >
                <>
                  <span>#{tag}</span>
                  <span>{count}</span>
                </>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <section class="index-records" aria-label="記録">
      <Timeline entries={entries} variant="index" />
      <p class="index-empty" data-search-empty hidden>
        該当する記録はありません。<button type="button" data-search-clear
          >条件を外す</button
        >
      </p>
    </section>
  </main>
</BaseLayout>

<style>
  .index-page {
    width: 100%;
    max-width: var(--max-width-content);
    margin: 0 auto;
    padding: 32px 16px 80px;
  }

  .index-head,
  .fields,
  .index-records {
    max-width: var(--layout-stream);
    margin-right: auto;
    margin-left: auto;
  }

  .index-title-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 20px;
  }

  .index-title-row h1 {
    margin: 0;
    color: var(--color-primary);
    font-size: var(--text-2xl);
    line-height: 1.2;
  }

  .index-title-row span,
  .index-head > p {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .index-head > p {
    margin: 12px 0 0;
  }

  .search-field {
    display: flex;
    align-items: center;
    gap: 8px;
    width: min(100%, 360px);
    min-height: 42px;
    margin-top: 20px;
    padding: 0 2px;
    color: var(--color-text-muted);
    border-bottom: 1px solid var(--color-border-strong);
  }

  .search-field:focus-within {
    border-bottom-color: var(--color-secondary);
  }

  .search-field input {
    appearance: none;
    flex: 1;
    min-width: 0;
    border: 0;
    outline: 0;
    color: var(--color-text);
    background: transparent;
  }

  .search-field input::-webkit-search-cancel-button {
    display: none;
  }

  .search-field button,
  .index-empty button {
    min-width: 32px;
    min-height: 32px;
    color: var(--color-interaction-text);
    background: transparent;
    border: 0;
    cursor: pointer;
  }

  .fields {
    margin-top: 32px;
  }

  .fields ul {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 0 24px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .fields a {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 6px 0;
    color: var(--color-text-sub);
    font-size: var(--text-sm);
    text-decoration: none;
    border-bottom: 1px solid var(--color-border);
  }

  .fields a span:last-child {
    color: var(--color-text-muted);
    font-family: var(--font-machine);
    font-size: 11px;
  }

  .tags {
    margin-top: 24px;
  }

  .tags ul {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 16px;
  }

  .tags a {
    gap: 6px;
    padding: 4px 0;
    color: var(--color-text-muted);
    font-size: 12px;
    border-bottom: 0;
  }

  .tags a:hover {
    color: var(--color-text-sub);
  }

  .index-records {
    margin-top: 44px;
  }

  .index-empty {
    margin: 28px 0;
    padding: 24px 0;
    color: var(--color-text-sub);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  @media (min-width: 640px) {
    .index-page {
      padding: 48px 24px 96px;
    }
  }
</style>

<script>
  import { initPostSearch } from "~/scripts/postSearch";
  initPostSearch();
</script>
