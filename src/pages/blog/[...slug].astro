---
import { getCollection, getEntry, render } from "astro:content";
import BaseLayout from "~/layouts/BaseLayout.astro";
import Article from "~/components/Article.astro";
import Navigation from "~/components/Navigation.astro";
import { PUBLISHED_STATUS } from "~/constants/publishedStatus";
import { Icon } from "astro-icon/components";
import { normalizePostSlug, resolvePostEntrySlug } from "~/utils/postSlug";

export async function getStaticPaths() {
  /**
   * 公開または下書きのpostだけを取得
   */
  const posts = await getCollection("posts", ({ data }) => {
    return data.status !== PUBLISHED_STATUS.PRIVATE;
  });
  return posts.map((post) => {
    const normalizedSlug = normalizePostSlug(post.id);
    return {
      /**
       * glob loaderの id は基本ファイル名(拡張子なし)。
       * フロントマターでの slug オーバーライドや Sveltia CMS の slug 編集機能で変更可能。
       * @see https://docs.astro.build/en/guides/content-collections/
       */
      params: { slug: normalizedSlug },
      props: { entrySlug: post.id },
    };
  });
}

const slugParam = Array.isArray(Astro.params.slug)
  ? Astro.params.slug.join("/")
  : (Astro.params.slug ?? "");
const entrySlug =
  Astro.props.entrySlug ?? (slugParam ? resolvePostEntrySlug(slugParam) : "");
const post = entrySlug ? await getEntry("posts", entrySlug) : null;

if (!post) return Astro.redirect("/404");

const rendered = await render(post);
const { Content, headings } = rendered;
const isDraft = post.data.status.includes(PUBLISHED_STATUS.DRAFT);
---

<BaseLayout
  title={`記事｜${post.data.title}`}
  ogTitle={post.data.title}
  ogImage={post.data.thumbnail}
>
  <main class="article-main">
    <div class="article-toolbar">
      <a href="/blog" class="back-link">
        <Icon name="octicon:arrow-left-16" />
        一覧へ戻る
      </a>
    </div>

    {
      isDraft ? (
        <Article
          title={post.data.title}
          publishedAt={post.data.publishedAt}
          updatedAt={post.data.updatedAt}
          categories={post.data.categories}
          githubUrl={post.data.githubUrl}
          content={Content}
          headings={headings}
          status={post.data.status}
        />
      ) : (
        <div class:list={["article-grid", { "has-toc": headings.length > 0 }]}>
          <Article
            title={post.data.title}
            publishedAt={post.data.publishedAt}
            updatedAt={post.data.updatedAt}
            categories={post.data.categories}
            githubUrl={post.data.githubUrl}
            content={Content}
            headings={headings}
            status={post.data.status}
          />
          <Navigation headings={headings} />
        </div>
      )
    }
  </main>

  <button
    id="scroll-to-top-btn"
    type="button"
    class="to-top is-hidden"
    aria-label="ページの先頭へ戻る"
  >
    <Icon name="octicon:chevron-up-16" />
  </button>
</BaseLayout>

<style>
  .article-main {
    width: 100%;
    max-width: var(--max-width-content);
    margin: 0 auto;
    padding: 24px 16px 48px;
  }

  .article-toolbar {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 20px;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    color: var(--text-secondary);
    text-decoration: none;
    transition: color 140ms ease-out;
  }

  .back-link:hover {
    color: var(--text-primary);
    text-decoration: none;
  }

  .back-link :global(svg) {
    font-size: 15px;
  }

  .article-grid {
    display: grid;
    gap: 24px;
  }

  .to-top {
    position: fixed;
    right: 16px;
    bottom: 16px;
    z-index: 20;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    color: var(--text-secondary);
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    transition:
      opacity 200ms ease-out,
      transform 200ms ease-out,
      color 140ms ease-out,
      border-color 140ms ease-out;
  }

  .to-top:hover {
    color: var(--text-primary);
    border-color: var(--accent-warm);
  }

  .to-top.is-hidden {
    opacity: 0;
    transform: translateY(12px);
    pointer-events: none;
  }

  .to-top :global(svg) {
    font-size: 20px;
  }

  @media (min-width: 640px) {
    .article-main {
      padding: 32px 24px 64px;
    }
  }

  @media (min-width: 1024px) {
    .article-grid.has-toc {
      grid-template-columns: minmax(0, 1fr) 200px;
      gap: 40px;
    }
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const btn = document.getElementById("scroll-to-top-btn");
    if (!btn) return;

    /**
     * document body の最下部付近に到達したら、
     * フローティングボタンを表示する
     */
    window.addEventListener(
      "scroll",
      () => {
        const bottom = window.scrollY + window.innerHeight;
        const pageHeight = document.body.scrollHeight;

        if (bottom >= pageHeight - 500) {
          btn.classList.remove("is-hidden");
        } else {
          btn.classList.add("is-hidden");
        }
      },
      { passive: true },
    );

    /**
     * フローティングボタンをクリックしたら、
     * ページの最上部にスクロールする
     */
    btn.addEventListener("click", () => {
      window.scrollTo({ top: 0, behavior: "smooth" });
    });
  });
</script>
