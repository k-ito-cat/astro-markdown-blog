---
import { getCollection, getEntry, render } from "astro:content";
import { Icon } from "astro-icon/components";
import BaseLayout from "~/layouts/BaseLayout.astro";
import Article from "~/components/Article.astro";
import CopyLinkButton from "~/components/CopyLinkButton.astro";
import Navigation from "~/components/Navigation.astro";
import RecordRelations from "~/components/RecordRelations.astro";
import { PUBLISHED_STATUS } from "~/constants/publishedStatus";
import { normalizePostSlug, resolvePostEntrySlug } from "~/utils/postSlug";
import { getPostRelations } from "~/utils/postRelations";

export async function getStaticPaths() {
  const posts = await getCollection(
    "posts",
    ({ data }) => data.status !== PUBLISHED_STATUS.PRIVATE,
  );
  return posts.map((post) => ({
    params: { slug: normalizePostSlug(post.id) },
    props: { entrySlug: post.id },
  }));
}

const slugParam = Array.isArray(Astro.params.slug)
  ? Astro.params.slug.join("/")
  : (Astro.params.slug ?? "");
const entrySlug =
  Astro.props.entrySlug ?? (slugParam ? resolvePostEntrySlug(slugParam) : "");
const post = entrySlug ? await getEntry("posts", entrySlug) : null;
if (!post) return Astro.redirect("/404");

const { Content, headings } = await render(post);
const isDraft = post.data.status === PUBLISHED_STATUS.DRAFT;
const previewSlug = normalizePostSlug(post.id);
const { groups, sameField, older, newer } = getPostRelations(
  post,
  await getCollection("posts"),
);
---

<BaseLayout
  title={`記録｜${post.data.title}`}
  ogTitle={post.data.title}
  ogImage={post.data.thumbnail}
>
  <main id="main-content" class="article-main">
    <div class="article-toolbar">
      <a
        href="/blog"
        class="back-link"
        data-reading-return
        data-return-paths='["/","/blog"]'
      >
        <Icon name="octicon:arrow-left-16" aria-hidden="true" />一覧へ戻る
      </a>
      <CopyLinkButton
        path={Astro.url.pathname}
        label="リンクをコピー"
        class="article-copy-link"
      />
      {
        /* ローカル専用の導線。公開ビルドには含めない */
        import.meta.env.DEV && (
          <a
            class="article-preview-link"
            href={`/preview/posts/${previewSlug}`}
          >
            プレビュー
          </a>
        )
      }
    </div>

    <div
      class:list={[
        "article-grid",
        { "has-trace": !isDraft && headings.length > 0 },
      ]}
    >
      <Article
        title={post.data.title}
        publishedAt={post.data.publishedAt}
        updatedAt={post.data.updatedAt}
        categories={post.data.categories}
        tags={post.data.tags}
        githubUrl={post.data.githubUrl}
        content={Content}
        headings={headings}
        status={post.data.status}
        revisions={post.data.revisions}
      />
      {
        !isDraft && (
          <Navigation
            headings={headings}
            returnHref="/blog"
            returnLabel="一覧へ戻る"
            returnSourcePaths={["/", "/blog"]}
          />
        )
      }
    </div>

    {
      !isDraft && (
        <RecordRelations
          groups={groups}
          sameField={sameField}
          older={older}
          newer={newer}
        />
      )
    }
  </main>
</BaseLayout>

<style>
  .article-main {
    width: 100%;
    max-width: var(--max-width-content);
    margin: 0 auto;
    padding: 24px 16px 80px;
  }

  .article-toolbar {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 28px;
  }

  /* 子コンポーネントの要素には scoped style が届かない */
  .article-toolbar :global(.article-copy-link) {
    margin-left: auto;
  }

  .article-preview-link {
    color: var(--color-text-sub);
    font-size: var(--text-sm);
    text-decoration: none;
  }

  .article-preview-link:hover,
  .article-preview-link:focus-visible {
    color: var(--color-interaction-text);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--color-text-sub);
    font-size: var(--text-sm);
    text-decoration: none;
  }

  .back-link:hover,
  .back-link:focus-visible {
    color: var(--color-interaction-text);
    text-decoration: underline;
  }

  .article-grid {
    display: grid;
    gap: 36px;
  }

  @media (min-width: 640px) {
    .article-main {
      padding: 36px 24px 96px;
    }
  }

  @media (min-width: 1024px) {
    .article-grid.has-trace {
      grid-template-columns: minmax(0, 1fr) 220px;
      gap: 48px;
    }
  }
</style>
