---
import { getCollection, getEntry, render } from "astro:content";
import { Icon } from "astro-icon/components";
import BaseLayout from "~/layouts/BaseLayout.astro";
import Article from "~/components/Article.astro";
import Navigation from "~/components/Navigation.astro";
import RecordRelations from "~/components/RecordRelations.astro";
import { PUBLISHED_STATUS } from "~/constants/publishedStatus";
import { normalizePostSlug, resolvePostEntrySlug } from "~/utils/postSlug";

export async function getStaticPaths() {
  const posts = await getCollection(
    "posts",
    ({ data }) => data.status !== PUBLISHED_STATUS.PRIVATE,
  );
  return posts.map((post) => ({
    params: { slug: normalizePostSlug(post.id) },
    props: { entrySlug: post.id },
  }));
}

const slugParam = Array.isArray(Astro.params.slug)
  ? Astro.params.slug.join("/")
  : (Astro.params.slug ?? "");
const entrySlug =
  Astro.props.entrySlug ?? (slugParam ? resolvePostEntrySlug(slugParam) : "");
const post = entrySlug ? await getEntry("posts", entrySlug) : null;
if (!post) return Astro.redirect("/404");

const { Content, headings } = await render(post);
const isDraft = post.data.status === PUBLISHED_STATUS.DRAFT;
const publishedPosts = await getCollection(
  "posts",
  ({ data }) => data.status !== PUBLISHED_STATUS.PRIVATE,
);
const timeline = publishedPosts.sort(
  (a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime(),
);
const bySlug = new Map(
  timeline.map((entry) => [normalizePostSlug(entry.id), entry]),
);
const currentIndex = timeline.findIndex((entry) => entry.id === post.id);
const newerPost = currentIndex > 0 ? timeline[currentIndex - 1] : undefined;
const olderPost =
  currentIndex >= 0 && currentIndex < timeline.length - 1
    ? timeline[currentIndex + 1]
    : undefined;

type LinkedRecord = { slug: string; title: string };
const toLinkedRecord = (slug: string): LinkedRecord | undefined => {
  const normalized = normalizePostSlug(slug);
  const entry = bySlug.get(normalized);
  return entry ? { slug: normalized, title: entry.data.title } : undefined;
};
const resolveRecords = (slugs?: string[]) =>
  (slugs ?? [])
    .map(toLinkedRecord)
    .filter((record): record is LinkedRecord => Boolean(record));

const relationGroups = [
  {
    label: "この記録の前提",
    description: "先に理解しておくと、この記録を辿りやすくなります。",
    records: resolveRecords(post.data.relations?.prerequisites),
  },
  {
    label: "関連する記録",
    description: "同じ論点を別の位置から扱っています。",
    records: resolveRecords(post.data.relations?.related),
  },
  {
    label: "ここから続く記録",
    description: "この理解を前提に、先へ進めた記録です。",
    records: resolveRecords(post.data.relations?.developments),
  },
  {
    label: "この記録を置き換えたもの",
    description: "認識の更新により、現在はこちらを参照します。",
    records: resolveRecords(post.data.relations?.replacements),
  },
];

// 関連記事は「共通タグ2点 + 共通カテゴリ1点」で採点する。
// カテゴリが1つ重なるだけ（=同じ分野というだけ）では関連として扱わない。
const TAG_SCORE = 2;
const CATEGORY_SCORE = 1;
const MIN_RELATION_SCORE = 2;
const RELATION_LIMIT = 3;

const currentCategories = new Set<string>(post.data.categories);
const currentTags = new Set<string>(post.data.tags);
const sameField = timeline
  .filter((entry) => entry.id !== post.id)
  .map((entry) => ({
    entry,
    score:
      entry.data.tags.filter((tag) => currentTags.has(tag)).length * TAG_SCORE +
      entry.data.categories.filter((category) =>
        currentCategories.has(category),
      ).length *
        CATEGORY_SCORE,
  }))
  .filter(({ score }) => score >= MIN_RELATION_SCORE)
  .sort(
    (a, b) =>
      b.score - a.score ||
      b.entry.data.publishedAt.getTime() - a.entry.data.publishedAt.getTime(),
  )
  .slice(0, RELATION_LIMIT)
  .map(({ entry }) => ({
    slug: normalizePostSlug(entry.id),
    title: entry.data.title,
  }));
const toSequenceRecord = (entry: typeof olderPost) =>
  entry
    ? { slug: normalizePostSlug(entry.id), title: entry.data.title }
    : undefined;
---

<BaseLayout
  title={`記録｜${post.data.title}`}
  ogTitle={post.data.title}
  ogImage={post.data.thumbnail}
>
  <main id="main-content" class="article-main">
    <a
      href="/blog"
      class="back-link"
      data-reading-return
      data-return-paths='["/","/blog"]'
    >
      <Icon name="octicon:arrow-left-16" aria-hidden="true" />一覧へ戻る
    </a>

    <div
      class:list={[
        "article-grid",
        { "has-trace": !isDraft && headings.length > 0 },
      ]}
    >
      <Article
        title={post.data.title}
        publishedAt={post.data.publishedAt}
        updatedAt={post.data.updatedAt}
        categories={post.data.categories}
        tags={post.data.tags}
        githubUrl={post.data.githubUrl}
        content={Content}
        headings={headings}
        status={post.data.status}
        verificationStatus={post.data.verificationStatus}
        revisions={post.data.revisions}
      />
      {
        !isDraft && (
          <Navigation
            headings={headings}
            returnHref="/blog"
            returnLabel="一覧へ戻る"
            returnSourcePaths={["/", "/blog"]}
          />
        )
      }
    </div>

    {
      !isDraft && (
        <RecordRelations
          groups={relationGroups}
          sameField={sameField}
          older={toSequenceRecord(olderPost)}
          newer={toSequenceRecord(newerPost)}
        />
      )
    }
  </main>
</BaseLayout>

<style>
  .article-main {
    width: 100%;
    max-width: var(--max-width-content);
    margin: 0 auto;
    padding: 24px 16px 80px;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 28px;
    color: var(--color-text-sub);
    font-size: var(--text-sm);
    text-decoration: none;
  }

  .back-link:hover,
  .back-link:focus-visible {
    color: var(--color-interaction-text);
    text-decoration: underline;
  }

  .article-grid {
    display: grid;
    gap: 36px;
  }

  @media (min-width: 640px) {
    .article-main {
      padding: 36px 24px 96px;
    }
  }

  @media (min-width: 1024px) {
    .article-grid.has-trace {
      grid-template-columns: minmax(0, 1fr) 180px;
      gap: 48px;
    }
  }
</style>
