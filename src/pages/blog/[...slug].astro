---
import { getCollection, getEntry, render } from "astro:content";
import BaseLayout from "~/layouts/BaseLayout.astro";
import Article from "~/components/Article.astro";
import Navigation from "~/components/Navigation.astro";
import RecordRelations from "~/components/RecordRelations.astro";
import { Icon } from "astro-icon/components";
import { PUBLISHED_STATUS } from "~/constants/publishedStatus";
import { normalizePostSlug, resolvePostEntrySlug } from "~/utils/postSlug";
import { getPostRelations } from "~/utils/postRelations";

export async function getStaticPaths() {
  const posts = await getCollection(
    "posts",
    ({ data }) => data.status !== PUBLISHED_STATUS.PRIVATE,
  );
  return posts.map((post) => ({
    params: { slug: normalizePostSlug(post.id) },
    props: { entrySlug: post.id },
  }));
}

const slugParam = Array.isArray(Astro.params.slug)
  ? Astro.params.slug.join("/")
  : (Astro.params.slug ?? "");
const entrySlug =
  Astro.props.entrySlug ?? (slugParam ? resolvePostEntrySlug(slugParam) : "");
const post = entrySlug ? await getEntry("posts", entrySlug) : null;
if (!post) return Astro.redirect("/404");

const { Content, headings } = await render(post);
const isDraft = post.data.status === PUBLISHED_STATUS.DRAFT;
const previewSlug = normalizePostSlug(post.id);
const { groups, older, newer } = getPostRelations(
  post,
  await getCollection("posts"),
);
---

<BaseLayout
  title={`記録｜${post.data.title}`}
  ogTitle={post.data.title}
  ogImage={post.data.thumbnail}
>
  <main id="main-content" class="article-main">
    <div
      class:list={[
        "article-grid",
        { "has-trace": !isDraft && headings.length > 0 },
      ]}
    >
      <Article
        title={post.data.title}
        publishedAt={post.data.publishedAt}
        updatedAt={post.data.updatedAt}
        categories={post.data.categories}
        tags={post.data.tags}
        githubUrl={post.data.githubUrl}
        content={Content}
        headings={headings}
        status={post.data.status}
        revisions={post.data.revisions}
        returnHref="/blog"
        returnLabel="一覧へ戻る"
        returnSourcePaths={["/", "/blog"]}
        copyPath={Astro.url.pathname}
        previewHref={import.meta.env.DEV
          ? `/preview/posts/${previewSlug}`
          : undefined}
      />
      {
        !isDraft && (
          <Navigation
            headings={headings}
            title={post.data.title}
            returnHref="/blog"
            returnLabel="一覧へ戻る"
            returnSourcePaths={["/", "/blog"]}
            copyPath={Astro.url.pathname}
            previewHref={
              import.meta.env.DEV ? `/preview/posts/${previewSlug}` : undefined
            }
          />
        )
      }
    </div>

    {
      !isDraft && (
        <RecordRelations
          groups={groups}
          currentTitle={post.data.title}
          older={older}
          newer={newer}
        />
      )
    }

    {
      /*
       * 読み終えた合図として、ページの末尾に来たときだけ下から出す。
       * 本文の途中では出さないので、脚注を行き来しても顔を出さない
       */
    }
    {
      !isDraft && (
        <>
          <span
            class="article-end-sentinel"
            aria-hidden="true"
            data-article-end
          />
          <a class="reading-return" href="/blog" data-reading-return-dock>
            <Icon name="octicon:arrow-left-16" aria-hidden="true" />
            <span>一覧へ戻る</span>
          </a>
        </>
      )
    }
  </main>
</BaseLayout>

<style>
  /*
   * 読み終えた合図。ページの末尾に来たときだけ、画面の下から現れる。
   * Desktopは欄外のtraceが戻り口を持つので、狭い画面にだけ出す
   */
  .article-end-sentinel {
    display: block;
    height: 1px;
  }

  .reading-return {
    position: fixed;
    bottom: max(16px, env(safe-area-inset-bottom));
    left: max(16px, env(safe-area-inset-left));
    z-index: 30;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 24px;
    color: var(--color-primary);
    font-family: var(--font-machine);
    font-size: 12px;
    text-decoration: none;

    /* 出るのも戻るのも画面の下。出た辺と動きの向きを合わせる */
    transform: translateY(calc(100% + 24px));
    transition:
      transform var(--duration-state) var(--ease-trace),
      visibility var(--duration-state);
    visibility: hidden;
  }

  /*
   * hidden 属性で隠すと UA の display: none と競合し、滑り出す前の位置を
   * 持てない。見せる・隠すは class で切り替える
   */
  .reading-return.is-visible {
    transform: translateY(0);
    visibility: visible;
  }

  .reading-return :global(svg) {
    width: 14px;
    height: 14px;
  }

  .reading-return:hover,
  .reading-return:focus-visible {
    color: var(--color-interaction-text);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /*
   * 960px から左端に edge navigation（48px）が立つ。その幅ぶん逃がして
   * menu の裏へ入らないようにする。Desktopは欄外のtraceが戻り口を持つので出さない
   */
  @media (min-width: 960px) {
    .reading-return {
      left: calc(48px + max(16px, env(safe-area-inset-left)));
    }
  }

  @media (min-width: 1024px) {
    .reading-return {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .reading-return {
      transition: none;
    }
  }

  .article-main {
    width: 100%;
    max-width: var(--max-width-content);
    margin: 0 auto;
    padding: 24px 16px 80px;
  }

  .article-grid {
    display: grid;
    gap: 36px;
  }

  @media (min-width: 640px) {
    .article-main {
      padding: 36px 24px 96px;
    }
  }

  @media (min-width: 1024px) {
    .article-main {
      --trace-column: 220px;
      --trace-gap: 48px;
    }

    .article-grid.has-trace {
      grid-template-columns: minmax(0, 1fr) var(--trace-column);
      gap: var(--trace-gap);
    }

    /*
     * 関係は grid の外にあるので、放っておくと目次の幅を勘定に入れずに
     * main の中央へ置かれ、本文より右へずれる。本文の列と同じ幅へ詰める
     */
    .article-grid.has-trace ~ :global(.record-relations) {
      max-width: calc(100% - var(--trace-column) - var(--trace-gap));
      margin-inline-start: 0;
      margin-inline-end: auto;
    }
  }
</style>

<script>
  import { onPageLoad, onPageCleanup } from "~/scripts/pageLifecycle";

  /*
   * ページの末尾に置いた番兵が見えたら、戻り口を下から出す。
   * 本文の途中では出さないので、脚注を行き来しても顔を出さない
   */
  onPageLoad(() => {
    const sentinel = document.querySelector<HTMLElement>("[data-article-end]");
    const dock = document.querySelector<HTMLElement>(
      "[data-reading-return-dock]",
    );
    if (!sentinel || !dock) return;

    const observer = new IntersectionObserver(
      ([entry]) => {
        dock.classList.toggle("is-visible", entry.isIntersecting);
      },
      // 末尾のもう少し手前では出さない。読み切る直前で初めて顔を出す
      { rootMargin: "0px 0px -40px 0px" },
    );
    observer.observe(sentinel);
    onPageCleanup(() => observer.disconnect());
  });
</script>
