---
import { getCollection, getEntry, render } from "astro:content";
import BaseLayout from "~/layouts/BaseLayout.astro";
import Article from "~/components/Article.astro";
import Navigation from "~/components/Navigation.astro";
import PreviewPostsIndex from "~/components/preview/PreviewPostsIndex.astro";
import { normalizePostSlug, resolvePostEntrySlug } from "~/utils/postSlug";

export async function getStaticPaths() {
  if (!import.meta.env.DEV) {
    return [];
  }

  const posts = await getCollection("posts");
  return [
    {
      params: { slug: undefined },
      props: { entrySlug: undefined },
    },
    ...posts.map((post) => ({
      params: { slug: normalizePostSlug(post.id) },
      props: { entrySlug: post.id },
    })),
  ];
}

if (!import.meta.env.DEV) {
  return Astro.redirect("/404");
}

const slugParam = Array.isArray(Astro.params.slug)
  ? Astro.params.slug.join("/")
  : (Astro.params.slug ?? "");
const entrySlug =
  Astro.props.entrySlug ?? (slugParam ? resolvePostEntrySlug(slugParam) : "");
const isDetail = Boolean(entrySlug);
const post = isDetail ? await getEntry("posts", entrySlug) : null;

if (isDetail && !post) {
  return Astro.redirect("/404");
}

const rendered = post ? await render(post) : null;
const Content = rendered?.Content;
const headings = rendered?.headings ?? [];

const posts = await getCollection("posts");
---

<BaseLayout title={post ? `Preview｜${post.data.title}` : "Preview Posts"}>
  {
    post && Content ? (
      <main class="preview-detail">
        <header class="preview-toolbar">
          <a
            href="/preview/posts"
            data-reading-return
            data-return-paths='["/preview/posts"]'
          >
            一覧へ戻る
          </a>
        </header>

        <div
          class:list={[
            "preview-article-grid",
            { "has-trace": headings.length > 0 },
          ]}
        >
          <Article
            slug={normalizePostSlug(post.id)}
            title={post.data.title}
            publishedAt={post.data.publishedAt}
            updatedAt={post.data.updatedAt}
            categories={post.data.categories}
            tags={post.data.tags}
            githubUrl={post.data.githubUrl}
            content={Content}
            headings={headings}
            status={post.data.status}
            verificationStatus={post.data.verificationStatus}
            revisions={post.data.revisions}
            forceRenderContent
            showGithubCard={false}
          />
          {headings.length > 0 && (
            <Navigation
              headings={headings}
              returnHref="/preview/posts"
              returnLabel="一覧へ戻る"
              returnSourcePaths={["/preview/posts"]}
            />
          )}
        </div>
      </main>
    ) : (
      <PreviewPostsIndex posts={posts} />
    )
  }
</BaseLayout>

<style>
  .preview-detail {
    width: 100%;
    max-width: var(--max-width-content);
    margin: 0 auto;
    padding: 24px 16px 80px;
  }

  .preview-toolbar {
    margin-bottom: 28px;
  }

  .preview-toolbar a {
    color: var(--color-text-sub);
    font-size: var(--text-sm);
    text-decoration: none;
  }

  .preview-toolbar a:hover,
  .preview-toolbar a:focus-visible {
    color: var(--color-interaction-text);
    text-decoration: underline;
  }

  .preview-article-grid {
    display: grid;
    gap: 36px;
  }

  @media (min-width: 640px) {
    .preview-detail {
      padding: 36px 24px 96px;
    }
  }

  @media (min-width: 1024px) {
    .preview-article-grid.has-trace {
      grid-template-columns: minmax(0, 1fr) 180px;
      gap: 48px;
    }
  }
</style>
