---
import { getCollection, getEntry, render } from "astro:content";
import BaseLayout from "~/layouts/BaseLayout.astro";
import Article from "~/components/Article.astro";
import Navigation from "~/components/Navigation.astro";
import { Icon } from "astro-icon/components";
import CopyLinkButton from "~/components/CopyLinkButton.astro";
import RecordRelations from "~/components/RecordRelations.astro";
import { getPostRelations } from "~/utils/postRelations";
import PreviewBodyEditor from "~/components/preview/PreviewBodyEditor.astro";
import PreviewFrontmatterEditor from "~/components/preview/PreviewFrontmatterEditor.astro";
import PreviewPostsIndex from "~/components/preview/PreviewPostsIndex.astro";
import PreviewSidebar from "~/components/preview/PreviewSidebar.astro";
import { PUBLISHED_STATUS } from "~/constants/publishedStatus";
import { normalizePostSlug, resolvePostEntrySlug } from "~/utils/postSlug";
import { stripMemoHeadings } from "~/utils/postHeadings";

export async function getStaticPaths() {
  if (!import.meta.env.DEV) {
    return [];
  }

  const posts = await getCollection("posts");
  return [
    {
      params: { slug: undefined },
      props: { entrySlug: undefined },
    },
    ...posts.map((post) => ({
      params: { slug: normalizePostSlug(post.id) },
      props: { entrySlug: post.id },
    })),
  ];
}

if (!import.meta.env.DEV) {
  return Astro.redirect("/404");
}

const slugParam = Array.isArray(Astro.params.slug)
  ? Astro.params.slug.join("/")
  : (Astro.params.slug ?? "");
const entrySlug =
  Astro.props.entrySlug ?? (slugParam ? resolvePostEntrySlug(slugParam) : "");
const isDetail = Boolean(entrySlug);
const post = isDetail ? await getEntry("posts", entrySlug) : null;

if (isDetail && !post) {
  return Astro.redirect("/404");
}

const rendered = post ? await render(post) : null;
const Content = rendered?.Content;
// メモ配下の見出しは作業用なので、目次と現在位置トレースには載せない
const headings = stripMemoHeadings(rendered?.headings ?? []);

const posts = await getCollection("posts");

// 本番ページは非公開記事を生成しないため、導線もそのときだけ出す
const publicPath = post ? `/blog/${normalizePostSlug(post.id)}` : "";
const hasPublicPage = post?.data.status !== PUBLISHED_STATUS.PRIVATE;

const relations = post ? getPostRelations(post, posts) : null;
// 本番の記事ページは下書きのとき関係を出さない
const relationsHidden = post?.data.status === PUBLISHED_STATUS.DRAFT;
---

<BaseLayout title={post ? `Preview｜${post.data.title}` : "Preview Posts"}>
  {
    post && Content ? (
      <div class="preview-layout">
        <PreviewSidebar posts={posts} currentId={post.id} />
        <main id="main-content" class="preview-detail">
          <header class="preview-toolbar">
            <a
              href="/preview/posts"
              data-reading-return
              data-return-paths='["/preview/posts"]'
            >
              一覧へ戻る
            </a>
            <CopyLinkButton path={Astro.url.pathname} label="リンクをコピー" />
            {hasPublicPage ? (
              <a class="preview-toolbar-public" href={publicPath}>
                本番ページ
              </a>
            ) : (
              <span class="preview-toolbar-public preview-toolbar-note">
                非公開のため本番ページなし
              </span>
            )}
            <button
              type="button"
              class="preview-toolbar-delete"
              data-delete-post={normalizePostSlug(post.id)}
              data-post-title={post.data.title}
            >
              削除
            </button>
          </header>

          <PreviewFrontmatterEditor entryId={post.id} data={post.data} />

          <PreviewBodyEditor entryId={post.id} body={post.body ?? ""} />

          <div
            class:list={[
              "preview-article-grid",
              { "has-trace": headings.length > 0 },
            ]}
          >
            <Article
              title={post.data.title}
              publishedAt={post.data.publishedAt}
              updatedAt={post.data.updatedAt}
              categories={post.data.categories}
              tags={post.data.tags}
              githubUrl={post.data.githubUrl}
              content={Content}
              headings={headings}
              status={post.data.status}
              revisions={post.data.revisions}
              forceRenderContent
              showGithubCard={false}
            />
            {headings.length > 0 && (
              <Navigation
                headings={headings}
                returnHref="/preview/posts"
                returnLabel="一覧へ戻る"
                returnSourcePaths={["/preview/posts"]}
              />
            )}
          </div>

          {relations && (
            <section class="preview-relations">
              <p class="preview-relations-note">
                関連情報
                {relationsHidden &&
                  "（下書きのため本番ページには表示されません）"}
              </p>
              <RecordRelations
                groups={relations.groups}
                sameField={relations.sameField}
                older={relations.older}
                newer={relations.newer}
                basePath="/preview/posts"
              />
            </section>
          )}
        </main>
      </div>
    ) : (
      <PreviewPostsIndex posts={posts} />
    )
  }
</BaseLayout>

<!-- JS が作る要素には scoped style が当たらないため、共通のチップはここで当てる -->
<style is:global>
  .create-chip {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 3px 8px;
    color: var(--color-primary);
    background: var(--bg-base);
    border: 1px solid var(--color-primary);
    border-radius: var(--radius-label);
    font-size: var(--text-xs);
    font-family: inherit;
    cursor: pointer;
  }
  .create-chip::after {
    content: "×";
    color: var(--text-muted);
  }
  /* AI が出した候補。押して入力に入れるものなので、
     確定済みの選択チップ（.create-chip）とは別の見た目にする */
  .suggestion-chip {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 3px 9px;
    color: var(--color-interaction-text);
    background: color-mix(in srgb, var(--accent-warm) 34%, var(--bg-base));
    border: 1px solid color-mix(in srgb, var(--color-primary) 40%, transparent);
    border-radius: var(--radius-label);
    font-family: inherit;
    font-size: var(--text-xs);
    cursor: pointer;
  }

  .suggestion-chip::before {
    content: "✦";
    color: color-mix(in srgb, var(--color-primary) 70%, transparent);
    font-size: 0.9em;
  }

  /* まだ定数に無いタグ。保存・作成のときに tags.ts へ書かれる */
  .new-tag-chip {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 3px 9px;
    color: var(--color-primary);
    background: var(--bg-base);
    border: 1px dashed var(--color-primary);
    border-radius: var(--radius-label);
    font-size: var(--text-xs);
    font-family: inherit;
    cursor: pointer;
  }

  .new-tag-chip::before {
    content: "＋";
  }

  .new-tag-chip::after {
    content: "×";
    color: var(--text-muted);
  }

  .suggestion-chip-machine {
    font-family: var(--font-machine);
  }

  .suggestion-chip:hover {
    color: var(--bg-base);
    background: var(--color-primary);
    border-color: var(--color-primary);
  }

  .suggestion-chip:hover::before {
    color: var(--bg-base);
  }
</style>

<style>
  .preview-layout {
    width: 100%;
    max-width: var(--max-width-content);
    margin: 0 auto;
    padding: 24px 16px 80px;
  }

  .preview-detail {
    min-width: 0;
  }

  .preview-relations-note {
    max-width: var(--measure-prose);
    margin: 48px auto 0;
    color: var(--text-muted);
    font-size: var(--text-sm);
  }

  .preview-toolbar {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 28px;
  }

  /* 「戻る」とは役割が違うので、行の反対側に離す */
  .preview-toolbar-public {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-left: auto;
  }

  .preview-toolbar-public svg {
    width: 0.85em;
    height: 0.85em;
  }

  .preview-toolbar-delete {
    min-height: 24px;
    padding: 0 8px;
    border: 0;
    background: transparent;
    color: var(--text-muted);
    font-size: var(--text-sm);
    cursor: pointer;
  }

  .preview-toolbar-delete:hover,
  .preview-toolbar-delete:focus-visible {
    color: var(--danger);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .preview-toolbar-note {
    color: var(--text-muted);
    font-size: var(--text-sm);
  }

  .preview-toolbar a {
    color: var(--color-text-sub);
    font-size: var(--text-sm);
    text-decoration: none;
  }

  .preview-toolbar a:hover,
  .preview-toolbar a:focus-visible {
    color: var(--color-interaction-text);
    text-decoration: underline;
  }

  /*
   * Article と Prose は自分で margin-inline: auto して中央に寄る。
   * 列の幅を本文の測度に合わせれば余白が生まれず、サイドバー側の端に揃う。
   */
  .preview-article-grid {
    display: grid;
    gap: 36px;
    max-width: var(--measure-prose);
  }

  @media (min-width: 640px) {
    .preview-layout {
      padding: 36px 24px 96px;
    }
  }

  /* 記事の横に一覧を出し、別の記事へすぐ移れるようにする。
     本文が痩せないよう、二段組みは十分な幅があるときだけにする */
  @media (min-width: 1280px) {
    .preview-layout {
      display: grid;
      grid-template-columns: 320px minmax(0, 1fr);
      gap: 72px;
      max-width: calc(var(--max-width-content) + 320px + 72px);
      align-items: start;
    }
  }

  @media (min-width: 1024px) {
    .preview-article-grid.has-trace {
      grid-template-columns: minmax(0, 1fr) 180px;
      gap: 48px;
      max-width: calc(var(--measure-prose) + 48px + 180px);
    }
  }
</style>

<script>
  import { initPreviewPostManager } from "~/scripts/previewPostManager";

  initPreviewPostManager();
</script>
