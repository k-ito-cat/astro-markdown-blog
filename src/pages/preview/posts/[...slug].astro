---
import { getCollection, getEntry } from "astro:content";
import BaseLayout from "~/layouts/BaseLayout.astro";
import Article from "~/components/Article.astro";
import Navigation from "~/components/Navigation.astro";
import { normalizePostSlug, resolvePostEntrySlug } from "~/utils/postSlug";

const STATUS_ORDER = {
  draft: 0,
  private: 1,
  published: 2,
};

const STATUS_LABELS = {
  draft: "下書き",
  private: "非公開",
  published: "公開",
};

const STATUS_BADGE_CLASSES = {
  draft: "bg-warning-bg text-warning-text",
  private: "bg-danger-bg text-danger-text",
  published: "bg-tip-bg text-tip-text",
};

const WRITING_STATUS_ORDER = {
  writing: 0,
  "planned-high": 1,
  "planned-mid": 2,
  todo: 3,
  done: 4,
};

const WRITING_STATUS_LABELS = {
  writing: "進行中",
  "planned-high": "進行予定（高）",
  "planned-mid": "進行予定（中）",
  todo: "未着手",
  done: "執筆完了",
};

const WRITING_STATUS_BADGE_CLASSES = {
  writing: "bg-info-bg text-info-text",
  "planned-high": "bg-warning-bg text-warning-text",
  "planned-mid": "bg-[var(--bg-selection)] text-primary",
  todo: "bg-[var(--bg-code)] text-secondary",
  done: "bg-tip-bg text-tip-text",
};

const hasMemo = (body: string) => {
  return Boolean(extractMemo(body));
};

const extractMemo = (body: string) => {
  const match = body.match(/^## メモ\s*$/m);
  if (!match || match.index === undefined) return "";

  return body.slice(match.index + match[0].length).trim();
};

export async function getStaticPaths() {
  if (!import.meta.env.DEV) {
    return [];
  }

  const posts = await getCollection("posts");
  return [
    {
      params: { slug: undefined },
      props: { entrySlug: undefined },
    },
    ...posts.map((post) => ({
      params: { slug: normalizePostSlug(post.slug) },
      props: { entrySlug: post.slug },
    })),
  ];
}

if (!import.meta.env.DEV) {
  return Astro.redirect("/404");
}

const slugParam = Array.isArray(Astro.params.slug)
  ? Astro.params.slug.join("/")
  : (Astro.params.slug ?? "");
const entrySlug =
  Astro.props.entrySlug ?? (slugParam ? resolvePostEntrySlug(slugParam) : "");
const isDetail = Boolean(entrySlug);
const post = isDetail ? await getEntry("posts", entrySlug) : null;

if (isDetail && !post) {
  return Astro.redirect("/404");
}

const rendered = post ? await post.render() : null;
const Content = rendered?.Content;
const headings = rendered?.headings ?? [];

const posts = await getCollection("posts");
const sortedPosts = posts
  .map((post) => ({
    ...post,
    previewSlug: normalizePostSlug(post.slug),
    hasMemo: hasMemo(post.body),
  }))
  .sort((a, b) => {
    const statusDiff =
      STATUS_ORDER[a.data.status] - STATUS_ORDER[b.data.status];
    if (statusDiff !== 0) return statusDiff;

    const writingStatusDiff =
      WRITING_STATUS_ORDER[a.data.writingStatus] -
      WRITING_STATUS_ORDER[b.data.writingStatus];
    if (writingStatusDiff !== 0) return writingStatusDiff;

    return a.data.title.localeCompare(b.data.title, "ja");
  });
---

<BaseLayout title={post ? `Preview｜${post.data.title}` : "Preview Posts"}>
  {
    post && Content ? (
      <main class="mx-auto max-w-[var(--max-width-pc)] bg-transparent px-2 py-8 lg:px-[80px] lg:py-4">
        <header class="mb-4">
          <a
            href="/preview/posts"
            class="text-link hover:text-link-hover inline-flex items-center rounded-md border border-[var(--border-base)] px-3 py-1 text-sm no-underline hover:bg-[var(--bg-hover)]"
          >
            一覧に戻る
          </a>
        </header>

        <div
          class:list={[
            {
              "grid gap-4 lg:grid-cols-[minmax(0,auto)_30%]":
                headings.length > 0,
            },
          ]}
        >
          <Navigation headings={headings} />
          <div class="order-2 lg:order-1">
            <Article
              title={post.data.title}
              publishedAt={post.data.publishedAt}
              updatedAt={post.data.updatedAt}
              categories={post.data.categories}
              githubUrl={post.data.githubUrl}
              content={Content}
              headings={headings}
              status={post.data.status}
              forceRenderContent
              showGithubCard={false}
            />
          </div>
        </div>
      </main>
    ) : (
      <main class="mx-auto w-full max-w-[var(--max-width-pc)] px-4 py-6">
        <header class="mb-5 flex flex-col gap-2">
          <p class="text-meta text-xsmall font-semibold tracking-[0.08em] uppercase">
            Local Preview
          </p>
          <div class="flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
            <h1 class="text-primary text-[24px] font-bold sm:text-[28px]">
              記事プレビュー
            </h1>
            <div class="flex items-center gap-3">
              <span class="text-meta text-small">
                {sortedPosts.length} posts
              </span>
              <a
                href="/blog"
                class="text-link hover:text-link-hover rounded-sm bg-[var(--bg-code)] px-2.5 py-1 text-xs font-medium no-underline hover:bg-[var(--bg-hover)]"
              >
                ブログ一覧
              </a>
            </div>
          </div>
        </header>

        <div class="overflow-x-auto">
          <table class="w-full min-w-[960px] border-separate border-spacing-y-1 text-left text-sm">
            <caption class="sr-only">ローカルプレビュー用の記事一覧</caption>
            <thead>
              <tr>
                <th
                  scope="col"
                  class="w-10 px-1.5 py-2 text-center font-semibold"
                >
                  メモ
                </th>
                <th scope="col" class="px-3 py-2 font-semibold">
                  公開状態
                </th>
                <th scope="col" class="px-3 py-2 font-semibold">
                  執筆状態
                </th>
                <th scope="col" class="px-3 py-2 font-semibold">
                  タイトル
                </th>
                <th
                  scope="col"
                  class="w-[180px] max-w-[180px] px-3 py-2 font-semibold"
                >
                  カテゴリ
                </th>
                <th scope="col" class="px-3 py-2 font-semibold">
                  更新日
                </th>
              </tr>
            </thead>
            <tbody>
              {sortedPosts.map((previewPost) => (
                <tr class="rounded-md hover:bg-[var(--bg-hover)]">
                  <td class="w-10 px-1.5 py-2.5 text-center align-top">
                    <span
                      class:list={[
                        "inline-flex size-6 items-center justify-center rounded-sm",
                        previewPost.hasMemo
                          ? "bg-tip-bg text-tip"
                          : "text-meta bg-[var(--bg-code)]",
                      ]}
                      title={previewPost.hasMemo ? "メモあり" : "メモなし"}
                    >
                      {previewPost.hasMemo ? (
                        <svg
                          viewBox="0 0 16 16"
                          class="size-3.5"
                          aria-hidden="true"
                        >
                          <path
                            fill="currentColor"
                            d="M6.4 11.6 2.9 8.1l1-1 2.5 2.5 5.7-5.7 1 1z"
                          />
                        </svg>
                      ) : (
                        <svg
                          viewBox="0 0 16 16"
                          class="size-3.5"
                          aria-hidden="true"
                        >
                          <path fill="currentColor" d="M3 7.25h10v1.5H3z" />
                        </svg>
                      )}
                      <span class="sr-only">
                        {previewPost.hasMemo ? "メモあり" : "メモなし"}
                      </span>
                    </span>
                  </td>
                  <td class="px-3 py-2.5 align-top">
                    <span
                      class:list={[
                        "inline-flex items-center rounded-sm px-2 py-1 text-[12px] leading-tight font-normal whitespace-nowrap",
                        STATUS_BADGE_CLASSES[previewPost.data.status],
                      ]}
                    >
                      {STATUS_LABELS[previewPost.data.status]}
                    </span>
                  </td>
                  <td class="px-3 py-2.5 align-top">
                    <span
                      class:list={[
                        "inline-flex items-center rounded-sm px-2 py-1 text-[12px] leading-tight font-normal whitespace-nowrap",
                        WRITING_STATUS_BADGE_CLASSES[
                          previewPost.data.writingStatus
                        ],
                      ]}
                    >
                      {WRITING_STATUS_LABELS[previewPost.data.writingStatus]}
                    </span>
                  </td>
                  <th scope="row" class="px-3 py-2.5 align-top font-medium">
                    <a
                      href={`/preview/posts/${previewPost.previewSlug}`}
                      class="text-link hover:text-link-hover underline-offset-4 hover:underline"
                    >
                      {previewPost.data.title}
                    </a>
                  </th>
                  <td class="w-[180px] max-w-[180px] px-3 py-2.5 align-top">
                    <div class="flex flex-wrap gap-1">
                      {previewPost.data.categories.map((category) => (
                        <span class="text-secondary rounded-sm bg-[var(--bg-code)] px-2 py-1 text-[12px] leading-tight font-normal">
                          {category}
                        </span>
                      ))}
                    </div>
                  </td>
                  <td class="text-secondary px-3 py-2.5 align-top whitespace-nowrap">
                    {previewPost.data.updatedAt.toISOString().slice(0, 10)}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </main>
    )
  }
</BaseLayout>
