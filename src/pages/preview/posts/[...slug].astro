---
import { getCollection, getEntry, render } from "astro:content";
import BaseLayout from "~/layouts/BaseLayout.astro";
import Article from "~/components/Article.astro";
import Navigation from "~/components/Navigation.astro";
import { Icon } from "astro-icon/components";
import RecordRelations from "~/components/RecordRelations.astro";
import { getPostRelations } from "~/utils/postRelations";
import PreviewBodyEditor from "~/components/preview/PreviewBodyEditor.astro";
import PreviewDeleteDialog from "~/components/preview/PreviewDeleteDialog.astro";
import PreviewFrontmatterEditor from "~/components/preview/PreviewFrontmatterEditor.astro";
import PreviewViewportDialog from "~/components/preview/PreviewViewportDialog.astro";
import PreviewPostsIndex from "~/components/preview/PreviewPostsIndex.astro";
import PreviewSidebar from "~/components/preview/PreviewSidebar.astro";
import {
  PUBLISHED_STATUS,
  PUBLISHED_STATUS_LABELS,
} from "~/constants/publishedStatus";
import { WRITING_STATUS_LABELS } from "~/constants/writingStatus";
import { POST_PRIORITY_LABELS } from "~/constants/postPriority";
import { normalizePostSlug, resolvePostEntrySlug } from "~/utils/postSlug";
import { stripMemoHeadings } from "~/utils/postHeadings";

export async function getStaticPaths() {
  if (!import.meta.env.DEV) {
    return [];
  }

  const posts = await getCollection("posts");
  return [
    {
      params: { slug: undefined },
      props: { entrySlug: undefined },
    },
    ...posts.map((post) => ({
      params: { slug: normalizePostSlug(post.id) },
      props: { entrySlug: post.id },
    })),
  ];
}

if (!import.meta.env.DEV) {
  return Astro.redirect("/404");
}

const slugParam = Array.isArray(Astro.params.slug)
  ? Astro.params.slug.join("/")
  : (Astro.params.slug ?? "");
const entrySlug =
  Astro.props.entrySlug ?? (slugParam ? resolvePostEntrySlug(slugParam) : "");
const isDetail = Boolean(entrySlug);
const post = isDetail ? await getEntry("posts", entrySlug) : null;

if (isDetail && !post) {
  return Astro.redirect("/404");
}

const rendered = post ? await render(post) : null;
const Content = rendered?.Content;
// メモ配下の見出しは作業用なので、目次と現在位置トレースには載せない
const headings = stripMemoHeadings(rendered?.headings ?? []);

const posts = await getCollection("posts");

const relations = post ? getPostRelations(post, posts) : null;
// 本番の記事ページは下書きのとき関係を出さない
const relationsHidden = post?.data.status === PUBLISHED_STATUS.DRAFT;
---

<BaseLayout title={post ? `Preview｜${post.data.title}` : "Preview Posts"}>
  {
    post && Content ? (
      <div class="preview-layout">
        <main id="main-content" class="preview-detail">
          <p
            class="preview-toolbar-state preview-toolbar-state-mobile"
            data-publication={post.data.status}
          >
            <span class="preview-toolbar-publication">
              {PUBLISHED_STATUS_LABELS[post.data.status]}
            </span>
            <span>{WRITING_STATUS_LABELS[post.data.writingStatus]}</span>
            <span>優先度 {POST_PRIORITY_LABELS[post.data.priority]}</span>
          </p>

          <PreviewBodyEditor entryId={post.id} body={post.body ?? ""}>
            <p
              slot="state"
              class="preview-toolbar-state preview-toolbar-state-desktop"
              data-publication={post.data.status}
            >
              <span class="preview-toolbar-publication">
                {PUBLISHED_STATUS_LABELS[post.data.status]}
              </span>
              <span>{WRITING_STATUS_LABELS[post.data.writingStatus]}</span>
              <span>優先度 {POST_PRIORITY_LABELS[post.data.priority]}</span>
            </p>

            <PreviewSidebar slot="tools" posts={posts} currentId={post.id} />

            <PreviewViewportDialog
              slot="tools-end"
              slug={normalizePostSlug(post.id)}
              isDraft={post.data.status === PUBLISHED_STATUS.DRAFT}
            />

            <PreviewFrontmatterEditor
              slot="tools-end"
              entryId={post.id}
              data={post.data}
            />

            <button
              slot="more"
              type="button"
              class="preview-toolbar-delete"
              data-delete-post={normalizePostSlug(post.id)}
              data-post-title={post.data.title}
            >
              削除
            </button>
          </PreviewBodyEditor>

          <div
            class:list={[
              "preview-article-grid",
              { "has-trace": headings.length > 0 },
            ]}
          >
            <Article
              title={post.data.title}
              publishedAt={post.data.publishedAt}
              updatedAt={post.data.updatedAt}
              categories={post.data.categories}
              tags={post.data.tags}
              recordType={post.data.recordType}
              githubUrl={post.data.githubUrl}
              content={Content}
              headings={headings}
              status={post.data.status}
              revisions={post.data.revisions}
              forceRenderContent
            />
            {headings.length > 0 && (
              <Navigation
                headings={headings}
                title={post.data.title}
                returnHref="/preview/posts"
                returnLabel="一覧へ戻る"
                returnSourcePaths={["/preview/posts"]}
                copyPath={Astro.url.pathname}
              />
            )}
          </div>

          {relations && (
            <section class="preview-relations">
              {relationsHidden && (
                <p class="preview-relations-note">
                  下書きのため、本番ページには表示されません
                </p>
              )}
              <RecordRelations
                groups={relations.groups}
                currentTitle={post.data.title}
                older={relations.older}
                newer={relations.newer}
                basePath="/preview/posts"
              />
            </section>
          )}
        </main>
      </div>
    ) : (
      <PreviewPostsIndex posts={posts} />
    )
  }

  {/* 一覧からも記事からも同じ確認面を開く */}
  <PreviewDeleteDialog />
</BaseLayout>

<!-- JS が作る要素には scoped style が当たらないため、共通のチップはここで当てる -->
<style is:global>
  .create-chip {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 3px 8px;
    color: var(--color-primary);
    background: var(--bg-base);
    border: 1px solid var(--color-primary);
    border-radius: var(--radius-label);
    font-size: var(--text-xs);
    font-family: inherit;
    cursor: pointer;
  }
  .create-chip::after {
    content: "×";
    color: var(--text-muted);
  }
  /* AI が出した候補。押して入力に入れるものなので、
     確定済みの選択チップ（.create-chip）とは別の見た目にする */
  .suggestion-chip {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 3px 9px;
    color: var(--color-interaction-text);
    background: color-mix(in srgb, var(--accent-warm) 34%, var(--bg-base));
    border: 1px solid color-mix(in srgb, var(--color-primary) 40%, transparent);
    border-radius: var(--radius-label);
    font-family: inherit;
    font-size: var(--text-xs);
    cursor: pointer;
  }

  .suggestion-chip::before {
    content: "✦";
    color: color-mix(in srgb, var(--color-primary) 70%, transparent);
    font-size: 0.9em;
  }

  /* まだ定数に無いタグ。保存・作成のときに tags.ts へ書かれる */
  .new-tag-chip {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 3px 9px;
    color: var(--color-primary);
    background: var(--bg-base);
    border: 1px dashed var(--color-primary);
    border-radius: var(--radius-label);
    font-size: var(--text-xs);
    font-family: inherit;
    cursor: pointer;
  }

  .new-tag-chip::before {
    content: "＋";
  }

  .new-tag-chip::after {
    content: "×";
    color: var(--text-muted);
  }

  .suggestion-chip-machine {
    font-family: var(--font-machine);
  }

  .suggestion-chip:hover {
    color: var(--bg-base);
    background: var(--color-primary);
    border-color: var(--color-primary);
  }

  .suggestion-chip:hover::before {
    color: var(--bg-base);
  }
</style>

<style>
  .preview-layout {
    width: 100%;
    max-width: var(--max-width-content);
    margin: 0 auto;
    padding: 24px 16px 80px;
  }

  .preview-detail {
    min-width: 0;
  }

  /*
   * 関係は grid の外にあるので、放っておくと目次の幅を勘定に入れずに
   * 中央へ置かれ、本文より右へずれる。本文の列と同じ幅・同じ左端へ詰める
   */
  .preview-relations {
    max-width: var(--measure-prose);
  }

  .preview-relations > :global(.record-relations) {
    margin-inline-start: 0;
    margin-inline-end: auto;
  }

  .preview-relations-note {
    max-width: var(--measure-prose);
    margin: 48px 0 0;
    color: var(--text-muted);
    font-size: var(--text-sm);
  }

  /*
   * 編集の判断材料になる状態は、frontmatter を開かなくても読めるようにする。
   * 公開ステータスだけ色を持たせ、残りは本文より前に出ないよう控えめに置く。
   */
  .preview-toolbar-state {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin: 0;
    color: var(--text-muted);
    font-size: var(--text-xs);
  }

  .preview-toolbar-state span + span::before {
    content: "／";
    margin-right: 8px;
    color: var(--border-strong);
  }

  .preview-toolbar-publication {
    color: var(--publication-color, var(--text-muted));
    font-weight: 600;
  }

  .preview-toolbar-state[data-publication="published"] {
    --publication-color: var(--color-primary);
  }

  .preview-toolbar-state[data-publication="draft"] {
    --publication-color: var(--warning);
  }

  .preview-toolbar-state-mobile {
    display: none;
  }

  /*
   * Article と Prose は自分で margin-inline: auto して中央に寄る。
   * 列の幅を本文の測度に合わせれば余白が生まれず、サイドバー側の端に揃う。
   */
  .preview-article-grid {
    display: grid;
    gap: 36px;
    max-width: var(--measure-prose);
  }

  @media (min-width: 640px) {
    .preview-layout {
      padding: 36px 24px 96px;
    }
  }

  /* ヘッダーの分だけ下げ、その下の余白は広い幅の20pxに近い量へ抑える */
  @media (max-width: 959px) {
    .preview-layout {
      padding-top: calc(52px + clamp(12px, 3vw, 24px));
    }
  }

  /*
   * 左レールが立つ幅では、上を塞ぐヘッダーが無くなる。狭い幅と同じ余白を
   * 取ると、一番上にいるとき頭上が空きすぎて、道具だけが宙に浮いて見える。
   */
  @media (min-width: 960px) {
    .preview-layout {
      padding-top: 20px;
    }
  }

  @media (max-width: 1023px) {
    /* 指で触る操作子なので、なぞりや長押しで選択が割り込まないようにする */
    .preview-toolbar-state {
      -webkit-touch-callout: none;
      user-select: none;
    }
  }

  @media (max-width: 639px) {
    .preview-toolbar-state-mobile {
      display: flex;
      margin-bottom: 8px;
    }

    .preview-toolbar-state-desktop {
      display: none;
    }
  }

  /* 記事の横に一覧を出し、別の記事へすぐ移れるようにする。
     本文が痩せないよう、二段組みは十分な幅があるときだけにする */
  @media (min-width: 1280px) {
  }

  @media (min-width: 1024px) {
    .preview-detail {
      --trace-column: 220px;
      --trace-gap: 48px;
    }

    .preview-article-grid.has-trace {
      grid-template-columns: minmax(0, 1fr) var(--trace-column);
      gap: var(--trace-gap);
      max-width: calc(
        var(--measure-prose) + var(--trace-gap) + var(--trace-column)
      );
    }

    .preview-article-grid.has-trace ~ .preview-relations {
      max-width: calc(
        var(--measure-prose) + var(--trace-gap) + var(--trace-column)
      );
    }

    .preview-article-grid.has-trace
      ~ .preview-relations
      > :global(.record-relations) {
      max-width: calc(100% - var(--trace-column) - var(--trace-gap));
    }
  }
</style>

<script>
  import { initPreviewPostManager } from "~/scripts/previewPostManager";
  import { onPageLoad } from "~/scripts/pageLifecycle";

  onPageLoad(() => {
    initPreviewPostManager();
  });
</script>
