---
import RecordType from "./RecordType.astro";
import {
  RECORD_TYPE_LABELS,
  type RecordType as RecordTypeValue,
} from "~/constants/recordType";

export type TimelineEntry = {
  slug: string;
  title: string;
  isoDate: string;
  displayDate: string;
  /** 年の断層線が年を持つので、日付groupはこちらを出す */
  monthDay: string;
  year: string;
  month: string;
  categories: string[];
  tags: string[];
  recordType: RecordTypeValue;
  activity: "新規" | "改訂";
  isWip: boolean;
  revisionCount: number;
};

type Props = {
  entries: TimelineEntry[];
  variant?: "stream" | "index";
  /* 年ごとに件数を絞っている場合の、その年の続きへの導線 */
  yearLinks?: Record<string, string>;
};

const { entries, variant = "stream", yearLinks } = Astro.props;
---

<div class="timeline-root" data-timeline-root>
  <ol class="timeline">
    {
      entries.map((entry, index) => {
        const previous = entries[index - 1];
        const showDate = index === 0 || previous.isoDate !== entry.isoDate;
        const showYear = index === 0 || previous.year !== entry.year;
        const showMonth =
          index === 0 ||
          previous.year !== entry.year ||
          previous.month !== entry.month;
        return (
          <Fragment>
            {showYear && (
              <li class="tl-year" id={`year-${entry.year}`} data-year-group>
                <span>{entry.year}</span>
                {yearLinks?.[entry.year] && (
                  <a class="tl-year-more" href={yearLinks[entry.year]}>
                    {entry.year}年をすべて見る →
                  </a>
                )}
              </li>
            )}
            {showDate && (
              <li
                class="tl-date-group"
                data-date-group
                id={
                  showMonth ? `month-${entry.year}-${entry.month}` : undefined
                }
              >
                <time datetime={entry.isoDate}>{entry.monthDay}</time>
              </li>
            )}
            <li
              class:list={["tl-entry", { "is-wip": entry.isWip }]}
              data-record-entry
              data-search-text={`${entry.title} ${entry.categories.join(" ")} ${entry.tags.join(" ")}`.toLocaleLowerCase(
                "ja",
              )}
              data-year={entry.year}
              data-month={entry.month}
              data-categories={JSON.stringify(entry.categories)}
              data-tags={JSON.stringify(entry.tags)}
              data-record-types={JSON.stringify([
                RECORD_TYPE_LABELS[entry.recordType],
              ])}
            >
              <div class="tl-row">
                <a
                  href={`/blog/${entry.slug}`}
                  class="tl-body"
                  data-record-link
                  aria-describedby={`record-context-${index}`}
                >
                  <span class="tl-meta">
                    <span class="tl-node" aria-hidden="true" />
                    <span
                      class:list={[
                        "tl-activity",
                        { "is-revision": entry.activity === "改訂" },
                      ]}
                    >
                      {entry.activity}
                    </span>
                    {entry.isWip && <span class="tl-wip">WIP</span>}
                    <RecordType recordType={entry.recordType} />
                  </span>
                  <span class="tl-title">{entry.title}</span>
                  {entry.categories.length > 0 && (
                    <span class="tl-tags">{entry.categories.join("・")}</span>
                  )}
                </a>
              </div>
              <aside class="tl-context" id={`record-context-${index}`}>
                <p>{entry.displayDate}の記録</p>
                {entry.categories.length > 0 && (
                  <p>分野: {entry.categories.join("・")}</p>
                )}
                {entry.tags.length > 0 && <p>タグ: {entry.tags.join("・")}</p>}
                {entry.revisionCount > 0 && (
                  <p>改訂: {entry.revisionCount}回</p>
                )}
              </aside>
            </li>
          </Fragment>
        );
      })
    }
  </ol>
  {
    variant === "index" && (
      <div class="timeline-mist-space" aria-hidden="true" />
    )
  }
  {
    /* 送っている間だけ出る現在地のTrace。断層線が流れても年を見失わないための補助 */
  }
  <p class="tl-year-cue" data-year-cue aria-hidden="true"></p>
  <div class="timeline-mist" data-timeline-mist aria-hidden="true"></div>
</div>

<style>
  .timeline-root {
    --timeline-mist-height: 96px;
  }

  .timeline {
    position: relative;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* 年の境界だけを断層線として引く。時系列の連続を示す縦レールは持たない */
  .tl-year {
    display: flex;
    align-items: center;
    gap: 14px;
    margin: 72px 0 0;
    color: var(--color-primary);
    font-family: var(--font-machine);
    font-size: var(--text-sm);
    letter-spacing: 0.1em;
  }

  /* 絞り込みで前の年が消えたときも、先頭に立つ年は上の余白を持たない */
  .tl-year:first-child,
  .tl-year.is-first-visible {
    margin-top: 0;
  }

  .tl-year {
    scroll-margin-top: 24px;
  }

  .tl-year::after {
    content: "";
    order: 1;
    flex: 1;
    height: 1px;
    background: var(--color-primary);
    opacity: 0.32;
  }

  /* 断層線の右端に、その年の続きへの導線を置く */
  .tl-year-more {
    order: 2;
    color: var(--color-interaction-text);
    font-family: var(--font-machine);
    font-size: 11px;
    letter-spacing: 0;
    text-decoration: none;
    white-space: nowrap;
  }

  .tl-year-more:hover,
  .tl-year-more:focus-visible {
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .tl-date-group {
    margin: 32px 0 4px;
    color: var(--color-primary);
    font-size: var(--text-sm);
    font-weight: 700;
  }

  .tl-year + .tl-date-group,
  .tl-date-group:first-child {
    margin-top: 20px;
  }

  .tl-entry {
    position: relative;
  }

  /* 状態記号。縦レールを廃したので、メタ行の先頭に文字と並べて置く */
  .tl-node {
    flex: none;
    width: 8px;
    height: 8px;
    background: var(--color-background);
    border: 2px solid var(--color-primary);
  }

  /* WIP は「まだ固まっていない」= 破線 の語彙で揃える。
     記号（ノード）・言葉（WIPバッジの下線）・線（行の罫）の3層すべてを破線にする。
     明度は落とさない（探すページの過半数がWIPのため、落とすとページ全体が沈む） */
  .tl-entry.is-wip .tl-node {
    border-style: dashed;
  }

  .tl-entry.is-wip .tl-row {
    border-bottom-style: dashed;
  }

  .tl-row {
    border-bottom: 1px solid var(--color-border);
  }

  .tl-body {
    position: relative;
    display: block;
    min-width: 0;
    /* 記録どうしが詰まって見えないよう、罫の上下に余白を取る */
    padding: 22px 4px 24px 0;
    color: inherit;
    text-decoration: none;
  }

  .tl-body::after {
    content: "";
    position: absolute;
    right: 0;
    bottom: -1px;
    left: 0;
    height: 2px;
    background: var(--color-secondary);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--duration-feedback) var(--ease-trace);
  }

  .tl-body:hover::after,
  .tl-body:focus-visible::after {
    transform: scaleX(1);
  }

  .tl-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    min-height: 18px;
  }

  /* 型は行の右端へ送り、新規 / 改訂 / WIP と読み分けられるようにする */
  .tl-meta :global(.record-type) {
    margin-inline-start: auto;
  }

  .tl-activity,
  .tl-wip,
  .tl-verification {
    font-size: 11px;
    line-height: 1.4;
    color: var(--color-text-sub);
  }

  .tl-activity {
    font-weight: 700;
    color: var(--color-primary);
  }

  .tl-wip {
    color: var(--color-primary);
    font-family: var(--font-machine);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.04em;
    border-bottom: 1px dashed currentColor;
  }

  .tl-activity.is-revision,
  .tl-verification {
    background: linear-gradient(transparent 52%, var(--color-accent) 52%);
  }

  .tl-title {
    display: block;
    margin-top: 7px;
    color: var(--color-text);
    font-size: clamp(1rem, 2vw, 1.125rem);
    font-weight: 500;
    line-height: 1.55;
    opacity: 1;
    transition: opacity var(--duration-page) ease-out;
    line-break: strict;
    text-wrap: pretty;
    word-break: auto-phrase;
  }

  .tl-entry.is-awaiting-reveal .tl-title {
    opacity: 0.7;
  }

  .tl-tags {
    display: block;
    margin-top: 5px;
    color: var(--color-text-muted);
    font-family: var(--font-machine);
    font-size: 11px;
  }

  .tl-context {
    display: none;
  }

  .tl-entry[hidden],
  .tl-date-group[hidden],
  .tl-year[hidden] {
    display: none;
  }

  /*
   * 年の道しるべ。年をまたいだときに出し、送りが止まったら引く。
   * 枠や線は持たず、紙をぼかした面の上に文字だけを置く。
   *
   * 面は白へ固定せず紙の色で持つ。2枚目の紙でも面と紙の関係が保たれる。
   * 縁はmaskで散らし、矩形の輪郭を残さない。時間軸の裾にかかるmistと同じ扱いで、
   * 面ではなく霧として置く。maskもblurも効かない環境では矩形になるが読める
   */
  .tl-year-cue {
    position: fixed;
    top: 64px;
    /* 横位置は時間軸の中央。JS が測れないうちは画面中央へ置く */
    left: var(--cue-left, 50%);
    z-index: 25;
    margin: 0;
    /* 霧が文字の外側まで広がるよう、左右は文字の倍ほど取る */
    padding: 8px 32px 9px;
    color: var(--color-primary);
    font-family: var(--font-machine);
    font-size: var(--text-sm);
    letter-spacing: 0.1em;
    line-height: 1.4;
    background: color-mix(in srgb, var(--color-background) 68%, transparent);
    -webkit-backdrop-filter: blur(22px);
    backdrop-filter: blur(22px);
    -webkit-mask-image: radial-gradient(
      ellipse closest-side,
      #000 46%,
      transparent 100%
    );
    mask-image: radial-gradient(
      ellipse closest-side,
      #000 46%,
      transparent 100%
    );
    pointer-events: none;
    opacity: 0;
    transform: translate(-50%, -6px);
    transition:
      opacity var(--duration-feedback) ease-out,
      transform var(--duration-feedback) var(--ease-trace),
      visibility var(--duration-feedback);
    visibility: hidden;
  }

  .tl-year-cue.is-visible {
    opacity: 1;
    transform: translate(-50%, 0);
    visibility: visible;
  }

  /* 狭い画面は上端をモバイルバー（52px）が占めるので、その下へ出す */
  @media (min-width: 960px) {
    .tl-year-cue {
      top: 24px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tl-year-cue {
      transition: none;
    }
  }

  .timeline-mist-space {
    display: none;
    height: var(--timeline-mist-height);
  }

  .timeline-root.has-mist .timeline-mist-space {
    display: block;
  }

  .timeline-mist {
    position: fixed;
    z-index: 20;
    right: 0;
    bottom: 0;
    left: 0;
    height: var(--timeline-mist-height);
    pointer-events: none;
    background: linear-gradient(
      to bottom,
      transparent 0%,
      color-mix(in srgb, var(--color-background) 8%, transparent) 28%,
      color-mix(in srgb, var(--color-background) 58%, transparent) 72%,
      color-mix(in srgb, var(--color-background) 96%, transparent) 100%
    );
    opacity: 0;
    transition: opacity var(--duration-feedback) ease-out;
  }

  .timeline-mist.is-visible {
    opacity: 1;
  }

  @media (min-width: 1400px) {
    .tl-context {
      position: absolute;
      top: 10px;
      left: calc(100% + 52px);
      display: block;
      width: 220px;
      padding-left: 16px;
      color: var(--color-text-muted);
      font-size: 12px;
      line-height: 1.7;
      border-left: 1px solid var(--color-secondary);
      opacity: 0;
      transform: translateX(-8px);
      pointer-events: none;
      transition:
        opacity var(--duration-feedback) ease,
        transform var(--duration-feedback) var(--ease-trace);
    }

    .tl-context p {
      margin: 0;
    }

    .tl-entry:hover .tl-context,
    .tl-entry:focus-within .tl-context {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @media (min-width: 760px) {
    .timeline-root {
      --timeline-mist-height: 160px;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .tl-entry.is-search-revealed,
    .tl-date-group.is-search-revealed {
      animation: tl-search-reveal var(--duration-feedback) ease-out;
    }

    @keyframes tl-search-reveal {
      from {
        opacity: 0.35;
      }

      to {
        opacity: 1;
      }
    }
  }

  @media (forced-colors: active) {
    .timeline-mist,
    .timeline-mist-space {
      display: none;
    }
  }
</style>

<script>
  import {
    observePage,
    onPageCleanup,
    onPageEvent,
    onPageLoad,
  } from "~/scripts/pageLifecycle";

  /*
   * 年の道しるべ。断層線が画面外へ流れても、いま読んでいるのが何年の記録かを
   * 送っている間だけ示す。
   *
   * 出すきっかけは年が変わったこと、引くきっかけは送りが止まったこと。
   * 同じ年を読み続けている間は出したままにし、止まって読むときは邪魔しない。
   *
   * 読み込み時点の年は覚えない。Home は最初から最新年の中にいるので、覚えると
   * 次の年まで下りるまで一度も出なくなる。送り始めた時点で今の年を示す
   */
  const initYearCue = () => {
    const cue = document.querySelector<HTMLElement>("[data-year-cue]");
    if (!cue) return;

    const groups = Array.from(
      document.querySelectorAll<HTMLElement>("[data-year-group]"),
    );
    if (groups.length === 0) return;

    /*
     * 横位置は画面ではなく時間軸の中央に合わせる。Home は左に月のTraceが並ぶぶん
     * 時間軸が右へ寄るので、画面中央だと記録の列から外れる
     */
    const root = cue.closest<HTMLElement>("[data-timeline-root]");

    /*
     * 判定の境目は道しるべ自身が立つ高さ。断層線がそこを通り過ぎた年を示すので、
     * 断層線が見えている間は出ず、見えなくなった瞬間に入れ替わる
     */
    const cueTop = () => (window.innerWidth >= 960 ? 24 : 64);
    // 送りが止まったと見なすまでの待ち。指を離してからの惰性より少し長く取る
    const SETTLE_DELAY = 700;

    let shownYear = "";
    let settleTimer = 0;
    let updateQueued = false;
    onPageCleanup(() => window.clearTimeout(settleTimer));

    const currentYear = () => {
      const edge = cueTop();
      let year = "";
      groups.forEach((group) => {
        // 絞り込みで隠れている年は現在地にならない
        if (group.hidden) return;
        if (group.getBoundingClientRect().bottom <= edge) {
          year = group.id.replace("year-", "");
        }
      });
      return year;
    };

    const hide = () => {
      cue.classList.remove("is-visible");
    };

    const syncPosition = () => {
      if (!root) return;

      const rect = root.getBoundingClientRect();
      cue.style.setProperty("--cue-left", `${rect.left + rect.width / 2}px`);
    };

    const sync = () => {
      updateQueued = false;
      syncPosition();
      const year = currentYear();
      // 断層線そのものが見えている間は、道しるべを重ねない
      if (year === "") {
        shownYear = "";
        hide();
        return;
      }
      if (year !== shownYear) {
        shownYear = year;
        cue.textContent = year;
        cue.classList.add("is-visible");
      }

      // 出ている間は、送りが途切れるたびに引くまでの時間を計り直す
      if (cue.classList.contains("is-visible")) {
        window.clearTimeout(settleTimer);
        settleTimer = window.setTimeout(hide, SETTLE_DELAY);
      }
    };

    const queue = () => {
      if (updateQueued) return;
      updateQueued = true;
      requestAnimationFrame(sync);
    };

    onPageEvent(window, "scroll", queue, { passive: true });
    onPageEvent(window, "resize", queue);
  };

  onPageLoad(() => {
    initYearCue();

    const reducedMotion = matchMedia("(prefers-reduced-motion: reduce)");
    const entries = Array.from(
      document.querySelectorAll<HTMLElement>("[data-record-entry]"),
    );
    const timelineRoot = document.querySelector<HTMLElement>(
      "[data-timeline-root]",
    );
    const timelineMist = document.querySelector<HTMLElement>(
      "[data-timeline-mist]",
    );

    if (!reducedMotion.matches && "IntersectionObserver" in window) {
      if (timelineRoot && timelineMist) {
        timelineRoot.classList.add("has-mist");
        const mistObserver = observePage(
          new IntersectionObserver(
            ([timelineEntry]) => {
              timelineMist.classList.toggle(
                "is-visible",
                timelineEntry?.isIntersecting ?? false,
              );
            },
            { rootMargin: "-80% 0px 0px 0px" },
          ),
        );
        mistObserver.observe(timelineRoot);
      }

      const revealObserver = observePage(
        new IntersectionObserver(
          (observedEntries) => {
            observedEntries.forEach((observedEntry) => {
              if (!observedEntry.isIntersecting) return;
              observedEntry.target.classList.remove("is-awaiting-reveal");
              revealObserver.unobserve(observedEntry.target);
            });
          },
          { rootMargin: "0px 0px -8%", threshold: 0.05 },
        ),
      );

      entries.forEach((entry) => {
        if (entry.getBoundingClientRect().top <= window.innerHeight * 0.92)
          return;
        entry.classList.add("is-awaiting-reveal");
        revealObserver.observe(entry);
      });
    }
  });
</script>
