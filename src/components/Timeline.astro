---
export type TimelineEntry = {
  slug: string;
  title: string;
  isoDate: string;
  displayDate: string;
  year: string;
  month: string;
  categories: string[];
  tags: string[];
  activity: "新規" | "改訂";
  isWip: boolean;
  verificationLabel?: string;
  revisionCount: number;
};

type Props = {
  entries: TimelineEntry[];
  variant?: "stream" | "index";
  /* 年ごとに件数を絞っている場合の、その年の続きへの導線 */
  yearLinks?: Record<string, string>;
};

const { entries, variant = "stream", yearLinks } = Astro.props;

const countsByYear = entries.reduce<Record<string, number>>((counts, entry) => {
  counts[entry.year] = (counts[entry.year] ?? 0) + 1;
  return counts;
}, {});
---

<div class="timeline-root" data-timeline-root>
  <ol class:list={["timeline", { "is-index": variant === "index" }]}>
    {
      entries.map((entry, index) => {
        const previous = entries[index - 1];
        const showDate = index === 0 || previous.isoDate !== entry.isoDate;
        const showYear = index === 0 || previous.year !== entry.year;
        const showMonth =
          index === 0 ||
          previous.year !== entry.year ||
          previous.month !== entry.month;
        return (
          <Fragment>
            {showYear && (
              <li class="tl-year" id={`year-${entry.year}`} data-year-group>
                <span>{entry.year}</span>
                {variant === "index" && (
                  <span
                    class="tl-year-count"
                    data-year-count
                    data-total={String(countsByYear[entry.year])}
                  >
                    {countsByYear[entry.year]}件
                  </span>
                )}
                {yearLinks?.[entry.year] && (
                  <a class="tl-year-more" href={yearLinks[entry.year]}>
                    {entry.year}年をすべて見る →
                  </a>
                )}
              </li>
            )}
            {showDate && (
              <li
                class="tl-date-group"
                data-date-group
                id={
                  showMonth ? `month-${entry.year}-${entry.month}` : undefined
                }
              >
                <time datetime={entry.isoDate}>{entry.displayDate}</time>
              </li>
            )}
            <li
              class:list={["tl-entry", { "is-wip": entry.isWip }]}
              data-record-entry
              data-search-text={`${entry.title} ${entry.categories.join(" ")} ${entry.tags.join(" ")}`.toLocaleLowerCase(
                "ja",
              )}
              data-year={entry.year}
              data-month={entry.month}
            >
              <div class="tl-row">
                <a
                  href={`/blog/${entry.slug}`}
                  class="tl-body"
                  data-record-link
                  aria-describedby={`record-context-${index}`}
                >
                  <span class="tl-meta">
                    <span class="tl-node" aria-hidden="true" />
                    <span
                      class:list={[
                        "tl-activity",
                        { "is-revision": entry.activity === "改訂" },
                      ]}
                    >
                      {entry.activity}
                    </span>
                    {entry.isWip && <span class="tl-wip">WIP</span>}
                    {entry.verificationLabel && (
                      <span class="tl-verification">
                        {entry.verificationLabel}
                      </span>
                    )}
                  </span>
                  <span class="tl-title">{entry.title}</span>
                  {entry.categories.length > 0 && (
                    <span class="tl-tags">{entry.categories.join("・")}</span>
                  )}
                </a>
              </div>
              <aside class="tl-context" id={`record-context-${index}`}>
                <p>{entry.displayDate}の記録</p>
                {entry.categories.length > 0 && (
                  <p>分野: {entry.categories.join("・")}</p>
                )}
                {entry.tags.length > 0 && <p>タグ: {entry.tags.join("・")}</p>}
                {entry.verificationLabel && (
                  <p>状態: {entry.verificationLabel}</p>
                )}
                {entry.revisionCount > 0 && (
                  <p>改訂: {entry.revisionCount}回</p>
                )}
              </aside>
            </li>
          </Fragment>
        );
      })
    }
  </ol>
  {
    variant === "index" && (
      <div class="timeline-mist-space" aria-hidden="true" />
    )
  }
  <div class="timeline-mist" data-timeline-mist aria-hidden="true"></div>
</div>

<style>
  .timeline-root {
    --timeline-mist-height: 96px;
  }

  .timeline {
    position: relative;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* 年の境界だけを断層線として引く。時系列の連続を示す縦レールは持たない */
  .tl-year {
    display: flex;
    align-items: center;
    gap: 14px;
    margin: 72px 0 0;
    color: var(--color-primary);
    font-family: var(--font-machine);
    font-size: var(--text-sm);
    letter-spacing: 0.1em;
  }

  /* 絞り込みで前の年が消えたときも、先頭に立つ年は上の余白を持たない */
  .tl-year:first-child,
  .tl-year.is-first-visible {
    margin-top: 0;
  }

  .tl-year {
    scroll-margin-top: 24px;
  }

  .tl-year::after {
    content: "";
    order: 1;
    flex: 1;
    height: 1px;
    background: var(--color-primary);
    opacity: 0.32;
  }

  /* 断層線の右端に、その年の件数を置く */
  .tl-year-count {
    order: 2;
    color: var(--color-text-muted);
    font-size: 11px;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0;
  }

  /* 断層線の右端に、その年の続きへの導線を置く */
  .tl-year-more {
    order: 2;
    color: var(--color-interaction-text);
    font-family: var(--font-machine);
    font-size: 11px;
    letter-spacing: 0;
    text-decoration: none;
    white-space: nowrap;
  }

  .tl-year-more:hover,
  .tl-year-more:focus-visible {
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .tl-date-group {
    margin: 32px 0 4px;
    color: var(--color-primary);
    font-size: var(--text-sm);
    font-weight: 700;
  }

  .tl-year + .tl-date-group,
  .tl-date-group:first-child {
    margin-top: 20px;
  }

  .tl-entry {
    position: relative;
  }

  /* 状態記号。縦レールを廃したので、メタ行の先頭に文字と並べて置く */
  .tl-node {
    flex: none;
    width: 8px;
    height: 8px;
    background: var(--color-background);
    border: 2px solid var(--color-primary);
  }

  /* WIP は「まだ固まっていない」= 破線 の語彙で揃える。
     記号（ノード）・言葉（WIPバッジの下線）・線（行の罫）の3層すべてを破線にする。
     明度は落とさない（索引の過半数がWIPのため、落とすとページ全体が沈む） */
  .tl-entry.is-wip .tl-node {
    border-style: dashed;
  }

  .tl-entry.is-wip .tl-row {
    border-bottom-style: dashed;
  }

  .tl-row {
    border-bottom: 1px solid var(--color-border);
  }

  .tl-body {
    position: relative;
    display: block;
    min-width: 0;
    /* 記録どうしが詰まって見えないよう、罫の上下に余白を取る */
    padding: 22px 4px 24px 0;
    color: inherit;
    text-decoration: none;
  }

  .tl-body::after {
    content: "";
    position: absolute;
    right: 0;
    bottom: -1px;
    left: 0;
    height: 2px;
    background: var(--color-secondary);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--duration-feedback) var(--ease-trace);
  }

  .tl-body:hover::after,
  .tl-body:focus-visible::after {
    transform: scaleX(1);
  }

  .tl-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    min-height: 18px;
  }

  .tl-activity,
  .tl-wip,
  .tl-verification {
    font-size: 11px;
    line-height: 1.4;
    color: var(--color-text-sub);
  }

  .tl-activity {
    font-weight: 700;
    color: var(--color-primary);
  }

  .tl-wip {
    color: var(--color-primary);
    font-family: var(--font-machine);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.04em;
    border-bottom: 1px dashed currentColor;
  }

  .tl-activity.is-revision,
  .tl-verification {
    background: linear-gradient(transparent 52%, var(--color-accent) 52%);
  }

  .tl-title {
    display: block;
    margin-top: 7px;
    color: var(--color-text);
    font-size: clamp(1rem, 2vw, 1.125rem);
    font-weight: 500;
    line-height: 1.55;
    opacity: 1;
    transition: opacity var(--duration-page) ease-out;
    word-break: auto-phrase;
  }

  .tl-entry.is-awaiting-reveal .tl-title {
    opacity: 0.7;
  }

  .tl-tags {
    display: block;
    margin-top: 5px;
    color: var(--color-text-muted);
    font-family: var(--font-machine);
    font-size: 11px;
  }

  .tl-context {
    display: none;
  }

  .tl-entry[hidden],
  .tl-date-group[hidden],
  .tl-year[hidden] {
    display: none;
  }

  .timeline-mist-space {
    display: none;
    height: var(--timeline-mist-height);
  }

  .timeline-root.has-mist .timeline-mist-space {
    display: block;
  }

  .timeline-mist {
    position: fixed;
    z-index: 20;
    right: 0;
    bottom: 0;
    left: 0;
    height: var(--timeline-mist-height);
    pointer-events: none;
    background: linear-gradient(
      to bottom,
      transparent 0%,
      color-mix(in srgb, var(--color-background) 8%, transparent) 28%,
      color-mix(in srgb, var(--color-background) 58%, transparent) 72%,
      color-mix(in srgb, var(--color-background) 96%, transparent) 100%
    );
    opacity: 0;
    transition: opacity var(--duration-feedback) ease-out;
  }

  .timeline-mist.is-visible {
    opacity: 1;
  }

  @media (min-width: 1400px) {
    .tl-context {
      position: absolute;
      top: 10px;
      left: calc(100% + 52px);
      display: block;
      width: 220px;
      padding-left: 16px;
      color: var(--color-text-muted);
      font-size: 12px;
      line-height: 1.7;
      border-left: 1px solid var(--color-secondary);
      opacity: 0;
      transform: translateX(-8px);
      pointer-events: none;
      transition:
        opacity var(--duration-feedback) ease,
        transform var(--duration-feedback) var(--ease-trace);
    }

    .tl-context p {
      margin: 0;
    }

    .tl-entry:hover .tl-context,
    .tl-entry:focus-within .tl-context {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @media (min-width: 760px) {
    .timeline-root {
      --timeline-mist-height: 160px;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .tl-entry.is-search-revealed,
    .tl-date-group.is-search-revealed {
      animation: tl-search-reveal var(--duration-feedback) ease-out;
    }

    @keyframes tl-search-reveal {
      from {
        opacity: 0.35;
      }

      to {
        opacity: 1;
      }
    }
  }

  @media (forced-colors: active) {
    .timeline-mist,
    .timeline-mist-space {
      display: none;
    }
  }
</style>

<script>
  const reducedMotion = matchMedia("(prefers-reduced-motion: reduce)");
  const entries = Array.from(
    document.querySelectorAll<HTMLElement>("[data-record-entry]"),
  );
  const timelineRoot = document.querySelector<HTMLElement>(
    "[data-timeline-root]",
  );
  const timelineMist = document.querySelector<HTMLElement>(
    "[data-timeline-mist]",
  );

  if (!reducedMotion.matches && "IntersectionObserver" in window) {
    if (timelineRoot && timelineMist) {
      timelineRoot.classList.add("has-mist");
      const mistObserver = new IntersectionObserver(
        ([timelineEntry]) => {
          timelineMist.classList.toggle(
            "is-visible",
            timelineEntry?.isIntersecting ?? false,
          );
        },
        { rootMargin: "-80% 0px 0px 0px" },
      );
      mistObserver.observe(timelineRoot);
    }

    const revealObserver = new IntersectionObserver(
      (observedEntries) => {
        observedEntries.forEach((observedEntry) => {
          if (!observedEntry.isIntersecting) return;
          observedEntry.target.classList.remove("is-awaiting-reveal");
          revealObserver.unobserve(observedEntry.target);
        });
      },
      { rootMargin: "0px 0px -8%", threshold: 0.05 },
    );

    entries.forEach((entry) => {
      if (entry.getBoundingClientRect().top <= window.innerHeight * 0.92)
        return;
      entry.classList.add("is-awaiting-reveal");
      revealObserver.observe(entry);
    });
  }
</script>
