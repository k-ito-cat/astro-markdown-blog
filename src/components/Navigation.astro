---
import { Icon } from "astro-icon/components";
import CopyLinkButton from "~/components/CopyLinkButton.astro";
import { HEADING_LEVEL } from "~/constants/headingLevel";

type Heading = { depth: number; slug: string; text: string };
type Section = Heading & { sectionIndex: number; subheadings: Heading[] };
type Props = {
  headings: Heading[];
  returnHref?: string;
  returnLabel?: string;
  returnSourcePaths?: string[];
  copyPath: string;
  previewHref?: string;
};

const {
  headings,
  returnHref = "/blog",
  returnLabel = "一覧へ戻る",
  returnSourcePaths = ["/", "/blog"],
  copyPath,
  previewHref,
} = Astro.props;
const returnPaths = JSON.stringify(returnSourcePaths);
const outlineHeadings = headings.filter(
  (heading) =>
    heading.depth === HEADING_LEVEL.TWO ||
    heading.depth === HEADING_LEVEL.THREE,
);
const sections: Section[] = [];

outlineHeadings.forEach((heading) => {
  if (heading.depth === HEADING_LEVEL.TWO) {
    sections.push({
      ...heading,
      sectionIndex: sections.length,
      subheadings: [],
    });
    return;
  }

  sections.at(-1)?.subheadings.push(heading);
});

const firstSection = sections[0];
---

{
  firstSection && (
    <aside class="current-trace" aria-label="記事の構成と現在位置">
      <div class="trace-current">
        <div class="trace-status">
          <span>現在位置</span>
          <span data-section-position>{`1 / ${sections.length}`}</span>
        </div>
        <p class="current-heading" data-current-heading>
          {firstSection.text}
        </p>
      </div>

      <ol class="trace-outline">
        {sections.map((section) => {
          const panelId = `trace-subheadings-${section.sectionIndex}`;
          const hasSubheadings = section.subheadings.length > 0;

          return (
            <li
              class:list={[
                "trace-section",
                { "is-current": section.sectionIndex === 0 },
              ]}
              data-trace-item
              data-heading-id={section.slug}
              data-section-index={section.sectionIndex}
            >
              <div class="trace-section-row">
                <a
                  href={`#${section.slug}`}
                  data-trace-link
                  aria-current={
                    section.sectionIndex === 0 ? "location" : undefined
                  }
                >
                  {section.text}
                </a>
              </div>

              {hasSubheadings && (
                <div class="trace-sub-wrap">
                  <div class="trace-sub-clip">
                    <ol id={panelId} class="trace-subheadings">
                      {section.subheadings.map((subheading) => (
                        <li>
                          <a href={`#${subheading.slug}`}>{subheading.text}</a>
                        </li>
                      ))}
                    </ol>
                  </div>
                </div>
              )}
            </li>
          );
        })}
      </ol>

      <div class="trace-actions">
        <a
          href={returnHref}
          data-reading-return
          data-return-paths={returnPaths}
        >
          <Icon name="octicon:arrow-left-16" aria-hidden="true" />
          <span>{returnLabel}</span>
        </a>
        <a href="#">
          <Icon name="octicon:arrow-up-16" aria-hidden="true" />
          <span>ページの上部へ戻る</span>
        </a>
        <CopyLinkButton path={copyPath} label="記事のリンクをコピー" />
        {previewHref && (
          <a href={previewHref}>
            <Icon name="octicon:eye-16" aria-hidden="true" />
            <span>プレビュー</span>
          </a>
        )}
      </div>
    </aside>
  )
}

<style>
  .current-trace {
    display: none;
  }

  @media (min-width: 1024px) {
    .current-trace {
      position: sticky;
      top: 32px;
      display: grid;
      grid-template-rows: auto minmax(0, 1fr) auto;
      align-self: start;
      max-height: calc(100vh - 64px);
    }

    .trace-current {
      min-width: 0;
      border-bottom: 1px solid var(--color-border);
    }

    .trace-status {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 12px;
      color: var(--color-text-muted);
      font-size: 12px;
      font-variant-numeric: tabular-nums;
    }

    .current-heading {
      display: -webkit-box;
      margin: 5px 0 16px;
      overflow: hidden;
      color: var(--color-primary);
      font-size: var(--text-md);
      font-weight: 700;
      line-height: 1.55;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 2;
    }

    .trace-outline {
      position: relative;
      min-height: 0;
      /* 罫線の上下を 16px で揃える（項目自身の padding 4px と合わせて 12px + 4px） */
      margin: 12px 0 0;
      padding: 0 4px;
      overflow-y: auto;
      overscroll-behavior: contain;
      scrollbar-width: thin;
      list-style: none;
    }

    .trace-section {
      position: relative;
      min-width: 0;
      padding: 4px 0;
    }

    .trace-section-row {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      align-items: start;
      gap: 3px;
      min-height: 27px;
    }

    .trace-section a {
      min-width: 0;
      color: var(--color-text-muted);
      font-size: var(--text-sm);
      line-height: 1.45;
      text-decoration: none;
      text-wrap: pretty;
      transition: color var(--duration-feedback) ease;
    }

    .trace-section.is-past > .trace-section-row > a {
      color: var(--color-text-sub);
    }

    .trace-section.is-current > .trace-section-row > a {
      color: var(--color-primary);
      font-weight: 700;
    }

    .trace-section a:hover,
    .trace-section a:focus-visible {
      color: var(--color-interaction-text);
      text-decoration: underline;
      text-underline-offset: 3px;
    }

    /* 小見出しは現在地の章だけ開く。0fr→1fr で高さを、opacity で濃さを送る */
    .trace-sub-wrap {
      display: grid;
      grid-template-rows: 0fr;
      visibility: hidden;
      opacity: 0;
      transition:
        grid-template-rows var(--duration-state) var(--ease-trace),
        opacity var(--duration-state) ease,
        visibility 0s linear var(--duration-state);
    }

    .trace-section.is-current .trace-sub-wrap {
      grid-template-rows: 1fr;
      visibility: visible;
      opacity: 1;
      transition:
        grid-template-rows var(--duration-state) var(--ease-trace),
        opacity var(--duration-state) ease,
        visibility 0s;
    }

    .trace-sub-clip {
      min-height: 0;
      overflow: hidden;
    }

    .trace-subheadings {
      display: grid;
      gap: 6px;
      /* 畳んだときに余白が残らないよう、間隔は内側の padding で持つ */
      margin: 0;
      padding: 8px 0 10px 11px;
      list-style: none;
    }

    .trace-subheadings a {
      display: block;
      font-size: 13px;
      line-height: 1.7;
    }

    .trace-actions {
      display: grid;
      gap: 8px;
      padding-top: 16px;
      border-top: 1px solid var(--color-border);
    }

    .trace-actions > a,
    .trace-actions :global(.copy-link) {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      justify-self: start;
      padding: 0;
      color: var(--color-text-sub);
      font-size: 13px;
      text-decoration: none;
    }

    .trace-actions > a:hover,
    .trace-actions > a:focus-visible,
    .trace-actions :global(.copy-link):hover,
    .trace-actions :global(.copy-link):focus-visible {
      color: var(--color-interaction-text);
      text-decoration: underline;
      text-underline-offset: 3px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .trace-section a,
    .trace-sub-wrap {
      transition: none;
    }
  }

  @media print {
    .current-trace {
      display: none;
    }
  }
</style>

<script>
  const output = document.querySelector<HTMLElement>("[data-current-heading]");
  const position = document.querySelector<HTMLElement>(
    "[data-section-position]",
  );
  const sections = Array.from(
    document.querySelectorAll<HTMLElement>(".prose h2[id]"),
  );
  const traceItems = Array.from(
    document.querySelectorAll<HTMLElement>("[data-trace-item]"),
  );
  // 狭幅の目次（Article の .article-structure）にも同じ現在地を配る。
  // 判定を二重に持つと読み取り線がずれるため、ここに相乗りさせる
  const structureItems = Array.from(
    document.querySelectorAll<HTMLElement>("[data-structure-item]"),
  );

  const syncCurrentMarks = (items: HTMLElement[], currentIndex: number) => {
    items.forEach((item) => {
      const itemIndex = Number(item.dataset.sectionIndex);
      const link = item.querySelector("a");

      item.classList.toggle("is-past", itemIndex < currentIndex);
      item.classList.toggle("is-current", itemIndex === currentIndex);

      if (!link) return;

      if (itemIndex === currentIndex) {
        link.setAttribute("aria-current", "location");
      } else {
        link.removeAttribute("aria-current");
      }
    });
  };

  const setCurrentSection = (sectionId: string) => {
    const currentItem = traceItems.find(
      (item) => item.dataset.headingId === sectionId,
    );
    if (!currentItem) return;

    const currentIndex = Number(currentItem.dataset.sectionIndex);
    output && (output.textContent = sections[currentIndex]?.textContent ?? "");
    position &&
      (position.textContent = `${currentIndex + 1} / ${traceItems.length}`);

    syncCurrentMarks(traceItems, currentIndex);
    syncCurrentMarks(structureItems, currentIndex);
  };

  if (output && sections.length > 0) {
    const hashId = decodeURIComponent(window.location.hash.slice(1));
    const hashItem = traceItems.find(
      (item) => item.dataset.headingId === hashId,
    );
    const initialIndex = Number(hashItem?.dataset.sectionIndex ?? 0);
    setCurrentSection(sections[initialIndex]?.id ?? sections[0].id);

    let updateQueued = false;
    const updateFromScrollPosition = () => {
      const readingLine = window.innerHeight * 0.22;
      const current = sections.reduce(
        (latest, heading) =>
          heading.getBoundingClientRect().top <= readingLine ? heading : latest,
        sections[0],
      );
      setCurrentSection(current.id);
      updateQueued = false;
    };

    const queueUpdate = () => {
      if (updateQueued) return;
      updateQueued = true;
      requestAnimationFrame(updateFromScrollPosition);
    };

    window.addEventListener("scroll", queueUpdate, { passive: true });
    window.addEventListener("hashchange", queueUpdate);
    updateFromScrollPosition();
  }

  document
    .querySelectorAll<HTMLAnchorElement>("[data-reading-return]")
    .forEach((link) => {
      const sourcePaths = JSON.parse(
        link.dataset.returnPaths ?? "[]",
      ) as string[];
      if (!document.referrer || sourcePaths.length === 0) return;

      const referrer = new URL(document.referrer);
      const canReturnToSource =
        referrer.origin === window.location.origin &&
        sourcePaths.includes(referrer.pathname);
      if (!canReturnToSource || window.history.length <= 1) return;

      link.addEventListener("click", (event) => {
        if (
          event.button !== 0 ||
          event.metaKey ||
          event.ctrlKey ||
          event.shiftKey ||
          event.altKey
        )
          return;

        event.preventDefault();
        window.history.back();
      });
    });
</script>
