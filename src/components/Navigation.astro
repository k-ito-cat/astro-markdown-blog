---
import { HEADING_LEVEL } from "~/constants/headingLevel";

type Props = {
  headings: {
    depth: number;
    slug: string;
    text: string;
  }[];
};

const { headings } = Astro.props;

const tocHeadings = headings.filter(
  (heading) =>
    heading.depth === HEADING_LEVEL.TWO ||
    heading.depth === HEADING_LEVEL.THREE,
);
---

{
  tocHeadings.length > 0 && (
    <aside class="toc-rail lg:order-2">
      <div class="toc-sticky">
        <p class="toc-label">目次</p>
        <ul class="toc-list">
          {tocHeadings.map((heading) => (
            <li>
              <a
                href={`#${heading.slug}`}
                class:list={[
                  "toc-link",
                  { "is-h3": heading.depth === HEADING_LEVEL.THREE },
                ]}
              >
                {heading.text}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </aside>
  )
}

<style>
  .toc-rail {
    display: none;
  }

  @media (min-width: 1024px) {
    .toc-rail {
      display: block;
    }
  }

  .toc-sticky {
    position: sticky;
    top: 24px;
  }

  .toc-label {
    margin: 0 0 8px;
    font-size: 12px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-muted);
  }

  .toc-list {
    display: grid;
    gap: 8px;
    margin: 0;
    padding: 0 0 0 12px;
    list-style: none;
    border-left: 1px solid var(--border);
  }

  .toc-link {
    display: block;
    font-size: 13px;
    line-height: 1.6;
    color: var(--text-secondary);
    text-decoration: none;
    transition: color 140ms ease-out;
  }

  .toc-link:hover {
    color: var(--text-primary);
    text-decoration: none;
  }

  .toc-link.is-h3 {
    padding-left: 12px;
  }
</style>
