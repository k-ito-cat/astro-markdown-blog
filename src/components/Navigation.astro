---
import { Icon } from "astro-icon/components";
import { HEADING_LEVEL } from "~/constants/headingLevel";

type Heading = { depth: number; slug: string; text: string };
type Section = Heading & { sectionIndex: number; subheadings: Heading[] };
type Props = {
  headings: Heading[];
  returnHref?: string;
  returnLabel?: string;
  returnSourcePaths?: string[];
};

const {
  headings,
  returnHref = "/blog",
  returnLabel = "一覧へ戻る",
  returnSourcePaths = ["/", "/blog"],
} = Astro.props;
const returnPaths = JSON.stringify(returnSourcePaths);
const outlineHeadings = headings.filter(
  (heading) =>
    heading.depth === HEADING_LEVEL.TWO ||
    heading.depth === HEADING_LEVEL.THREE,
);
const sections: Section[] = [];

outlineHeadings.forEach((heading) => {
  if (heading.depth === HEADING_LEVEL.TWO) {
    sections.push({
      ...heading,
      sectionIndex: sections.length,
      subheadings: [],
    });
    return;
  }

  sections.at(-1)?.subheadings.push(heading);
});

const firstSection = sections[0];
---

<a
  href={returnHref}
  class="mobile-reading-return"
  data-reading-return
  data-return-paths={returnPaths}
>
  <Icon name="octicon:arrow-left-16" aria-hidden="true" />
  <span>{returnLabel}</span>
  <span class="return-trace" aria-hidden="true"></span>
</a>

{
  firstSection && (
    <aside class="current-trace" aria-label="記事の構成と現在位置">
      <a
        href={returnHref}
        class="trace-return"
        data-reading-return
        data-return-paths={returnPaths}
      >
        <Icon name="octicon:arrow-left-16" aria-hidden="true" />
        <span>{returnLabel}</span>
      </a>

      <div class="trace-current">
        <div class="trace-status">
          <span>現在位置</span>
          <span data-section-position>{`1 / ${sections.length}`}</span>
        </div>
        <p class="current-heading" data-current-heading>
          {firstSection.text}
        </p>
      </div>

      <ol class="trace-outline">
        {sections.map((section) => {
          const panelId = `trace-subheadings-${section.sectionIndex}`;
          const hasSubheadings = section.subheadings.length > 0;

          return (
            <li
              class:list={[
                "trace-section",
                { "is-current": section.sectionIndex === 0 },
              ]}
              data-trace-item
              data-heading-id={section.slug}
              data-section-index={section.sectionIndex}
            >
              <div class="trace-section-row">
                <a
                  href={`#${section.slug}`}
                  data-trace-link
                  aria-current={
                    section.sectionIndex === 0 ? "location" : undefined
                  }
                >
                  {section.text}
                </a>
              </div>

              {hasSubheadings && (
                <div class="trace-sub-wrap">
                  <ol id={panelId} class="trace-subheadings">
                    {section.subheadings.map((subheading) => (
                      <li>
                        <a href={`#${subheading.slug}`}>{subheading.text}</a>
                      </li>
                    ))}
                  </ol>
                </div>
              )}
            </li>
          );
        })}
      </ol>
    </aside>
  )
}

<style>
  .mobile-reading-return {
    --return-resting-width: 44px;
    position: fixed;
    z-index: 25;
    bottom: max(14px, env(safe-area-inset-bottom));
    left: 0;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    min-height: 44px;
    padding: 3px 12px 0 14px;
    color: var(--color-primary);
    font-size: var(--text-sm);
    font-weight: 600;
    text-decoration: none;
    opacity: 0.72;
    background: color-mix(in srgb, var(--color-background) 88%, transparent);
    transition:
      opacity var(--duration-feedback) ease,
      transform var(--duration-feedback) var(--ease-trace);
  }

  .return-trace {
    width: 20px;
    height: 2px;
    flex: 0 0 auto;
    background: currentColor;
  }

  .mobile-reading-return[data-return-state="hidden"] {
    pointer-events: none;
    opacity: 0;
    transform: translateX(calc(-100% - 8px));
  }

  .mobile-reading-return[data-return-state="tucked"] {
    opacity: 0.42;
    transform: translateX(calc(-100% + var(--return-resting-width)));
  }

  .mobile-reading-return[data-return-state="revealed"] {
    opacity: 0.72;
  }

  .mobile-reading-return:hover,
  .mobile-reading-return:focus-visible {
    color: var(--color-interaction-text);
    opacity: 1;
    transform: none;
  }

  .current-trace {
    display: none;
  }

  @media (min-width: 1024px) {
    .mobile-reading-return {
      display: none;
    }

    .current-trace {
      position: sticky;
      top: 32px;
      display: grid;
      grid-template-rows: auto auto minmax(0, 1fr);
      align-self: start;
      max-height: calc(100vh - 64px);
    }

    .trace-return {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      justify-self: start;
      margin-bottom: 20px;
      color: var(--color-text-sub);
      font-size: 13px;
      text-decoration: none;
    }

    .trace-return:hover,
    .trace-return:focus-visible {
      color: var(--color-interaction-text);
      text-decoration: underline;
      text-underline-offset: 3px;
    }

    .trace-current {
      min-width: 0;
      border-bottom: 1px solid var(--color-border);
    }

    .trace-status {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 12px;
      color: var(--color-text-muted);
      font-size: 12px;
      font-variant-numeric: tabular-nums;
    }

    .current-heading {
      display: -webkit-box;
      margin: 5px 0 16px;
      overflow: hidden;
      color: var(--color-primary);
      font-size: var(--text-md);
      font-weight: 700;
      line-height: 1.55;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 2;
    }

    .trace-outline {
      position: relative;
      min-height: 0;
      /* 罫線の上下を 16px で揃える（項目自身の padding 4px と合わせて 12px + 4px） */
      margin: 12px 0 0;
      padding: 0 4px;
      overflow-y: auto;
      overscroll-behavior: contain;
      scrollbar-width: thin;
      list-style: none;
    }

    .trace-section {
      position: relative;
      min-width: 0;
      padding: 4px 0;
    }

    .trace-section-row {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      align-items: start;
      gap: 3px;
      min-height: 27px;
    }

    .trace-section a {
      min-width: 0;
      color: var(--color-text-muted);
      font-size: var(--text-sm);
      line-height: 1.45;
      text-decoration: none;
      text-wrap: pretty;
      transition: color var(--duration-feedback) ease;
    }

    .trace-section.is-past > .trace-section-row > a {
      color: var(--color-text-sub);
    }

    .trace-section.is-current > .trace-section-row > a {
      color: var(--color-primary);
      font-weight: 700;
    }

    .trace-section a:hover,
    .trace-section a:focus-visible {
      color: var(--color-interaction-text);
      text-decoration: underline;
      text-underline-offset: 3px;
    }

    /* 小見出しは現在地の章だけ開く。0fr→1fr で高さを、opacity で濃さを送る */
    .trace-sub-wrap {
      display: grid;
      grid-template-rows: 0fr;
      visibility: hidden;
      opacity: 0;
      transition:
        grid-template-rows var(--duration-state) var(--ease-trace),
        opacity var(--duration-state) ease,
        visibility 0s linear var(--duration-state);
    }

    .trace-section.is-current .trace-sub-wrap {
      grid-template-rows: 1fr;
      visibility: visible;
      opacity: 1;
      transition:
        grid-template-rows var(--duration-state) var(--ease-trace),
        opacity var(--duration-state) ease,
        visibility 0s;
    }

    .trace-subheadings {
      display: grid;
      gap: 6px;
      /* 畳んだときに余白が残らないよう、間隔は内側の padding で持つ */
      min-height: 0;
      margin: 0;
      padding: 8px 0 10px 11px;
      overflow: hidden;
      list-style: none;
    }

    .trace-subheadings a {
      display: block;
      font-size: 13px;
      line-height: 1.7;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mobile-reading-return,
    .trace-section a,
    .trace-sub-wrap {
      transition: none;
    }
  }

  @media print {
    .mobile-reading-return,
    .current-trace {
      display: none;
    }
  }
</style>

<script>
  const output = document.querySelector<HTMLElement>("[data-current-heading]");
  const position = document.querySelector<HTMLElement>(
    "[data-section-position]",
  );
  const sections = Array.from(
    document.querySelectorAll<HTMLElement>(".prose h2[id]"),
  );
  const traceItems = Array.from(
    document.querySelectorAll<HTMLElement>("[data-trace-item]"),
  );

  const setCurrentSection = (sectionId: string) => {
    const currentItem = traceItems.find(
      (item) => item.dataset.headingId === sectionId,
    );
    if (!currentItem) return;

    const currentIndex = Number(currentItem.dataset.sectionIndex);
    output && (output.textContent = sections[currentIndex]?.textContent ?? "");
    position &&
      (position.textContent = `${currentIndex + 1} / ${traceItems.length}`);

    traceItems.forEach((item) => {
      const itemIndex = Number(item.dataset.sectionIndex);
      const link = item.querySelector("[data-trace-link]");

      item.classList.toggle("is-past", itemIndex < currentIndex);
      item.classList.toggle("is-current", itemIndex === currentIndex);

      if (link) {
        if (itemIndex === currentIndex) {
          link.setAttribute("aria-current", "location");
        } else {
          link.removeAttribute("aria-current");
        }
      }
    });
  };

  if (output && sections.length > 0) {
    const hashId = decodeURIComponent(window.location.hash.slice(1));
    const hashItem = traceItems.find(
      (item) => item.dataset.headingId === hashId,
    );
    const initialIndex = Number(hashItem?.dataset.sectionIndex ?? 0);
    setCurrentSection(sections[initialIndex]?.id ?? sections[0].id);

    let updateQueued = false;
    const updateFromScrollPosition = () => {
      const readingLine = window.innerHeight * 0.22;
      const current = sections.reduce(
        (latest, heading) =>
          heading.getBoundingClientRect().top <= readingLine ? heading : latest,
        sections[0],
      );
      setCurrentSection(current.id);
      updateQueued = false;
    };

    const queueUpdate = () => {
      if (updateQueued) return;
      updateQueued = true;
      requestAnimationFrame(updateFromScrollPosition);
    };

    window.addEventListener("scroll", queueUpdate, { passive: true });
    window.addEventListener("hashchange", queueUpdate);
    updateFromScrollPosition();
  }

  document
    .querySelectorAll<HTMLAnchorElement>("[data-reading-return]")
    .forEach((link) => {
      const sourcePaths = JSON.parse(
        link.dataset.returnPaths ?? "[]",
      ) as string[];
      if (!document.referrer || sourcePaths.length === 0) return;

      const referrer = new URL(document.referrer);
      const canReturnToSource =
        referrer.origin === window.location.origin &&
        sourcePaths.includes(referrer.pathname);
      if (!canReturnToSource || window.history.length <= 1) return;

      link.addEventListener("click", (event) => {
        if (
          event.button !== 0 ||
          event.metaKey ||
          event.ctrlKey ||
          event.shiftKey ||
          event.altKey
        )
          return;

        event.preventDefault();
        window.history.back();
      });
    });

  const mobileReadingReturn = document.querySelector<HTMLAnchorElement>(
    ".mobile-reading-return",
  );
  const articleStartReturn = document.querySelector<HTMLAnchorElement>(
    "[data-reading-return]:not(.mobile-reading-return):not(.trace-return)",
  );

  if (mobileReadingReturn && articleStartReturn) {
    const revealScrollDistance = 40;
    const tuckScrollDistance = 24;
    let articleStartReturnVisible = true;
    let lastScrollY = window.scrollY;
    let scrollDirection = 0;
    let scrollDistance = 0;
    let returnUpdateQueued = false;

    const setReturnState = (state: "hidden" | "tucked" | "revealed") => {
      mobileReadingReturn.dataset.returnState = state;
      if (state === "hidden") {
        mobileReadingReturn.tabIndex = -1;
        mobileReadingReturn.setAttribute("aria-hidden", "true");
      } else {
        mobileReadingReturn.removeAttribute("tabindex");
        mobileReadingReturn.removeAttribute("aria-hidden");
      }
    };

    const startReturnRect = articleStartReturn.getBoundingClientRect();
    articleStartReturnVisible =
      startReturnRect.bottom > 0 && startReturnRect.top < window.innerHeight;
    setReturnState(articleStartReturnVisible ? "hidden" : "tucked");

    const startReturnObserver = new IntersectionObserver(([entry]) => {
      articleStartReturnVisible = entry.isIntersecting;
      setReturnState(articleStartReturnVisible ? "hidden" : "tucked");
    });
    startReturnObserver.observe(articleStartReturn);

    window.addEventListener(
      "scroll",
      () => {
        if (returnUpdateQueued) return;
        returnUpdateQueued = true;

        requestAnimationFrame(() => {
          const currentScrollY = window.scrollY;
          const delta = currentScrollY - lastScrollY;
          lastScrollY = currentScrollY;

          if (articleStartReturnVisible || Math.abs(delta) < 1) {
            returnUpdateQueued = false;
            return;
          }

          const nextDirection = Math.sign(delta);
          if (nextDirection !== scrollDirection) {
            scrollDirection = nextDirection;
            scrollDistance = 0;
          }
          scrollDistance += Math.abs(delta);

          if (scrollDirection > 0 && scrollDistance >= tuckScrollDistance) {
            setReturnState("tucked");
          } else if (
            scrollDirection < 0 &&
            scrollDistance >= revealScrollDistance
          ) {
            setReturnState("revealed");
          }

          returnUpdateQueued = false;
        });
      },
      { passive: true },
    );
  }
</script>
