---
import { Icon } from "astro-icon/components";
---

<div class="theme-switcher" data-theme-switcher>
  <button
    type="button"
    class="theme-trigger"
    aria-label="テーマを切り替え"
    aria-haspopup="true"
    aria-expanded="false"
    data-theme-trigger
  >
    <span class="theme-icon" data-pref-icon="system">
      <Icon name="octicon:device-desktop-16" />
    </span>
    <span class="theme-icon" data-pref-icon="light" hidden>
      <Icon name="octicon:sun-16" />
    </span>
    <span class="theme-icon" data-pref-icon="dark" hidden>
      <Icon name="octicon:moon-16" />
    </span>
  </button>

  <ul class="theme-menu" role="menu" data-theme-menu hidden>
    <li role="none">
      <button
        type="button"
        role="menuitemradio"
        aria-checked="false"
        class="theme-menu-item"
        data-theme-value="system"
      >
        <Icon name="octicon:device-desktop-16" />
        <span>システム</span>
      </button>
    </li>
    <li role="none">
      <button
        type="button"
        role="menuitemradio"
        aria-checked="false"
        class="theme-menu-item"
        data-theme-value="light"
      >
        <Icon name="octicon:sun-16" />
        <span>ライト</span>
      </button>
    </li>
    <li role="none">
      <button
        type="button"
        role="menuitemradio"
        aria-checked="false"
        class="theme-menu-item"
        data-theme-value="dark"
      >
        <Icon name="octicon:moon-16" />
        <span>ダーク</span>
      </button>
    </li>
  </ul>
</div>

<style>
  .theme-switcher {
    position: relative;
  }

  .theme-trigger {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    background: transparent;
    color: var(--text-secondary);
    transition:
      background-color 140ms ease-out,
      color 140ms ease-out;
  }

  .theme-trigger:hover {
    background: var(--bg-hover);
    color: var(--text-primary);
  }

  .theme-icon {
    display: inline-flex;
    font-size: 18px;
  }

  .theme-menu {
    position: absolute;
    top: calc(100% + 6px);
    right: 0;
    z-index: 50;
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 148px;
    margin: 0;
    padding: 4px;
    list-style: none;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
  }

  .theme-menu[hidden] {
    display: none;
  }

  .theme-menu-item {
    display: flex;
    align-items: center;
    gap: 8px;
    width: 100%;
    height: 34px;
    padding: 0 10px;
    border: 0;
    border-radius: var(--radius-label);
    background: transparent;
    color: var(--text-secondary);
    font-size: var(--text-sm);
    text-align: left;
    transition:
      background-color 140ms ease-out,
      color 140ms ease-out;
  }

  .theme-menu-item :global(svg) {
    font-size: 16px;
  }

  .theme-menu-item:hover {
    background: var(--bg-hover);
    color: var(--text-primary);
  }

  .theme-menu-item[aria-checked="true"] {
    background: var(--bg-selection);
    color: var(--text-primary);
  }

  @media (min-width: 768px) {
    .theme-trigger {
      width: 34px;
      height: 34px;
    }
  }
</style>

<script>
  const KEY = "amb-theme";
  const root = document.documentElement;
  const mql = window.matchMedia("(prefers-color-scheme: dark)");

  type Pref = "system" | "light" | "dark";

  const wrap = document.querySelector<HTMLElement>("[data-theme-switcher]");

  if (wrap) {
    const trigger = wrap.querySelector<HTMLButtonElement>(
      "[data-theme-trigger]",
    );
    const menu = wrap.querySelector<HTMLElement>("[data-theme-menu]");
    const items =
      wrap.querySelectorAll<HTMLButtonElement>("[data-theme-value]");
    const triggerIcons = wrap.querySelectorAll<HTMLElement>("[data-pref-icon]");

    const getPref = (): Pref => {
      const s = localStorage.getItem(KEY);
      return s === "light" || s === "dark" || s === "system" ? s : "system";
    };

    const resolve = (p: Pref) =>
      p === "dark" || (p === "system" && mql.matches) ? "dark" : "light";

    const reflect = (pref: Pref) => {
      root.dataset.theme = resolve(pref);
      triggerIcons.forEach((el) => {
        el.hidden = el.dataset.prefIcon !== pref;
      });
      items.forEach((el) => {
        el.setAttribute(
          "aria-checked",
          el.dataset.themeValue === pref ? "true" : "false",
        );
      });
    };

    const open = () => {
      if (menu) menu.hidden = false;
      trigger?.setAttribute("aria-expanded", "true");
    };

    const close = () => {
      if (menu) menu.hidden = true;
      trigger?.setAttribute("aria-expanded", "false");
    };

    reflect(getPref());

    trigger?.addEventListener("click", () => {
      if (menu?.hidden) {
        open();
      } else {
        close();
      }
    });

    items.forEach((el) => {
      el.addEventListener("click", () => {
        const value = el.dataset.themeValue as Pref;
        localStorage.setItem(KEY, value);
        reflect(value);
        close();
        trigger?.focus();
      });
    });

    document.addEventListener("click", (e) => {
      if (!wrap.contains(e.target as Node)) close();
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && menu && !menu.hidden) {
        close();
        trigger?.focus();
      }
    });

    mql.addEventListener("change", () => {
      if (getPref() === "system") reflect("system");
    });
  }
</script>
