---
type RelationRecord = { slug: string; title: string };
type RelationGroup = {
  label: string;
  records: RelationRecord[];
};
type Props = {
  groups: RelationGroup[];
  /** いま読んでいる記録のタイトル。時間軸の節点に置く */
  currentTitle: string;
  older?: RelationRecord;
  newer?: RelationRecord;
  /** プレビューから呼ぶときはプレビュー側へ辿らせる */
  basePath?: string;
};
const {
  groups,
  currentTitle,
  older,
  newer,
  basePath = "/blog",
} = Astro.props;
const meaningfulGroups = groups.filter((group) => group.records.length > 0);
---

{
  (meaningfulGroups.length > 0 || older || newer) && (
    <nav class="record-relations" aria-label="記録同士の関係">
      {meaningfulGroups.map((group) => (
        <section>
          <p class="relation-label">{group.label}</p>
          <ul>
            {group.records.map((record) => (
              <li>
                <a href={`${basePath}/${record.slug}`}>→ {record.title}</a>
              </li>
            ))}
          </ul>
        </section>
      ))}
      {(older || newer) && (
        <section class="sequence" aria-label="時間軸の前後">
          <ol>
            {newer && (
              <li>
                <a href={`${basePath}/${newer.slug}`}>{newer.title}</a>
              </li>
            )}
            <li class="is-current">
              <span>{currentTitle}</span>
            </li>
            {older && (
              <li>
                <a href={`${basePath}/${older.slug}`}>{older.title}</a>
              </li>
            )}
          </ol>
        </section>
      )}
    </nav>
  )
}

<style>
  .record-relations {
    max-width: var(--measure-prose);
    margin: 64px auto 0;
    padding-top: 26px;
    border-top: 2px solid var(--color-primary);
  }

  .record-relations > * + * {
    margin-top: 30px;
  }

  .relation-label {
    /* 説明文を置かなくなったので、見出しと一覧の間はここで空ける */
    margin: 0 0 10px;
    color: var(--color-primary);
    font-weight: 700;
  }

  .record-relations ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .record-relations li {
    padding: 7px 0;
    border-bottom: 1px solid var(--color-border);
  }

  .record-relations a {
    color: var(--color-interaction-text);
    text-decoration: none;
  }

  .record-relations a:hover,
  .record-relations a:focus-visible {
    text-decoration: underline;
  }

  /*
   * 時間軸。上が新しく下が古い一本の線に、前後の記録と現在地を置く。
   * 向きは並び順で示し、言葉は置かない。分岐も作らない。改訂履歴がすぐ上に
   * 並ぶので、git のグラフに見える形にしない
   */
  .sequence {
    display: grid;
    gap: 4px;
  }

  .sequence ol {
    position: relative;
    margin: 0;
    /* 軸と枝を置くための溝。これ以上詰めると節点が本文の外へ出る */
    padding: 0 0 0 18px;
    list-style: none;
  }

  /* 軸。最初と最後の節点のあいだだけに引く */
  .sequence ol::before {
    content: "";
    position: absolute;
    inset-block: 18px;
    inset-inline-start: 3px;
    width: 1px;
    background: var(--color-border-strong);
  }

  .sequence li {
    position: relative;
    padding: 9px 0;
    border-bottom: 0;
  }

  /* 軸から項目へ渡す枝 */
  .sequence li::before {
    content: "";
    position: absolute;
    inset-block-start: calc(50% - 1px);
    inset-inline-start: -15px;
    width: 12px;
    height: 1px;
    background: var(--color-border-strong);
  }

  /* 現在地の節点 */
  .sequence .is-current::after {
    content: "";
    position: absolute;
    inset-block-start: calc(50% - 5px);
    inset-inline-start: -19px;
    width: 9px;
    height: 9px;
    background: var(--color-background);
    border-radius: 50%;
    box-shadow: inset 0 0 0 2px var(--color-primary);
  }

  .sequence .is-current span {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }
</style>
