---
import { Icon } from "astro-icon/components";
import {
  PUBLISHED_STATUS,
  type PublishedStatus,
} from "~/constants/publishedStatus";
import type { Category } from "~/constants/categories";
import { normalizePostSlug } from "~/utils/postSlug";

interface Props {
  slug: string;
  title: string;
  description?: string;
  thumbnail?: string;
  categories: Category[];
  publishedAt: Date;
  status: PublishedStatus;
}

const {
  slug,
  title,
  description = "",
  thumbnail,
  categories = [],
  publishedAt,
  status,
} = Astro.props;

const isDraft = status.includes(PUBLISHED_STATUS.DRAFT);
const hasDescription = Boolean(description && description.trim().length > 0);
const normalizedSlug = normalizePostSlug(slug);
const isoDate = new Date(publishedAt).toISOString().split("T")[0];
const displayDate = isoDate.replaceAll("-", ".");
const cardCategories = categories.filter((category) => category !== "すべて");
---

<article class:list={["post-card", { "is-draft": isDraft }]}>
  <a
    href={`/blog/${normalizedSlug}`}
    class="post-card-thumb"
    tabindex="-1"
    aria-hidden="true"
  >
    {
      thumbnail ? (
        <img src={thumbnail} alt={title} loading="lazy" />
      ) : (
        <span class="post-card-thumb-empty">
          <Icon name="octicon:file-16" />
        </span>
      )
    }
  </a>

  <div class="post-card-body">
    <div class="post-card-meta">
      <time datetime={isoDate}>{displayDate}</time>
      {isDraft && <span class="post-card-draft">下書き</span>}
    </div>

    <h3 class="post-card-title">
      <a href={`/blog/${normalizedSlug}`}>{title}</a>
    </h3>

    {hasDescription && <p class="post-card-desc">{description}</p>}

    {
      cardCategories.length > 0 && (
        <ul class="post-card-tags">
          {cardCategories.map((category) => (
            <li class="post-card-tag">{category}</li>
          ))}
        </ul>
      )
    }
  </div>
</article>

<style>
  .post-card {
    display: flex;
    gap: 12px;
    padding: 14px;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    transition:
      border-color 140ms ease-out,
      background-color 140ms ease-out;
  }

  .post-card:hover {
    border-color: var(--accent-warm);
  }

  .post-card.is-draft {
    opacity: 0.7;
  }

  .post-card-thumb {
    position: relative;
    flex: none;
    width: 104px;
    height: 78px;
    overflow: hidden;
    border-radius: var(--radius-card);
    background: var(--bg-selection);
  }

  .post-card-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .post-card-thumb-empty {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    color: var(--text-muted);
    font-size: 20px;
  }

  .post-card-body {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
    flex: 1;
  }

  .post-card-meta {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    color: var(--text-muted);
  }

  .post-card-draft {
    padding: 1px 7px;
    border: 1px solid color-mix(in srgb, var(--warning) 40%, var(--border));
    border-radius: var(--radius-label);
    color: color-mix(in srgb, var(--warning) 80%, var(--text-primary));
  }

  .post-card-title {
    margin: 0;
    font-size: 16px;
    font-weight: 500;
    line-height: 1.5;
  }

  .post-card-title a {
    color: var(--text-primary);
    text-decoration: none;
  }

  .post-card-title a:hover {
    color: var(--text-primary);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .post-card-desc {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
    margin: 0;
    font-size: 13px;
    line-height: 1.7;
    color: var(--text-secondary);
  }

  .post-card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 4px 0 0;
    padding: 0;
    list-style: none;
  }

  .post-card-tag {
    padding: 2px 8px;
    font-size: 12px;
    color: var(--text-secondary);
    background: var(--bg-selection);
    border: 1px solid var(--border);
    border-radius: var(--radius-label);
  }

  @media (min-width: 640px) {
    .post-card {
      gap: 16px;
      padding: 16px;
    }

    .post-card-thumb {
      width: 132px;
      height: 92px;
    }
  }
</style>
