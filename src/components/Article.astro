---
import type { AstroComponentFactory } from "astro/runtime/server/index.js";
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import CopyLinkButton from "~/components/CopyLinkButton.astro";
import wipCat from "~/assets/wip-cat.png";
import ArticleSearch from "./ArticleSearch.astro";
import ArticleSearchDialog from "./ArticleSearchDialog.astro";
import Prose from "./Prose.astro";
import Categories from "./Categories.astro";
import Meta from "./Meta.astro";
import GithubCard from "./GithubCard.astro";
import RevisionHistory from "./RevisionHistory.astro";
import RecordType from "./RecordType.astro";
import type { Category } from "~/constants/categories";
import type { Tag } from "~/constants/tags";
import {
  PUBLISHED_STATUS,
  type PublishedStatus,
} from "~/constants/publishedStatus";
import { HEADING_LEVEL } from "~/constants/headingLevel";
import type { RecordType as RecordTypeValue } from "~/constants/recordType";

type Props = {
  title: string;
  publishedAt: Date;
  updatedAt: Date;
  categories: Category[];
  tags: Tag[];
  recordType: RecordTypeValue;
  githubUrl?: string;
  content: AstroComponentFactory;
  headings?: { depth: number; slug: string; text: string }[];
  status: PublishedStatus;
  revisions?: { date: Date; summary: string }[];
  forceRenderContent?: boolean;
  hidesMemo?: boolean;
  showGithubCard?: boolean;
  returnHref?: string;
  returnLabel?: string;
  returnSourcePaths?: string[];
  copyPath?: string;
};

const {
  title,
  publishedAt,
  updatedAt,
  categories,
  tags,
  recordType,
  githubUrl,
  content,
  headings = [],
  status,
  revisions,
  forceRenderContent = false,
  hidesMemo = false,
  showGithubCard = true,
  returnHref,
  returnLabel,
  returnSourcePaths = [],
  copyPath,
} = Astro.props;
const returnPaths = JSON.stringify(returnSourcePaths);
const tocHeadings = headings.filter(
  (heading) =>
    heading.depth === HEADING_LEVEL.TWO ||
    heading.depth === HEADING_LEVEL.THREE,
);
/*
 * 現在地は PC の .current-trace と同じく h2 単位で数える。h3 は位置を持たないので
 * 通し番号を振らず、既定色のまま置く
 */
let sectionCount = 0;
const tocItems = tocHeadings.map((heading) => ({
  ...heading,
  sectionIndex:
    heading.depth === HEADING_LEVEL.TWO ? sectionCount++ : undefined,
}));
const isDraft = status === PUBLISHED_STATUS.DRAFT;
const showContent = !isDraft || forceRenderContent;
const xShareUrl = `https://x.com/intent/tweet?text=${encodeURIComponent(title)}&url=${encodeURIComponent(Astro.url.href)}`;
---

<article class="article">
  <header class="article-header">
    <div class="article-kicker">
      <RecordType recordType={recordType} />
      <Meta publishedAt={publishedAt} updatedAt={updatedAt} />
    </div>
    <h1 class="article-title">{title}</h1>
    <Categories categories={categories} tags={tags} />
    {githubUrl && showGithubCard && <GithubCard url={githubUrl} />}
  </header>

  {
    showContent && tocHeadings.length > 0 && (
      <>
        <ArticleSearch />
        <span class="article-structure-sentinel" aria-hidden="true" />
        <details class="article-structure">
          <summary>
            <span>
              <span>目次</span>
            </span>
            <Icon name="octicon:chevron-down-16" aria-hidden="true" />
          </summary>
          <div class="article-structure-body">
            <ol>
              {tocItems.map((item) => (
                <li
                  class:list={{
                    "is-h3": item.depth === HEADING_LEVEL.THREE,
                  }}
                  data-structure-item={
                    item.sectionIndex === undefined ? undefined : ""
                  }
                  data-heading-id={
                    item.sectionIndex === undefined ? undefined : item.slug
                  }
                  data-section-index={item.sectionIndex}
                >
                  <a href={`#${item.slug}`} data-structure-link>
                    {item.text}
                  </a>
                </li>
              ))}
            </ol>
            {returnHref && returnLabel && copyPath && (
              <div class="article-structure-actions">
                <div class="article-structure-actions-inner">
                  <a
                    class="article-structure-action article-structure-action--return"
                    href={returnHref}
                    aria-label={returnLabel}
                    data-reading-return
                    data-return-paths={returnPaths}
                  >
                    <Icon name="octicon:arrow-left-16" aria-hidden="true" />
                    <span>
                      一覧へ
                      <wbr />
                      戻る
                    </span>
                  </a>
                  <a
                    class="article-structure-action article-structure-action--top"
                    href="#"
                    aria-label="ページの上部へ戻る"
                  >
                    <Icon name="octicon:arrow-up-16" aria-hidden="true" />
                    <span>
                      ページ上部へ
                      <wbr />
                      戻る
                    </span>
                  </a>
                  <CopyLinkButton
                    class="article-structure-action article-structure-action--copy"
                    path={copyPath}
                    label="記事のリンクをコピー"
                  >
                    <Fragment slot="label">
                      記事のリンクを
                      <wbr />
                      コピー
                    </Fragment>
                  </CopyLinkButton>
                  <a
                    class="article-structure-action article-structure-action--share"
                    href={xShareUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    <Icon name="x-logo" aria-hidden="true" />
                    <span>Xで共有</span>
                  </a>
                </div>
              </div>
            )}
          </div>
        </details>
      </>
    )
  }

  {showContent && <ArticleSearchDialog />}

  {
    showContent ? (
      <Prose content={content} status={status} hidesMemo={hidesMemo} />
    ) : (
      <div class="draft-placeholder">
        <Image
          class="draft-mark"
          src={wipCat}
          alt=""
          widths={[176, 352]}
          sizes="176px"
          loading="eager"
        />
        <p class="draft-note">この記事は公開予定です。</p>
        {returnHref && returnLabel && (
          <a class="draft-return" href={returnHref}>
            <Icon name="octicon:arrow-left-16" aria-hidden="true" />
            <span>{returnLabel}</span>
          </a>
        )}
      </div>
    )
  }

  {showContent && <RevisionHistory revisions={revisions} />}
</article>

<style>
  .article {
    --article-sticky-header-height: 52px;
    /*
     * 目次が吸着する高さ。既定ではヘッダーの下だが、上にさらに追従する
     * ものがある画面ではその分を足して積み上げるため、別の名前で持つ。
     */
    --article-structure-offset: var(--article-sticky-header-height);
    --article-structure-summary-height: 44px;
    --article-structure-padding-bottom: 14px;

    width: 100%;
    min-width: 0;
  }

  /*
   * 本文との区切りは線を引かず余白で示す。本文のh2が全幅の線を持つので、
   * ここにも線を置くと縦に線が続いて見える
   */
  .article-header {
    display: grid;
    gap: 15px;
    max-width: var(--measure-prose);
    margin: 0 auto 32px;
  }

  /*
   * 型と記録日は題を読むより先に渡すので、タイトルの前へ 1 行で置く。
   * 型を左、日付を右へ振り分ける。型は日付の値と並ぶので、ラベル（11px）では
   * なく値と同じ大きさにする
   */
  .article-kicker {
    --record-type-size: var(--text-sm);
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px 16px;
  }

  /* 型と高さを揃えるため、記事の頭だけラベルと値を横に置く */
  .article-kicker :global(.record-meta div) {
    display: flex;
    align-items: baseline;
    gap: 6px;
  }

  .article-title {
    margin: 0;
    color: var(--color-primary);
    font-size: var(--text-2xl);
    font-weight: 700;
    line-height: 1.35;
    letter-spacing: -0.025em;
    line-break: strict;
    /* balance は行を揃えるぶん右へ余白を残す。和文では幅を使い切るほうが読める */
    text-wrap: pretty;
    word-break: auto-phrase;
  }

  /*
   * 本文上の目次は狭幅でのみ出す。1024px 以上では Navigation の
   * .current-trace が同じ役割を担うため、二重に置かない。
   */
  .article-structure {
    /*
     * 背景を端まで伸ばすときの基準。画面幅ではなく、記事が実際に置ける幅を
     * 見る。960px 以上では左端にレールが立ち、body がその分だけ右へ寄るため、
     * 画面幅で測ると伸ばす量が左右でずれる。
     */
    --article-structure-viewport: 100vw;
    --article-structure-side-inset: calc(
      (
          var(--article-structure-viewport) -
            min(var(--measure-prose), var(--article-structure-viewport) - 32px)
        ) /
        2
    );

    position: relative;
    isolation: isolate;
    max-width: var(--measure-prose);
    margin: 0 auto 24px;
    padding: 0 0 var(--article-structure-padding-bottom);
  }

  .article-structure::before {
    position: absolute;
    z-index: -1;
    inset-block: 0;
    inset-inline: calc(-1 * var(--article-structure-side-inset));
    pointer-events: none;
    content: "";
    background: var(--color-background);
    border-bottom: 1px solid var(--color-border);
    clip-path: inset(0 var(--article-structure-side-inset));
    transition:
      border-color var(--duration-feedback) ease,
      box-shadow var(--duration-state) var(--ease-trace),
      clip-path var(--duration-state) var(--ease-trace);
  }

  .article-structure-sentinel {
    display: block;
    height: 1px;
  }

  /*
   * 記事内検索は目次と同じ列に立つ。幅と中央寄せを目次に合わせないと、
   * 本文とも目次とも端が揃わない。下の余白も目次の 24px と同じ間隔にする
   */
  .article :global(.article-search) {
    max-width: var(--measure-prose);
    margin: 0 auto 16px;
  }

  /*
   * 狭幅はヘッダーのバーに虫眼鏡があるので、本文の上へ重ねて置かない。
   * バーが消える 960px から、目次が欄外へ移る 1024px までの間だけ出す
   */
  @media (max-width: 959px) {
    .article :global(.article-search) {
      display: none;
    }
  }

  /* 広幅では欄外の .current-trace が同じ役割を持つので、こちらは出さない */
  @media (min-width: 1024px) {
    .article-structure,
    .article :global(.article-search) {
      display: none;
    }
  }

  .article-structure summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: var(--article-structure-summary-height);
    color: var(--color-primary);
    font-size: var(--text-sm);
    font-weight: 700;
    cursor: pointer;
    list-style: none;
    transition:
      color var(--duration-feedback) ease,
      background-color var(--duration-feedback) ease,
      transform var(--duration-state) var(--ease-trace);
  }

  .article-structure summary > span {
    display: flex;
    align-items: baseline;
    min-width: 0;
  }

  .article-structure summary::-webkit-details-marker {
    display: none;
  }
  .article-structure[open] summary :global(svg) {
    transform: rotate(180deg);
  }

  .article-structure ol {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 6px;
    margin: 8px 0 0;
    padding: 0;
    list-style: none;
  }

  .article-structure-body {
    min-block-size: 0;
  }

  /*
   * 開閉の動きはハンバーガーメニューと同じにする。面が上から降りて薄く入り、
   * 閉じるときは同じ分だけ戻る。<details> は open を外した瞬間に中身が消えるので、
   * 閉じる側は script が data-closing を付けているあいだだけ見せる
   */
  .article-structure[open]:not([data-closing]) .article-structure-body {
    animation: article-structure-in var(--duration-feedback) ease both;
  }

  /*
   * 閉じる側も keyframes で持つ。開く animation が残した値からは transition が
   * 起きず、文字だけ先に消えてから面が閉じるように見えてしまう
   */
  .article-structure[data-closing] .article-structure-body {
    pointer-events: none;
    animation: article-structure-out var(--duration-feedback) var(--ease-trace)
      both;
  }

  @keyframes article-structure-out {
    from {
      opacity: 1;
      transform: translateY(0);
    }

    to {
      opacity: 0;
      transform: translateY(-8px);
    }
  }

  @keyframes article-structure-in {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .article-structure li.is-h3 {
    padding-left: 18px;
  }
  .article-structure a {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    text-decoration: none;
    transition: color var(--duration-feedback) ease;
  }

  /* 現在地の示し方は PC の .current-trace と同じ 3 段階に揃える */
  .article-structure li.is-past > a {
    color: var(--color-text-sub);
  }

  .article-structure li.is-current > a {
    color: var(--color-primary);
    font-weight: 700;
  }
  .article-structure a:hover {
    color: var(--color-interaction-text);
    text-decoration: underline;
  }

  .article-structure-actions {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-rows: 0fr;
    margin-top: 0;
    padding-top: 0;
    overflow: hidden;
    visibility: hidden;
    border-top: 1px solid transparent;
    border-bottom: 1px solid transparent;
    opacity: 0;
    transition:
      grid-template-rows var(--duration-state) var(--ease-trace),
      margin var(--duration-state) var(--ease-trace),
      padding var(--duration-state) var(--ease-trace),
      border-color var(--duration-feedback) ease,
      opacity var(--duration-feedback) ease;
  }

  .article-structure-actions-inner {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    min-block-size: 0;
    gap: 0;
  }

  .article-structure-actions-inner > :global(.article-structure-action) {
    display: grid;
    grid-template-columns: 14px minmax(0, 1fr);
    align-items: center;
    align-content: center;
    justify-items: start;
    gap: 6px;
    justify-self: stretch;
    min-width: 0;
    min-height: 44px;
    padding: 6px 8px;
    color: var(--color-text-sub);
    font-size: var(--text-xs);
    line-height: 1.3;
    text-align: start;
    text-decoration: none;
    transition:
      color var(--duration-feedback) ease,
      background-color var(--duration-feedback) ease;
  }

  .article-structure-actions-inner
    > :global(.article-structure-action)
    :global(svg) {
    width: 14px;
    height: 14px;
  }

  .article-structure-actions-inner
    > :global(.article-structure-action)
    :global(.copy-link-label),
  .article-structure-actions-inner > a.article-structure-action > span {
    min-width: 0;
    word-break: keep-all;
  }

  .article-structure-actions-inner > a.article-structure-action {
    font-size: var(--text-xs);
    line-height: 1.3;
  }

  .article-structure-actions-inner > :global(.article-structure-action--top) {
    border-inline-start: 1px solid var(--color-border);
  }

  /* コピーは一段を使い切る。戻る・上部への行と段を分ける */
  .article-structure-actions-inner > :global(.article-structure-action--copy) {
    grid-column: 1 / -1;
    border-top: 1px solid var(--color-border);
    border-inline-start: 0;
  }

  /* 共有は最後の行に一段で置く */
  .article-structure-actions-inner > :global(.article-structure-action--share) {
    grid-column: 1 / -1;
    border-top: 1px solid var(--color-border);
  }

  .article-structure-actions-inner > :global(.article-structure-action):hover,
  .article-structure-actions-inner
    > :global(.article-structure-action):focus-visible {
    color: var(--color-interaction-text);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (max-width: 1023px) {
    /*
     * 目次と操作子は指で触る面なので、長押しやなぞりで選択やコピーの UI が
     * 割り込まないようにする。ここで取りたいのは操作の手応えだけで、
     * 読ませたい文章は本文の側にある。本文と見出しは従来どおり選択できる。
     */
    .article-structure {
      -webkit-touch-callout: none;
      user-select: none;
    }

    /*
     * プレビューには記事の上に追従する編集バーがある。ヘッダー、バー、目次の
     * 順に積み上げるため、吸着の基準にバーの実高を足す。この変数を配るのは
     * プレビューのスクリプトだけなので、本番の記事ページは従来どおり動く。
     */
    :global(.preview-detail) .article {
      --article-structure-offset: calc(
        var(--article-sticky-header-height) +
          var(--preview-editor-bar-height, 0px)
      );
    }

    .article-structure {
      position: sticky;
      inset-block-start: var(--article-structure-offset);
      z-index: 20;
      transition: transform var(--duration-feedback) var(--ease-trace);
    }

    .article-structure[data-stuck]::before {
      border-bottom-color: var(--color-border-strong);
      box-shadow: 0 6px 12px -6px rgb(0 0 0 / 18%);
      clip-path: inset(0);
    }

    /* 開いている間はバーの下に本体が続くので、目次直下に線は引かない */
    .article-structure[data-stuck][open]::before {
      border-bottom-color: transparent;
    }

    .article-structure[data-stuck] summary {
      color: var(--color-text-sub);
      font-weight: 600;
    }

    .article-structure[data-stuck] summary :global(svg) {
      width: 14px;
      height: 14px;
    }

    .article-structure[data-stuck]:not([open]) {
      padding-block-end: 0;
    }

    .article-structure[data-stuck][open] {
      padding-block-end: 0;
    }

    /*
     * 追従中に開いた本体はフローから外し、バーの下へ浮かせる。details 自身の
     * 高さが伸びると後続の本文がその分だけ押し下げられ、スクロールアンカリング
     * 未対応の Safari では背面が開閉に合わせて動いて見える。要素の高さをバーの
     * ままに保てば、補正の有無に関係なく背面は動かない
     */
    .article-structure[data-stuck][open] .article-structure-body {
      position: absolute;
      inset-block-start: 100%;
      inset-inline: calc(-1 * var(--article-structure-side-inset));
      display: grid;
      grid-template-rows: minmax(0, 1fr) auto;
      max-block-size: calc(
        80dvb - var(--article-structure-offset) -
          var(--article-structure-summary-height)
      );
      min-block-size: 0;
      padding-inline: var(--article-structure-side-inset);
      background: var(--color-background);
      border-bottom: 1px solid var(--color-primary);
      box-shadow: 0 12px 20px -10px rgb(0 0 0 / 26%);
    }

    .article-structure[data-stuck][open] ol {
      align-content: start;
      min-block-size: 0;
      padding-block-end: var(--article-structure-padding-bottom);
      overflow-x: hidden;
      overflow-y: auto;
      overscroll-behavior: contain;
      touch-action: pan-y;
      scrollbar-width: none;
    }

    .article-structure[data-stuck][open] ol::-webkit-scrollbar {
      display: none;
    }

    /*
     * 追従中のクロームの上で指を動かしても、裏の記事が流れないようにする。
     * 上へ引いてヘッダーを退避させる操作が成立するのはヘッダーバーの上だけで、
     * 目次バーやシートで同じ動きをすると「バーは上がらないのに本文だけ流れる」
     * 空振りになる。パンそのものを断てば、効かない場所で画面が動くことはなくなる。
     * シートは左右の余白ごと止め、縦スクロールは目次リストにだけ戻す。リストは
     * 自身がスクロールコンテナなので、touch-action の交差がそこで止まり pan-y が残る
     */
    .article-structure[data-stuck] summary,
    .article-structure[data-stuck][open] .article-structure-body {
      touch-action: none;
    }

    .article-structure[data-stuck] .article-structure-actions {
      grid-template-rows: 1fr;
      margin-top: 0;
      padding-top: 0;
      visibility: visible;
      background: var(--color-background);
      border-top-color: var(--color-border-strong);
      opacity: 1;
    }

    .article-structure[open] summary {
      z-index: 1;
      background: var(--color-background);
    }
  }

  /*
   * ヘッダーを指で引いている間、追従中の目次も一緒に動かして画面上部を空ける。
   * ヘッダーの分と自身の分を合わせて退避するので、上端まで完全に外れる。
   * sticky の offset を書き換えると再吸着で跳ねるため transform で動かす。
   * 追従していない目次は本文中の位置にあるので動かさない。展開中も、
   * 開いた本体だけが取り残されるため対象から外す
   */
  @media (max-width: 959px) {
    .article-structure[data-stuck]:not([open]) {
      /* ヘッダーと同じ理由で 1px 余分に送る（下端の罫線を残さない） */
      --chrome-hidden-shift: calc(
        -1px - var(--article-structure-offset) -
          var(--article-structure-summary-height)
      );
      --chrome-shift: 0px;

      transform: translateY(
        clamp(
          var(--chrome-hidden-shift),
          calc(var(--chrome-shift) + var(--chrome-drag-y, 0px)),
          var(--chrome-rubber-max, 0px)
        )
      );
    }

    :global(html[data-chrome-hidden])
      .article-structure[data-stuck]:not([open]) {
      --chrome-shift: var(--chrome-hidden-shift);
    }

    :global(html[data-chrome-dragging]) .article-structure {
      transition: none;
    }
  }

  @media (max-width: 639px) {
    .article-structure[data-stuck] .article-structure-actions {
      margin-inline: calc(-1 * var(--article-structure-side-inset));
    }
  }

  @media (min-width: 640px) and (max-width: 1023px) {
    .article-structure {
      --article-structure-side-inset: calc(
        (
            var(--article-structure-viewport) -
              min(
                var(--measure-prose),
                var(--article-structure-viewport) - 48px
              )
          ) /
          2
      );
    }
  }

  /*
   * 左レールが立つ幅。記事はレールのぶん右へ寄り、上を塞ぐバーは無くなる。
   * 目次もそれに合わせ、基準幅を狭め、吸着は画面の上端に戻す。
   */
  @media (min-width: 960px) {
    .article {
      --article-sticky-header-height: 0px;
    }

    .article-structure {
      --article-structure-viewport: calc(100vw - 48px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .article-structure,
    .article-structure summary,
    .article-structure::before,
    .article-structure-actions {
      transition: none;
    }

    .article-structure[open]:not([data-closing]) .article-structure-body {
      animation: none;
    }

    .article-structure[data-closing] .article-structure-body {
      animation: none;
    }
  }

  /* 本文がまだ無い記録には、目次も欄外traceも出ない。戻り口だけ残す */
  .draft-return {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 20px;
    color: var(--color-primary);
    font-family: var(--font-machine);
    font-size: 12px;
    text-decoration: none;
  }

  .draft-return :global(svg) {
    width: 14px;
    height: 14px;
  }

  .draft-return:hover,
  .draft-return:focus-visible {
    color: var(--color-interaction-text);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .draft-placeholder {
    /* 高さと猫の大きさは目視で詰める前提の暫定値。ここ2つだけ触れば調整できる */
    --wip-area-height: min(46vh, 420px);
    --wip-cat-width: 11rem;

    display: grid;
    place-items: center;
    gap: 20px;
    max-width: var(--measure-prose);
    min-height: var(--wip-area-height);
    margin: 40px auto;
    padding: 24px 16px;
  }

  .draft-mark {
    width: var(--wip-cat-width);
    height: auto;
    opacity: 0.8;
  }

  .draft-note {
    max-width: 28ch;
    margin: 0;
    color: var(--color-text-sub);
    line-height: 1.9;
    text-align: center;
  }
</style>

<style is:global>
  /* 飛んだ先の頭上は、その見出しが本来持つ上の余白と同じだけ空ける */
  .prose h2,
  .prose h3 {
    scroll-margin-top: var(--heading-gap);
  }

  @media (max-width: 1023px) {
    .prose h2,
    .prose h3 {
      scroll-margin-top: calc(
        var(--article-structure-offset) +
          var(--article-structure-summary-height) + var(--heading-gap)
      );
    }
  }
</style>

<script>
  import {
    observePage,
    onPageLoad,
    onPageEvent,
    onPageCleanup,
  } from "~/scripts/pageLifecycle";

  onPageLoad(() => {
    document
      .querySelectorAll<HTMLDetailsElement>(".article-structure")
      .forEach((details) => {
        details
          .querySelectorAll<HTMLAnchorElement>("[data-structure-link]")
          .forEach((link) => {
            link.addEventListener("click", () => {
              if (matchMedia("(max-width: 1023px)").matches) {
                details.open = false;
              }
            });
          });

        const sentinel = details.previousElementSibling;
        if (!(sentinel instanceof HTMLElement)) return;

        const mobileViewport = matchMedia("(max-width: 1023px)");
        const isOpenStickySheet = () =>
          mobileViewport.matches &&
          details.open &&
          details.hasAttribute("data-stuck");
        let scrollCloseGuard = 0;

        /*
         * 閉じる動きを見せてから open を外す。ハンバーガーメニューと同じ作りで、
         * 待つ時間も揃える。動きを減らす設定では待たずに閉じる
         */
        const reducedMotion = matchMedia("(prefers-reduced-motion: reduce)");
        // CSS の --duration-feedback と対で持つ。動きが終わった時点で閉じる
        const closeDuration = 160;
        let closeTimer = 0;
        onPageCleanup(() => window.clearTimeout(closeTimer));

        const finishClosing = () => {
          window.clearTimeout(closeTimer);
          details.open = false;
          delete details.dataset.closing;
        };

        details.querySelector("summary")?.addEventListener("click", (event) => {
          if (details.open && details.dataset.closing === undefined) {
            event.preventDefault();
            if (reducedMotion.matches) {
              finishClosing();
            } else {
              details.dataset.closing = "";
              closeTimer = window.setTimeout(finishClosing, closeDuration);
            }
          }

          const currentGuard = ++scrollCloseGuard;
          requestAnimationFrame(() => {
            requestAnimationFrame(() => {
              if (scrollCloseGuard === currentGuard) {
                scrollCloseGuard = 0;
              }
            });
          });
        });

        onPageEvent(document, "pointerdown", (event) => {
          if (
            isOpenStickySheet() &&
            event.target instanceof Node &&
            !details.contains(event.target)
          ) {
            details.open = false;
          }
        });

        onPageEvent(
          document,
          "scroll",
          () => {
            if (scrollCloseGuard === 0 && isOpenStickySheet()) {
              details.open = false;
            }
          },
          { passive: true },
        );

        const syncReadingMode = ([entry]: IntersectionObserverEntry[]) => {
          if (!mobileViewport.matches) {
            delete details.dataset.stuck;
            return;
          }

          const hasReachedHeader =
            !entry.isIntersecting && entry.boundingClientRect.top <= 52;
          const wasStuck = details.hasAttribute("data-stuck");
          const structureBody = details.querySelector(
            ".article-structure-body",
          );
          const hasFocusInsideStructure =
            structureBody instanceof HTMLElement &&
            structureBody.contains(document.activeElement);

          details.toggleAttribute("data-stuck", hasReachedHeader);

          if (
            !hasReachedHeader ||
            (hasReachedHeader && !wasStuck && !hasFocusInsideStructure)
          ) {
            details.open = false;
          }
        };

        const observer = observePage(
          new IntersectionObserver(syncReadingMode, {
            rootMargin: "-52px 0px 0px 0px",
            threshold: 0,
          }),
        );
        observer.observe(sentinel);
      });
  });
</script>
