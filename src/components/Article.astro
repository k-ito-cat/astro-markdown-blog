---
import type { AstroComponentFactory } from "astro/runtime/server/index.js";
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import wipCat from "~/assets/wip-cat.png";
import Prose from "./Prose.astro";
import Categories from "./Categories.astro";
import Meta from "./Meta.astro";
import GithubCard from "./GithubCard.astro";
import RevisionHistory from "./RevisionHistory.astro";
import type { Category } from "~/constants/categories";
import type { Tag } from "~/constants/tags";
import {
  PUBLISHED_STATUS,
  type PublishedStatus,
} from "~/constants/publishedStatus";
import { HEADING_LEVEL } from "~/constants/headingLevel";

type Props = {
  title: string;
  publishedAt: Date;
  updatedAt: Date;
  categories: Category[];
  tags: Tag[];
  githubUrl?: string;
  content: AstroComponentFactory;
  headings?: { depth: number; slug: string; text: string }[];
  status: PublishedStatus;
  revisions?: { date: Date; summary: string }[];
  forceRenderContent?: boolean;
  showGithubCard?: boolean;
};

const {
  title,
  publishedAt,
  updatedAt,
  categories,
  tags,
  githubUrl,
  content,
  headings = [],
  status,
  revisions,
  forceRenderContent = false,
  showGithubCard = true,
} = Astro.props;
const tocHeadings = headings.filter(
  (heading) =>
    heading.depth === HEADING_LEVEL.TWO ||
    heading.depth === HEADING_LEVEL.THREE,
);
const isDraft = status === PUBLISHED_STATUS.DRAFT;
const showContent = !isDraft || forceRenderContent;
const xShareUrl = `https://x.com/intent/tweet?text=${encodeURIComponent(title)}&url=${encodeURIComponent(Astro.url.href)}`;
---

<article class="article">
  <header class="article-header">
    <h1 class="article-title">{title}</h1>
    <Meta publishedAt={publishedAt} updatedAt={updatedAt} />
    <Categories categories={categories} tags={tags} />
    {githubUrl && showGithubCard && <GithubCard url={githubUrl} />}
  </header>

  {
    showContent && tocHeadings.length > 0 && (
      <details class="article-structure" open>
        <summary>
          <span>
            目次
            <small>{tocHeadings.length}項目</small>
          </span>
          <Icon name="octicon:chevron-down-16" aria-hidden="true" />
        </summary>
        <ol>
          {tocHeadings.map((heading) => (
            <li class:list={{ "is-h3": heading.depth === HEADING_LEVEL.THREE }}>
              <a href={`#${heading.slug}`} data-structure-link>
                {heading.text}
              </a>
            </li>
          ))}
        </ol>
      </details>
    )
  }

  {
    showContent ? (
      <Prose content={content} status={status} />
    ) : (
      <div class="draft-placeholder">
        <Image
          class="draft-mark"
          src={wipCat}
          alt=""
          widths={[176, 352]}
          sizes="176px"
          loading="eager"
        />
        <p class="draft-note">
          この記録は検討中です。本文は公開されていません。
        </p>
      </div>
    )
  }

  {showContent && <RevisionHistory revisions={revisions} />}

  <footer class="article-footer">
    <span>この記録を共有</span>
    <a
      href={xShareUrl}
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Xで共有"
    >
      <Icon name="x-logo" width={16} height={16} aria-hidden="true" />
    </a>
  </footer>
</article>

<style>
  .article {
    width: 100%;
    min-width: 0;
  }

  .article-header {
    display: grid;
    gap: 15px;
    max-width: var(--measure-prose);
    margin: 0 auto 30px;
    padding-bottom: 24px;
    border-bottom: 2px solid var(--color-primary);
  }

  .article-title {
    margin: 0;
    color: var(--color-primary);
    font-size: var(--text-2xl);
    font-weight: 700;
    line-height: 1.35;
    letter-spacing: -0.025em;
    word-break: auto-phrase;
  }

  /*
   * 本文上の目次は狭幅でのみ出す。1024px 以上では Navigation の
   * .current-trace が同じ役割を担うため、二重に置かない。
   */
  .article-structure {
    max-width: var(--measure-prose);
    margin: 0 auto 24px;
    padding: 0 0 14px;
    border-bottom: 1px solid var(--color-border);
  }

  @media (min-width: 1024px) {
    .article-structure {
      display: none;
    }
  }

  .article-structure summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 40px;
    color: var(--color-primary);
    font-size: var(--text-sm);
    font-weight: 700;
    cursor: pointer;
    list-style: none;
  }

  .article-structure summary small {
    margin-left: 8px;
    color: var(--color-text-muted);
    font-size: 11px;
    font-weight: 400;
  }

  .article-structure summary::-webkit-details-marker {
    display: none;
  }
  .article-structure[open] summary :global(svg) {
    transform: rotate(180deg);
  }

  .article-structure ol {
    display: grid;
    gap: 6px;
    margin: 8px 0 0;
    padding: 0;
    list-style: none;
  }

  .article-structure li.is-h3 {
    padding-left: 18px;
  }
  .article-structure a {
    color: var(--color-text-sub);
    font-size: var(--text-sm);
    text-decoration: none;
  }
  .article-structure a:hover {
    color: var(--color-interaction-text);
    text-decoration: underline;
  }

  .draft-placeholder {
    /* 高さと猫の大きさは目視で詰める前提の暫定値。ここ2つだけ触れば調整できる */
    --wip-area-height: min(46vh, 420px);
    --wip-cat-width: 11rem;

    display: grid;
    place-items: center;
    gap: 20px;
    max-width: var(--measure-prose);
    min-height: var(--wip-area-height);
    margin: 40px auto;
    padding: 24px 16px;
  }

  .draft-mark {
    width: var(--wip-cat-width);
    height: auto;
    opacity: 0.8;
  }

  .draft-note {
    max-width: 28ch;
    margin: 0;
    color: var(--color-text-sub);
    line-height: 1.9;
    text-align: center;
  }

  .article-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: var(--measure-prose);
    margin: 48px auto 0;
    padding-top: 18px;
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    border-top: 1px solid var(--color-border);
  }

  .article-footer a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    color: var(--color-text-sub);
    border: 1px solid var(--color-border);
    text-decoration: none;
  }
</style>

<style is:global>
  .prose h2,
  .prose h3 {
    scroll-margin-top: 24px;
  }
</style>

<script>
  document.querySelectorAll("[data-structure-link]").forEach((link) => {
    link.addEventListener("click", () => {
      const details = link.closest("details");
      if (
        details instanceof HTMLDetailsElement &&
        matchMedia("(max-width: 639px)").matches
      )
        details.open = false;
    });
  });
</script>
