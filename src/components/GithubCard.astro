---
import { Icon } from "astro-icon/components";

type Props = { url: string };
const { url } = Astro.props;

const match = url.match(/^https:\/\/github\.com\/([^/]+)\/([^/#?]+)/);
const fullName = match ? `${match[1]}/${match[2]}` : url.replace(/^https?:\/\//, "");
let repoInfo: { full_name: string; description?: string | null; language?: string | null; stargazers_count?: number | null } = {
  full_name: fullName,
};

if (match) {
  const token = import.meta.env.GITHUB_REPO_METADATA_TOKEN;
  try {
    const response = await fetch(`https://api.github.com/repos/${match[1]}/${match[2]}`, {
      headers: token ? { Authorization: `Bearer ${token}` } : undefined,
    });
    if (response.ok) repoInfo = await response.json();
  } catch {
    // Repository metadata is enhancement; the GitHub link remains useful offline.
  }
}

const stars = typeof repoInfo.stargazers_count === "number" ? repoInfo.stargazers_count : null;
const language = typeof repoInfo.language === "string" ? repoInfo.language : null;
const formatCompactNumber = (value: number) =>
  new Intl.NumberFormat("en", { notation: "compact" }).format(value);
---

<a href={url} target="_blank" rel="noopener noreferrer" class="github-reference" aria-label={`${repoInfo.full_name}をGitHubで開く`}>
  <Icon name="octicon:mark-github-16" aria-hidden="true" />
  <span class="github-copy">
    <strong>{repoInfo.full_name}</strong>
    {repoInfo.description && <span>{repoInfo.description}</span>}
  </span>
  {(language || stars !== null) && (
    <span class="github-meta machine">
      {language}{language && stars !== null && " · "}{stars !== null && `★ ${formatCompactNumber(stars)}`}
    </span>
  )}
</a>

<style>
  .github-reference {
    display: grid;
    grid-template-columns: 18px minmax(0, 1fr) auto;
    align-items: start;
    gap: 8px;
    padding: 10px 0;
    color: var(--color-text-sub);
    text-decoration: none;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .github-reference:hover,
  .github-reference:focus-visible { color: var(--color-interaction-text); }
  .github-copy { display: grid; min-width: 0; gap: 2px; }
  .github-copy strong { color: var(--color-interaction-text); font-size: var(--text-sm); }
  .github-copy > span { overflow: hidden; color: var(--color-text-muted); font-size: var(--text-xs); text-overflow: ellipsis; white-space: nowrap; }
  .github-meta { color: var(--color-text-muted); font-size: 11px; }
</style>
