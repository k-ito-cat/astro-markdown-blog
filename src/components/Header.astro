---
import { Icon } from "astro-icon/components";

const pathname = Astro.url.pathname;
const navItems = [
  {
    href: "/",
    label: "時系列順に見る",
    icon: "octicon:pencil-16",
    current: pathname === "/",
  },
  {
    href: "/blog",
    label: "索引から引く",
    icon: "octicon:list-unordered-16",
    current: pathname.startsWith("/blog"),
  },
  {
    href: "/#works",
    label: "制作物",
    icon: "octicon:repo-16",
    current: false,
  },
];
---

<header class="site-header">
  <div class="desktop-edge">
    <a
      href="/"
      class="edge-mark"
      aria-label="ホーム"
      aria-current={pathname === "/" ? "page" : undefined}
    >
      <Icon name="octicon:home-16" aria-hidden="true" />
    </a>
    <nav class="edge-nav" aria-label="サイト内ナビゲーション">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class="edge-link"
            aria-current={item.current ? "page" : undefined}
          >
            <Icon name={item.icon} aria-hidden="true" />
            <span>{item.label}</span>
          </a>
        ))
      }
      {
        import.meta.env.DEV && (
          <a href="/preview/posts" class="edge-link">
            <Icon name="octicon:eye-16" aria-hidden="true" />
            <span>プレビュー</span>
          </a>
        )
      }
      <button class="edge-link" type="button" data-paper-toggle>
        <Icon name="octicon:file-16" aria-hidden="true" />
        <span data-paper-label>まぶしさを抑える</span>
      </button>
    </nav>
  </div>

  <div class="mobile-bar" data-chrome-drag>
    <span class="chrome-pull" aria-hidden="true"></span>
    <a
      href="/"
      class="mobile-home"
      aria-label="ホーム"
      aria-current={pathname === "/" ? "page" : undefined}
    >
      <Icon name="octicon:home-16" aria-hidden="true" />
    </a>
    <details class="mobile-menu" data-mobile-menu>
      <summary aria-label="サイト内ナビゲーション" data-mobile-menu-summary>
        <span class="menu-bars" aria-hidden="true">
          <span class="menu-bar"></span>
          <span class="menu-bar"></span>
          <span class="menu-bar"></span>
        </span>
      </summary>
      <nav aria-label="モバイルナビゲーション" data-mobile-menu-panel>
        {
          navItems.map((item) => (
            <a
              href={item.href}
              aria-current={item.current ? "page" : undefined}
            >
              <Icon name={item.icon} aria-hidden="true" />
              <span>{item.label}</span>
            </a>
          ))
        }
        {
          import.meta.env.DEV && (
            <a href="/preview/posts">
              <Icon name="octicon:eye-16" aria-hidden="true" />
              <span>プレビュー</span>
            </a>
          )
        }
        <button type="button" data-paper-toggle>
          <Icon name="octicon:file-16" aria-hidden="true" />
          <span data-paper-label>まぶしさを抑える</span>
        </button>
      </nav>
    </details>
  </div>
  <button
    class="chrome-handle"
    type="button"
    aria-label="ヘッダーを表示"
    data-chrome-drag
    data-chrome-handle
  >
    <span class="chrome-handle-pill" aria-hidden="true">
      <span class="chrome-grabber"></span>
    </span>
  </button>
  <span class="menu-scrim" aria-hidden="true"></span>
</header>

<style>
  .site-header {
    position: fixed;
    inset-block-start: 0;
    inset-inline: 0;
    z-index: 30;
  }

  .desktop-edge {
    display: none;
  }

  /*
   * バーは掴んで動かす面なので、指の操作に選択やコピーの UI が割り込まない
   * ようにする。ここに読ませたい文章はなく、取れて困るのは操作の手応えだけ。
   * 960px 以上ではバーも取っ手も出ないため、実質は指で触る幅にだけ効く。
   */
  .mobile-bar,
  .chrome-handle {
    -webkit-touch-callout: none;
    user-select: none;
  }

  /*
   * 下へ引くと画面上端とバーの間が空く。地の色が覗くとバーだけが浮いて見え、
   * 引いた手応えが「めくれ」に見えてしまうので、伸びしろの分だけ同じ紙を
   * バーの真上に足しておく。バーと一緒に動くので、常に隙間へ付いてくる。
   */
  .mobile-bar::before {
    position: absolute;
    inset-inline: 0;
    inset-block-end: 100%;
    height: var(--chrome-rubber-max, 0px);
    content: "";
    background: var(--color-background);
  }

  /*
   * 引き切るまでの残りを、空いた余白の中に示す。出るのは下へ引いている間だけ。
   * 満ちたら色を変えて、ここで離せば巻き取ることを先に伝える。
   */
  .chrome-pull {
    position: absolute;
    inset-inline: 16px;
    inset-block-end: 100%;
    height: 2px;
    margin-block-end: 8px;
    opacity: 0;
    transition: opacity var(--duration-feedback) ease;
  }

  :global(html[data-chrome-pulling]) .chrome-pull {
    opacity: 1;
  }

  .chrome-pull::after {
    display: block;
    width: calc(var(--chrome-pull-progress, 0) * 100%);
    height: 100%;
    content: "";
    background: var(--color-border-strong);
    border-radius: 999px;
  }

  :global(html[data-chrome-pull-ready]) .chrome-pull::after {
    background: var(--color-secondary);
  }

  .mobile-bar {
    position: relative;
    z-index: 30;
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 52px;
    padding: 0 16px;
    background: var(--color-background);
    border-bottom: 1px solid var(--color-border);
    transition: transform var(--duration-feedback) var(--ease-trace);
  }

  /*
   * 掴める面であることを形だけで示す。文言も方向の記号も置かない。
   * 罫線から離してバーの内側に置く。罫線に重ねると継ぎ目の記号に見えて、
   * 下に並ぶ目次バーまで掴めるように読めてしまう。掴める面はヘッダ全体なので、
   * 印もその内側に収める
   */
  .mobile-bar::after {
    position: absolute;
    inset-block-end: 8px;
    inset-inline-start: 50%;
    width: 36px;
    height: 3px;
    content: "";
    background: var(--color-border-strong);
    border-radius: 999px;
    opacity: 1;
    transform: translateX(-50%);
    transition:
      opacity var(--duration-feedback) ease,
      transform 220ms cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  /*
   * メニューや目次を開いている間は、その真上に線が残っても読みづらいので消す。
   * メニューは閉じ始めた時点で戻す（スクリムの出し入れと歩調を揃える）
   */
  .site-header:has(.mobile-menu[open]:not([data-closing])) .mobile-bar::after,
  :global(html:has(.article-structure[data-stuck][open])) .mobile-bar::after {
    opacity: 0;
  }

  @media (min-width: 960px) {
    .mobile-bar::after {
      content: none;
    }
  }

  /*
   * 指で上へ引いて退避させる。--chrome-drag-y は引いている最中の移動量で、
   * 離すと 0（表示）か --chrome-hidden-shift（退避）に落ち着く。
   * transform は .site-header ではなくバーに掛ける。header 側に transform が
   * 乗ると、中の position: fixed な .menu-scrim の基準が header になり全画面を
   * 覆えなくなる。退避中の header は中身が画面外にあるだけで箱は残るため、
   * 上端 52px がタップを吸わないよう pointer-events を切る
   */
  @media (max-width: 959px) {
    .mobile-bar {
      /* バーの高さちょうどだと下端の罫線が y=0 に着地し、端数の丸めで
         髪の毛一本分残ることがある。1px 余分に送って確実に画面外へ出す */
      --chrome-hidden-shift: -53px;
      --chrome-shift: 0px;

      touch-action: none;
      transform: translateY(
        clamp(
          var(--chrome-hidden-shift),
          calc(var(--chrome-shift) + var(--chrome-drag-y, 0px)),
          var(--chrome-rubber-max, 0px)
        )
      );
    }

    :global(html[data-chrome-hidden]) .mobile-bar {
      --chrome-shift: var(--chrome-hidden-shift);
    }

    :global(html[data-chrome-hidden]) .site-header {
      pointer-events: none;
    }

    :global(html[data-chrome-dragging]) .mobile-bar,
    :global(html[data-chrome-dragging]) .chrome-handle {
      transition: none;
    }
  }

  /*
   * 退避すると出てくる取っ手。タップでも下へのドラッグでも戻せる。
   * 上端に貼り付けると iOS の画面端スワイプ（通知/コントロールセンター）と
   * 取り合いになるため 12px 浮かせる。バー(z-index 30)より奥に置いて、
   * 戻ってくるバーに覆われるようにする。ボタン自身は取っ手より下へ広げて
   * 指の当たりを稼ぐ
   */
  .chrome-handle {
    position: fixed;
    inset-block-start: 12px;
    inset-inline-start: 50%;
    z-index: 29;
    display: grid;
    align-items: start;
    justify-items: center;
    width: 72px;
    height: 44px;
    padding: 0;
    background: none;
    border: 0;
    cursor: pointer;
    visibility: hidden;
    touch-action: none;
    transform: translate(-50%, calc(-100% - 13px));
    transition:
      transform 220ms cubic-bezier(0.34, 1.56, 0.64, 1),
      visibility 220ms;
  }

  /*
   * 面も枠も持たせず、線だけを浮かせる。ただし本文や画像の上では線が埋もれる
   * ので、線の周りの背景だけをぼかして手前と奥を分ける。
   * ぼかす範囲は線を包むカプセル形にして、角が立たないようにする
   */
  .chrome-handle-pill {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 22px;
    border-radius: 999px;
    -webkit-backdrop-filter: blur(10px) saturate(140%);
    backdrop-filter: blur(10px) saturate(140%);
  }

  /* バー下端のグラバーと同じ線。退避しても同じものだと形で分かるようにする */
  .chrome-grabber {
    width: 36px;
    height: 3px;
    background: var(--color-border-strong);
    border-radius: 999px;
    transition: transform 220ms cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  /*
   * 指を置いた時点で線を膨らませる。掴めたことをその場で返すためのもので、
   * 当たり判定は変わらない。data-chrome-dragging は 6px 動くまで付かないので、
   * 触った瞬間を表す印は別に持つ
   */
  :global(html[data-chrome-pressed]) .mobile-bar::after {
    transform: translateX(-50%) scale(1.2, 1.6);
  }

  :global(html[data-chrome-pressed]) .chrome-grabber {
    transform: scale(1.2, 1.6);
  }

  @media (max-width: 959px) {
    :global(html[data-chrome-hidden]) .chrome-handle {
      pointer-events: auto;
      visibility: visible;
      transform: translate(-50%, 0);
    }
  }

  @media (min-width: 960px) {
    .chrome-handle {
      display: none;
    }
  }

  .mobile-home,
  .mobile-menu summary {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    color: var(--color-primary);
  }

  /* 2枚のアイコンを同じセルに重ね、絶対配置に頼らず中央へ揃える */
  .mobile-menu summary {
    display: grid;
    grid-template-areas: "menu-icon";
    place-items: center;
  }

  .mobile-home {
    text-decoration: none;
  }

  .mobile-home svg {
    width: 18px;
    height: 18px;
  }

  .mobile-home[aria-current="page"]::after {
    content: "";
    position: absolute;
    right: 12px;
    bottom: 2px;
    left: 12px;
    height: 2px;
    background: var(--color-secondary);
  }

  .mobile-home:hover,
  .mobile-home:focus-visible,
  .mobile-menu summary:hover,
  .mobile-menu summary:focus-visible,
  .mobile-menu[open] summary {
    color: var(--color-secondary);
  }

  .mobile-menu summary {
    cursor: pointer;
    list-style: none;
  }

  .mobile-menu summary::-webkit-details-marker {
    display: none;
  }

  /*
   * 三本線と × は同じ線の変形として見せる。別々のアイコンを重ねて
   * 入れ替えると形が繋がらず、切り替わりが唐突に見える。
   * 開くも閉じるも同じ transition を逆にたどるので、往復の動きが揃う。
   */
  .menu-bars {
    grid-area: menu-icon;
    position: relative;
    width: 18px;
    height: 14px;
  }

  .menu-bar {
    /* 吸収と傾きの二段で動かす。開閉にかかる時間はこの倍になる */
    --menu-bar-step: 120ms;

    position: absolute;
    left: 0;
    width: 100%;
    height: 2px;
    background: currentcolor;
    border-radius: 1px;
    translate: 0 0;
    rotate: 0deg;
    /*
     * 閉じるときは開くときの逆順をたどる。まず傾きが戻って三本に揃い、
     * そのあと上下の線が元の位置へ離れていく。
     * 位置と角度を別々に遅らせたいので、transform ではなく translate と
     * rotate を個別のプロパティとして動かす。
     */
    transition:
      rotate var(--menu-bar-step) var(--ease-trace),
      opacity var(--menu-bar-step) ease,
      translate var(--menu-bar-step) var(--ease-trace) var(--menu-bar-step);
  }

  .menu-bar:nth-child(1) {
    top: 0;
  }

  .menu-bar:nth-child(2) {
    top: 6px;
  }

  .menu-bar:nth-child(3) {
    top: 12px;
  }

  /*
   * 開くときは、上下の線が中央へ吸い込まれて三本が重なり、
   * そこから互いに反対へ傾いて × になる。真ん中の線は傾きに合わせて消す。
   */
  .mobile-menu[open]:not([data-closing]) .menu-bar {
    transition:
      translate var(--menu-bar-step) var(--ease-trace),
      rotate var(--menu-bar-step) var(--ease-trace) var(--menu-bar-step),
      opacity var(--menu-bar-step) ease var(--menu-bar-step);
  }

  .mobile-menu[open]:not([data-closing]) .menu-bar:nth-child(1) {
    translate: 0 6px;
    rotate: 45deg;
  }

  .mobile-menu[open]:not([data-closing]) .menu-bar:nth-child(2) {
    opacity: 0;
  }

  .mobile-menu[open]:not([data-closing]) .menu-bar:nth-child(3) {
    translate: 0 -6px;
    rotate: -45deg;
  }

  .mobile-menu nav {
    position: absolute;
    inset: 52px 0 auto;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 4px 20px;
    padding: 20px 16px 24px;
    opacity: 1;
    background: var(--color-background);
    transform: translateY(0);
    transition:
      opacity var(--duration-feedback) ease,
      transform var(--duration-feedback) var(--ease-trace);
  }

  .mobile-menu[open]:not([data-closing]) nav {
    animation: mobile-menu-surface-in var(--duration-feedback) ease both;
  }

  .mobile-menu[data-closing] nav {
    pointer-events: none;
    opacity: 0;
    transform: translateY(-8px);
  }

  .mobile-menu nav::before {
    content: "";
    position: absolute;
    top: 0;
    right: 16px;
    width: 44px;
    height: 2px;
    background: var(--color-primary);
  }

  .mobile-menu[open]:not([data-closing]) nav::before {
    animation: mobile-menu-line-in var(--duration-feedback) var(--ease-trace)
      both;
  }

  .mobile-menu nav::after {
    content: "";
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 2px;
    background: var(--color-primary);
    transform-origin: left;
  }

  .mobile-menu[open]:not([data-closing]) nav::after {
    animation: mobile-menu-rule-in var(--duration-feedback) var(--ease-trace)
      both;
  }

  .mobile-menu[data-closing] nav::before {
    width: 0;
    transition: width var(--duration-feedback) var(--ease-trace);
  }

  .mobile-menu[data-closing] nav::after {
    transform: scaleX(0);
    transition: transform var(--duration-feedback) var(--ease-trace);
  }

  /*
   * 展開中は本文にスクリムを敷き、メニューを手前に立たせる。
   * 画面いっぱいの面を一様に暗くすると、明るさが一度に変わって目が痛い。
   * パネルが上から降りるのに続けて、上端から下へ広げる。閉じるときは
   * 同じ経路を上へ畳む。パネルより少し長くかけ、追って広がるようにする。
   *
   * 伸ばすのは clip-path ではなく scaleY。切り抜きを動かすと画面いっぱいの
   * 塗り直しが毎フレーム走り、端末によってはあからさまに引っかかる。
   * 単色の面なので、拡大しても見た目は切り抜きと変わらない。
   */
  .menu-scrim {
    position: fixed;
    z-index: 25;
    inset: 0;
    pointer-events: none;
    background: rgb(0 0 0 / 40%);
    transform: scaleY(0);
    transform-origin: top;
    transition: transform var(--duration-state) var(--ease-trace);
  }

  .site-header:has(.mobile-menu[open]:not([data-closing])) .menu-scrim {
    pointer-events: auto;
    transform: scaleY(1);
  }

  .mobile-menu nav :is(a, button) {
    position: relative;
    background: none;
    border: 0;
    cursor: pointer;
    text-align: start;
    display: grid;
    grid-template-columns: 18px minmax(0, 1fr);
    align-items: center;
    gap: 10px;
    min-height: 52px;
    padding: 10px 8px;
    color: var(--color-text-sub);
    font-size: var(--text-sm);
    text-decoration: none;
  }

  .mobile-menu nav :is(a, button):last-child:nth-child(odd) {
    grid-column: 1 / -1;
  }

  .mobile-menu nav :is(a, button) svg {
    color: var(--color-secondary);
  }

  .mobile-menu nav :is(a, button):hover,
  .mobile-menu nav :is(a, button):focus-visible {
    color: var(--color-interaction-text);
  }

  .mobile-menu nav a[aria-current="page"] {
    color: var(--color-primary);
    font-weight: 600;
  }

  @keyframes mobile-menu-surface-in {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes mobile-menu-line-in {
    from {
      width: 0;
    }

    to {
      width: 44px;
    }
  }

  @keyframes mobile-menu-rule-in {
    from {
      transform: scaleX(0);
    }

    to {
      transform: scaleX(1);
    }
  }

  @media (min-width: 960px) {
    .site-header {
      position: static;
    }

    .mobile-bar,
    .menu-scrim {
      display: none;
    }

    .desktop-edge {
      position: fixed;
      inset: 0 auto 0 0;
      z-index: 40;
      display: flex;
      flex-direction: column;
      width: 48px;
      overflow: hidden;
      background: var(--color-background);
      border-right: 2px solid var(--color-primary);
      transition: width var(--duration-state) var(--ease-trace);
    }

    .desktop-edge:hover,
    .desktop-edge:focus-within {
      width: 196px;
    }

    .edge-mark {
      display: flex;
      align-items: center;
      gap: 14px;
      min-height: 64px;
      padding: 0 16px;
      color: var(--color-primary);
      font-weight: 700;
      white-space: nowrap;
      text-decoration: none;
      border-bottom: 1px solid var(--color-border);
    }

    .edge-mark > svg {
      flex: 0 0 16px;
      color: var(--color-secondary);
    }

    .edge-nav {
      display: grid;
      margin-top: 18px;
    }

    .edge-link {
      position: relative;
      background: none;
      border: 0;
      cursor: pointer;
      text-align: start;
      display: grid;
      grid-template-columns: 16px 1fr;
      align-items: center;
      gap: 14px;
      min-height: 44px;
      padding: 0 16px;
      color: var(--color-text-sub);
      font-size: var(--text-sm);
      white-space: nowrap;
      text-decoration: none;
    }

    .edge-link::after {
      content: "";
      position: absolute;
      right: 0;
      bottom: 5px;
      width: 0;
      height: 1px;
      background: var(--color-secondary);
      transition: width var(--duration-feedback) var(--ease-trace);
    }

    .edge-link:hover,
    .edge-link:focus-visible,
    .edge-link[aria-current="page"] {
      color: var(--color-primary);
    }

    .edge-link:hover::after,
    .edge-link:focus-visible::after,
    .edge-link[aria-current="page"]::after {
      width: calc(100% - 48px);
    }
  }

  @media (forced-colors: active) {
    .menu-scrim {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mobile-bar,
    .mobile-bar::after,
    .chrome-pull,
    .chrome-handle,
    .chrome-grabber,
    .menu-bar,
    .mobile-menu nav,
    .mobile-menu nav::before,
    .mobile-menu nav::after,
    .menu-scrim {
      animation: none !important;
      transition: none !important;
    }
  }
</style>

<style is:global>
  @media (max-width: 959px) {
    body {
      padding-top: 52px;
    }

    /*
     * ヘッダーを下へ引いたときに伸びる量の上限。ヘッダーと一緒に動くもの
     * （目次、プレビューの編集バー）が同じ値を見られるよう html に置く。
     * 退避中の下引きは戻す操作なので、そのときは伸びしろを持たせない。
     */
    :root {
      --chrome-rubber-max: 48px;
    }

    :root[data-chrome-hidden] {
      --chrome-rubber-max: 0px;
    }
  }
</style>

<script>
  const mobileMenu =
    document.querySelector<HTMLDetailsElement>("[data-mobile-menu]");
  const mobileMenuSummary = mobileMenu?.querySelector<HTMLElement>(
    "[data-mobile-menu-summary]",
  );
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  /*
   * 閉じ切るまで open を外さない。線は傾きを戻してから離れる二段の動きなので、
   * 片方だけの時間で外すと途中で消える（CSS の --menu-bar-step の倍）
   */
  const closeDuration = 240;
  const closeScrollDistance = 72;

  if (mobileMenu && mobileMenuSummary) {
    let closeTimer = 0;
    let openedAtScrollY = window.scrollY;
    let scrollUpdateQueued = false;

    const finishClosing = () => {
      window.clearTimeout(closeTimer);
      mobileMenu.open = false;
      delete mobileMenu.dataset.closing;
    };

    const closeMobileMenu = () => {
      if (!mobileMenu.open || mobileMenu.dataset.closing !== undefined) return;

      if (reducedMotion.matches) {
        finishClosing();
        return;
      }

      mobileMenu.dataset.closing = "";
      closeTimer = window.setTimeout(finishClosing, closeDuration);
    };

    mobileMenuSummary.addEventListener("click", (event) => {
      if (!mobileMenu.open) return;
      event.preventDefault();
      closeMobileMenu();
    });

    mobileMenu.addEventListener("toggle", () => {
      if (!mobileMenu.open) return;
      openedAtScrollY = window.scrollY;
    });

    document.addEventListener("click", (event) => {
      if (!mobileMenu.open) return;
      const target = event.target;
      if (target instanceof Node && !mobileMenu.contains(target)) {
        closeMobileMenu();
      }
    });

    window.addEventListener(
      "scroll",
      () => {
        if (!mobileMenu.open || scrollUpdateQueued) return;
        scrollUpdateQueued = true;

        requestAnimationFrame(() => {
          if (
            Math.abs(window.scrollY - openedAtScrollY) >= closeScrollDistance
          ) {
            closeMobileMenu();
          }
          scrollUpdateQueued = false;
        });
      },
      { passive: true },
    );
  }

  /*
   * 上部バーの出し入れ。自動では動かさない。バーを指で上へ引くとヘッダーと
   * 追従中の目次がまとめて退避し、上端に出る取っ手をタップするか下へ引くと戻る。
   * 引いている最中の移動量は --chrome-drag-y に流し、位置は CSS 側で clamp する
   */
  const root = document.documentElement;
  const siteHeader = document.querySelector<HTMLElement>(".site-header");
  const chromeHandle = document.querySelector<HTMLElement>(
    "[data-chrome-handle]",
  );
  const compactViewport = matchMedia("(max-width: 959px)");
  // 確定に必要な移動量と、タップと見なす許容量
  const commitDistance = 24;
  const tapSlop = 6;
  /*
   * 表示中に下へ引いたときは、引いた分がそのまま付いてくると「降りる」操作に
   * 見えてしまう。抵抗をかけて伸びを抑え、引き切って離したところで上へ巻き取る。
   * 退避中の下引きは戻す操作なので、抵抗はかけず指の動きどおりに追わせる。
   */
  const rubberMax = 48;
  const pullCommitDistance = 56;
  /*
   * 伸びは漸近させる。引くほど鈍り、確定に必要な量まで引いたところで上限の
   * 八割ほどに達してそれ以上は動かない。進み具合の線が満ちるのと、指が感じる
   * 「引き切った」ところを揃えるための値
   */
  const rubberSoftness = 35;

  let dragPointerId = -1;
  let dragStartY = 0;
  let dragDistance = 0;
  let suppressNextClick = false;

  const isChromeHidden = () => root.dataset.chromeHidden !== undefined;

  const setChromeHidden = (hidden: boolean) => {
    if (hidden) {
      root.dataset.chromeHidden = "";
      return;
    }
    delete root.dataset.chromeHidden;
  };

  const endDrag = () => {
    dragPointerId = -1;
    delete root.dataset.chromePressed;
    delete root.dataset.chromeDragging;
    delete root.dataset.chromePulling;
    root.removeAttribute("data-chrome-pull-ready");
    root.style.removeProperty("--chrome-drag-y");
    root.style.removeProperty("--chrome-pull-progress");
  };

  document.addEventListener("pointerdown", (event) => {
    suppressNextClick = false;

    if (dragPointerId !== -1 || !compactViewport.matches || mobileMenu?.open) {
      return;
    }

    const target = event.target instanceof Element ? event.target : null;
    const origin = target?.closest("[data-chrome-drag]") ?? null;
    if (!origin) return;

    dragPointerId = event.pointerId;
    dragStartY = event.clientY;
    dragDistance = 0;

    /*
     * 掴み自体はバーのどこからでも始められるが、手応えは操作子の上では返さない。
     * ホームやメニューを押しただけで線が動くと、何に反応したのか読めなくなる。
     * 取っ手自身はボタンでありながら掴み面そのものなので、対象から外さない
     */
    const control = target?.closest("a, button, summary");
    if (!control || control === origin) {
      root.dataset.chromePressed = "";
    }
  });

  document.addEventListener(
    "pointermove",
    (event) => {
      if (event.pointerId !== dragPointerId) return;

      dragDistance = event.clientY - dragStartY;
      if (Math.abs(dragDistance) < tapSlop) return;

      const pulling = dragDistance > 0 && !isChromeHidden();
      const offset = pulling
        ? rubberMax * (1 - Math.exp(-dragDistance / rubberSoftness))
        : dragDistance;

      root.dataset.chromeDragging = "";
      root.style.setProperty("--chrome-drag-y", `${offset}px`);

      if (pulling) {
        const progress = Math.min(1, dragDistance / pullCommitDistance);
        root.dataset.chromePulling = "";
        root.style.setProperty("--chrome-pull-progress", `${progress}`);
        root.toggleAttribute("data-chrome-pull-ready", progress >= 1);
      } else {
        delete root.dataset.chromePulling;
        root.removeAttribute("data-chrome-pull-ready");
      }
    },
    { passive: true },
  );

  const finishDrag = (event: PointerEvent) => {
    if (event.pointerId !== dragPointerId) return;

    /*
     * 引き切ったかどうかだけで決める。届かなければ元の位置へ戻す。
     * 表示中は上へ送っても下へ引き切っても退避させる。下は伸びに抵抗がある分、
     * 手が動く距離は長くなるので、確定に必要な量も上より大きく取る
     */
    if (isChromeHidden()) {
      if (dragDistance > commitDistance) setChromeHidden(false);
    } else if (
      dragDistance < -commitDistance ||
      dragDistance > pullCommitDistance
    ) {
      setChromeHidden(true);
    }

    // 引いた後の指離しでリンクやメニューが反応しないようにする
    suppressNextClick = Math.abs(dragDistance) > tapSlop;
    endDrag();
  };

  document.addEventListener("pointerup", finishDrag);
  document.addEventListener("pointercancel", (event) => {
    if (event.pointerId !== dragPointerId) return;
    endDrag();
  });

  document.addEventListener(
    "click",
    (event) => {
      if (!suppressNextClick) return;
      suppressNextClick = false;
      event.preventDefault();
      event.stopPropagation();
    },
    true,
  );

  chromeHandle?.addEventListener("click", () => {
    setChromeHidden(false);
  });

  // 退避中にキーボードで入ってきた場合、見えない位置に焦点を残さない
  siteHeader?.addEventListener("focusin", (event) => {
    if (event.target === chromeHandle) return;
    setChromeHidden(false);
  });

  /*
   * 紙の入れ替え。設計上は紙を替えているが、紙の呼び名は一般に通らないので、
   * 表に出す言葉は起きること（まぶしさ／明るさ）で書く。初期値は head の
   * インラインスクリプトが決めており、ここでは選び直しと保存だけを担う。
   * label は押した結果を先に言う
   */
  const paperActions = {
    white: "明るさを戻す",
    dim: "まぶしさを抑える",
  };
  const themeColor = document.querySelector("[data-theme-color]");
  const paperToggles = document.querySelectorAll<HTMLElement>(
    "[data-paper-toggle]",
  );
  const paperLabels =
    document.querySelectorAll<HTMLElement>("[data-paper-label]");

  const nextPaper = () => (root.dataset.paper === "dim" ? "white" : "dim");

  const syncPaperLabels = () => {
    const label = paperActions[nextPaper()];
    paperLabels.forEach((node) => {
      node.textContent = label;
    });
  };

  paperToggles.forEach((toggle) => {
    toggle.addEventListener("click", () => {
      const paper = nextPaper();
      root.dataset.paper = paper;
      themeColor?.setAttribute(
        "content",
        paper === "dim" ? "#efe8d9" : "#ffffff",
      );
      try {
        localStorage.setItem("paper", paper);
      } catch {
        // 保存できない環境では、その場の選択だけ効かせる
      }
      syncPaperLabels();
    });
  });

  syncPaperLabels();
</script>
