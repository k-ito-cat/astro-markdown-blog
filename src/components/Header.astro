---
import ThemeSwitcher from "./ThemeSwitcher.astro";

const siteName = "のーと";
---

<header class="site-header">
  <div class="site-header-inner">
    <a href="/" class="site-name">{siteName}</a>
    <nav class="site-nav" aria-label="サイト内ナビゲーション">
      {
        import.meta.env.DEV && (
          <a href="/preview/posts" class="site-nav-link">
            Preview
          </a>
        )
      }
      <a href="/blog" class="site-nav-link">Blog</a>
      <ThemeSwitcher />
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--border);
    background: var(--bg-base);
  }

  .site-header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    width: 100%;
    max-width: var(--max-width-content);
    margin: 0 auto;
    padding: 12px 16px;
  }

  .site-name {
    font-size: 16px;
    font-weight: 600;
    color: var(--text-primary);
    text-decoration: none;
    letter-spacing: 0.01em;
  }

  .site-name:hover {
    color: var(--text-primary);
    text-decoration: none;
  }

  .site-nav {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .site-nav-link {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    text-decoration: none;
    transition: color 140ms ease-out;
  }

  .site-nav-link:hover {
    color: var(--text-primary);
  }

  @media (min-width: 640px) {
    .site-header-inner {
      padding: 14px 24px;
    }
  }
</style>
