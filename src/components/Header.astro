---
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import reachingPaw from "~/assets/reaching-paw.png";

const pathname = Astro.url.pathname;
const navItems = [
  {
    href: "/",
    label: "記録",
    icon: "octicon:pencil-16",
    current: pathname === "/",
  },
  {
    href: "/blog",
    label: "索引",
    icon: "octicon:list-unordered-16",
    current: pathname.startsWith("/blog"),
  },
  {
    href: "/blog#fields",
    label: "分野",
    icon: "octicon:hash-16",
    current: false,
  },
  {
    href: "/#works",
    label: "制作物",
    icon: "octicon:repo-16",
    current: false,
  },
];
const mobileNavItems = navItems.filter((item) => item.href !== "/");
---

<header class="site-header">
  <div class="desktop-edge">
    <a
      href="/"
      class="edge-mark"
      aria-label="ホーム"
      aria-current={pathname === "/" ? "page" : undefined}
    >
      <Icon name="octicon:home-16" aria-hidden="true" />
    </a>
    <nav class="edge-nav" aria-label="サイト内ナビゲーション">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class="edge-link"
            aria-current={item.current ? "page" : undefined}
          >
            <Icon name={item.icon} aria-hidden="true" />
            <span>{item.label}</span>
          </a>
        ))
      }
      {
        import.meta.env.DEV && (
          <a href="/preview/posts" class="edge-link">
            <Icon name="octicon:eye-16" aria-hidden="true" />
            <span>プレビュー</span>
          </a>
        )
      }
    </nav>
  </div>

  <div class="mobile-bar">
    <a
      href="/"
      class="mobile-home"
      aria-label="ホーム"
      aria-current={pathname === "/" ? "page" : undefined}
    >
      <Icon name="octicon:home-16" aria-hidden="true" />
    </a>
    <details class="mobile-menu" data-mobile-menu>
      <summary aria-label="サイト内ナビゲーション" data-mobile-menu-summary>
        <span class="menu-open-icon" aria-hidden="true">
          <Icon name="octicon:three-bars-16" />
        </span>
        <span class="menu-close-icon" aria-hidden="true">
          <Icon name="octicon:x-16" />
        </span>
      </summary>
      <nav aria-label="モバイルナビゲーション" data-mobile-menu-panel>
        {
          mobileNavItems.map((item) => (
            <a
              href={item.href}
              aria-current={item.current ? "page" : undefined}
            >
              <Icon name={item.icon} aria-hidden="true" />
              <span>{item.label}</span>
            </a>
          ))
        }
        {
          import.meta.env.DEV && (
            <a href="/preview/posts">
              <Icon name="octicon:eye-16" aria-hidden="true" />
              <span>プレビュー</span>
            </a>
          )
        }
      </nav>
    </details>
  </div>
  <span class="menu-scrim" aria-hidden="true"></span>

  {
    (["right", "left"] as const).map((side) => (
      <div class="edge-dock" data-edge-dock data-dock-side={side}>
        <button
          type="button"
          class="edge-dock-tab"
          data-edge-dock-tab
          aria-expanded="false"
          aria-controls={`edge-dock-nav-${side}`}
          aria-label={`サイト内ナビゲーション（${side === "right" ? "右下" : "左下"}）`}
        >
          <Image
            class="edge-dock-paw"
            src={reachingPaw}
            alt=""
            widths={[56, 112, 200, 400]}
            sizes="(min-width: 960px) 200px, 56px"
            loading="eager"
          />
        </button>
        <nav
          id={`edge-dock-nav-${side}`}
          class="edge-dock-panel"
          aria-label={`追従ナビゲーション（${side === "right" ? "右下" : "左下"}）`}
        >
          {navItems.map((item) => (
            <a
              href={item.href}
              aria-current={item.current ? "page" : undefined}
            >
              <Icon name={item.icon} aria-hidden="true" />
              <span>{item.label}</span>
            </a>
          ))}
          {import.meta.env.DEV && (
            <a href="/preview/posts">
              <Icon name="octicon:eye-16" aria-hidden="true" />
              <span>プレビュー</span>
            </a>
          )}
        </nav>
      </div>
    ))
  }
</header>

<style>
  .desktop-edge {
    display: none;
  }

  .mobile-bar {
    position: relative;
    z-index: 30;
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 52px;
    padding: 0 16px;
    background: var(--color-background);
    border-bottom: 1px solid var(--color-border);
  }

  .mobile-home,
  .mobile-menu summary {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    color: var(--color-primary);
  }

  /* 2枚のアイコンを同じセルに重ね、絶対配置に頼らず中央へ揃える */
  .mobile-menu summary {
    display: grid;
    grid-template-areas: "menu-icon";
    place-items: center;
  }

  .mobile-home {
    text-decoration: none;
  }

  .mobile-home svg,
  .mobile-menu summary svg {
    width: 18px;
    height: 18px;
  }

  .mobile-home[aria-current="page"]::after {
    content: "";
    position: absolute;
    right: 12px;
    bottom: 2px;
    left: 12px;
    height: 2px;
    background: var(--color-secondary);
  }

  .mobile-home:hover,
  .mobile-home:focus-visible,
  .mobile-menu summary:hover,
  .mobile-menu summary:focus-visible,
  .mobile-menu[open] summary {
    color: var(--color-secondary);
  }

  .mobile-menu summary {
    cursor: pointer;
    list-style: none;
  }

  .mobile-menu summary::-webkit-details-marker {
    display: none;
  }

  .menu-open-icon,
  .menu-close-icon {
    grid-area: menu-icon;
    display: inline-flex;
    opacity: 1;
    transition: opacity var(--duration-feedback) ease;
  }

  .menu-close-icon {
    opacity: 0;
  }

  .mobile-menu[open]:not([data-closing]) .menu-open-icon {
    opacity: 0;
  }

  .mobile-menu[open]:not([data-closing]) .menu-close-icon {
    opacity: 1;
  }

  .mobile-menu nav {
    position: absolute;
    inset: 52px 0 auto;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 4px 20px;
    padding: 20px 16px 24px;
    opacity: 1;
    background: var(--color-background);
    transition: opacity var(--duration-feedback) ease;
  }

  .mobile-menu[open]:not([data-closing]) nav {
    animation: mobile-menu-surface-in var(--duration-feedback) ease both;
  }

  .mobile-menu[data-closing] nav {
    pointer-events: none;
    opacity: 0;
  }

  .mobile-menu nav::before {
    content: "";
    position: absolute;
    top: 0;
    right: 16px;
    width: 44px;
    height: 2px;
    background: var(--color-primary);
  }

  .mobile-menu[open]:not([data-closing]) nav::before {
    animation: mobile-menu-line-in var(--duration-feedback) var(--ease-trace)
      both;
  }

  .mobile-menu nav::after {
    content: "";
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 2px;
    background: var(--color-primary);
    transform-origin: left;
  }

  .mobile-menu[open]:not([data-closing]) nav::after {
    animation: mobile-menu-rule-in var(--duration-feedback) var(--ease-trace)
      both;
  }

  .mobile-menu[data-closing] nav::before {
    width: 0;
    transition: width var(--duration-feedback) var(--ease-trace);
  }

  .mobile-menu[data-closing] nav::after {
    transform: scaleX(0);
    transition: transform var(--duration-feedback) var(--ease-trace);
  }

  /* 展開中は本文にスクリムを敷き、メニューを手前に立たせる */
  .menu-scrim {
    position: fixed;
    z-index: 25;
    inset: 0;
    pointer-events: none;
    opacity: 0;
    background: rgb(0 0 0 / 50%);
    transition: opacity var(--duration-feedback) ease;
  }

  .site-header:has(.mobile-menu[open]:not([data-closing])) .menu-scrim {
    pointer-events: auto;
    opacity: 1;
  }

  .mobile-menu nav a {
    position: relative;
    display: grid;
    grid-template-columns: 18px minmax(0, 1fr);
    align-items: center;
    gap: 10px;
    min-height: 52px;
    padding: 10px 8px;
    color: var(--color-text-sub);
    font-size: var(--text-sm);
    text-decoration: none;
  }

  .mobile-menu nav a:last-child:nth-child(odd) {
    grid-column: 1 / -1;
  }

  .mobile-menu nav a svg {
    color: var(--color-secondary);
  }

  .mobile-menu nav a::before {
    content: "";
    position: absolute;
    top: 12px;
    bottom: 12px;
    left: 0;
    width: 2px;
    background: transparent;
  }

  .mobile-menu nav a:hover,
  .mobile-menu nav a:focus-visible {
    color: var(--color-interaction-text);
  }

  .mobile-menu nav a[aria-current="page"] {
    color: var(--color-primary);
    font-weight: 600;
  }

  .mobile-menu nav a[aria-current="page"]::before {
    background: var(--color-primary);
  }

  @keyframes mobile-menu-surface-in {
    from {
      opacity: 0;
    }

    to {
      opacity: 1;
    }
  }

  @keyframes mobile-menu-line-in {
    from {
      width: 0;
    }

    to {
      width: 44px;
    }
  }

  @keyframes mobile-menu-rule-in {
    from {
      transform: scaleX(0);
    }

    to {
      transform: scaleX(1);
    }
  }

  @media (min-width: 960px) {
    .mobile-bar,
    .menu-scrim {
      display: none;
    }

    .edge-dock {
      --dock-tab-width: 200px;
      --dock-tab-height: 195px;
      --dock-paw-shift: 88px;
      --dock-paw-hover-shift: 42px;
    }

    .desktop-edge {
      position: fixed;
      inset: 0 auto 0 0;
      z-index: 40;
      display: flex;
      flex-direction: column;
      width: 48px;
      overflow: hidden;
      background: var(--color-background);
      border-right: 2px solid var(--color-primary);
      transition: width var(--duration-state) var(--ease-trace);
    }

    .desktop-edge:hover,
    .desktop-edge:focus-within {
      width: 196px;
    }

    .edge-mark {
      display: flex;
      align-items: center;
      gap: 14px;
      min-height: 64px;
      padding: 0 16px;
      color: var(--color-primary);
      font-weight: 700;
      white-space: nowrap;
      text-decoration: none;
      border-bottom: 1px solid var(--color-border);
    }

    .edge-mark > svg {
      flex: 0 0 16px;
      color: var(--color-secondary);
    }

    .edge-nav {
      display: grid;
      margin-top: 18px;
    }

    .edge-link {
      position: relative;
      display: grid;
      grid-template-columns: 16px 1fr;
      align-items: center;
      gap: 14px;
      min-height: 44px;
      padding: 0 16px;
      color: var(--color-text-sub);
      font-size: var(--text-sm);
      white-space: nowrap;
      text-decoration: none;
    }

    .edge-link::after {
      content: "";
      position: absolute;
      right: 0;
      bottom: 5px;
      width: 0;
      height: 1px;
      background: var(--color-secondary);
      transition: width var(--duration-feedback) var(--ease-trace);
    }

    .edge-link:hover,
    .edge-link:focus-visible,
    .edge-link[aria-current="page"] {
      color: var(--color-primary);
    }

    .edge-link:hover::after,
    .edge-link:focus-visible::after,
    .edge-link[aria-current="page"]::after {
      width: calc(100% - 48px);
    }
  }

  /* スクロール中に画面の下隅から出る追従タブと、そこから開くドロワー */
  .edge-dock {
    /* 右下は 1、左下は -1。向き・位置・反転をこの符号だけで切り替える */
    --dock-dir: 1;
    --dock-tab-width: 56px;
    --dock-tab-height: 55px;
    --dock-paw-shift: 25px;
    --dock-paw-hover-shift: 12px;

    display: contents;
  }

  .edge-dock[data-dock-side="left"] {
    --dock-dir: -1;
  }

  .edge-dock-tab,
  .edge-dock-panel {
    position: fixed;
    z-index: 26;
    bottom: 0;
    visibility: hidden;
    opacity: 0;
    transition:
      translate var(--duration-state) var(--ease-trace),
      opacity var(--duration-feedback) ease,
      visibility 0s linear var(--duration-state);
  }

  .edge-dock[data-dock-side="right"] :is(.edge-dock-tab, .edge-dock-panel) {
    right: 0;
  }

  .edge-dock[data-dock-side="left"] :is(.edge-dock-tab, .edge-dock-panel) {
    left: 0;
  }

  .edge-dock.is-ready .edge-dock-tab,
  .edge-dock.is-open .edge-dock-panel {
    visibility: visible;
    opacity: 1;
    translate: 0 0;
    transition:
      translate var(--duration-state) var(--ease-trace),
      opacity var(--duration-feedback) ease,
      visibility 0s;
  }

  /* ドロワーが開いている間は手を画面外へ引っ込め、閉じたらまた出す */
  .edge-dock.is-open .edge-dock-tab {
    visibility: hidden;
    opacity: 0;
    translate: calc(100% * var(--dock-dir)) 100%;
    transition:
      translate var(--duration-state) var(--ease-trace),
      opacity var(--duration-feedback) ease,
      visibility 0s linear var(--duration-state);
  }

  /* 猫の手そのものがタブ。下隅の外から斜めに覗かせる */
  .edge-dock-tab {
    display: block;
    width: var(--dock-tab-width);
    height: var(--dock-tab-height);
    padding: 0;
    overflow: visible;
    cursor: pointer;
    background: none;
    border: 0;
    translate: calc(100% * var(--dock-dir)) 100%;
  }

  .edge-dock-paw {
    display: block;
    width: 100%;
    height: auto;
    translate: calc(var(--dock-paw-shift) * var(--dock-dir));
    rotate: calc(-10deg * var(--dock-dir));
    transform: scaleX(calc(var(--dock-dir) * -1));
    transition: translate var(--duration-feedback) var(--ease-trace);
  }

  /* 触れると手をもう少しだけ伸ばす */
  .edge-dock-tab:hover .edge-dock-paw,
  .edge-dock-tab:focus-visible .edge-dock-paw {
    translate: calc(var(--dock-paw-hover-shift) * var(--dock-dir));
  }

  .edge-dock-panel {
    display: grid;
    width: 180px;
    padding: 8px;
    background: var(--color-background);
    box-shadow: 0 0 12px rgb(0 0 0 / 8%);
    translate: calc(100% * var(--dock-dir)) 0;
  }

  .edge-dock-panel a {
    display: grid;
    grid-template-columns: 18px minmax(0, 1fr);
    align-items: center;
    gap: 10px;
    min-height: 48px;
    padding: 8px 10px;
    color: var(--color-text-sub);
    font-size: var(--text-sm);
    text-decoration: none;
    border-radius: 6px;
  }

  .edge-dock-panel a svg {
    color: var(--color-secondary);
  }

  .edge-dock-panel a:hover,
  .edge-dock-panel a:focus-visible {
    color: var(--color-interaction-text);
    background: var(--bg-hover);
  }

  .edge-dock-panel a[aria-current="page"] {
    color: var(--color-primary);
    font-weight: 600;
  }

  @media (forced-colors: active) {
    .menu-scrim {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .menu-open-icon,
    .menu-close-icon,
    .mobile-menu nav,
    .mobile-menu nav::before,
    .mobile-menu nav::after,
    .menu-scrim,
    .edge-dock-tab,
    .edge-dock-panel,
    .edge-dock-paw {
      animation: none !important;
      transition: none !important;
    }
  }
</style>

<script>
  const mobileMenu =
    document.querySelector<HTMLDetailsElement>("[data-mobile-menu]");
  const mobileMenuSummary = mobileMenu?.querySelector<HTMLElement>(
    "[data-mobile-menu-summary]",
  );
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  const closeDuration = 160;
  const closeScrollDistance = 72;
  const edgeDocks = Array.from(
    document.querySelectorAll<HTMLElement>("[data-edge-dock]"),
  );
  const mobileBar = document.querySelector<HTMLElement>(".mobile-bar");
  const dockRevealOffset = 120;

  if (mobileMenu && mobileMenuSummary) {
    let closeTimer = 0;
    let openedAtScrollY = window.scrollY;
    let scrollUpdateQueued = false;

    const finishClosing = () => {
      window.clearTimeout(closeTimer);
      mobileMenu.open = false;
      delete mobileMenu.dataset.closing;
    };

    const closeMobileMenu = () => {
      if (!mobileMenu.open || mobileMenu.dataset.closing !== undefined) return;

      if (reducedMotion.matches) {
        finishClosing();
        return;
      }

      mobileMenu.dataset.closing = "";
      closeTimer = window.setTimeout(finishClosing, closeDuration);
    };

    mobileMenuSummary.addEventListener("click", (event) => {
      if (!mobileMenu.open) return;
      event.preventDefault();
      closeMobileMenu();
    });

    mobileMenu.addEventListener("toggle", () => {
      if (!mobileMenu.open) return;
      openedAtScrollY = window.scrollY;
    });

    document.addEventListener("click", (event) => {
      if (!mobileMenu.open) return;
      const target = event.target;
      if (target instanceof Node && !mobileMenu.contains(target)) {
        closeMobileMenu();
      }
    });

    window.addEventListener(
      "scroll",
      () => {
        if (!mobileMenu.open || scrollUpdateQueued) return;
        scrollUpdateQueued = true;

        requestAnimationFrame(() => {
          if (
            Math.abs(window.scrollY - openedAtScrollY) >= closeScrollDistance
          ) {
            closeMobileMenu();
          }
          scrollUpdateQueued = false;
        });
      },
      { passive: true },
    );
  }

  if (edgeDocks.length > 0) {
    let dockOpenedAtScrollY = window.scrollY;
    let dockScrollUpdateQueued = false;

    const closeEdgeDocks = () => {
      edgeDocks.forEach((dock) => {
        if (!dock.classList.contains("is-open")) return;
        dock.classList.remove("is-open");
        dock
          .querySelector("[data-edge-dock-tab]")
          ?.setAttribute("aria-expanded", "false");
      });
    };

    // ヘッダーが画面外へ出て、さらに dockRevealOffset ぶん進んだら出す
    // （PC ではヘッダーバーが非表示なので高さ 0 として扱う）
    const syncEdgeDockReady = () => {
      const ready =
        window.scrollY > (mobileBar?.offsetHeight ?? 0) + dockRevealOffset;
      edgeDocks.forEach((dock) => dock.classList.toggle("is-ready", ready));
      if (!ready) closeEdgeDocks();
    };

    edgeDocks.forEach((dock) => {
      const tab = dock.querySelector<HTMLButtonElement>("[data-edge-dock-tab]");
      if (!tab) return;

      // 開くとパネルがタブを覆うため、タブは開く操作だけを担う
      tab.addEventListener("click", () => {
        if (dock.classList.contains("is-open")) return;
        closeEdgeDocks();
        dock.classList.add("is-open");
        tab.setAttribute("aria-expanded", "true");
        dockOpenedAtScrollY = window.scrollY;
      });
    });

    document.addEventListener("click", (event) => {
      const target = event.target;
      if (!(target instanceof Node)) return;
      if (edgeDocks.some((dock) => dock.contains(target))) return;
      closeEdgeDocks();
    });

    document.addEventListener("keydown", (event) => {
      if (event.key !== "Escape") return;
      const openDock = edgeDocks.find((dock) =>
        dock.classList.contains("is-open"),
      );
      if (!openDock) return;
      closeEdgeDocks();
      openDock
        .querySelector<HTMLButtonElement>("[data-edge-dock-tab]")
        ?.focus();
    });

    window.addEventListener(
      "scroll",
      () => {
        if (dockScrollUpdateQueued) return;
        dockScrollUpdateQueued = true;

        requestAnimationFrame(() => {
          syncEdgeDockReady();
          if (
            edgeDocks.some((dock) => dock.classList.contains("is-open")) &&
            Math.abs(window.scrollY - dockOpenedAtScrollY) >=
              closeScrollDistance
          ) {
            closeEdgeDocks();
          }
          dockScrollUpdateQueued = false;
        });
      },
      { passive: true },
    );

    syncEdgeDockReady();
  }
</script>
