---
import ThemeSwitcher from "./ThemeSwitcher.astro";
---

<header class="site-header">
  <div class="site-header-inner">
    <a href="/" class="site-logo" aria-label="Note ホーム">
      <span class="site-logo-mark" aria-hidden="true">¶</span>
      <span class="site-logo-name">Note</span>
    </a>
    <nav class="site-nav" aria-label="サイト内ナビゲーション">
      {
        import.meta.env.DEV && (
          <a href="/preview/posts" class="site-nav-link">
            preview
          </a>
        )
      }
      <a href="/blog" class="site-nav-link">blog</a>
      <ThemeSwitcher />
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--border);
    background: var(--bg-base);
  }

  .site-header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    width: 100%;
    max-width: var(--max-width-content);
    margin: 0 auto;
    padding: 12px 16px;
  }

  .site-logo {
    display: inline-flex;
    align-items: baseline;
    gap: 7px;
    text-decoration: none;
  }

  .site-logo-mark {
    font-size: 15px;
    line-height: 1;
    color: var(--accent-warm);
  }

  .site-logo-name {
    font-size: 16px;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--text-primary);
  }

  .site-nav {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .site-nav-link {
    font-size: 13px;
    letter-spacing: 0.02em;
    color: var(--text-secondary);
    text-decoration: none;
    transition: color 140ms ease-out;
  }

  .site-nav-link:hover {
    color: var(--text-primary);
  }

  @media (min-width: 640px) {
    .site-header-inner {
      padding: 14px 24px;
    }
  }
</style>
