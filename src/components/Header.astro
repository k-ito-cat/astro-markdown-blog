---
import { Icon } from "astro-icon/components";

const pathname = Astro.url.pathname;
const navItems = [
  {
    href: "/",
    label: "時系列順に見る",
    icon: "octicon:pencil-16",
    current: pathname === "/",
  },
  {
    href: "/blog",
    label: "索引から引く",
    icon: "octicon:list-unordered-16",
    current: pathname.startsWith("/blog"),
  },
  {
    href: "/#works",
    label: "制作物",
    icon: "octicon:repo-16",
    current: false,
  },
];
---

<header class="site-header">
  <div class="desktop-edge">
    <a
      href="/"
      class="edge-mark"
      aria-label="ホーム"
      aria-current={pathname === "/" ? "page" : undefined}
    >
      <Icon name="octicon:home-16" aria-hidden="true" />
    </a>
    <nav class="edge-nav" aria-label="サイト内ナビゲーション">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class="edge-link"
            aria-current={item.current ? "page" : undefined}
          >
            <Icon name={item.icon} aria-hidden="true" />
            <span>{item.label}</span>
          </a>
        ))
      }
      {
        import.meta.env.DEV && (
          <a href="/preview/posts" class="edge-link">
            <Icon name="octicon:eye-16" aria-hidden="true" />
            <span>プレビュー</span>
          </a>
        )
      }
    </nav>
  </div>

  <div class="mobile-bar" data-chrome-drag>
    <a
      href="/"
      class="mobile-home"
      aria-label="ホーム"
      aria-current={pathname === "/" ? "page" : undefined}
    >
      <Icon name="octicon:home-16" aria-hidden="true" />
    </a>
    <details class="mobile-menu" data-mobile-menu>
      <summary aria-label="サイト内ナビゲーション" data-mobile-menu-summary>
        <span class="menu-open-icon" aria-hidden="true">
          <Icon name="octicon:three-bars-16" />
        </span>
        <span class="menu-close-icon" aria-hidden="true">
          <Icon name="octicon:x-16" />
        </span>
      </summary>
      <nav aria-label="モバイルナビゲーション" data-mobile-menu-panel>
        {
          navItems.map((item) => (
            <a
              href={item.href}
              aria-current={item.current ? "page" : undefined}
            >
              <Icon name={item.icon} aria-hidden="true" />
              <span>{item.label}</span>
            </a>
          ))
        }
        {
          import.meta.env.DEV && (
            <a href="/preview/posts">
              <Icon name="octicon:eye-16" aria-hidden="true" />
              <span>プレビュー</span>
            </a>
          )
        }
      </nav>
    </details>
  </div>
  <button
    class="chrome-handle"
    type="button"
    aria-label="ヘッダーを表示"
    data-chrome-drag
    data-chrome-handle
  >
    <span class="chrome-handle-pill" aria-hidden="true">
      <span class="chrome-grabber"></span>
    </span>
  </button>
  <span class="menu-scrim" aria-hidden="true"></span>
</header>

<style>
  .site-header {
    position: fixed;
    inset-block-start: 0;
    inset-inline: 0;
    z-index: 30;
  }

  .desktop-edge {
    display: none;
  }

  .mobile-bar {
    position: relative;
    z-index: 30;
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 52px;
    padding: 0 16px;
    background: var(--color-background);
    border-bottom: 1px solid var(--color-border);
    transition: transform var(--duration-feedback) var(--ease-trace);
  }

  /*
   * 掴める面であることを形だけで示す。文言も方向の記号も置かない。
   * 下端の罫線にまたがせて、線が中央だけ太くなったように見せる
   */
  .mobile-bar::after {
    position: absolute;
    inset-block-end: -2px;
    inset-inline-start: 50%;
    width: 36px;
    height: 3px;
    content: "";
    background: var(--color-border-strong);
    border-radius: 999px;
    opacity: 1;
    transform: translateX(-50%);
    transition: opacity var(--duration-feedback) ease;
  }

  /*
   * メニューや目次を開いている間は、その真上に線が残っても読みづらいので消す。
   * メニューは閉じ始めた時点で戻す（スクリムの出し入れと歩調を揃える）
   */
  .site-header:has(.mobile-menu[open]:not([data-closing])) .mobile-bar::after,
  :global(html:has(.article-structure[data-stuck][open])) .mobile-bar::after {
    opacity: 0;
  }

  @media (min-width: 960px) {
    .mobile-bar::after {
      content: none;
    }
  }

  /*
   * 指で上へ引いて退避させる。--chrome-drag-y は引いている最中の移動量で、
   * 離すと 0（表示）か --chrome-hidden-shift（退避）に落ち着く。
   * transform は .site-header ではなくバーに掛ける。header 側に transform が
   * 乗ると、中の position: fixed な .menu-scrim の基準が header になり全画面を
   * 覆えなくなる。退避中の header は中身が画面外にあるだけで箱は残るため、
   * 上端 52px がタップを吸わないよう pointer-events を切る
   */
  @media (max-width: 959px) {
    .mobile-bar {
      --chrome-hidden-shift: -52px;
      --chrome-shift: 0px;

      touch-action: none;
      transform: translateY(
        clamp(
          var(--chrome-hidden-shift),
          calc(var(--chrome-shift) + var(--chrome-drag-y, 0px)),
          0px
        )
      );
    }

    :global(html[data-chrome-hidden]) .mobile-bar {
      --chrome-shift: var(--chrome-hidden-shift);
    }

    :global(html[data-chrome-hidden]) .site-header {
      pointer-events: none;
    }

    :global(html[data-chrome-dragging]) .mobile-bar,
    :global(html[data-chrome-dragging]) .chrome-handle {
      transition: none;
    }
  }

  /*
   * 退避すると出てくる取っ手。タップでも下へのドラッグでも戻せる。
   * 上端に貼り付けると iOS の画面端スワイプ（通知/コントロールセンター）と
   * 取り合いになるため 12px 浮かせる。バー(z-index 30)より奥に置いて、
   * 戻ってくるバーに覆われるようにする。ボタン自身は取っ手より下へ広げて
   * 指の当たりを稼ぐ
   */
  .chrome-handle {
    position: fixed;
    inset-block-start: 12px;
    inset-inline-start: 50%;
    z-index: 29;
    display: grid;
    align-items: start;
    justify-items: center;
    width: 72px;
    height: 44px;
    padding: 0;
    background: none;
    border: 0;
    cursor: pointer;
    visibility: hidden;
    touch-action: none;
    transform: translate(-50%, calc(-100% - 12px));
    transition:
      transform 220ms cubic-bezier(0.34, 1.56, 0.64, 1),
      visibility 220ms;
  }

  /*
   * 面も枠も持たせず、線だけを浮かせる。ただし本文や画像の上では線が埋もれる
   * ので、線の周りの背景だけをぼかして手前と奥を分ける
   */
  .chrome-handle-pill {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 22px;
    border-radius: var(--radius-card);
    -webkit-backdrop-filter: blur(10px) saturate(140%);
    backdrop-filter: blur(10px) saturate(140%);
  }

  /* バー下端のグラバーと同じ線。退避しても同じものだと形で分かるようにする */
  .chrome-grabber {
    width: 36px;
    height: 3px;
    background: var(--color-border-strong);
    border-radius: 999px;
  }

  @media (max-width: 959px) {
    :global(html[data-chrome-hidden]) .chrome-handle {
      pointer-events: auto;
      visibility: visible;
      transform: translate(-50%, 0);
    }
  }

  @media (min-width: 960px) {
    .chrome-handle {
      display: none;
    }
  }

  .mobile-home,
  .mobile-menu summary {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    color: var(--color-primary);
  }

  /* 2枚のアイコンを同じセルに重ね、絶対配置に頼らず中央へ揃える */
  .mobile-menu summary {
    display: grid;
    grid-template-areas: "menu-icon";
    place-items: center;
  }

  .mobile-home {
    text-decoration: none;
  }

  .mobile-home svg,
  .mobile-menu summary svg {
    width: 18px;
    height: 18px;
  }

  .mobile-home[aria-current="page"]::after {
    content: "";
    position: absolute;
    right: 12px;
    bottom: 2px;
    left: 12px;
    height: 2px;
    background: var(--color-secondary);
  }

  .mobile-home:hover,
  .mobile-home:focus-visible,
  .mobile-menu summary:hover,
  .mobile-menu summary:focus-visible,
  .mobile-menu[open] summary {
    color: var(--color-secondary);
  }

  .mobile-menu summary {
    cursor: pointer;
    list-style: none;
  }

  .mobile-menu summary::-webkit-details-marker {
    display: none;
  }

  .menu-open-icon,
  .menu-close-icon {
    grid-area: menu-icon;
    display: inline-flex;
    opacity: 1;
    transition: opacity var(--duration-feedback) ease;
  }

  .menu-close-icon {
    opacity: 0;
  }

  .mobile-menu[open]:not([data-closing]) .menu-open-icon {
    opacity: 0;
  }

  .mobile-menu[open]:not([data-closing]) .menu-close-icon {
    opacity: 1;
  }

  .mobile-menu nav {
    position: absolute;
    inset: 52px 0 auto;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 4px 20px;
    padding: 20px 16px 24px;
    opacity: 1;
    background: var(--color-background);
    transition: opacity var(--duration-feedback) ease;
  }

  .mobile-menu[open]:not([data-closing]) nav {
    animation: mobile-menu-surface-in var(--duration-feedback) ease both;
  }

  .mobile-menu[data-closing] nav {
    pointer-events: none;
    opacity: 0;
  }

  .mobile-menu nav::before {
    content: "";
    position: absolute;
    top: 0;
    right: 16px;
    width: 44px;
    height: 2px;
    background: var(--color-primary);
  }

  .mobile-menu[open]:not([data-closing]) nav::before {
    animation: mobile-menu-line-in var(--duration-feedback) var(--ease-trace)
      both;
  }

  .mobile-menu nav::after {
    content: "";
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 2px;
    background: var(--color-primary);
    transform-origin: left;
  }

  .mobile-menu[open]:not([data-closing]) nav::after {
    animation: mobile-menu-rule-in var(--duration-feedback) var(--ease-trace)
      both;
  }

  .mobile-menu[data-closing] nav::before {
    width: 0;
    transition: width var(--duration-feedback) var(--ease-trace);
  }

  .mobile-menu[data-closing] nav::after {
    transform: scaleX(0);
    transition: transform var(--duration-feedback) var(--ease-trace);
  }

  /* 展開中は本文にスクリムを敷き、メニューを手前に立たせる */
  .menu-scrim {
    position: fixed;
    z-index: 25;
    inset: 0;
    pointer-events: none;
    opacity: 0;
    background: rgb(0 0 0 / 50%);
    transition: opacity var(--duration-feedback) ease;
  }

  .site-header:has(.mobile-menu[open]:not([data-closing])) .menu-scrim {
    pointer-events: auto;
    opacity: 1;
  }

  .mobile-menu nav a {
    position: relative;
    display: grid;
    grid-template-columns: 18px minmax(0, 1fr);
    align-items: center;
    gap: 10px;
    min-height: 52px;
    padding: 10px 8px;
    color: var(--color-text-sub);
    font-size: var(--text-sm);
    text-decoration: none;
  }

  .mobile-menu nav a:last-child:nth-child(odd) {
    grid-column: 1 / -1;
  }

  .mobile-menu nav a svg {
    color: var(--color-secondary);
  }

  .mobile-menu nav a:hover,
  .mobile-menu nav a:focus-visible {
    color: var(--color-interaction-text);
  }

  .mobile-menu nav a[aria-current="page"] {
    color: var(--color-primary);
    font-weight: 600;
  }

  @keyframes mobile-menu-surface-in {
    from {
      opacity: 0;
    }

    to {
      opacity: 1;
    }
  }

  @keyframes mobile-menu-line-in {
    from {
      width: 0;
    }

    to {
      width: 44px;
    }
  }

  @keyframes mobile-menu-rule-in {
    from {
      transform: scaleX(0);
    }

    to {
      transform: scaleX(1);
    }
  }

  @media (min-width: 960px) {
    .site-header {
      position: static;
    }

    .mobile-bar,
    .menu-scrim {
      display: none;
    }

    .desktop-edge {
      position: fixed;
      inset: 0 auto 0 0;
      z-index: 40;
      display: flex;
      flex-direction: column;
      width: 48px;
      overflow: hidden;
      background: var(--color-background);
      border-right: 2px solid var(--color-primary);
      transition: width var(--duration-state) var(--ease-trace);
    }

    .desktop-edge:hover,
    .desktop-edge:focus-within {
      width: 196px;
    }

    .edge-mark {
      display: flex;
      align-items: center;
      gap: 14px;
      min-height: 64px;
      padding: 0 16px;
      color: var(--color-primary);
      font-weight: 700;
      white-space: nowrap;
      text-decoration: none;
      border-bottom: 1px solid var(--color-border);
    }

    .edge-mark > svg {
      flex: 0 0 16px;
      color: var(--color-secondary);
    }

    .edge-nav {
      display: grid;
      margin-top: 18px;
    }

    .edge-link {
      position: relative;
      display: grid;
      grid-template-columns: 16px 1fr;
      align-items: center;
      gap: 14px;
      min-height: 44px;
      padding: 0 16px;
      color: var(--color-text-sub);
      font-size: var(--text-sm);
      white-space: nowrap;
      text-decoration: none;
    }

    .edge-link::after {
      content: "";
      position: absolute;
      right: 0;
      bottom: 5px;
      width: 0;
      height: 1px;
      background: var(--color-secondary);
      transition: width var(--duration-feedback) var(--ease-trace);
    }

    .edge-link:hover,
    .edge-link:focus-visible,
    .edge-link[aria-current="page"] {
      color: var(--color-primary);
    }

    .edge-link:hover::after,
    .edge-link:focus-visible::after,
    .edge-link[aria-current="page"]::after {
      width: calc(100% - 48px);
    }
  }

  @media (forced-colors: active) {
    .menu-scrim {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mobile-bar,
    .chrome-handle,
    .menu-open-icon,
    .menu-close-icon,
    .mobile-menu nav,
    .mobile-menu nav::before,
    .mobile-menu nav::after,
    .menu-scrim {
      animation: none !important;
      transition: none !important;
    }
  }
</style>

<style is:global>
  @media (max-width: 959px) {
    body {
      padding-top: 52px;
    }
  }
</style>

<script>
  const mobileMenu =
    document.querySelector<HTMLDetailsElement>("[data-mobile-menu]");
  const mobileMenuSummary = mobileMenu?.querySelector<HTMLElement>(
    "[data-mobile-menu-summary]",
  );
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  const closeDuration = 160;
  const closeScrollDistance = 72;

  if (mobileMenu && mobileMenuSummary) {
    let closeTimer = 0;
    let openedAtScrollY = window.scrollY;
    let scrollUpdateQueued = false;

    const finishClosing = () => {
      window.clearTimeout(closeTimer);
      mobileMenu.open = false;
      delete mobileMenu.dataset.closing;
    };

    const closeMobileMenu = () => {
      if (!mobileMenu.open || mobileMenu.dataset.closing !== undefined) return;

      if (reducedMotion.matches) {
        finishClosing();
        return;
      }

      mobileMenu.dataset.closing = "";
      closeTimer = window.setTimeout(finishClosing, closeDuration);
    };

    mobileMenuSummary.addEventListener("click", (event) => {
      if (!mobileMenu.open) return;
      event.preventDefault();
      closeMobileMenu();
    });

    mobileMenu.addEventListener("toggle", () => {
      if (!mobileMenu.open) return;
      openedAtScrollY = window.scrollY;
    });

    document.addEventListener("click", (event) => {
      if (!mobileMenu.open) return;
      const target = event.target;
      if (target instanceof Node && !mobileMenu.contains(target)) {
        closeMobileMenu();
      }
    });

    window.addEventListener(
      "scroll",
      () => {
        if (!mobileMenu.open || scrollUpdateQueued) return;
        scrollUpdateQueued = true;

        requestAnimationFrame(() => {
          if (
            Math.abs(window.scrollY - openedAtScrollY) >= closeScrollDistance
          ) {
            closeMobileMenu();
          }
          scrollUpdateQueued = false;
        });
      },
      { passive: true },
    );
  }

  /*
   * 上部バーの出し入れ。自動では動かさない。バーを指で上へ引くとヘッダーと
   * 追従中の目次がまとめて退避し、上端に出る取っ手をタップするか下へ引くと戻る。
   * 引いている最中の移動量は --chrome-drag-y に流し、位置は CSS 側で clamp する
   */
  const root = document.documentElement;
  const siteHeader = document.querySelector<HTMLElement>(".site-header");
  const chromeHandle = document.querySelector<HTMLElement>(
    "[data-chrome-handle]",
  );
  const compactViewport = matchMedia("(max-width: 959px)");
  // 確定に必要な移動量と、タップと見なす許容量
  const commitDistance = 24;
  const tapSlop = 6;

  let dragPointerId = -1;
  let dragStartY = 0;
  let dragDistance = 0;
  let suppressNextClick = false;

  const isChromeHidden = () => root.dataset.chromeHidden !== undefined;

  const setChromeHidden = (hidden: boolean) => {
    if (hidden) {
      root.dataset.chromeHidden = "";
      return;
    }
    delete root.dataset.chromeHidden;
  };

  const endDrag = () => {
    dragPointerId = -1;
    delete root.dataset.chromeDragging;
    root.style.removeProperty("--chrome-drag-y");
  };

  document.addEventListener("pointerdown", (event) => {
    suppressNextClick = false;

    if (dragPointerId !== -1 || !compactViewport.matches || mobileMenu?.open) {
      return;
    }

    const origin =
      event.target instanceof Element
        ? event.target.closest("[data-chrome-drag]")
        : null;
    if (!origin) return;

    dragPointerId = event.pointerId;
    dragStartY = event.clientY;
    dragDistance = 0;
  });

  document.addEventListener(
    "pointermove",
    (event) => {
      if (event.pointerId !== dragPointerId) return;

      dragDistance = event.clientY - dragStartY;
      if (Math.abs(dragDistance) < tapSlop) return;

      root.dataset.chromeDragging = "";
      root.style.setProperty("--chrome-drag-y", `${dragDistance}px`);
    },
    { passive: true },
  );

  const finishDrag = (event: PointerEvent) => {
    if (event.pointerId !== dragPointerId) return;

    // 引き切ったかどうかだけで決める。届かなければ元の位置へ戻す
    if (isChromeHidden()) {
      if (dragDistance > commitDistance) setChromeHidden(false);
    } else if (dragDistance < -commitDistance) {
      setChromeHidden(true);
    }

    // 引いた後の指離しでリンクやメニューが反応しないようにする
    suppressNextClick = Math.abs(dragDistance) > tapSlop;
    endDrag();
  };

  document.addEventListener("pointerup", finishDrag);
  document.addEventListener("pointercancel", (event) => {
    if (event.pointerId !== dragPointerId) return;
    endDrag();
  });

  document.addEventListener(
    "click",
    (event) => {
      if (!suppressNextClick) return;
      suppressNextClick = false;
      event.preventDefault();
      event.stopPropagation();
    },
    true,
  );

  chromeHandle?.addEventListener("click", () => {
    setChromeHidden(false);
  });

  // 退避中にキーボードで入ってきた場合、見えない位置に焦点を残さない
  siteHeader?.addEventListener("focusin", (event) => {
    if (event.target === chromeHandle) return;
    setChromeHidden(false);
  });
</script>
