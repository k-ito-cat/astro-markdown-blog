---
import { Icon } from "astro-icon/components";

const pathname = Astro.url.pathname;
// 記事内検索は記事ページにしか無いので、入口も記事ページのメニューだけへ置く
const isArticle = /^\/blog\/[^/]/.test(pathname);
const navItems = [
  {
    href: "/",
    label: "時系列順に見る",
    icon: "octicon:pencil-16",
    current: pathname === "/",
  },
  {
    href: "/blog",
    label: "探す",
    icon: "octicon:list-unordered-16",
    current: pathname.startsWith("/blog"),
  },
  {
    href: "/#works",
    label: "制作物",
    icon: "octicon:repo-16",
    current: false,
  },
];
---

<header class="site-header">
  <div class="desktop-edge">
    <a
      href="/"
      class="edge-mark"
      aria-label="ホーム"
      aria-current={pathname === "/" ? "page" : undefined}
    >
      <Icon name="octicon:home-16" aria-hidden="true" />
    </a>
    <nav class="edge-nav" aria-label="サイト内ナビゲーション">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class="edge-link"
            aria-current={item.current ? "page" : undefined}
          >
            <Icon name={item.icon} aria-hidden="true" />
            <span>{item.label}</span>
          </a>
        ))
      }
    </nav>
    <div class="edge-settings">
      <span class="edge-settings-mark" aria-hidden="true">
        <Icon name="octicon:gear-16" />
      </span>
      <div class="edge-toggles" role="group" aria-label="表示のカスタマイズ">
        <button
          class="edge-toggle"
          type="button"
          aria-pressed="false"
          aria-label="まぶしさを抑える"
          data-paper-toggle
        >
          <Icon name="octicon:light-bulb-16" aria-hidden="true" />
          <span class="edge-tip" aria-hidden="true">
            まぶしさを抑える
            <span class="edge-tip-state edge-tip-state--on">減光中</span>
            <span class="edge-tip-state edge-tip-state--off">標準</span>
          </span>
        </button>
        <button
          class="edge-toggle"
          type="button"
          aria-pressed="false"
          aria-label="用語の注釈を隠す"
          data-glossary-toggle
        >
          <Icon name="octicon:question-16" aria-hidden="true" />
          <span class="edge-tip" aria-hidden="true">
            用語の注釈を隠す
            <span class="edge-tip-state edge-tip-state--on">非表示中</span>
            <span class="edge-tip-state edge-tip-state--off">表示中</span>
          </span>
        </button>
        <button
          class="edge-toggle"
          type="button"
          aria-pressed="false"
          aria-label="スクロールを一瞬に"
          data-scroll-toggle
        >
          <Icon name="octicon:unfold-16" aria-hidden="true" />
          <span class="edge-tip" aria-hidden="true">
            スクロールを一瞬に
            <span class="edge-tip-state edge-tip-state--on">一瞬</span>
            <span class="edge-tip-state edge-tip-state--off">スムース</span>
          </span>
        </button>
      </div>
    </div>
  </div>

  <div class="mobile-bar" data-chrome-drag>
    <span class="chrome-pull" aria-hidden="true"></span>
    <a
      href="/"
      class="mobile-home"
      aria-label="ホーム"
      aria-current={pathname === "/" ? "page" : undefined}
    >
      <Icon name="octicon:home-16" aria-hidden="true" />
    </a>
    <div class="mobile-actions">
      {
        isArticle && (
          <button
            type="button"
            class="mobile-search"
            aria-label="記事内を検索"
            data-article-search-open
            hidden
          >
            <Icon name="octicon:search-16" aria-hidden="true" />
          </button>
        )
      }
      <details class="mobile-menu" data-mobile-menu>
        <summary aria-label="サイト内ナビゲーション" data-mobile-menu-summary>
          <span class="menu-bars" aria-hidden="true">
            <span class="menu-bar"></span>
            <span class="menu-bar"></span>
            <span class="menu-bar"></span>
          </span>
        </summary>
        <div class="menu-panel" data-mobile-menu-panel>
          <nav class="menu-group" aria-label="モバイルナビゲーション">
            {
              navItems.map((item) => (
                <a
                  href={item.href}
                  aria-current={item.current ? "page" : undefined}
                >
                  <Icon name={item.icon} aria-hidden="true" />
                  <span>{item.label}</span>
                </a>
              ))
            }
          </nav>
          <div
            class="menu-group menu-settings"
            role="group"
            aria-label="表示のカスタマイズ"
          >
            <button type="button" aria-pressed="false" data-paper-toggle>
              <Icon name="octicon:light-bulb-16" aria-hidden="true" />
              <span>まぶしさを抑える</span>
              <span class="menu-state" aria-hidden="true">
                <span class="menu-state-on">減光中</span>
                <span class="menu-state-off">標準</span>
              </span>
            </button>
            <button type="button" aria-pressed="false" data-glossary-toggle>
              <Icon name="octicon:question-16" aria-hidden="true" />
              <span>用語の注釈を隠す</span>
              <span class="menu-state" aria-hidden="true">
                <span class="menu-state-on">非表示中</span>
                <span class="menu-state-off">表示中</span>
              </span>
            </button>
            <button type="button" aria-pressed="false" data-scroll-toggle>
              <Icon name="octicon:unfold-16" aria-hidden="true" />
              <span>スクロールを一瞬に</span>
              <span class="menu-state" aria-hidden="true">
                <span class="menu-state-on">一瞬</span>
                <span class="menu-state-off">スムース</span>
              </span>
            </button>
          </div>
        </div>
      </details>
    </div>
  </div>
  <button
    class="chrome-handle"
    type="button"
    aria-label="ヘッダーを表示"
    data-chrome-drag
    data-chrome-handle
  >
    <span class="chrome-handle-pill" aria-hidden="true">
      <span class="chrome-grabber"></span>
    </span>
  </button>
  <span class="menu-scrim" aria-hidden="true"></span>
</header>

{
  /*
   * プレビューへの入口。行き先でも読み方の設定でもない、書き手の道具なので
   * ナビゲーションから出す。開発時しか出ないため、読者の画面には現れない
   */
  import.meta.env.DEV && (
    <a class="preview-dock" href="/preview/posts" aria-label="プレビュー">
      <Icon name="octicon:eye-16" aria-hidden="true" />
    </a>
  )
}

<style>
  .preview-dock {
    position: fixed;
    z-index: 40;
    /* 記事の「一覧へ戻る」は左下にいるので、こちらは右下へ置く */
    inset-block-end: 16px;
    inset-inline-end: 16px;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    color: var(--color-primary);
    background: var(--color-background);
    border: 1px solid var(--color-border-strong);
    border-radius: 50%;
    box-shadow: 0 6px 18px rgb(31 41 55 / 12%);
    transition:
      color var(--duration-feedback) ease,
      border-color var(--duration-feedback) ease;
  }

  .preview-dock:hover,
  .preview-dock:focus-visible {
    color: var(--color-secondary);
    border-color: var(--color-primary);
  }

  .preview-dock svg {
    width: 18px;
    height: 18px;
  }
</style>

<style>
  .site-header {
    position: fixed;
    inset-block-start: 0;
    inset-inline: 0;
    z-index: 30;
  }

  .desktop-edge {
    display: none;
  }

  /*
   * バーは掴んで動かす面なので、指の操作に選択やコピーの UI が割り込まない
   * ようにする。ここに読ませたい文章はなく、取れて困るのは操作の手応えだけ。
   * 960px 以上ではバーも取っ手も出ないため、実質は指で触る幅にだけ効く。
   */
  .mobile-bar,
  .chrome-handle {
    -webkit-touch-callout: none;
    user-select: none;
  }

  /*
   * 下へ引くと画面上端とバーの間が空く。地の色が覗くとバーだけが浮いて見え、
   * 引いた手応えが「めくれ」に見えてしまうので、伸びしろの分だけ同じ紙を
   * バーの真上に足しておく。バーと一緒に動くので、常に隙間へ付いてくる。
   */
  .mobile-bar::before {
    position: absolute;
    inset-inline: 0;
    inset-block-end: 100%;
    height: var(--chrome-rubber-max, 0px);
    content: "";
    background: var(--color-background);
  }

  /*
   * 引き切るまでの残りを、空いた余白の中に示す。出るのは下へ引いている間だけ。
   * 満ちたら色を変えて、ここで離せば巻き取ることを先に伝える。
   */
  .chrome-pull {
    position: absolute;
    inset-inline: 16px;
    inset-block-end: 100%;
    height: 2px;
    margin-block-end: 8px;
    opacity: 0;
    transition: opacity var(--duration-feedback) ease;
  }

  :global(html[data-chrome-pulling]) .chrome-pull {
    opacity: 1;
  }

  .chrome-pull::after {
    display: block;
    width: calc(var(--chrome-pull-progress, 0) * 100%);
    height: 100%;
    content: "";
    background: var(--color-border-strong);
    border-radius: 999px;
  }

  :global(html[data-chrome-pull-ready]) .chrome-pull::after {
    background: var(--color-secondary);
  }

  .mobile-bar {
    position: relative;
    z-index: 30;
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 52px;
    padding: 0 16px;
    background: var(--color-background);
    border-bottom: 1px solid var(--color-border);
    transition: transform var(--duration-feedback) var(--ease-trace);
  }

  /*
   * 掴める面であることを形だけで示す。文言も方向の記号も置かない。
   * 罫線から離してバーの内側に置く。罫線に重ねると継ぎ目の記号に見えて、
   * 下に並ぶ目次バーまで掴めるように読めてしまう。掴める面はヘッダ全体なので、
   * 印もその内側に収める
   */
  .mobile-bar::after {
    position: absolute;
    inset-block-end: 8px;
    inset-inline-start: 50%;
    width: 36px;
    height: 3px;
    content: "";
    background: var(--color-border-strong);
    border-radius: 999px;
    opacity: 1;
    transform: translateX(-50%);
    transition:
      opacity var(--duration-feedback) ease,
      transform 220ms cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  /*
   * メニューや目次を開いている間は、その真上に線が残っても読みづらいので消す。
   * メニューは閉じ始めた時点で戻す（スクリムの出し入れと歩調を揃える）
   */
  .site-header:has(.mobile-menu[open]:not([data-closing])) .mobile-bar::after,
  :global(html:has(.article-structure[data-stuck][open])) .mobile-bar::after {
    opacity: 0;
  }

  @media (min-width: 960px) {
    .mobile-bar::after {
      content: none;
    }
  }

  /*
   * 指で上へ引いて退避させる。--chrome-drag-y は引いている最中の移動量で、
   * 離すと 0（表示）か --chrome-hidden-shift（退避）に落ち着く。
   * transform は .site-header ではなくバーに掛ける。header 側に transform が
   * 乗ると、中の position: fixed な .menu-scrim の基準が header になり全画面を
   * 覆えなくなる。退避中の header は中身が画面外にあるだけで箱は残るため、
   * 上端 52px がタップを吸わないよう pointer-events を切る
   */
  @media (max-width: 959px) {
    .mobile-bar {
      /* バーの高さちょうどだと下端の罫線が y=0 に着地し、端数の丸めで
         髪の毛一本分残ることがある。1px 余分に送って確実に画面外へ出す */
      --chrome-hidden-shift: -53px;
      --chrome-shift: 0px;

      touch-action: none;
      transform: translateY(
        clamp(
          var(--chrome-hidden-shift),
          calc(var(--chrome-shift) + var(--chrome-drag-y, 0px)),
          var(--chrome-rubber-max, 0px)
        )
      );
    }

    :global(html[data-chrome-hidden]) .mobile-bar {
      --chrome-shift: var(--chrome-hidden-shift);
    }

    :global(html[data-chrome-hidden]) .site-header {
      pointer-events: none;
    }

    :global(html[data-chrome-dragging]) .mobile-bar,
    :global(html[data-chrome-dragging]) .chrome-handle {
      transition: none;
    }
  }

  /*
   * 退避すると出てくる取っ手。タップでも下へのドラッグでも戻せる。
   * 上端に貼り付けると iOS の画面端スワイプ（通知/コントロールセンター）と
   * 取り合いになるため 12px 浮かせる。バー(z-index 30)より奥に置いて、
   * 戻ってくるバーに覆われるようにする。ボタン自身は取っ手より下へ広げて
   * 指の当たりを稼ぐ
   */
  .chrome-handle {
    position: fixed;
    inset-block-start: 12px;
    inset-inline-start: 50%;
    z-index: 29;
    display: grid;
    align-items: start;
    justify-items: center;
    width: 72px;
    height: 44px;
    padding: 0;
    background: none;
    border: 0;
    cursor: pointer;
    visibility: hidden;
    touch-action: none;
    transform: translate(-50%, calc(-100% - 13px));
    transition:
      transform 220ms cubic-bezier(0.34, 1.56, 0.64, 1),
      visibility 220ms;
  }

  /*
   * 面も枠も持たせず、線だけを浮かせる。ただし本文や画像の上では線が埋もれる
   * ので、線の周りの背景だけをぼかして手前と奥を分ける。
   * ぼかす範囲は線を包むカプセル形にして、角が立たないようにする
   */
  .chrome-handle-pill {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 22px;
    border-radius: 999px;
    -webkit-backdrop-filter: blur(10px) saturate(140%);
    backdrop-filter: blur(10px) saturate(140%);
  }

  /* バー下端のグラバーと同じ線。退避しても同じものだと形で分かるようにする */
  .chrome-grabber {
    width: 36px;
    height: 3px;
    background: var(--color-border-strong);
    border-radius: 999px;
    transition: transform 220ms cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  /*
   * 指を置いた時点で線を膨らませる。掴めたことをその場で返すためのもので、
   * 当たり判定は変わらない。data-chrome-dragging は 6px 動くまで付かないので、
   * 触った瞬間を表す印は別に持つ
   */
  :global(html[data-chrome-pressed]) .mobile-bar::after {
    transform: translateX(-50%) scale(1.2, 1.6);
  }

  :global(html[data-chrome-pressed]) .chrome-grabber {
    transform: scale(1.2, 1.6);
  }

  @media (max-width: 959px) {
    :global(html[data-chrome-hidden]) .chrome-handle {
      pointer-events: auto;
      visibility: visible;
      transform: translate(-50%, 0);
    }
  }

  @media (min-width: 960px) {
    .chrome-handle {
      display: none;
    }
  }

  /*
   * バーの右側。検索とメニューを並べて置く。position は持たせない。
   * メニューの面は .mobile-bar を基準に敷いているので、間に基準を作らない
   */
  .mobile-actions {
    display: flex;
    align-items: center;
  }

  .mobile-search[hidden] {
    display: none;
  }

  .mobile-home,
  .mobile-search,
  .mobile-menu summary {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    color: var(--color-primary);
  }

  /* 2枚のアイコンを同じセルに重ね、絶対配置に頼らず中央へ揃える */
  .mobile-menu summary {
    display: grid;
    grid-template-areas: "menu-icon";
    place-items: center;
  }

  .mobile-home {
    text-decoration: none;
  }

  .mobile-home svg,
  .mobile-search svg {
    width: 18px;
    height: 18px;
  }

  .mobile-search {
    padding: 0;
    background: none;
    border: 0;
    cursor: pointer;
  }

  .mobile-home[aria-current="page"]::after {
    content: "";
    position: absolute;
    right: 12px;
    bottom: 2px;
    left: 12px;
    height: 2px;
    background: var(--color-secondary);
  }

  .mobile-home:hover,
  .mobile-home:focus-visible,
  .mobile-search:hover,
  .mobile-search:focus-visible,
  .mobile-menu summary:hover,
  .mobile-menu summary:focus-visible,
  .mobile-menu[open] summary {
    color: var(--color-secondary);
  }

  .mobile-menu summary {
    cursor: pointer;
    list-style: none;
  }

  .mobile-menu summary::-webkit-details-marker {
    display: none;
  }

  /*
   * 三本線と × は同じ線の変形として見せる。別々のアイコンを重ねて
   * 入れ替えると形が繋がらず、切り替わりが唐突に見える。
   * 開くも閉じるも同じ transition を逆にたどるので、往復の動きが揃う。
   */
  .menu-bars {
    grid-area: menu-icon;
    position: relative;
    width: 18px;
    height: 14px;
  }

  .menu-bar {
    /* 吸収と傾きの二段で動かす。開閉にかかる時間はこの倍になる */
    --menu-bar-step: 120ms;

    position: absolute;
    left: 0;
    width: 100%;
    height: 2px;
    background: currentcolor;
    border-radius: 1px;
    translate: 0 0;
    rotate: 0deg;
    /*
     * 閉じるときは開くときの逆順をたどる。まず傾きが戻って三本に揃い、
     * そのあと上下の線が元の位置へ離れていく。
     * 位置と角度を別々に遅らせたいので、transform ではなく translate と
     * rotate を個別のプロパティとして動かす。
     */
    transition:
      rotate var(--menu-bar-step) var(--ease-trace),
      opacity var(--menu-bar-step) ease,
      translate var(--menu-bar-step) var(--ease-trace) var(--menu-bar-step);
  }

  .menu-bar:nth-child(1) {
    top: 0;
  }

  .menu-bar:nth-child(2) {
    top: 6px;
  }

  .menu-bar:nth-child(3) {
    top: 12px;
  }

  /*
   * 開くときは、上下の線が中央へ吸い込まれて三本が重なり、
   * そこから互いに反対へ傾いて × になる。真ん中の線は傾きに合わせて消す。
   */
  .mobile-menu[open]:not([data-closing]) .menu-bar {
    transition:
      translate var(--menu-bar-step) var(--ease-trace),
      rotate var(--menu-bar-step) var(--ease-trace) var(--menu-bar-step),
      opacity var(--menu-bar-step) ease var(--menu-bar-step);
  }

  .mobile-menu[open]:not([data-closing]) .menu-bar:nth-child(1) {
    translate: 0 6px;
    rotate: 45deg;
  }

  .mobile-menu[open]:not([data-closing]) .menu-bar:nth-child(2) {
    opacity: 0;
  }

  .mobile-menu[open]:not([data-closing]) .menu-bar:nth-child(3) {
    translate: 0 -6px;
    rotate: -45deg;
  }

  .mobile-menu .menu-panel {
    position: absolute;
    inset: 52px 0 auto;
    display: grid;
    gap: 10px;
    padding: 20px 16px 24px;
    opacity: 1;
    background: var(--color-background);
    transform: translateY(0);
    transition:
      opacity var(--duration-feedback) ease,
      transform var(--duration-feedback) var(--ease-trace);
  }

  .mobile-menu[open]:not([data-closing]) .menu-panel {
    animation: mobile-menu-surface-in var(--duration-feedback) ease both;
  }

  .mobile-menu[data-closing] .menu-panel {
    pointer-events: none;
    opacity: 0;
    transform: translateY(-8px);
  }

  .mobile-menu .menu-panel::before {
    content: "";
    position: absolute;
    top: 0;
    right: 16px;
    width: 44px;
    height: 2px;
    background: var(--color-primary);
  }

  .mobile-menu[open]:not([data-closing]) nav::before {
    animation: mobile-menu-line-in var(--duration-feedback) var(--ease-trace)
      both;
  }

  .mobile-menu .menu-panel::after {
    content: "";
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 2px;
    background: var(--color-primary);
    transform-origin: left;
  }

  .mobile-menu[open]:not([data-closing]) nav::after {
    animation: mobile-menu-rule-in var(--duration-feedback) var(--ease-trace)
      both;
  }

  .mobile-menu[data-closing] nav::before {
    width: 0;
    transition: width var(--duration-feedback) var(--ease-trace);
  }

  .mobile-menu[data-closing] nav::after {
    transform: scaleX(0);
    transition: transform var(--duration-feedback) var(--ease-trace);
  }

  /*
   * 展開中は本文にスクリムを敷き、メニューを手前に立たせる。
   * 画面いっぱいの面を一様に暗くすると、明るさが一度に変わって目が痛い。
   * パネルが上から降りるのに続けて、上端から下へ広げる。閉じるときは
   * 同じ経路を上へ畳む。パネルより少し長くかけ、追って広がるようにする。
   *
   * 伸ばすのは clip-path ではなく scaleY。切り抜きを動かすと画面いっぱいの
   * 塗り直しが毎フレーム走り、端末によってはあからさまに引っかかる。
   * 単色の面なので、拡大しても見た目は切り抜きと変わらない。
   */
  .menu-scrim {
    position: fixed;
    z-index: 25;
    inset: 0;
    pointer-events: none;
    background: rgb(0 0 0 / 40%);
    opacity: 0;
    transition: opacity var(--duration-state) ease;
  }

  /*
   * 覆いはメニューより遅れて出す。同時に暗くすると、開く動きより先に画面が
   * 沈んで見える。閉じるときは遅らせない（遅延を持つのは開く側の指定だけ）
   */
  .site-header:has(.mobile-menu[open]:not([data-closing])) .menu-scrim {
    pointer-events: auto;
    opacity: 1;
    transition-delay: 100ms;
  }

  .mobile-menu .menu-panel :is(a, button) {
    position: relative;
    background: none;
    border: 0;
    cursor: pointer;
    text-align: start;
    display: grid;
    /* 3列目は状態の印。印を持たない項目では幅 0 に畳まれる */
    grid-template-columns: 18px minmax(0, 1fr) auto;
    align-items: center;
    gap: 10px;
    min-height: 52px;
    padding: 10px 8px;
    color: var(--color-text-sub);
    font-size: var(--text-sm);
    text-decoration: none;
  }

  /*
   * 設定は一列に積み、アイコンと説明だけを置く。ラベルは「何をする設定か」で
   * 固定し、効いているかどうかはマスの面が持つ（aria-pressed と同じもの）。
   * Accent は状態表示に必要なコントラストを持たないので、面は primary の混色、
   * 枠は primary にして 3:1 を確保する
   */
  /*
   * 設定は一列に積む。`.menu-group` と同じ重みだと後勝ちで2列に戻るため、
   * 器まで含めて書いて詳細度で上回る。行の高さも同じ理由で器から書く
   */
  .mobile-menu .menu-panel .menu-settings {
    grid-template-columns: minmax(0, 1fr);
    gap: 2px;
    /* 群の境目は PC の欄外と同じく罫線一本で示す。見出しの文字は置かない */
    margin-block-start: 6px;
    padding-block-start: 10px;
    border-block-start: 1px solid var(--color-border);
  }

  .mobile-menu .menu-panel .menu-settings button {
    min-height: 44px;
    padding: 6px 8px;
  }

  /*
   * hig.md button.toggle-state。色を primary へ上げ、Line で示す。
   * 線の引き方はホームの現在地（.mobile-home[aria-current]::after）と同じ
   */
  .mobile-menu .menu-panel .menu-settings button[aria-pressed="true"] > span {
    color: var(--color-primary);
    font-weight: 700;
  }

  .mobile-menu .menu-panel .menu-settings button[aria-pressed="true"]::after {
    content: "";
    position: absolute;
    right: 8px;
    bottom: 4px;
    left: 8px;
    height: 2px;
    background: var(--color-secondary);
  }

  /*
   * いまどちらかを行の右端に置く。読み上げ名は説明の文字が持ち、状態は
   * aria-pressed が持つので、ここは見た目だけの補い
   */
  .mobile-menu .menu-panel .menu-settings .menu-state {
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    font-weight: 400;
  }

  .menu-state-on,
  .menu-state-off {
    display: none;
  }

  [aria-pressed="true"] .menu-state-on,
  [aria-pressed="false"] .menu-state-off {
    display: inline;
  }

  /* 群ごとに2列で組む。行き先と読み方の設定は、押した結果の種類が違う */
  .menu-group {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 4px 20px;
  }

  .menu-group :is(a, button):last-child:nth-child(odd) {
    grid-column: 1 / -1;
  }

  .mobile-menu .menu-panel :is(a, button) svg {
    color: var(--color-secondary);
  }

  .mobile-menu .menu-panel :is(a, button):hover,
  .mobile-menu .menu-panel :is(a, button):focus-visible {
    color: var(--color-interaction-text);
  }

  .mobile-menu .menu-panel a[aria-current="page"] {
    color: var(--color-primary);
    font-weight: 700;
  }

  @keyframes mobile-menu-surface-in {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes mobile-menu-line-in {
    from {
      width: 0;
    }

    to {
      width: 44px;
    }
  }

  @keyframes mobile-menu-rule-in {
    from {
      transform: scaleX(0);
    }

    to {
      transform: scaleX(1);
    }
  }

  @media (min-width: 960px) {
    .site-header {
      position: static;
    }

    .mobile-bar,
    .menu-scrim {
      display: none;
    }

    .desktop-edge {
      position: fixed;
      inset: 0 auto 0 0;
      z-index: 40;
      display: flex;
      flex-direction: column;
      width: 48px;
      overflow: hidden;
      background: var(--color-background);
      border-right: 2px solid var(--color-primary);
      transition: width var(--duration-state) var(--ease-trace);
    }

    .desktop-edge:hover,
    .desktop-edge:focus-within {
      width: 196px;
    }

    .edge-mark {
      display: flex;
      align-items: center;
      gap: 14px;
      min-height: 64px;
      padding: 0 16px;
      color: var(--color-primary);
      font-weight: 700;
      white-space: nowrap;
      text-decoration: none;
      border-bottom: 1px solid var(--color-border);
    }

    .edge-mark > svg {
      flex: 0 0 16px;
      color: var(--color-secondary);
    }

    .edge-nav {
      display: grid;
      margin-top: 18px;
    }

    /*
     * 表示のカスタマイズ。行き先ではないので nav から出し、線で段を分ける。
     * 畳んでいるあいだは歯車だけを罫線の下に置き、開いたらマスへ入れ替える。
     * どちらも同じ場所で切り替わるので、レールの幅が変わっても位置が動かない
     */
    .edge-settings {
      position: relative;
      margin-top: 14px;
      padding: 14px 16px 0;
      border-top: 1px solid var(--color-border);
    }

    .edge-settings-mark {
      display: grid;
      place-items: center;
      width: 16px;
      height: 36px;
      color: var(--color-text-sub);
      transition: opacity var(--duration-feedback) ease;
    }

    .edge-settings-mark svg {
      width: 16px;
      height: 16px;
    }

    /*
     * マスは畳んでいるあいだも DOM に残す。display で消すと Tab が届かず、
     * focus-within で開く経路そのものが無くなる
     */
    .edge-toggles {
      position: absolute;
      inset-block-start: 14px;
      inset-inline-start: 16px;
      display: grid;
      /* マスで内側いっぱいを埋める。残り幅を折半し、正方形のまま大きくする */
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 8px;
      width: 164px;
      opacity: 0;
      /* 畳んでいるあいだは押せない。歯車の位置に透明なマスが重なるため */
      pointer-events: none;
      transition: opacity var(--duration-feedback) ease;
    }

    .desktop-edge:hover .edge-settings-mark,
    .desktop-edge:focus-within .edge-settings-mark {
      opacity: 0;
    }

    .desktop-edge:hover .edge-toggles,
    .desktop-edge:focus-within .edge-toggles {
      opacity: 1;
      pointer-events: auto;
    }

    .edge-toggle {
      display: grid;
      place-items: center;
      height: 48px;
      padding: 0;
      color: var(--color-text-sub);
      background: none;
      border: 1px solid var(--color-border);
      border-radius: 4px;
      cursor: pointer;
      transition:
        color var(--duration-feedback) ease,
        background-color var(--duration-feedback) ease,
        border-color var(--duration-feedback) ease;
    }

    .edge-toggle svg {
      width: 18px;
      height: 18px;
    }

    .edge-toggle:hover,
    .edge-toggle:focus-visible {
      color: var(--color-primary);
      border-color: var(--color-border-strong);
    }

    /*
     * 効いている状態。面ではなく Line で示すのは他と同じで、マスの場合は
     * 枠そのものを太くする。components.md の「current を Primary の Line で
     * 示す」に合わせて色は primary。box-sizing は border-box なので、
     * 太らせてもマスの大きさは変わらない
     */
    .edge-toggle[aria-pressed="true"] {
      color: var(--color-primary);
      border-width: 2px;
      border-color: var(--color-primary);
    }

    /*
     * 説明。レールは overflow: hidden なので外へは出せない。マスの下、
     * レールの内側へ置く。読み上げ名は aria-label が持つので aria-hidden
     */
    .edge-tip {
      position: absolute;
      inset-block-start: calc(100% + 6px);
      inset-inline: 0;
      color: var(--color-text-muted);
      font-size: var(--text-xs);
      line-height: 1.5;
      opacity: 0;
      pointer-events: none;
      transition: opacity var(--duration-feedback) ease;
    }

    .edge-toggle:hover .edge-tip,
    .edge-toggle:focus-visible .edge-tip {
      opacity: 1;
    }

    /*
     * いまどちらかを説明の中で言う。読み上げ名は aria-label が固定で持ち、
     * 状態は aria-pressed が持つので、ここは見た目だけの補いになる
     */
    .edge-tip-state {
      display: none;
      margin-block-start: 5px;
      color: var(--color-primary);
    }

    .edge-toggle[aria-pressed="true"] .edge-tip-state--on,
    .edge-toggle[aria-pressed="false"] .edge-tip-state--off {
      display: block;
    }

    .edge-link {
      position: relative;
      background: none;
      border: 0;
      cursor: pointer;
      text-align: start;
      display: grid;
      /* 3列目は状態の印。印を持たない項目では幅 0 に畳まれる */
      grid-template-columns: 16px 1fr auto;
      align-items: center;
      gap: 14px;
      min-height: 44px;
      padding: 0 16px;
      color: var(--color-text-sub);
      font-size: var(--text-sm);
      white-space: nowrap;
      text-decoration: none;
    }

    .edge-link::after {
      content: "";
      position: absolute;
      right: 0;
      bottom: 5px;
      width: 0;
      height: 1px;
      background: var(--color-secondary);
      transition: width var(--duration-feedback) var(--ease-trace);
    }

    .edge-link:hover,
    .edge-link:focus-visible,
    .edge-link[aria-current="page"] {
      color: var(--color-primary);
    }

    .edge-link:hover::after,
    .edge-link:focus-visible::after,
    .edge-link[aria-current="page"]::after {
      width: calc(100% - 48px);
    }
  }

  @media (forced-colors: active) {
    .menu-scrim {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mobile-bar,
    .mobile-bar::after,
    .chrome-pull,
    .chrome-handle,
    .chrome-grabber,
    .menu-bar,
    .mobile-menu .menu-panel,
    .mobile-menu .menu-panel::before,
    .mobile-menu .menu-panel::after,
    .menu-scrim {
      animation: none !important;
      transition: none !important;
    }
  }
</style>

<style is:global>
  @media (max-width: 959px) {
    body {
      padding-top: 52px;
    }

    /*
     * ヘッダーを下へ引いたときに伸びる量の上限。ヘッダーと一緒に動くもの
     * （目次、プレビューの編集バー）が同じ値を見られるよう html に置く。
     * 退避中の下引きは戻す操作なので、そのときは伸びしろを持たせない。
     */
    :root {
      --chrome-rubber-max: 48px;
    }

    :root[data-chrome-hidden] {
      --chrome-rubber-max: 0px;
    }
  }
</style>

<script>
  import {
    onPageLoad,
    onPageEvent,
    onPageCleanup,
  } from "~/scripts/pageLifecycle";

  onPageLoad(() => {
    const mobileMenu =
      document.querySelector<HTMLDetailsElement>("[data-mobile-menu]");
    const mobileMenuSummary = mobileMenu?.querySelector<HTMLElement>(
      "[data-mobile-menu-summary]",
    );
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    /*
     * 閉じ切るまで open を外さない。線は傾きを戻してから離れる二段の動きなので、
     * 片方だけの時間で外すと途中で消える（CSS の --menu-bar-step の倍）
     */
    const closeDuration = 240;
    const closeScrollDistance = 72;

    if (mobileMenu && mobileMenuSummary) {
      let closeTimer = 0;
      onPageCleanup(() => window.clearTimeout(closeTimer));
      let openedAtScrollY = window.scrollY;
      let scrollUpdateQueued = false;

      const finishClosing = () => {
        window.clearTimeout(closeTimer);
        mobileMenu.open = false;
        delete mobileMenu.dataset.closing;
      };

      const closeMobileMenu = () => {
        if (!mobileMenu.open || mobileMenu.dataset.closing !== undefined)
          return;

        if (reducedMotion.matches) {
          finishClosing();
          return;
        }

        mobileMenu.dataset.closing = "";
        closeTimer = window.setTimeout(finishClosing, closeDuration);
      };

      mobileMenuSummary.addEventListener("click", (event) => {
        if (!mobileMenu.open) return;
        event.preventDefault();
        closeMobileMenu();
      });

      mobileMenu.addEventListener("toggle", () => {
        if (!mobileMenu.open) return;
        openedAtScrollY = window.scrollY;
      });

      onPageEvent(document, "click", (event) => {
        if (!mobileMenu.open) return;
        const target = event.target;
        if (target instanceof Node && !mobileMenu.contains(target)) {
          closeMobileMenu();
        }
      });

      onPageEvent(
        window,
        "scroll",
        () => {
          if (!mobileMenu.open || scrollUpdateQueued) return;
          scrollUpdateQueued = true;

          requestAnimationFrame(() => {
            if (
              Math.abs(window.scrollY - openedAtScrollY) >= closeScrollDistance
            ) {
              closeMobileMenu();
            }
            scrollUpdateQueued = false;
          });
        },
        { passive: true },
      );
    }

    /*
     * 上部バーの出し入れ。自動では動かさない。バーを指で上へ引くとヘッダーと
     * 追従中の目次がまとめて退避し、上端に出る取っ手をタップするか下へ引くと戻る。
     * 引いている最中の移動量は --chrome-drag-y に流し、位置は CSS 側で clamp する
     */
    const root = document.documentElement;
    const siteHeader = document.querySelector<HTMLElement>(".site-header");
    const chromeHandle = document.querySelector<HTMLElement>(
      "[data-chrome-handle]",
    );
    const compactViewport = matchMedia("(max-width: 959px)");
    // 確定に必要な移動量と、タップと見なす許容量
    const commitDistance = 24;
    const tapSlop = 6;
    /*
     * 表示中に下へ引いたときは、引いた分がそのまま付いてくると「降りる」操作に
     * 見えてしまう。抵抗をかけて伸びを抑え、引き切って離したところで上へ巻き取る。
     * 退避中の下引きは戻す操作なので、抵抗はかけず指の動きどおりに追わせる。
     */
    const rubberMax = 48;
    const pullCommitDistance = 56;
    /*
     * 伸びは漸近させる。引くほど鈍り、確定に必要な量まで引いたところで上限の
     * 八割ほどに達してそれ以上は動かない。進み具合の線が満ちるのと、指が感じる
     * 「引き切った」ところを揃えるための値
     */
    const rubberSoftness = 35;

    let dragPointerId = -1;
    let dragStartY = 0;
    let dragDistance = 0;
    let suppressNextClick = false;

    const isChromeHidden = () => root.dataset.chromeHidden !== undefined;

    const setChromeHidden = (hidden: boolean) => {
      if (hidden) {
        root.dataset.chromeHidden = "";
        return;
      }
      delete root.dataset.chromeHidden;
    };

    const endDrag = () => {
      dragPointerId = -1;
      delete root.dataset.chromePressed;
      delete root.dataset.chromeDragging;
      delete root.dataset.chromePulling;
      root.removeAttribute("data-chrome-pull-ready");
      root.style.removeProperty("--chrome-drag-y");
      root.style.removeProperty("--chrome-pull-progress");
    };

    onPageEvent(document, "pointerdown", (event) => {
      suppressNextClick = false;

      if (
        dragPointerId !== -1 ||
        !compactViewport.matches ||
        mobileMenu?.open
      ) {
        return;
      }

      const target = event.target instanceof Element ? event.target : null;
      const origin = target?.closest("[data-chrome-drag]") ?? null;
      if (!origin) return;

      dragPointerId = event.pointerId;
      dragStartY = event.clientY;
      dragDistance = 0;

      /*
       * 掴み自体はバーのどこからでも始められるが、手応えは操作子の上では返さない。
       * ホームやメニューを押しただけで線が動くと、何に反応したのか読めなくなる。
       * 取っ手自身はボタンでありながら掴み面そのものなので、対象から外さない
       */
      const control = target?.closest("a, button, summary");
      if (!control || control === origin) {
        root.dataset.chromePressed = "";
      }
    });

    onPageEvent(
      document,
      "pointermove",
      (event) => {
        if (event.pointerId !== dragPointerId) return;

        dragDistance = event.clientY - dragStartY;
        if (Math.abs(dragDistance) < tapSlop) return;

        const pulling = dragDistance > 0 && !isChromeHidden();
        const offset = pulling
          ? rubberMax * (1 - Math.exp(-dragDistance / rubberSoftness))
          : dragDistance;

        root.dataset.chromeDragging = "";
        root.style.setProperty("--chrome-drag-y", `${offset}px`);

        if (pulling) {
          const progress = Math.min(1, dragDistance / pullCommitDistance);
          root.dataset.chromePulling = "";
          root.style.setProperty("--chrome-pull-progress", `${progress}`);
          root.toggleAttribute("data-chrome-pull-ready", progress >= 1);
        } else {
          delete root.dataset.chromePulling;
          root.removeAttribute("data-chrome-pull-ready");
        }
      },
      { passive: true },
    );

    const finishDrag = (event: PointerEvent) => {
      if (event.pointerId !== dragPointerId) return;

      /*
       * 引き切ったかどうかだけで決める。届かなければ元の位置へ戻す。
       * 表示中は上へ送っても下へ引き切っても退避させる。下は伸びに抵抗がある分、
       * 手が動く距離は長くなるので、確定に必要な量も上より大きく取る
       */
      if (isChromeHidden()) {
        if (dragDistance > commitDistance) setChromeHidden(false);
      } else if (
        dragDistance < -commitDistance ||
        dragDistance > pullCommitDistance
      ) {
        setChromeHidden(true);
      }

      // 引いた後の指離しでリンクやメニューが反応しないようにする
      suppressNextClick = Math.abs(dragDistance) > tapSlop;
      endDrag();
    };

    onPageEvent(document, "pointerup", finishDrag);
    onPageEvent(document, "pointercancel", (event) => {
      if (event.pointerId !== dragPointerId) return;
      endDrag();
    });

    onPageEvent(
      document,
      "click",
      (event) => {
        if (!suppressNextClick) return;
        suppressNextClick = false;
        event.preventDefault();
        event.stopPropagation();
      },
      true,
    );

    chromeHandle?.addEventListener("click", () => {
      setChromeHidden(false);
    });

    // 退避中にキーボードで入ってきた場合、見えない位置に焦点を残さない
    siteHeader?.addEventListener("focusin", (event) => {
      if (event.target === chromeHandle) return;
      setChromeHidden(false);
    });

    /*
     * 紙の入れ替え。設計上は紙を替えているが、紙の呼び名は一般に通らないので、
     * 表に出す言葉は起きること（まぶしさ／明るさ）で書く。初期値は head の
     * インラインスクリプトが決めており、ここでは選び直しと保存だけを担う。
     * label は押した結果を先に言う
     */
    const themeColor = document.querySelector("[data-theme-color]");
    const paperToggles = document.querySelectorAll<HTMLElement>(
      "[data-paper-toggle]",
    );

    const syncPaper = () => {
      paperToggles.forEach((toggle) => {
        toggle.setAttribute(
          "aria-pressed",
          String(root.dataset.paper === "dim"),
        );
      });
    };

    paperToggles.forEach((toggle) => {
      toggle.addEventListener("click", () => {
        const paper = root.dataset.paper === "dim" ? "white" : "dim";
        root.dataset.paper = paper;
        themeColor?.setAttribute(
          "content",
          paper === "dim" ? "#efe8d9" : "#ffffff",
        );
        try {
          localStorage.setItem("paper", paper);
        } catch {
          // 保存できない環境では、その場の選択だけ効かせる
        }
        syncPaper();
      });
    });

    syncPaper();

    const glossaryToggles = document.querySelectorAll<HTMLElement>(
      "[data-glossary-toggle]",
    );

    const syncGlossary = () => {
      glossaryToggles.forEach((toggle) => {
        toggle.setAttribute(
          "aria-pressed",
          String(root.dataset.glossary === "off"),
        );
      });
    };

    glossaryToggles.forEach((toggle) => {
      toggle.addEventListener("click", () => {
        const glossary = root.dataset.glossary === "on" ? "off" : "on";
        root.dataset.glossary = glossary;
        try {
          localStorage.setItem("glossary", glossary);
        } catch {
          // 保存できない環境では、その場の選択だけ効かせる
        }
        syncGlossary();
      });
    });

    syncGlossary();

    const scrollToggles = document.querySelectorAll<HTMLElement>(
      "[data-scroll-toggle]",
    );

    const syncScroll = () => {
      scrollToggles.forEach((toggle) => {
        toggle.setAttribute(
          "aria-pressed",
          String(root.dataset.scroll === "instant"),
        );
      });
    };

    scrollToggles.forEach((toggle) => {
      toggle.addEventListener("click", () => {
        const scroll = root.dataset.scroll === "instant" ? "smooth" : "instant";
        root.dataset.scroll = scroll;
        try {
          localStorage.setItem("scroll", scroll);
        } catch {
          // 保存できない環境では、その場の選択だけ効かせる
        }
        syncScroll();
      });
    });

    syncScroll();
  });
</script>
