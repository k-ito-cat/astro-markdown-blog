---
import type { AstroComponentFactory } from "astro/runtime/server/index.js";
import "glightbox/dist/css/glightbox.min.css";
import {
  PUBLISHED_STATUS,
  type PublishedStatus,
} from "~/constants/publishedStatus";

type Props = {
  content: AstroComponentFactory;
  status: PublishedStatus;
};
const { content: Content, status } = Astro.props;
---

<div class="prose" data-is-published={status === PUBLISHED_STATUS.PUBLISHED}>
  <Content />
</div>

<script>
  // medium-zoom で画像をLightbox表示
  // @ts-ignore 型定義が無いライブラリのため
  import("glightbox").then(({ default: GLightbox }) => {
    const imgEls = Array.from(document.querySelectorAll(".prose img"));
    if (imgEls.length === 0) return;

    const elements = imgEls.map((img) => ({
      href: (img as HTMLImageElement).src,
      type: "image",
      alt: (img as HTMLImageElement).alt,
    }));

    // @ts-ignore 型定義がないため
    const lightbox = (GLightbox as any)({
      elements,
      touchNavigation: true,
      closeButton: true,
      loop: false,
      slideEffect: "slide",
      cssEasing: "cubic-bezier(0.4,0,0.2,1)",
      speed: 50,
    });

    // 各画像クリックで該当インデックスを開く
    imgEls.forEach((img, idx) => {
      img.addEventListener("click", () => lightbox.openAt(idx));
      (img as HTMLImageElement).style.cursor = "zoom-in";
    });
  });

  // 見出し(h2/h3/h4)をリンク化
  const headingEls = document.querySelectorAll(
    ".prose h2[id], .prose h3[id], .prose h4[id]",
  );
  headingEls.forEach((headingEl) => {
    const id = (headingEl as HTMLElement).id;
    if (!id) return;
    if (headingEl.querySelector("a.heading-self-link")) return;

    const navLink = document.createElement("a");
    navLink.href = `#${id}`;
    navLink.classList.add("heading-self-link");
    // 既存の子要素をリンク内へ移動
    while (headingEl.firstChild) navLink.appendChild(headingEl.firstChild);
    headingEl.appendChild(navLink);
  });

  const memoHeading = document.querySelector(".prose h2#メモ");
  if (memoHeading && !memoHeading.closest(".prose-memo-section")) {
    const prose = memoHeading.closest<HTMLElement>(".prose");
    const isPublished = prose?.dataset.isPublished === "true";
    const memoSection = document.createElement("section");
    memoSection.className = "prose-memo-section";
    memoSection.classList.toggle("is-published", isPublished);
    memoHeading.parentNode?.insertBefore(memoSection, memoHeading);

    let currentNode = memoHeading.nextSibling;
    memoSection.appendChild(memoHeading);
    while (currentNode) {
      const nextNode = currentNode.nextSibling;
      memoSection.appendChild(currentNode);
      currentNode = nextNode;
    }

    const memoNote = document.createElement("p");
    memoNote.className = "prose-memo-note";
    memoNote.textContent = isPublished
      ? "このメモは本番にも表示されます。メモを削除するか、公開状態を変更してください。"
      : "編集用メモです。公開済みにする前に削除してください。";
    memoHeading.insertAdjacentElement("afterend", memoNote);
  }
</script>

<style is:global>
  a:focus-visible,
  button:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }

  .prose {
    width: 100%;
    max-width: var(--measure-prose);
    margin-inline: auto;
    font-size: var(--text-md);
    line-height: var(--leading-body);
    color: var(--text-primary);
  }

  @media (min-width: 768px) {
    .prose {
      font-size: 17px;
    }
  }

  .prose p {
    margin: var(--space-paragraph) 0;
  }

  .prose a {
    color: var(--link);
    overflow-wrap: anywhere;
    text-decoration: underline;
    text-underline-offset: 2px;
    text-decoration-color: color-mix(in srgb, var(--link) 45%, transparent);
    transition: color 140ms ease-out;
  }

  .prose a:hover {
    color: var(--link-hover);
    text-decoration-color: currentColor;
  }

  .prose a:visited {
    color: var(--link-visited);
  }

  .prose a:active {
    color: var(--link-active);
  }

  .prose strong {
    color: var(--text-primary);
    font-weight: 700;
  }

  .prose h1 {
    color: color-mix(in srgb, var(--text-primary) 82%, var(--accent-warm));
  }

  .prose h2,
  .prose h3,
  .prose h4 {
    color: var(--color-primary);
    line-height: var(--leading-heading);
    font-weight: 700;
    scroll-margin-top: 24px;
  }

  .prose h2 {
    font-size: 24px;
    margin: 48px 0 16px;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--color-border-strong);
  }

  .prose h3 {
    font-size: 20px;
    margin: 36px 0 12px;
  }

  .prose h4 {
    font-size: 17px;
    margin: 28px 0 8px;
  }

  .prose ul,
  .prose ol {
    margin: 18px 0;
    padding-left: 1.4em;
  }

  .prose ul {
    list-style: disc;
  }

  .prose ol {
    list-style: decimal;
  }

  .prose li {
    margin: 6px 0;
  }

  .prose li::marker {
    color: var(--text-muted);
  }

  .prose blockquote {
    margin: 24px 0;
    padding: 2px 16px;
    border-left: 3px solid var(--border);
    color: var(--text-secondary);
  }

  .prose blockquote p {
    margin: 0.5em 0;
  }

  /* inline code: 本文に馴染ませる (design ui-patterns Code Block / Inline Code) */
  .prose :not(pre) > code {
    font-family: var(--font-mono);
    font-size: 0.94em;
    padding: 0.1em 0.4em;
    margin-inline: 2px;
    border-radius: var(--radius-label);
    background: var(--bg-subtle);
    border: 1px solid var(--border);
    color: var(--text-primary);
  }

  /* コードの前後の擬似要素（` `）を非表示にする */
  .prose code::before,
  .prose code::after {
    content: none;
    display: none;
  }

  /* code block は astro-expressive-code に委ねる。素の pre の余白だけ整える */
  .prose pre {
    margin: 24px 0;
    overflow-x: auto;
  }

  .prose .expressive-code {
    --ec-codeFontFml: var(--font-machine);
    --ec-uiFontFml: var(--font-human);
    width: 100%;
    max-width: 100%;
    margin: 24px 0;
  }

  .prose [data-filename] {
    position: relative;
  }
  .prose [data-filename]::before {
    content: attr(data-filename);
    position: absolute;
    top: -22px;
    left: 0;
    background-color: var(--bg-code);
    color: var(--c-code-text, #e9e3d7);
    font-size: 0.75rem;
    padding: 0.25rem 0.5rem;
    border-top-left-radius: var(--radius-label);
    border-top-right-radius: var(--radius-label);
  }
  .prose [data-filename] pre {
    margin-top: 30px;
  }

  .prose img {
    width: 100%;
    height: auto;
    max-width: var(--measure-prose);
    max-height: 520px;
    object-fit: contain;
    margin: 24px auto;
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    cursor: zoom-in;
  }

  .prose .prose-memo-section {
    margin: 40px 0 0;
    padding: 0 0 0 16px;
    border-left: 1px solid var(--border-strong);
  }

  .prose .prose-memo-section.is-published {
    border-left-color: var(--danger);
  }

  .prose .prose-memo-section > h2:first-child {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 7px;
    padding: 0;
    color: var(--text-muted);
    border: 0;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  .prose .prose-memo-section > h2:first-child::after {
    content: "";
    flex: 1;
    height: 1px;
    background: var(--border);
  }

  .prose .prose-memo-note {
    margin: 0 0 16px;
    color: var(--text-muted);
    font-size: 12px;
    line-height: 1.6;
  }

  .prose .prose-memo-section.is-published .prose-memo-note {
    color: var(--danger);
  }

  .prose .prose-memo-section > :last-child {
    margin-bottom: 0;
  }

  /* Link Card: 大きなカードにせず、淡い面と細い border の参照ブロックにする */
  .prose .remark-link-card-plus__container {
    margin: 24px 0;
    width: 100%;
  }

  .prose .remark-link-card-plus__card {
    display: flex;
    align-items: stretch;
    gap: 16px;
    border: 1px solid var(--border);
    background: transparent;
    border-radius: 0;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition:
      background-color 140ms ease-out,
      border-color 140ms ease-out;
  }

  .prose .remark-link-card-plus__card:hover {
    border-color: var(--color-secondary);
    background: transparent;
  }

  .prose .remark-link-card-plus__main {
    padding: 14px 16px;
    min-width: 0;
    flex: 1;
  }

  .prose .remark-link-card-plus__content {
    min-width: 0;
  }

  .prose .remark-link-card-plus__title {
    font-size: 15px;
    font-weight: 600;
    color: var(--link);
    margin: 0 0 6px 0;
    line-height: 1.5;
  }

  .prose .remark-link-card-plus__description {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    margin: 0 0 10px 0;
    line-height: 1.7;
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .prose .remark-link-card-plus__meta {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  .prose .remark-link-card-plus__favicon {
    width: 14px;
    height: 14px;
    border-radius: 4px;
    flex: 0 0 auto;
  }

  .prose .remark-link-card-plus__url {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .prose .remark-link-card-plus__thumbnail {
    width: 160px;
    background: var(--bg-code);
    flex: 0 0 auto;
    position: relative;
    overflow: hidden;
  }

  .prose .remark-link-card-plus__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    margin-block: 0;
    border: 0;
    border-radius: 0;
  }

  @media (max-width: 640px) {
    .prose .remark-link-card-plus__thumbnail {
      display: none;
    }

    .prose .remark-link-card-plus__container {
      margin: 16px 0;
    }

    .prose .remark-link-card-plus__main {
      padding: 12px 14px;
    }

    .prose .remark-link-card-plus__url {
      max-width: 26ch;
    }
  }

  /* Callout: 本文の流れを横切る Line と余白で、注釈の開始・終了を示す */
  .prose .markdown-alert {
    --annotation-color: var(--info);
    --annotation-line-size: 1px;
    --annotation-surface: var(--color-annotation-note-surface);
    margin: 34px 0;
    padding: 17px clamp(16px, 3vw, 24px) 20px;
    color: var(--text-primary);
    background: var(--annotation-surface);
    border: 0;
  }

  .prose .markdown-alert-note {
    --annotation-color: var(--info);
    --annotation-surface: var(--color-annotation-note-surface);
  }

  .prose .markdown-alert-tip {
    --annotation-color: var(--success);
    --annotation-surface: var(--color-annotation-tip-surface);
  }

  .prose .markdown-alert-important {
    --annotation-color: var(--color-primary);
    --annotation-line-size: 2px;
    --annotation-surface: var(--color-annotation-important-surface);
  }

  .prose .markdown-alert-warning {
    --annotation-color: var(--warning);
    --annotation-line-size: 2px;
    --annotation-surface: var(--color-annotation-warning-surface);
  }

  .prose .markdown-alert-caution {
    --annotation-color: var(--danger);
    --annotation-line-size: 3px;
    --annotation-surface: var(--color-annotation-caution-surface);
    margin-block: 40px;
  }

  .prose .markdown-alert-title {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 0 0 13px;
    color: var(--annotation-color);
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 700;
    line-height: 1.4;
    letter-spacing: 0.06em;
  }

  .prose .markdown-alert-title::after {
    content: "";
    flex: 1;
    height: var(--annotation-line-size);
    background: currentColor;
    opacity: 0.82;
  }

  .prose .markdown-alert-tip .markdown-alert-title::after {
    background: linear-gradient(
      to right,
      var(--color-accent) 0 48px,
      var(--annotation-color) 48px
    );
  }

  .prose .markdown-alert-title svg {
    display: none;
  }

  .prose .markdown-alert > :not(.markdown-alert-title) {
    margin: 0;
    color: var(--text-primary);
    font-size: 16px;
    line-height: 1.85;
  }

  .prose
    .markdown-alert
    > :not(.markdown-alert-title)
    + :not(.markdown-alert-title) {
    margin-top: 0.8em;
  }

  .prose .markdown-alert-warning > :not(.markdown-alert-title),
  .prose .markdown-alert-caution > :not(.markdown-alert-title) {
    font-weight: 500;
  }

  .prose .markdown-alert :not(pre) > code {
    background: color-mix(in srgb, var(--bg-base) 60%, transparent);
  }

  @media (max-width: 640px) {
    .prose .markdown-alert {
      margin-block: 30px;
      padding: 15px 16px 18px;
    }

    .prose .markdown-alert-caution {
      margin-block: 36px;
    }
  }

  /* 見出し自己リンク: リンクとして装飾せず見出し色を保つ */
  .prose .heading-self-link,
  .prose h2 a.heading-self-link,
  .prose h3 a.heading-self-link,
  .prose h4 a.heading-self-link {
    color: inherit;
    text-decoration: none;
    font-weight: inherit;
    transition: none;
  }

  .prose h2 a.heading-self-link:hover,
  .prose h3 a.heading-self-link:hover,
  .prose h4 a.heading-self-link:hover,
  .prose h2 a.heading-self-link:visited,
  .prose h3 a.heading-self-link:visited,
  .prose h4 a.heading-self-link:visited {
    color: inherit;
    text-decoration: none;
  }
</style>
