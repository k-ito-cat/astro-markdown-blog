---
import type { AstroComponentFactory } from "astro/runtime/server/index.js";
import { Icon } from "astro-icon/components";
import {
  PUBLISHED_STATUS,
  type PublishedStatus,
} from "~/constants/publishedStatus";

type Props = {
  content: AstroComponentFactory;
  status: PublishedStatus;
  /*
   * メモは執筆者向けの覚書なので、画面幅の確認では組み替えの邪魔になる。
   * 落とすのは dev 限定の /preview/frame だけで、公開ページは常に出す
   */
  hidesMemo?: boolean;
};
const { content: Content, status, hidesMemo = false } = Astro.props;
---

<div
  class="prose"
  data-is-published={status === PUBLISHED_STATUS.PUBLISHED}
  data-hides-memo={hidesMemo ? "" : undefined}
>
  <span id="external-link-new-tab" class="sr-only">新しいタブで開きます</span>
  <Content />
</div>

<dialog class="lightbox" aria-label="画像の拡大表示" data-lightbox>
  <div class="lightbox-track" data-lightbox-track></div>
  <button
    type="button"
    class="lightbox-control lightbox-close"
    aria-label="閉じる"
    data-lightbox-close
  >
    <Icon name="octicon:x-16" aria-hidden="true" />
  </button>
  <button
    type="button"
    class="lightbox-control lightbox-step lightbox-prev"
    aria-label="前の画像"
    data-lightbox-step="-1"
  >
    <Icon name="octicon:chevron-left-16" aria-hidden="true" />
  </button>
  <button
    type="button"
    class="lightbox-control lightbox-step lightbox-next"
    aria-label="次の画像"
    data-lightbox-step="1"
  >
    <Icon name="octicon:chevron-right-16" aria-hidden="true" />
  </button>
  <p class="lightbox-counter" aria-live="polite" data-lightbox-counter></p>
</dialog>

<script>
  import {
    observePage,
    pageSignal,
    onPageLoad,
    onPageEvent,
  } from "~/scripts/pageLifecycle";
  import { initFootnoteMark } from "~/scripts/footnoteMark";
  import { initGlossaryTerms } from "~/scripts/glossaryTerm";
  import { initLightbox } from "~/scripts/lightbox";

  onPageLoad(() => {
    const signal = pageSignal();

    initGlossaryTerms(signal);
    initFootnoteMark(signal);

    initLightbox(signal);

    // 見出し(h2/h3/h4)をリンク化
    const headingEls = document.querySelectorAll(
      ".prose h2[id], .prose h3[id], .prose h4[id]",
    );
    headingEls.forEach((headingEl) => {
      const id = (headingEl as HTMLElement).id;
      if (!id) return;
      if (headingEl.querySelector("a.heading-self-link")) return;

      const navLink = document.createElement("a");
      navLink.href = `#${id}`;
      navLink.classList.add("heading-self-link");
      // 既存の子要素をリンク内へ移動
      while (headingEl.firstChild) navLink.appendChild(headingEl.firstChild);
      headingEl.appendChild(navLink);
    });

    const memoHeading = document.querySelector(".prose h2#メモ");
    if (memoHeading && !memoHeading.closest(".prose-memo-section")) {
      const prose = memoHeading.closest<HTMLElement>(".prose");
      const isPublished = prose?.dataset.isPublished === "true";
      const memoSection = document.createElement("section");
      memoSection.className = "prose-memo-section";
      memoSection.classList.toggle("is-published", isPublished);
      memoHeading.parentNode?.insertBefore(memoSection, memoHeading);

      let currentNode = memoHeading.nextSibling;
      memoSection.appendChild(memoHeading);
      while (currentNode) {
        const nextNode = currentNode.nextSibling;
        memoSection.appendChild(currentNode);
        currentNode = nextNode;
      }

      // 画面幅の確認ではメモごと落とす。覚書は組み替えの確認に要らない
      if (prose?.dataset.hidesMemo !== undefined) {
        memoSection.remove();
      } else {
        const memoNote = document.createElement("p");
        memoNote.className = "prose-memo-note";
        memoNote.textContent = isPublished
          ? "このメモは本番にも表示されます。メモを削除するか、公開状態を変更してください。"
          : "編集用メモです。公開済みにする前に削除してください。";
        memoHeading.insertAdjacentElement("afterend", memoNote);
      }
    }

    // 横に溢れる表は、マウス以外でも送れるようフォーカスできるようにする
    // 器に包まれた表はその器を、生 HTML の表は自身を送る
    const scrollers = Array.from(
      document.querySelectorAll<HTMLElement>(
        ".prose .prose-table, .prose > table, .prose :not(.prose-table) > table",
      ),
    );
    if (scrollers.length > 0) {
      const syncScrollable = (scroller: HTMLElement) => {
        // 溢れていないうちは、意味のないタブ位置を作らない
        if (scroller.scrollWidth > scroller.clientWidth) {
          scroller.tabIndex = 0;
          scroller.setAttribute("role", "region");
          scroller.setAttribute("aria-label", "横にスクロールできる表");
          return;
        }

        scroller.removeAttribute("tabindex");
        scroller.removeAttribute("role");
        scroller.removeAttribute("aria-label");
      };

      scrollers.forEach(syncScrollable);

      const observer = observePage(
        new ResizeObserver((entries) => {
          entries.forEach((entry) =>
            syncScrollable(entry.target as HTMLElement),
          );
        }),
      );
      scrollers.forEach((scroller) => observer.observe(scroller));
    }

    /*
     * コピーボタンの出し入れ。触れたコードブロックだけ出し、ほかへ触れたら戻す。
     * hover のある端末はプラグイン側の hover 表示に任せる
     */
    const touchOnly = matchMedia("(hover: none)");

    onPageEvent(document, "pointerdown", (event) => {
      if (!touchOnly.matches) return;

      const target = event.target instanceof Element ? event.target : null;
      const block = target?.closest<HTMLElement>(".expressive-code") ?? null;

      document
        .querySelectorAll<HTMLElement>(".expressive-code[data-copy-visible]")
        .forEach((node) => {
          if (node !== block) delete node.dataset.copyVisible;
        });

      if (block) block.dataset.copyVisible = "";
    });
  });
</script>

<style is:global>
  /*
   * 画像の拡大表示。背景のスクロールは止めない。documentElement へ
   * overflow: hidden を当てると iOS では読んでいた位置が潰れ、閉じたあとに
   * 戻す動きが往復のジャンプとして見えるため。伝播は overscroll-behavior で
   * 止め、位置は最初から動かさない
   */
  .lightbox {
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: 0;
    overflow: hidden;
    overscroll-behavior: contain;
    background: transparent;
    border: 0;
    opacity: 0;
    transition:
      opacity var(--duration-feedback) ease-out,
      transform var(--duration-feedback) ease-out,
      display var(--duration-feedback) allow-discrete,
      overlay var(--duration-feedback) allow-discrete;
    transform: scale3d(0.97, 0.97, 1);
  }

  .lightbox[open] {
    opacity: 1;
    transform: none;
  }

  @starting-style {
    .lightbox[open] {
      opacity: 0;
      transform: scale3d(0.94, 0.94, 1);
    }
  }

  /* 面で覆わず、背景を透かしたまま曇らせる。彩度を少し上げて濁りを防ぐ */
  .lightbox::backdrop {
    background: rgb(17 24 39 / 0.4);
    -webkit-backdrop-filter: blur(20px) saturate(1.3);
    backdrop-filter: blur(20px) saturate(1.3);
  }

  /* 透過を減らす設定では、ぼかしをやめて素直に暗くする */
  @media (prefers-reduced-transparency: reduce) {
    .lightbox::backdrop {
      background: rgb(17 24 39 / 0.88);
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .lightbox {
      transition-duration: 0s;
      transform: none;
    }
  }

  /*
   * 送りは scroll snap に任せる。スワイプも慣性もブラウザの実装のまま使え、
   * 独自gestureを持たずに済む。縦方向は背後へ渡さない
   */
  .lightbox-track {
    display: flex;
    width: 100%;
    height: 100%;
    overflow-x: auto;
    overscroll-behavior: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    touch-action: pan-x;
    /* 画像の外は押すと閉じる面なので、閉じる意味のカーソルを出す */
    cursor: pointer;
    cursor: zoom-out;
  }

  .lightbox-track::-webkit-scrollbar {
    display: none;
  }

  .lightbox-slide {
    display: grid;
    flex: 0 0 100%;
    place-items: center;
    padding: 24px;
    scroll-snap-align: center;
    scroll-snap-stop: always;
  }

  .lightbox-slide img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    cursor: default;
  }

  /* 操作は記号と hover の薄い面だけで示す。面で押さえない */
  .lightbox-control {
    position: fixed;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    color: rgb(255 255 255 / 0.82);
    background: transparent;
    border: 0;
    border-radius: var(--radius-label);
    cursor: pointer;
    transition: background var(--duration-feedback) ease;
  }

  .lightbox-control:hover,
  .lightbox-control:focus-visible {
    color: #fff;
    background: rgb(255 255 255 / 0.14);
  }

  .lightbox-control:disabled {
    opacity: 0.3;
    cursor: default;
  }

  .lightbox-control:disabled:hover {
    background: transparent;
  }

  .lightbox-close {
    inset-block-start: 10px;
    inset-inline-end: 10px;
  }

  .lightbox-step {
    inset-block-start: 50%;
    translate: 0 -50%;
  }

  .lightbox-prev {
    inset-inline-start: 10px;
  }

  .lightbox-next {
    inset-inline-end: 10px;
  }

  .lightbox-counter {
    position: fixed;
    inset-block-end: 12px;
    inset-inline: 0;
    margin: 0;
    color: rgb(255 255 255 / 0.72);
    font-family: var(--font-machine);
    font-size: var(--text-xs);
    text-align: center;
  }

  /* 1 枚しかない記事では送りの UI を出さない */
  .lightbox[data-single="true"] .lightbox-step,
  .lightbox[data-single="true"] .lightbox-counter {
    display: none;
  }

  a:focus-visible,
  button:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }

  .prose {
    --prose-nesting-indent: 1.6em;

    width: 100%;
    max-width: var(--measure-prose);
    margin-inline: auto;
    font-size: var(--text-md);
    line-height: var(--leading-body);
    color: var(--text-primary);
  }

  @media (min-width: 768px) {
    .prose {
      font-size: 17px;
    }
  }

  /*
   * 和文の折り返し。実験的な値には寄りかからず、どのブラウザでも同じ組みに
   * なる指定を土台にする。
   *   - line-break: strict … 小書き仮名や長音符を行頭に置かない厳しめの禁則
   *   - overflow-wrap: break-word … 長い識別子や URL が measure をはみ出すのを防ぐ。
   *     anywhere と違い、まず語の区切りで折る機会を残す
   *   - text-wrap: pretty … 行末の不揃いと孤立語を減らす。Chromium と Safari 26 で効き、
   *     未対応のブラウザは既定の折り返しに落ちるだけで崩れはしない
   *   - word-break: auto-phrase … 文節の途中で折らない。未対応は normal に落ちる
   */
  /*
   * 本文は文字単位で折り返す。長い段落では文節を保つより幅を使い切るほうが
   * 行末が揃い、右の余白が残らない。文節で折るのは見出しだけに留める
   */
  .prose p,
  .prose li,
  .prose blockquote,
  .prose dd {
    line-break: strict;
    overflow-wrap: break-word;
    text-wrap: pretty;
  }

  /*
   * 見出しも本文と同じ折り返しにする。balance は行の長さを揃えるために
   * 幅を使い切らず、和文では右に余白が残りやすい
   */
  .prose h2,
  .prose h3,
  .prose h4 {
    line-break: strict;
    text-wrap: pretty;
    word-break: auto-phrase;
  }

  .prose p {
    margin: var(--space-paragraph) 0;
  }

  .prose a {
    color: var(--link);
    overflow-wrap: anywhere;
    text-decoration: underline;
    text-underline-offset: 2px;
    text-decoration-color: color-mix(in srgb, var(--link) 45%, transparent);
    transition: color 140ms ease-out;
  }

  .prose a:hover {
    color: var(--link-hover);
    text-decoration-color: currentColor;
  }

  .prose a:visited {
    color: var(--link-visited);
  }

  .prose a:active {
    color: var(--link-active);
  }

  .prose .external-link-icon {
    display: inline-block;
    width: 0.76em;
    height: 0.76em;
    margin-inline-start: 0.28em;
    color: currentColor;
    vertical-align: 0.06em;
  }

  /* マーカー。上を空けて下だけ塗り、行が詰まって見えないようにする */
  .prose mark,
  .prose .flexible-marker {
    padding: 0 0.15em;
    background: linear-gradient(
      transparent 58%,
      var(--marker-color, var(--color-marker-default)) 58%
    );
    color: inherit;
    border-radius: 1px;
  }

  .prose .flexible-marker-green {
    --marker-color: var(--color-marker-green);
  }

  .prose .flexible-marker-blue {
    --marker-color: var(--color-marker-blue);
  }

  .prose .flexible-marker-red {
    --marker-color: var(--color-marker-red);
  }

  /*
   * 脚注。語ではなく主張に付く注で、読みを止めて確かめにいくもの。
   * 本文の印は番号だけにし、末尾の一覧は番号を脇へ出して本文と読み分ける。
   * 用語の注釈（吹き出し）とは役割が違うので、見た目も混ぜない
   */
  /*
   * 飛び先を画面の中央へ置く。上端に貼り付くと前後の行が見えず、読み始める
   * 場所が分からない。scroll-margin を画面の半分ぶん取ると、飛び先はその下、
   * つまり中央に来る。固定のヘッダの下へ潜る問題も同時に消える。
   * 文書の末尾付近ではこれ以上送れないため、中央まで上がらないことがある
   */
  .prose [data-footnote-ref],
  .prose .footnotes li {
    scroll-margin-top: 50vh;
    /* 動くツールバーのぶんを除いた高さ。非対応なら上の行が残る */
    scroll-margin-top: 50dvh;
  }

  /* 本文の参照も一覧と同じ [n] の形にする。数字だけでは注だと読み取れない */
  .prose [data-footnote-ref]::before {
    content: "[";
  }

  .prose [data-footnote-ref]::after {
    content: "]";
  }

  .prose [data-footnote-ref] {
    /* inline のままだと scroll-margin が効かない環境がある */
    display: inline-block;
    /*
     * sup の line-height: 0 を継承すると、inline-block の高さが潰れて
     * 背景が細い線にしか見えなくなる。ここで数字ぶんの高さを戻す
     */
    line-height: 1;
    padding: 0.1em 0.3em;
    color: var(--link);
    font-family: var(--font-machine);
    font-size: 0.85em;
    text-decoration: none;
    border-radius: var(--radius-label);
  }

  /*
   * 一覧から戻ったとき、どこから来たのかを accent の面で示す。
   * 番号だけでは小さすぎて目に入らないので、番号を含むブロックごと塗り、
   * 番号はさらに濃くして戻り先の一点を指す。CSS で「行」は選べないため、
   * 塗れる最小の単位は段落・項目・セルになる
   */
  /* 対象の行。本文のマーカー（==で囲む記法）と同じ濃度で塗る */
  .prose .is-footnote-marked-block {
    background: var(--color-marker-default);
  }

  /* 飛び先そのものは一段濃く、戻った一点を指す */
  .prose [data-footnote-ref].is-footnote-marked {
    color: var(--text-primary);
    background: var(--color-accent);
  }

  .prose sup:has([data-footnote-ref]) {
    /* 上付きで行の高さが動くと、段落の組みが崩れる */
    line-height: 0;
  }

  .prose [data-footnote-ref]:hover,
  .prose [data-footnote-ref]:focus-visible {
    color: var(--link-hover);
    text-decoration: underline;
  }

  .prose .footnotes {
    margin-top: 48px;
    padding-top: 16px;
    border-top: 1px solid var(--border);
    color: var(--text-secondary);
    font-size: var(--text-sm);
  }

  .prose .footnotes ol {
    display: grid;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: footnote;
  }

  .prose .footnotes li {
    position: relative;
    counter-increment: footnote;
    padding-inline-start: 2.2em;
  }

  /* 番号は本文の脇へ出す。行頭を揃えて一覧として読ませる */
  .prose .footnotes li::before {
    position: absolute;
    inset-inline-start: 0;
    color: var(--text-muted);
    font-family: var(--font-machine);
    font-size: var(--text-sm);
    font-variant-numeric: tabular-nums;
    content: "[" counter(footnote) "]";
  }

  .prose .footnotes li p {
    margin: 0;
  }

  .prose .footnotes li p + p {
    margin-top: 6px;
  }

  /*
   * 戻りlinkは記号だけ。色は控えめにするが、触れる大きさは確保する
   * （hig の Touch target 最低 24px）
   */
  .prose .footnotes [data-footnote-backref] {
    display: inline-grid;
    place-items: center;
    min-width: 24px;
    min-height: 24px;
    margin-inline-start: 0.2em;
    color: var(--text-muted);
    font-family: var(--font-machine);
    font-size: 1.15em;
    line-height: 1;
    text-decoration: none;
    vertical-align: -0.3em;
  }

  .prose .footnotes [data-footnote-backref]:hover,
  .prose .footnotes [data-footnote-backref]:focus-visible {
    color: var(--link-hover);
  }

  /*
   * 用語の注釈。語に残す痕跡なので Mark の語彙（accent の短い線）で表し、
   * 単語モードを切っているときは痕跡ごと消して素の本文へ戻す
   */
  :root[data-glossary="on"] .prose .glossary-term-word {
    text-decoration: underline dotted;
    text-underline-offset: 3px;
    text-decoration-color: color-mix(
      in srgb,
      var(--color-accent) 85%,
      var(--text-muted)
    );
  }

  .prose .glossary-term-mark {
    display: none;
    position: relative;
    margin-inline-start: 0.15em;
    padding: 0;
    color: var(--text-muted);
    font-family: var(--font-machine);
    font-size: 0.78em;
    line-height: 1;
    vertical-align: 0.35em;
    background: none;
    border: 0;
    cursor: pointer;
  }

  :root[data-glossary="on"] .prose .glossary-term-mark {
    display: inline;
  }

  /* 文字が小さいので、行の高さを崩さずに触れる範囲だけ広げる */
  .prose .glossary-term-mark::after {
    position: absolute;
    inset-block-start: 50%;
    inset-inline-start: 50%;
    width: 24px;
    height: 24px;
    content: "";
    transform: translate(-50%, -50%);
  }

  .prose .glossary-term-mark:hover,
  .prose .glossary-term-mark[aria-expanded="true"] {
    color: var(--link-hover);
  }

  .prose .glossary-term-bubble {
    display: none;
    position: fixed;
    inset: auto;
    max-width: min(24rem, calc(100vw - 2rem));
    margin: 0;
    padding: 0.7em 0.9em;
    color: var(--text-primary);
    font-size: var(--text-sm);
    line-height: 1.75;
    background: var(--bg-card);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-card);
    /* accent の短い線で、本文ではなく注釈だと分かるようにする。
       浮かせる影は使わず、紙の面と罫線だけで本文から切り離す */
    border-inline-start: 2px solid var(--color-accent);
  }

  .prose .glossary-term-bubble:is(:popover-open, [data-open]) {
    display: block;
  }

  .prose .glossary-term-bubble p {
    margin: 0;
  }

  .prose strong {
    color: var(--text-primary);
    font-weight: 700;
  }

  .prose h1 {
    color: color-mix(in srgb, var(--text-primary) 82%, var(--accent-warm));
  }

  .prose h2,
  .prose h3,
  .prose h4 {
    color: var(--color-primary);
    line-height: var(--leading-heading);
    font-weight: 700;
    scroll-margin-top: 24px;
  }

  .prose h2 {
    font-size: 24px;
    margin: 48px 0 16px;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--color-border-strong);
  }

  .prose h3 {
    font-size: 20px;
    margin: 36px 0 12px;
  }

  .prose h4 {
    font-size: 17px;
    margin: 28px 0 8px;
  }

  .prose ul,
  .prose ol {
    margin: 18px 0;
    padding-left: 1.4em;
  }

  .prose ul {
    list-style: disc;
  }

  .prose ol {
    list-style: decimal;
  }

  /* 入れ子は 1 つの塊として見せたいので、外側ほど余白を取らない。
     字下げは、子の文字の頭が親の文字の頭と揃う量にする */
  .prose li > ul,
  .prose li > ol {
    margin: 2px 0;
    padding-left: 1.625em;
  }

  .prose li {
    /* 本文より詰める。行間はデジタル庁デザインシステムの推奨（150〜175%）に合わせる */
    margin: 2px 0;
    line-height: 1.75;
  }

  .prose li::marker {
    color: var(--text-muted);
  }

  /*
   * ファイル構成の箇条書きは、中黒ではなくフォルダとファイルで示す。
   * icon は装飾で、`/` と拡張子は本文に残るため、出ない環境でも読み取れる
   */
  .prose ul[data-path-list] {
    padding-inline-start: 0;
  }

  .prose li[data-path-kind] > ul[data-path-list] {
    padding-inline-start: var(--prose-nesting-indent);
  }

  .prose li[data-path-kind] {
    list-style: none;
    /* icon を項目の左端から始めるため、中黒のぶら下げ用の余白を戻す */
    padding-inline-start: 0;
    font-family: var(--font-machine);
  }

  .prose li[data-path-kind]::before {
    content: "";
    display: inline-block;
    width: 1em;
    height: 1em;
    /* 文字までの距離を字下げの刻みに合わせ、入れ子のフォルダと頭を揃える */
    margin-right: calc(var(--prose-nesting-indent) - 1em);
    /* 文字の中心へ合わせる。cap 未対応の環境向けに em での近似を先に置く */
    vertical-align: -0.15em;
    vertical-align: calc(0.5cap - 0.5em);
    background: var(--text-muted);
    -webkit-mask-image: var(--path-icon);
    mask-image: var(--path-icon);
    -webkit-mask-size: contain;
    mask-size: contain;
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
  }

  .prose li[data-path-kind="folder"] {
    --path-icon: url("data:image/svg+xml,%3Csvg%20xmlns%3D'http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg'%20viewBox%3D'0%200%2016%2016'%3E%3Cpath%20d%3D'M0%202.75C0%201.784.784%201%201.75%201H5c.55%200%201.07.26%201.4.7l.9%201.2a.25.25%200%200%200%20.2.1h6.75c.966%200%201.75.784%201.75%201.75v8.5A1.75%201.75%200%200%201%2014.25%2015H1.75A1.75%201.75%200%200%201%200%2013.25Zm1.75-.25a.25.25%200%200%200-.25.25v10.5c0%20.138.112.25.25.25h12.5a.25.25%200%200%200%20.25-.25v-8.5a.25.25%200%200%200-.25-.25H7.5c-.55%200-1.07-.26-1.4-.7l-.9-1.2a.25.25%200%200%200-.2-.1Z'%2F%3E%3C%2Fsvg%3E");
  }

  .prose li[data-path-kind="file"] {
    --path-icon: url("data:image/svg+xml,%3Csvg%20xmlns%3D'http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg'%20viewBox%3D'0%200%2016%2016'%3E%3Cpath%20d%3D'M2%201.75C2%20.784%202.784%200%203.75%200h6.586c.464%200%20.909.184%201.237.513l2.914%202.914c.329.328.513.773.513%201.237v9.586A1.75%201.75%200%200%201%2013.25%2016h-9.5A1.75%201.75%200%200%201%202%2014.25Zm1.75-.25a.25.25%200%200%200-.25.25v12.5c0%20.138.112.25.25.25h9.5a.25.25%200%200%200%20.25-.25V6h-2.75A1.75%201.75%200%200%201%209%204.25V1.5Zm6.75.062V4.25c0%20.138.112.25.25.25h2.688l-.011-.013l-2.914-2.914z'%2F%3E%3C%2Fsvg%3E");
  }

  /* チェックリストは点を出さず、チェックボックスを本文の左脇に置く */
  .prose .contains-task-list {
    list-style: none;
  }

  /*
   * チェックは記事の状態表示であって操作する部品ではない。四角い枠は押せる物の
   * 記号になるため描かず、済みはチェックの線、未完了は短い線だけを左脇へ置く。
   * disabled な input はブラウザ既定の描画が勝って灰色になるので、見た目は
   * 捨てて自前で描く。状態は支援技術へ渡す必要があるため要素自体は残す
   */
  .prose .task-list-item {
    position: relative;
  }

  .prose .task-list-item input[type="checkbox"] {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: 0;
    clip-path: inset(50%);
  }

  /* 未完了。まだ手が付いていないことを示す短い線 */
  .prose .task-list-item::before {
    position: absolute;
    inset-block-start: 0.85em;
    inset-inline-start: -1.35em;
    width: 0.62em;
    height: 1.5px;
    content: "";
    background: var(--text-muted);
    transform: translateY(-50%);
  }

  /* 済み。人が付けた痕跡なのでチェックの線で描く */
  .prose .task-list-item:has(input:checked)::before {
    inset-inline-start: -1.2em;
    width: 0.3em;
    height: 0.6em;
    background: none;
    border: solid var(--color-primary);
    border-width: 0 1.5px 1.5px 0;
    transform: translateY(-65%) rotate(45deg);
  }

  /* 表は器の側でスクロールさせ、表には最小幅を持たせる。
     table 自身を display: block にする方法だと、日本語のように任意の位置で
     折り返せる本文では列が縮んで収まってしまい、狭い画面でスクロールしない。
     左右の影は、続きがあることを示すために内容と一緒に動く背景で描く */
  .prose .prose-table {
    margin: 24px 0;
    overflow-x: auto;
    /* 端まで送ってもページごと横に流れないようにする */
    overscroll-behavior-inline: contain;
    background:
      linear-gradient(to right, var(--bg-base) 40%, transparent) left center /
        28px 100% no-repeat local,
      linear-gradient(to left, var(--bg-base) 40%, transparent) right center /
        28px 100% no-repeat local,
      radial-gradient(farthest-side at 0 50%, rgb(0 0 0 / 0.1), transparent)
        left center / 14px 100% no-repeat scroll,
      radial-gradient(farthest-side at 100% 50%, rgb(0 0 0 / 0.1), transparent)
        right center / 14px 100% no-repeat scroll;
  }

  .prose .prose-table > table {
    width: 100%;
    /* 狭い画面では必ず溢れさせ、横スクロールで読ませる */
    min-width: 30rem;
    margin: 0;
  }

  /* 生 HTML で直接書かれた表は器に包めないため、従来どおり自身で送る */
  .prose table {
    display: block;
    width: max-content;
    max-width: 100%;
    margin: 24px 0;
    overflow-x: auto;
    overscroll-behavior-inline: contain;
    border-collapse: collapse;
    font-variant-numeric: tabular-nums;
  }

  .prose .prose-table > table {
    display: table;
    max-width: none;
    overflow: visible;
  }

  /* キーボードで送れるよう、溢れる表には script が tabindex を付ける */
  .prose .prose-table:focus-visible,
  .prose table:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  .prose th,
  .prose td {
    padding: 8px 12px;
    border: 1px solid var(--border);
    text-align: left;
    vertical-align: top;
  }

  /* 上ヘッダ（thead）と左ヘッダ（th scope="row"）を同じ見た目に揃える */
  .prose th {
    background: var(--bg-subtle);
    font-weight: 600;
  }

  /* 行見出しは横に送っても左端へ残す。
     border-collapse では固定セルの罫線が消えるため、影で引き直す。
     器へ収めるときブラウザは先頭列から潰すため、2文字の見出しでも折り返る。
     下限だけ持たせて、長い見出しは従来どおり折り返させる */
  .prose th[scope="row"] {
    position: sticky;
    left: 0;
    z-index: 1;
    min-width: 6em;
    box-shadow: inset -1px 0 var(--border);
  }

  /* 行をたどりやすくする */
  .prose tr:hover td {
    background: var(--bg-subtle);
  }

  /* トグル。三角と文字の間、そして中身の字下げを同じ幅で揃える */
  .prose details {
    --details-indent: var(--prose-nesting-indent);
    /* 中身の高さを auto へ動かすための許可。未対応ブラウザは即時開閉になる */
    interpolate-size: allow-keywords;
    margin: 24px 0;
  }

  .prose details > summary {
    position: relative;
    padding-left: var(--details-indent);
    list-style: none;
    color: var(--text-primary);
    font-weight: 600;
    cursor: pointer;
  }

  /* Safari は list-style を無視するため、marker も個別に消す */
  .prose details > summary::-webkit-details-marker {
    display: none;
  }

  .prose details > summary:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 3px;
    border-radius: 2px;
  }

  /* 文字の三角は細いので図形で描く。回転させても中心がぶれない形にする */
  .prose details > summary::before {
    content: "";
    position: absolute;
    /* 1 行分の高さの中央に合わせる。lh 未対応の環境向けに em での近似を先に置く */
    top: 0.95em;
    top: 0.5lh;
    left: 0.08em;
    translate: 0 -50%;
    width: 0.62em;
    height: 0.62em;
    background: var(--text-muted);
    clip-path: polygon(20% 0%, 20% 100%, 92% 50%);
    transition:
      rotate 160ms ease,
      background-color 160ms ease;
  }

  .prose details[open] > summary::before {
    rotate: 90deg;
  }

  .prose details > summary:hover::before {
    background: var(--color-interaction-text);
  }

  /*
   * フォルダのトグルは、三角ではなく開閉するフォルダで示す。
   * 中身が増えるのではなく、既にある場所を開く操作だと分かるようにする
   */
  .prose details[data-icon="folder"] > summary::before {
    /* 三角と違い icon は字面いっぱいなので、項目の左端から始める */
    left: 0;
    width: 1em;
    height: 1em;
    background: var(--text-muted);
    clip-path: none;
    -webkit-mask-image: url("data:image/svg+xml,%3Csvg%20xmlns%3D'http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg'%20viewBox%3D'0%200%2016%2016'%3E%3Cpath%20d%3D'M1.75%201A1.75%201.75%200%200%200%200%202.75v10.5C0%2014.216.784%2015%201.75%2015h12.5A1.75%201.75%200%200%200%2016%2013.25v-8.5A1.75%201.75%200%200%200%2014.25%203H7.5a.25.25%200%200%201-.2-.1l-.9-1.2C6.07%201.26%205.55%201%205%201z'%2F%3E%3C%2Fsvg%3E");
    mask-image: url("data:image/svg+xml,%3Csvg%20xmlns%3D'http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg'%20viewBox%3D'0%200%2016%2016'%3E%3Cpath%20d%3D'M1.75%201A1.75%201.75%200%200%200%200%202.75v10.5C0%2014.216.784%2015%201.75%2015h12.5A1.75%201.75%200%200%200%2016%2013.25v-8.5A1.75%201.75%200%200%200%2014.25%203H7.5a.25.25%200%200%201-.2-.1l-.9-1.2C6.07%201.26%205.55%201%205%201z'%2F%3E%3C%2Fsvg%3E");
    -webkit-mask-size: contain;
    mask-size: contain;
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    /* 形が変わるので、三角のような回転はしない */
    rotate: none;
  }

  .prose details[data-icon="folder"][open] > summary::before {
    rotate: none;
    -webkit-mask-image: url("data:image/svg+xml,%3Csvg%20xmlns%3D'http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg'%20viewBox%3D'0%200%2016%2016'%3E%3Cpath%20d%3D'M.513%201.513A1.75%201.75%200%200%201%201.75%201h3.5c.55%200%201.07.26%201.4.7l.9%201.2a.25.25%200%200%200%20.2.1H13a1%201%200%200%201%201%201v.5H2.75a.75.75%200%200%200%200%201.5h11.978a1%201%200%200%201%20.994%201.117L15%2013.25A1.75%201.75%200%200%201%2013.25%2015H1.75A1.75%201.75%200%200%201%200%2013.25V2.75c0-.464.184-.91.513-1.237'%2F%3E%3C%2Fsvg%3E");
    mask-image: url("data:image/svg+xml,%3Csvg%20xmlns%3D'http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg'%20viewBox%3D'0%200%2016%2016'%3E%3Cpath%20d%3D'M.513%201.513A1.75%201.75%200%200%201%201.75%201h3.5c.55%200%201.07.26%201.4.7l.9%201.2a.25.25%200%200%200%20.2.1H13a1%201%200%200%201%201%201v.5H2.75a.75.75%200%200%200%200%201.5h11.978a1%201%200%200%201%20.994%201.117L15%2013.25A1.75%201.75%200%200%201%2013.25%2015H1.75A1.75%201.75%200%200%201%200%2013.25V2.75c0-.464.184-.91.513-1.237'%2F%3E%3C%2Fsvg%3E");
  }

  /* 開閉を滑らかにする。未対応ブラウザではこの指定ごと無視される */
  .prose details::details-content {
    block-size: 0;
    overflow: hidden;
    transition:
      block-size 200ms ease,
      content-visibility 200ms allow-discrete;
  }

  .prose details[open]::details-content {
    block-size: auto;
  }

  @media (prefers-reduced-motion: reduce) {
    .prose details > summary::before,
    .prose details::details-content {
      transition: none;
    }
  }

  .prose details > summary:hover {
    color: var(--color-interaction-text);
  }

  /* 中身は三角の幅だけ下げて、トグルの外の文章と見分けられるようにする */
  .prose details > :not(summary) {
    margin-left: var(--details-indent);
  }

  /* first-of-type では要素種別ごとの先頭に効くため、summary 直後だけを対象にする */
  .prose details > summary + * {
    margin-top: 8px;
  }

  /* フォルダツリーは通常ブロックの余白を持ち込まず、リストの入れ子と同じ間隔にする */
  .prose details[data-icon="folder"] > ul[data-path-list],
  .prose details[data-icon="folder"] > details[data-icon="folder"] {
    margin-block: 2px;
    margin-inline-start: var(--details-indent);
  }

  .prose details[data-icon="folder"] > summary + ul[data-path-list],
  .prose details[data-icon="folder"] > summary + details[data-icon="folder"] {
    margin-block-start: 8px;
  }

  /* 区切りは面ではなく Line と余白で強さを分ける（design/DESIGN.md 固有ルール5） */
  .prose hr {
    height: 0;
    margin: 40px 0;
    border: 0;
    border-top: 1px solid var(--border);
  }

  /* 章の切れ目。線を短くし、前後の余白で段を大きく取る */
  .prose hr[data-divider="chapter"] {
    width: 4em;
    margin: 72px 0;
    border-top: 2px solid var(--border-strong);
  }

  /*
   * ラベル付き。見た目はメモ欄の見出しと同じ「語 + Line」に揃える。
   * 余白も見出しに倣って非対称にする。上は hr と同じだけ空けて区切りとして
   * 働かせ、下は詰めてラベルを直後の本文に結びつける。
   */
  .prose [data-divider="labeled"] {
    margin: 40px 0 12px;
  }

  /*
   * 引用は面ではなく線で示す。地を塗ると本文の紙が途切れて別の箱に見え、
   * 注釈（markdown-alert）との区別も付きにくい。縦の罫線だけを引いて、
   * 本文の流れに乗せたまま出どころが別であることを示す。
   */
  .prose blockquote {
    margin: 24px 0;
    padding: 4px 0 4px 16px;
    border: 0;
    border-left: 2px solid var(--color-border-strong);
    background: none;
    color: var(--text-primary);
  }

  .prose blockquote p {
    margin: 0.5em 0;
  }

  .prose blockquote > :first-child {
    margin-top: 0;
  }

  .prose blockquote > :last-child {
    margin-bottom: 0;
  }

  /* inline code: 本文に馴染ませる (design ui-patterns Code Block / Inline Code) */
  .prose :not(pre) > code {
    font-family: var(--font-mono);
    font-size: 0.94em;
    padding: 0.1em 0.4em;
    margin-inline: 2px;
    border-radius: var(--radius-label);
    background: var(--bg-subtle);
    border: 1px solid var(--border);
    color: var(--text-primary);
  }

  /* コードの前後の擬似要素（` `）を非表示にする */
  .prose code::before,
  .prose code::after {
    content: none;
    display: none;
  }

  /* code block は astro-expressive-code に委ねる。素の pre の余白だけ整える */
  .prose pre {
    margin: 24px 0;
    overflow-x: auto;
  }

  .prose .expressive-code {
    --ec-codeFontFml: var(--font-machine);
    --ec-uiFontFml: var(--font-human);
    width: 100%;
    max-width: 100%;
    margin: 24px 0;
  }

  .prose .expressive-code .copy {
    --copy-done-icon: url("data:image/svg+xml,%3Csvg%20xmlns%3D'http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg'%20viewBox%3D'0%200%2016%2016'%3E%3Cpath%20d%3D'M13.78%204.22a.75.75%200%200%201%200%201.06l-7.25%207.25a.75.75%200%200%201-1.06%200L2.22%209.28a.75.75%200%200%201%20.018-1.042a.75.75%200%200%201%201.042-.018L6%2010.94l6.72-6.72a.75.75%200%200%201%201.06%200'%2F%3E%3C%2Fsvg%3E");
  }

  .prose .expressive-code .copy button {
    border-radius: var(--radius-label);
  }

  /*
   * コピーボタンは hover のない端末でだけ大きく描かれる。プラグイン側が
   * ボタンを 2rem から 2.5rem へ広げる一方、アイコンの余白は 0.475rem のままで、
   * 描画サイズが 16.8px から 24.8px へ跳ねる。操作 icon は 16–18px という規定
   * （design/foundations.md）を外れ、SP だけ本文より大きな図形になる。
   * 触りやすさのための 2.5rem は保ち、アイコンだけ hover 環境と同じ寸法へ戻す
   */
  @media (hover: none) {
    .prose .expressive-code .copy button::after {
      margin: 0.725rem;
    }

    /*
     * hover のある端末では、プラグインが枠に触れるまでボタンを隠す。
     * hover のない端末では出しっぱなしになり、コードの上に常にボタンが乗る。
     * 読む邪魔になるので、そのブロックに触れるまでは同じように隠す。
     * 隠している間は指を通し、一度目のタップで出して二度目でコピーさせる
     */
    .prose .expressive-code .copy button {
      opacity: 0;
      pointer-events: none;
      transition: opacity var(--duration-feedback) ease;
    }

    .prose .expressive-code[data-copy-visible] .copy button {
      opacity: 0.75;
      pointer-events: auto;
    }
  }

  .prose .expressive-code .copy:has(.feedback.show) button::after {
    background-color: var(--color-accent);
    -webkit-mask-image: var(--copy-done-icon);
    mask-image: var(--copy-done-icon);
  }

  .prose .expressive-code .copy .feedback {
    width: 1px;
    height: 1px;
    margin-inline-end: 0;
    padding: 0;
    overflow: hidden;
    background-color: transparent;
    clip-path: inset(50%);
  }

  .prose .expressive-code .copy .feedback::after {
    content: none;
  }

  .prose [data-filename] {
    position: relative;
  }
  .prose [data-filename]::before {
    content: attr(data-filename);
    position: absolute;
    top: -22px;
    left: 0;
    background-color: var(--bg-code);
    color: var(--c-code-text, #e9e3d7);
    font-size: 0.75rem;
    padding: 0.25rem 0.5rem;
    border-top-left-radius: var(--radius-label);
    border-top-right-radius: var(--radius-label);
  }
  .prose [data-filename] pre {
    margin-top: 30px;
  }

  .prose img {
    width: 100%;
    height: auto;
    max-width: var(--measure-prose);
    max-height: 520px;
    object-fit: contain;
    margin: 24px auto;
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    /*
     * 押すと拡大表示が開くことを示す。zoom-in を描画しない環境では宣言ごと
     * 捨てられ、前の行の pointer が残る
     */
    cursor: pointer;
    cursor: zoom-in;
