---
/*
 * 不可逆な削除の確認面。design/hig.md の `button.destructive` に従い、
 * 塗りつぶしの danger はここの実行ボタンだけが持つ。トリガー側は静かなまま。
 * ページに一つだけ置き、一覧からも記事からも同じものを開く。
 */
---

<dialog
  class="delete-dialog"
  aria-labelledby="delete-dialog-title"
  data-delete-dialog
>
  <div class="delete-panel">
    <h2 class="delete-title" id="delete-dialog-title">記事を削除</h2>
    <p class="delete-target" data-delete-target></p>
    <p class="delete-note">md ファイルを消します。この操作は取り消せません。</p>
    <p class="delete-status" role="status" aria-live="polite" data-delete-status>
    </p>

    <div class="delete-actions">
      <button type="button" class="delete-cancel" data-delete-cancel>
        キャンセル
      </button>
      <button type="button" class="delete-run" data-delete-run>削除</button>
    </div>
  </div>
</dialog>

<style>
  .delete-dialog {
    position: fixed;
    inset-block-start: 16vh;
    inset-inline: 0;
    width: min(420px, calc(100vw - 32px));
    margin-inline: auto;
    padding: 0;
    color: var(--color-text);
    background: var(--color-background);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    box-shadow: 0 18px 48px rgb(31 41 55 / 18%);
  }

  .delete-dialog:not([open]) {
    display: none;
  }

  /* 消える対象が背後に見えていたほうが、何を消すのか確かめられる */
  .delete-dialog::backdrop {
    background: rgb(17 24 39 / 18%);
  }

  .delete-panel {
    padding: 20px;
  }

  .delete-title {
    margin: 0;
    color: var(--danger);
    font-size: var(--text-md);
    font-weight: 700;
  }

  /* 取り違えを防ぐ手掛かりは色ではなく、この名前が担う */
  .delete-target {
    margin: 12px 0 0;
    color: var(--text-primary);
    font-size: var(--text-sm);
    font-weight: 700;
    overflow-wrap: anywhere;
  }

  .delete-note {
    margin: 6px 0 0;
    color: var(--text-secondary);
    font-size: var(--text-sm);
  }

  .delete-status {
    margin: 10px 0 0;
    min-height: 1.4em;
    color: var(--danger-text);
    font-size: var(--text-sm);
  }

  .delete-actions {
    display: flex;
    justify-content: flex-end;
    /* 実行と取りやめを指一本ぶん離す。押し間違いの余地を減らす */
    gap: 16px;
    margin-top: 20px;
  }

  .delete-cancel,
  .delete-run {
    min-height: 34px;
    padding: 0 16px;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-label);
    font-family: inherit;
    font-size: var(--text-sm);
    cursor: pointer;
  }

  .delete-cancel {
    color: var(--text-secondary);
    background: transparent;
  }

  .delete-cancel:hover,
  .delete-cancel:focus-visible {
    background: var(--bg-subtle);
    color: var(--text-primary);
  }

  /* 塗りつぶしの danger はここだけ。hig.md button.destructive */
  .delete-run {
    color: var(--danger-on-surface);
    background: var(--danger-surface);
    border-color: var(--danger-border);
  }

  .delete-run:hover,
  .delete-run:focus-visible {
    /* 面の濃さは変えず、輪郭を締める。赤をこれ以上強くしない */
    box-shadow: 0 0 0 1px var(--danger-border);
  }

  .delete-run:active {
    /* 押している最中だけ沈める */
    background: color-mix(in srgb, var(--danger-surface) 84%, #000);
  }

  .delete-run:disabled,
  .delete-cancel:disabled {
    opacity: 0.55;
    cursor: progress;
  }

  @media (max-width: 639px) {
    .delete-cancel,
    .delete-run {
      /* 指で触る操作子の下限（design/hig.md Interaction） */
      min-height: 44px;
    }
  }
</style>
