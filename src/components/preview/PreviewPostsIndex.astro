                            value={value}
                            selected={value === previewPost.data.priority}
                          >
                            {POST_PRIORITY_LABELS[value]}
                          </option>
                        ))}
                      </select>
                    </span>
                  </td>
                  <td data-label="執筆状態">
                    <select
                      class="preview-cell-select"
                      aria-label={`${previewPost.data.title} の執筆状態`}
                      data-edit-select="writingStatus"
                    >
                      {writingStatuses.map((value) => (
                        <option
                          value={value}
                          selected={value === previewPost.data.writingStatus}
                        >
                          {WRITING_STATUS_LABELS[value]}
                        </option>
                      ))}
                    </select>
                  </td>
                  <td data-label="公開状態">
                    <select
                      class="preview-cell-select"
                      aria-label={`${previewPost.data.title} の公開状態`}
                      data-edit-select="status"
                    >
                      {publishedStatuses.map((value) => (
                        <option
                          value={value}
                          selected={value === previewPost.data.status}
                        >
                          {PUBLISHED_STATUS_LABELS[value]}
                        </option>
                      ))}
                    </select>
                  </td>
                  <td data-label="メモ状態">
                    <span class="preview-status-badge preview-memo-badge">
                      {MEMO_STATE_LABELS[previewPost.memoState]}
                    </span>
                  </td>
                  <td class="preview-date-cell" data-label="更新日">
                    <input
                      type="date"
                      class="preview-cell-date"
                      value={previewPost.data.updatedAt
                        .toISOString()
                        .slice(0, 10)}
                      aria-label={`${previewPost.data.title} の更新日`}
                      data-edit-date
                    />
                  </td>
                </tr>
              );
            })
          }
        </tbody>
      </table>
    </div>

    <p class="preview-empty" data-empty-state hidden>
      条件に合う記事がありません。
      <button type="button" data-clear-all>条件をすべて解除</button>
    </p>
  </main>
</preview-posts>

