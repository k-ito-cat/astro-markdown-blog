---
import type { CollectionEntry } from "astro:content";
import { Icon } from "astro-icon/components";
import {
  POST_PRIORITY,
  POST_PRIORITY_LABELS,
  POST_PRIORITY_ORDER,
} from "~/constants/postPriority";
import {
  PUBLISHED_STATUS,
  PUBLISHED_STATUS_LABELS,
} from "~/constants/publishedStatus";
import {
  WRITING_STATUS,
  WRITING_STATUS_LABELS,
  WRITING_STATUS_ORDER,
} from "~/constants/writingStatus";
import { detectMemoState } from "~/utils/postMemo.js";
import { getPreviewPostIssues, type MemoState } from "~/utils/previewPost";
import { normalizePostSlug } from "~/utils/postSlug";

type Props = {
  posts: CollectionEntry<"posts">[];
};

const { posts } = Astro.props;

const MEMO_STATE_LABELS = {
  HAS_MEMO: "メモあり",
  EMPTY_MEMO: "空メモ",
  NO_MEMO: "メモなし",
  BROKEN_MEMO: "メモ不正",
} as const;

const normalizeSearchText = (value: string) =>
  value.normalize("NFKC").toLocaleLowerCase("ja");

const previewPosts = posts
  .map((post) => {
    const memoState = detectMemoState(post.body ?? "") as MemoState;
    const issues = getPreviewPostIssues({
      status: post.data.status,
      writingStatus: post.data.writingStatus,
      priority: post.data.priority,
      memoState,
    });
    const previewSlug = normalizePostSlug(post.id);

    return {
      ...post,
      previewSlug,
      memoState,
      issues,
      searchText: normalizeSearchText(
        [
          post.data.title,
          previewSlug,
          ...post.data.categories,
          ...post.data.tags,
        ].join(" "),
      ),
    };
  })
  .sort((a, b) => {
    const priorityDiff =
      POST_PRIORITY_ORDER[a.data.priority] -
      POST_PRIORITY_ORDER[b.data.priority];
    if (priorityDiff !== 0) return priorityDiff;

    const writingStatusDiff =
      WRITING_STATUS_ORDER[a.data.writingStatus] -
      WRITING_STATUS_ORDER[b.data.writingStatus];
    if (writingStatusDiff !== 0) return writingStatusDiff;

    return a.data.title.localeCompare(b.data.title, "ja");
  });

const priorities = Object.values(POST_PRIORITY).sort(
  (a, b) => POST_PRIORITY_ORDER[a] - POST_PRIORITY_ORDER[b],
);

const categories = Array.from(
  new Set(previewPosts.flatMap((post) => post.data.categories)),
).sort((a, b) => a.localeCompare(b, "ja"));

const tags = Array.from(
  new Set(previewPosts.flatMap((post) => post.data.tags)),
).sort((a, b) => a.localeCompare(b, "ja"));

const publishedMemoCount = previewPosts.filter(
  (post) =>
    post.data.status === PUBLISHED_STATUS.PUBLISHED &&
    post.memoState !== "NO_MEMO",
).length;
const publishedMemoFilterParams = new URLSearchParams({
  publication: PUBLISHED_STATUS.PUBLISHED,
});
["HAS_MEMO", "EMPTY_MEMO", "BROKEN_MEMO"].forEach((memoState) => {
  publishedMemoFilterParams.append("memo", memoState);
});
---

<preview-posts
  class="preview-posts"
  data-total={previewPosts.length}
  data-group="priority"
>
  <main class="preview-shell">
    <header class="preview-header">
      <div>
        <p class="preview-eyebrow">Local Preview</p>
        <h1 class="preview-title">記事プレビュー</h1>
      </div>
      <div class="preview-header-meta">
        <span class="preview-count" data-result-count aria-live="polite">
          表示中 {previewPosts.length} / 全{previewPosts.length}件
        </span>
        <a href="/blog" class="preview-blog-link">ブログ一覧</a>
      </div>
    </header>

    {
      publishedMemoCount > 0 && (
        <section
          class="preview-publication-warning"
          aria-labelledby="preview-publication-warning-title"
        >
          <Icon
            name="octicon:alert-16"
            class="preview-publication-warning-icon"
          />
          <div class="preview-publication-warning-copy">
            <h2 id="preview-publication-warning-title">
              公開済みの記事{publishedMemoCount}件にメモ欄が残っています
            </h2>
            <p>メモは本番ページにも表示されます。</p>
          </div>
          <a href={`/preview/posts?${publishedMemoFilterParams.toString()}`}>
            対象を表示
          </a>
        </section>
      )
    }

    <form class="preview-tools" data-preview-controls>
      <label class="preview-field preview-search-field">
        <span class="preview-field-label">検索</span>
        <span class="preview-search-control">
          <Icon name="octicon:search-16" class="preview-search-icon" />
          <input
            type="search"
            name="q"
            class="preview-search-input"
            placeholder="タイトル・カテゴリ・slug"
            autocomplete="off"
            data-search-input
          />
        </span>
      </label>

      <label class="preview-field">
        <span class="preview-field-label">グループ</span>
        <select name="group" class="preview-select" data-group-select>
          <option value="priority">優先度</option>
          <option value="writing">執筆状態</option>
          <option value="publication">公開状態</option>
          <option value="none">グループなし</option>
        </select>
      </label>

      <label class="preview-field">
        <span class="preview-field-label">並び順</span>
        <select name="sort" class="preview-select" data-sort-select>
          <option value="recommended">推奨順</option>
          <option value="updated-desc">更新日が新しい順</option>
          <option value="updated-asc">更新日が古い順</option>
          <option value="title">タイトル順</option>
          <option value="priority">優先度順</option>
        </select>
      </label>

      <details class="preview-filters" data-filter-details>
        <summary class="preview-filter-summary">
          絞り込み
          <span class="preview-filter-count" data-filter-count hidden></span>
        </summary>
        <div class="preview-filter-panel">
          <fieldset class="preview-filter-group">
            <legend>優先度</legend>
            <div class="preview-checkbox-list">
              {
                priorities.map((priority) => (
                  <label>
                    <input
                      type="checkbox"
                      name="priority"
                      value={priority}
                      data-filter-key="priority"
                    />
                    <span>{POST_PRIORITY_LABELS[priority]}</span>
                  </label>
                ))
              }
            </div>
          </fieldset>

          <fieldset class="preview-filter-group">
            <legend>執筆状態</legend>
            <div class="preview-checkbox-list">
              {
                Object.values(WRITING_STATUS).map((writingStatus) => (
                  <label>
                    <input
                      type="checkbox"
                      name="writing"
                      value={writingStatus}
                      data-filter-key="writing"
                    />
                    <span>{WRITING_STATUS_LABELS[writingStatus]}</span>
                  </label>
                ))
              }
            </div>
          </fieldset>

          <fieldset class="preview-filter-group">
            <legend>公開状態</legend>
            <div class="preview-checkbox-list">
              {
                Object.values(PUBLISHED_STATUS).map((status) => (
                  <label>
                    <input
                      type="checkbox"
                      name="publication"
                      value={status}
                      data-filter-key="publication"
                    />
                    <span>{PUBLISHED_STATUS_LABELS[status]}</span>
                  </label>
                ))
              }
            </div>
          </fieldset>

          <fieldset class="preview-filter-group">
            <legend>メモ状態</legend>
            <div class="preview-checkbox-list">
              {
                Object.entries(MEMO_STATE_LABELS).map(([memoState, label]) => (
                  <label>
                    <input
                      type="checkbox"
                      name="memo"
                      value={memoState}
                      data-filter-key="memo"
                    />
                    <span>{label}</span>
                  </label>
                ))
              }
            </div>
          </fieldset>

          <fieldset class="preview-filter-group preview-category-filter">
            <legend>カテゴリ</legend>
            <div class="preview-checkbox-list preview-category-list">
              {
                categories.map((category) => (
                  <label>
                    <input
                      type="checkbox"
                      name="category"
                      value={category}
                      data-filter-key="category"
                    />
                    <span>{category}</span>
                  </label>
                ))
              }
            </div>
          </fieldset>

          <fieldset class="preview-filter-group preview-category-filter">
            <legend>タグ</legend>
            <div class="preview-checkbox-list preview-category-list">
              {
                tags.map((tag) => (
                  <label>
                    <input
                      type="checkbox"
                      name="tag"
                      value={tag}
                      data-filter-key="tag"
                    />
                    <span>{tag}</span>
                  </label>
                ))
              }
            </div>
          </fieldset>

          <label class="preview-review-filter">
            <input
              type="checkbox"
              name="issues"
              value="only"
              data-issues-only
            />
            <span>要確認の記事だけ表示</span>
          </label>

          <button type="button" class="preview-filter-clear" data-filter-clear>
            絞り込みを解除
          </button>
        </div>
      </details>
    </form>

    <div class="preview-active-filters" data-active-filters hidden>
      <div class="preview-filter-chips" data-filter-chips></div>
      <button type="button" class="preview-clear-all" data-clear-all>
        条件をすべて解除
      </button>
    </div>

    <div class="preview-table-wrap" data-table-wrap>
      <table class="preview-table">
        <caption class="sr-only"> ローカルプレビュー用の記事管理一覧 </caption>
        <thead>
          <tr>
            <th scope="col">タイトル</th>
            <th scope="col" class="preview-priority-column">優先度</th>
            <th scope="col">執筆状態</th>
            <th scope="col">公開状態</th>
            <th scope="col">更新日</th>
          </tr>
        </thead>
        {
          priorities.map((priority) => {
            const groupPosts = previewPosts.filter(
              (post) => post.data.priority === priority,
            );
            const visibleCount = groupPosts.length;

            if (groupPosts.length === 0) return null;

            return (
              <tbody
                class="preview-post-group"
                data-post-group
                hidden={visibleCount === 0}
              >
                <tr class="preview-group-row">
                  <th colspan="5" scope="rowgroup">
                    <button
                      type="button"
                      class="preview-group-toggle"
                      data-group-toggle={priority}
                      aria-expanded="true"
                    >
                      <span class="preview-group-chevron" aria-hidden="true">
                        ▾
                      </span>
                      <span>{POST_PRIORITY_LABELS[priority]}</span>
                      <span class="preview-group-count">{visibleCount}件</span>
                    </button>
                  </th>
                </tr>
                {groupPosts.map((previewPost) => {
                  const issueTooltipId = `preview-issues-${encodeURIComponent(
                    previewPost.id,
                  ).replaceAll("%", "")}`;
                  return (
                    <tr
                      class="preview-post-row"
                      data-post-row
                      data-title={previewPost.data.title}
                      data-search={previewPost.searchText}
                      data-priority={previewPost.data.priority}
                      data-writing={previewPost.data.writingStatus}
                      data-publication={previewPost.data.status}
                      data-memo={previewPost.memoState}
                      data-categories={JSON.stringify(
                        previewPost.data.categories,
                      )}
                      data-tags={JSON.stringify(previewPost.data.tags)}
                      data-updated={previewPost.data.updatedAt
                        .toISOString()
                        .slice(0, 10)}
                      data-issues={JSON.stringify(previewPost.issues)}
                    >
                      <th
                        scope="row"
                        class="preview-title-cell"
                        data-label="タイトル"
                      >
                        <a
                          href={`/preview/posts/${previewPost.previewSlug}`}
                          class="preview-post-link"
                        >
                          {previewPost.data.title}
                        </a>
                        {previewPost.issues.length > 0 && (
                          <span
                            class="preview-issue preview-tooltip-anchor"
                            data-tooltip-anchor
                          >
                            <button
                              type="button"
                              class="preview-issue-trigger"
                              aria-describedby={issueTooltipId}
                            >
                              要確認
                            </button>
                            <span
                              id={issueTooltipId}
                              class="preview-tooltip preview-issue-tooltip"
                              role="tooltip"
                            >
                              <strong>確認理由</strong>
                              {previewPost.issues.map((issue) => (
                                <span class="preview-tooltip-item">
                                  ・{issue}
                                </span>
                              ))}
                            </span>
                          </span>
                        )}
                        <span class="preview-title-meta">
                          {previewPost.data.categories.join(" · ")}
                        </span>
                      </th>
                      <td class="preview-priority-column" data-label="優先度">
                        <span class="preview-priority">
                          <span
                            class="preview-priority-dot"
                            data-priority-value={previewPost.data.priority}
                            aria-hidden="true"
                          />
                          <span>
                            {POST_PRIORITY_LABELS[previewPost.data.priority]}
                          </span>
                        </span>
                      </td>
                      <td data-label="執筆状態">
                        <span class="preview-status-text">
                          {
                            WRITING_STATUS_LABELS[
                              previewPost.data.writingStatus
                            ]
                          }
                        </span>
                      </td>
                      <td data-label="公開状態">
                        <span class="preview-status-text">
                          {PUBLISHED_STATUS_LABELS[previewPost.data.status]}
                        </span>
                      </td>
                      <td class="preview-date-cell" data-label="更新日">
                        {previewPost.data.updatedAt.toISOString().slice(0, 10)}
                      </td>
                    </tr>
                  );
                })}
              </tbody>
            );
          })
        }
      </table>
    </div>

    <p class="preview-empty" data-empty-state hidden>
      条件に合う記事がありません。
      <button type="button" data-clear-all>条件をすべて解除</button>
    </p>
  </main>
</preview-posts>

<style is:global>
  .preview-shell {
    width: 100%;
    max-width: var(--max-width-pc);
    margin: 0 auto;
    padding: 28px 16px 48px;
  }

  .preview-header {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 20px;
  }

  .preview-eyebrow {
    margin: 0 0 4px;
    color: var(--text-muted);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .preview-title {
    margin: 0;
    color: var(--text-primary);
    font-size: 28px;
    font-weight: 700;
  }

  .preview-header-meta {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .preview-count {
    color: var(--text-muted);
    font-size: 13px;
    font-variant-numeric: tabular-nums;
  }

  .preview-blog-link {
    padding: 6px 10px;
    color: var(--link);
    background: var(--bg-card);
    border-radius: var(--radius-label);
    font-size: 13px;
    font-weight: 500;
    text-decoration: none;
  }

  .preview-blog-link:hover {
    color: var(--link-hover);
    background: var(--bg-hover);
  }

  .preview-publication-warning {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 5px 9px;
    margin-bottom: 18px;
    padding: 10px 12px;
    color: var(--warning-text);
    background: var(--warning-bg);
    border-left: 2px solid var(--warning);
  }

  .preview-publication-warning-icon {
    margin-top: 2px;
    color: var(--warning);
  }

  .preview-publication-warning-copy h2,
  .preview-publication-warning-copy p {
    margin: 0;
  }

  .preview-publication-warning-copy h2 {
    font-size: 13px;
    font-weight: 600;
  }

  .preview-publication-warning-copy p {
    margin-top: 2px;
    color: var(--text-secondary);
    font-size: 12px;
  }

  .preview-publication-warning > a {
    grid-column: 2;
    justify-self: start;
    color: var(--link);
    font-size: 12px;
    text-underline-offset: 3px;
  }

  .preview-tools {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 10px;
  }

  .preview-field {
    display: grid;
    gap: 5px;
    min-width: 0;
  }

  .preview-field-label {
    color: var(--text-muted);
    font-size: 12px;
    font-weight: 600;
  }

  .preview-search-control {
    display: flex;
    align-items: center;
    gap: 7px;
    min-width: 0;
    height: 40px;
    padding: 0 10px;
    background: var(--bg-base);
    border: 1px solid var(--border);
    border-radius: var(--radius-label);
  }

  .preview-search-control:focus-within {
    border-color: var(--focus);
  }

  .preview-search-icon {
    flex: none;
    color: var(--text-muted);
  }

  .preview-search-input {
    flex: 1;
    min-width: 0;
    height: 100%;
    color: var(--text-primary);
    background: transparent;
    border: 0;
    outline: 0;
    font-size: 14px;
  }

  .preview-search-input::placeholder {
    color: var(--text-muted);
  }

  .preview-select {
    width: 100%;
    height: 40px;
    padding: 0 10px;
    color: var(--text-primary);
    background: var(--bg-base);
    border: 1px solid var(--border);
    border-radius: var(--radius-label);
    font-size: 14px;
  }

  .preview-filters {
    position: relative;
    align-self: end;
  }

  .preview-filter-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    height: 40px;
    padding: 0 12px;
    color: var(--text-primary);
    background: var(--bg-base);
    border: 1px solid var(--border);
    border-radius: var(--radius-label);
    cursor: pointer;
    font-size: 14px;
    list-style: none;
  }

  .preview-filter-summary::-webkit-details-marker {
    display: none;
  }

  .preview-filter-summary::after {
    content: "▾";
    color: var(--text-muted);
  }

  .preview-filters[open] .preview-filter-summary::after {
    transform: rotate(180deg);
  }

  .preview-filter-count {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 20px;
    height: 20px;
    margin-left: auto;
    padding: 0 6px;
    color: var(--text-primary);
    background: var(--bg-selection);
    border-radius: 999px;
    font-size: 11px;
    font-variant-numeric: tabular-nums;
  }

  .preview-filter-count[hidden] {
    display: none;
  }

  .preview-filter-panel {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
    margin-top: 8px;
    padding: 14px;
    background: var(--bg-base);
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
  }

  .preview-filter-group {
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .preview-filter-group legend {
    margin-bottom: 7px;
    color: var(--text-secondary);
    font-size: 12px;
    font-weight: 600;
  }

  .preview-checkbox-list {
    display: grid;
    gap: 5px;
  }

  .preview-checkbox-list label,
  .preview-review-filter {
    display: flex;
    align-items: flex-start;
    gap: 7px;
    color: var(--text-secondary);
    font-size: 13px;
    line-height: 1.5;
  }

  .preview-checkbox-list input,
  .preview-review-filter input {
    flex: none;
    margin-top: 3px;
    accent-color: var(--accent-warm);
  }

  .preview-category-filter {
    grid-column: 1 / -1;
  }

  .preview-category-list {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    max-height: 180px;
    padding: 8px;
    overflow-y: auto;
    border: 1px solid var(--border);
    border-radius: var(--radius-label);
  }

  .preview-review-filter {
    grid-column: 1 / -1;
  }

  .preview-filter-clear {
    grid-column: 1 / -1;
    justify-self: start;
    padding: 0;
    color: var(--link);
    background: transparent;
    border: 0;
    font-size: 13px;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .preview-active-filters {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 16px;
    margin-top: 10px;
    padding: 4px 0;
    color: var(--text-secondary);
    font-size: 12px;
  }

  .preview-active-filters[hidden] {
    display: none;
  }

  .preview-filter-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0;
  }

  .preview-filter-chip {
    color: var(--text-secondary);
  }

  .preview-filter-chip:not(:last-child)::after {
    content: "・";
    margin: 0 5px;
    color: var(--text-muted);
  }

  .preview-clear-all {
    padding: 0;
    color: var(--link);
    background: transparent;
    border: 0;
    font-size: 12px;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .preview-table-wrap {
    margin-top: 16px;
    overflow-x: auto;
  }

  .preview-table-wrap[hidden] {
    display: none;
  }

  .preview-table {
    width: 100%;
    min-width: 760px;
    border-collapse: separate;
    border-spacing: 0;
    color: var(--text-primary);
    font-size: 13px;
    text-align: left;
  }

  .preview-table thead th {
    position: sticky;
    top: 0;
    z-index: 2;
    padding: 9px 10px;
    color: var(--text-muted);
    background: var(--bg-base);
    border-bottom: 1px solid var(--border-strong);
    font-size: 12px;
    font-weight: 600;
  }

  .preview-post-row > th,
  .preview-post-row > td {
    padding: 11px 10px;
    vertical-align: top;
  }

  .preview-post-row:hover > th,
  .preview-post-row:hover > td {
    background: var(--bg-hover);
  }

  .preview-title-cell {
    min-width: 340px;
    font-weight: 500;
  }

  .preview-post-link {
    color: var(--link);
    text-decoration: none;
    text-underline-offset: 3px;
  }

  .preview-post-link:hover {
    color: var(--link-hover);
    text-decoration: underline;
  }

  .preview-title-meta {
    display: block;
    margin-top: 3px;
    color: var(--text-muted);
    font-size: 11px;
    font-weight: 400;
  }

  .preview-tooltip-anchor {
    position: relative;
  }

  .preview-issue {
    display: inline-flex;
    margin-left: 7px;
    vertical-align: 1px;
  }

  .preview-issue-trigger {
    display: inline-flex;
    padding: 2px 5px;
    color: var(--danger-text);
    background: var(--danger-bg);
    border: 0;
    border-radius: var(--radius-label);
    cursor: help;
    font-size: 10px;
    font-weight: 600;
  }

  .preview-issue-trigger:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }

  .preview-tooltip {
    position: absolute;
    top: calc(100% + 8px);
