---
import fs from "node:fs/promises";
import type { CollectionEntry } from "astro:content";
import { Icon } from "astro-icon/components";
import CopyLinkButton from "~/components/CopyLinkButton.astro";
import { CATEGORIES, MAX_CATEGORIES_PER_POST } from "~/constants/categories";
import { TAGS } from "~/constants/tags";
import {
  POST_PRIORITY,
  POST_PRIORITY_LABELS,
  POST_PRIORITY_ORDER,
} from "~/constants/postPriority";
import {
  PUBLISHED_STATUS,
  PUBLISHED_STATUS_LABELS,
  PUBLISHED_STATUS_ORDER,
} from "~/constants/publishedStatus";
import {
  WRITING_STATUS,
  WRITING_STATUS_LABELS,
  WRITING_STATUS_ORDER,
} from "~/constants/writingStatus";
import {
  RECORD_TYPE,
  RECORD_TYPE_LABELS,
  RECORD_TYPE_ORDER,
} from "~/constants/recordType";
import { detectMemoState } from "~/utils/postMemo.js";
import { MEMO_STATE_LABELS, type MemoState } from "~/utils/previewPost";
import { normalizeSearchText } from "~/utils/search";
import { normalizePostSlug } from "~/utils/postSlug";
import { isPreviewPinned } from "~/constants/previewPinned";

type Props = {
  posts: CollectionEntry<"posts">[];
};

const { posts } = Astro.props;

const RECENT_DAY_OPTIONS = [1, 3, 7] as const;

const SORT_COLUMNS = [
  { value: "title", label: "タイトル" },
  { value: "priority", label: "優先度" },
  { value: "writing", label: "執筆状態" },
  { value: "publication", label: "公開状態" },
  { value: "recordType", label: "記事の型" },
  { value: "memo", label: "メモ状態" },
  { value: "updated", label: "更新日" },
  { value: "edited", label: "最終編集" },
] as const;

/*
 * 列見出しの補足。最終編集は公開側に出る更新日と別の値で、ファイル時刻による
 * 目安なので、取り違えないよう見出しで断る（TRM-023）
 */
const SORT_COLUMN_TITLES: Partial<Record<string, string>> = {
  edited: "ファイル時刻による目安。clone・一括置換で変わる",
};

// 今日かどうかは開いた時点で決める。開いたまま日付をまたいだら開き直すまで古いまま
const todayDateString = new Date().toDateString();
const formatEditedToday = (edited: Date) =>
  edited.toDateString() === todayDateString
    ? `今日 ${edited.toLocaleTimeString("ja-JP", {
        hour: "2-digit",
        minute: "2-digit",
      })}`
    : null;

// 最終編集の列は日時を出すことに徹する。今日かどうかはタイトル横のラベルが示す
const formatEdited = (edited: Date) => {
  const date = [
    edited.getFullYear(),
    String(edited.getMonth() + 1).padStart(2, "0"),
    String(edited.getDate()).padStart(2, "0"),
  ].join("-");
  const time = edited.toLocaleTimeString("ja-JP", {
    hour: "2-digit",
    minute: "2-digit",
  });
  return `${date} ${time}`;
};

const previewPosts = (
  await Promise.all(
    posts.map(async (post) => {
      const memoState = detectMemoState(post.body ?? "") as MemoState;
      const previewSlug = normalizePostSlug(post.id);
      if (!post.filePath) {
        throw new Error(`記事ファイルの場所がわかりません: ${post.id}`);
      }
      // 最終編集はファイルの更新時刻をそのまま使う目安の値（TRM-023）
      const { mtime: edited } = await fs.stat(post.filePath);

      return {
        ...post,
        previewSlug,
        memoState,
        edited,
        editedLabel: formatEdited(edited),
        editedToday: formatEditedToday(edited),
        pinned: isPreviewPinned(previewSlug),
        searchText: normalizeSearchText(
          [
            post.data.title,
            previewSlug,
            ...post.data.categories,
            ...post.data.tags,
            // 本文も対象にして、書いた内容から記事を引けるようにする
            post.body ?? "",
          ].join(" "),
        ),
      };
    }),
  )
).sort((a, b) => {
  const priorityDiff =
    POST_PRIORITY_ORDER[a.data.priority] - POST_PRIORITY_ORDER[b.data.priority];
  if (priorityDiff !== 0) return priorityDiff;

  const writingStatusDiff =
    WRITING_STATUS_ORDER[a.data.writingStatus] -
    WRITING_STATUS_ORDER[b.data.writingStatus];
  if (writingStatusDiff !== 0) return writingStatusDiff;

  return a.data.title.localeCompare(b.data.title, "ja");
});

const priorities = Object.values(POST_PRIORITY).sort(
  (a, b) => POST_PRIORITY_ORDER[a] - POST_PRIORITY_ORDER[b],
);

const writingStatuses = Object.values(WRITING_STATUS).sort(
  (a, b) => WRITING_STATUS_ORDER[a] - WRITING_STATUS_ORDER[b],
);

const recordTypes = Object.values(RECORD_TYPE).sort(
  (a, b) => RECORD_TYPE_ORDER[a] - RECORD_TYPE_ORDER[b],
);
const publishedStatuses = Object.values(PUBLISHED_STATUS).sort(
  (a, b) => PUBLISHED_STATUS_ORDER[a] - PUBLISHED_STATUS_ORDER[b],
);

const categories = Array.from(
  new Set(previewPosts.flatMap((post) => post.data.categories)),
).sort((a, b) => a.localeCompare(b, "ja"));

const tags = Array.from(
  new Set(previewPosts.flatMap((post) => post.data.tags)),
).sort((a, b) => a.localeCompare(b, "ja"));

/*
 * 公開日以外の絞り込み条件。条件ごとに開閉ボタンを並べ、この順で出す（SCR-004）。
 * wide は選択肢が多く、吹き出しを広く取る条件
 */
const toOptions = (values: readonly string[]) =>
  values.map((value) => ({ value, label: value }));
const filterFacets = [
  {
    key: "priority",
    label: "優先度",
    options: priorities.map((value) => ({
      value,
      label: POST_PRIORITY_LABELS[value],
    })),
    wide: false,
  },
  {
    key: "writing",
    label: "執筆状態",
    options: Object.values(WRITING_STATUS).map((value) => ({
      value,
      label: WRITING_STATUS_LABELS[value],
    })),
    wide: false,
  },
  {
    key: "publication",
    label: "公開状態",
    options: Object.values(PUBLISHED_STATUS).map((value) => ({
      value,
      label: PUBLISHED_STATUS_LABELS[value],
    })),
    wide: false,
  },
  {
    key: "memo",
    label: "メモ",
    options: Object.entries(MEMO_STATE_LABELS).map(([value, label]) => ({
      value,
      label,
    })),
    wide: false,
  },
  { key: "category", label: "分野", options: toOptions(categories), wide: true },
  { key: "tag", label: "タグ", options: toOptions(tags), wide: true },
];

// 作成フォームは正本の定数から出す。まだ使われていない選択肢も選べる必要がある
const createCategories = [...CATEGORIES].sort((a, b) =>
  a.localeCompare(b, "ja"),
);
const createTags = [...TAGS].sort((a, b) => a.localeCompare(b, "ja"));

const today = new Date().toISOString().slice(0, 10);
const createPublishedStatuses = Object.values(PUBLISHED_STATUS).sort(
  (a, b) => PUBLISHED_STATUS_ORDER[a] - PUBLISHED_STATUS_ORDER[b],
);
const createWritingStatuses = Object.values(WRITING_STATUS).sort(
  (a, b) => WRITING_STATUS_ORDER[a] - WRITING_STATUS_ORDER[b],
);
const createPriorities = Object.values(POST_PRIORITY).sort(
  (a, b) => POST_PRIORITY_ORDER[a] - POST_PRIORITY_ORDER[b],
);

const publishedMemoCount = previewPosts.filter(
  (post) =>
    post.data.status === PUBLISHED_STATUS.PUBLISHED &&
    post.memoState !== "NO_MEMO",
).length;
const publishedMemoFilterParams = new URLSearchParams({
  publication: PUBLISHED_STATUS.PUBLISHED,
});
["HAS_MEMO", "EMPTY_MEMO", "BROKEN_MEMO"].forEach((memoState) => {
  publishedMemoFilterParams.append("memo", memoState);
});
---

<preview-posts
  class="preview-posts"
  data-total={previewPosts.length}
  data-group="none"
  data-max-categories={MAX_CATEGORIES_PER_POST}
>
  {
    /*
     * astro-icon は同じアイコンの一つ目に <symbol> を置き、以降を <use> で参照させる。
     * 一覧の行は絞り込みのたびに DOM から外れるため、定義が行の中にあると、
     * その行が結果から外れた瞬間に残りの行のアイコンが全部消える。
     * 表より前でひととおり描いて、定義の置き場を固定する。
     */
  }
  <div class="preview-icon-sprites" aria-hidden="true">
    <Icon name="octicon:pin-16" />
    <Icon name="octicon:trash-16" />
    <Icon name="octicon:pencil-16" />
    <Icon name="octicon:link-16" />
    <Icon name="octicon:check-16" />
    <Icon name="octicon:chevron-down-16" />
  </div>
  <!-- グループの見出しは JS で組み立てるので、開閉の記号をここから複製する -->
  <template data-group-chevron>
    <Icon
      name="octicon:chevron-down-16"
      class="preview-group-chevron"
      aria-hidden="true"
    />
  </template>

  <main class="preview-shell">
    <header class="preview-header">
      <div>
        <p class="preview-eyebrow">Local Preview</p>
        <h1 class="preview-title">記事プレビュー</h1>
      </div>
      <div class="preview-header-meta">
        <a href="/blog" class="preview-blog-link">ブログ一覧</a>
      </div>
    </header>

    {
      publishedMemoCount > 0 && (
        <section
          class="preview-publication-warning"
          aria-labelledby="preview-publication-warning-title"
        >
          <Icon
            name="octicon:alert-16"
            class="preview-publication-warning-icon"
          />
          <div class="preview-publication-warning-copy">
            <h2 id="preview-publication-warning-title">
              公開済みの記事{publishedMemoCount}件にメモ欄が残っています
            </h2>
            <p>メモは本番ページにも表示されます。</p>
          </div>
          <a href={`/preview/posts?${publishedMemoFilterParams.toString()}`}>
            対象を表示
          </a>
        </section>
      )
    }

    <div class="preview-create-launch">
      <button type="button" class="preview-create-open" data-create-open>
        <Icon name="octicon:plus-16" />
        新しい記事
      </button>
    </div>

    <dialog
      class="create-dialog"
      closedby="any"
      aria-labelledby="create-dialog-title"
      data-create-dialog
    >
      <form class="create-form" data-create-form>
        <header class="create-head">
          <h2 class="create-title" id="create-dialog-title">新しい記事</h2>

          <details class="create-ai">
            <summary class="create-ai-summary">
              <Icon name="octicon:sparkle-fill-16" aria-hidden="true" />
              <span>AI 候補</span>
              <Icon
                name="octicon:chevron-down-16"
                class="create-ai-chevron"
                aria-hidden="true"
              />
            </summary>
            <div class="create-ai-panel">
              <p class="create-ai-note">
                タイトルをもとに、タイトル・スラッグ・分野・タグの候補を出します。
              </p>
              <textarea
                class="create-input create-ai-instruction"
                rows="3"
                placeholder="指示（任意）例: もっと短く、専門用語を避けて"
                data-create-instruction></textarea>
              <button type="button" class="create-ai-run" data-create-suggest>
                候補を出す
              </button>
            </div>
          </details>

          <button
            type="button"
            class="create-close"
            aria-label="閉じる"
            data-create-close
          >
            <Icon name="octicon:x-16" />
          </button>
        </header>

        <div class="create-body">
          <div class="create-column">
            <p class="create-legend">記録</p>

            <div class="create-field">
              <label class="create-label" for="create-title">タイトル</label>
              <input
                type="text"
                id="create-title"
                class="create-input create-title-input"
                autocomplete="off"
                required
                data-create-title
              />
              <div class="create-suggestions" data-suggestions="titles"></div>
            </div>

            <div class="create-field">
              <label class="create-label" for="create-slug">スラッグ</label>
              <input
                type="text"
                id="create-slug"
                class="create-input create-slug"
                placeholder="my-new-article"
                pattern="[a-z0-9]+(-[a-z0-9]+)*"
                autocomplete="off"
                spellcheck="false"
                required
                data-create-slug
              />
              <div class="create-suggestions" data-suggestions="slugs"></div>
              <p class="create-hint">
                src/content/posts/blog/<span data-create-preview>slug</span>.md
              </p>
            </div>

            <div class="create-field create-field-body">
              <label class="create-label" for="create-body">本文</label>
              <textarea
                id="create-body"
                class="create-input create-body-input"
                placeholder="空のままなら「ここに本文を書く」と「## メモ」で作ります"
                data-create-body></textarea>
              <div
                class="create-body-modes"
                role="radiogroup"
                aria-label="入力の扱い"
              >
                <label class="create-option">
                  <input
                    type="radio"
                    name="bodyMode"
                    value="body"
                    checked
                    data-create-body-mode
                  />
                  <span>本文にする</span>
                </label>
                <label class="create-option">
                  <input
                    type="radio"
                    name="bodyMode"
                    value="memo"
                    data-create-body-mode
                  />
                  <span>メモに入れる</span>
                </label>
              </div>
            </div>
          </div>

          <div class="create-column">
            {
              /* 型は必須で既定に寄せると全部が調査になる。詳細へ畳まず先に選ばせる */
            }
            <label class="create-field create-field-ruled">
              <span class="create-label">記事の型</span>
              <select class="create-input" data-create-field="recordType">
                {
                  recordTypes.map((value) => (
                    <option
                      value={value}
                      selected={value === RECORD_TYPE.RESEARCH}
                    >
                      {RECORD_TYPE_LABELS[value]}
                    </option>
                  ))
                }
              </select>
            </label>

            <fieldset
              class="create-choices"
              data-create-group="categories"
              data-create-max={MAX_CATEGORIES_PER_POST}
            >
              <legend class="create-legend">
                分野
                <span class="create-legend-hint">
                  1〜{MAX_CATEGORIES_PER_POST}件
                </span>
              </legend>
              <div class="create-suggestions" data-suggestions="categories">
              </div>
              <div class="create-options">
                {
                  createCategories.map((category) => (
                    <label class="create-option" data-create-choice={category}>
                      <input
                        type="checkbox"
                        name="categories"
                        value={category}
                      />
                      <span>{category}</span>
                    </label>
                  ))
                }
              </div>
            </fieldset>

            <fieldset class="create-choices" data-create-group="tags">
              <legend class="create-legend">
                タグ
                <span class="create-legend-hint">1件以上</span>
              </legend>
              <div class="create-tag-input">
                <input
                  type="search"
                  class="create-input"
                  placeholder="絞り込む・無ければ追加"
                  autocomplete="off"
                  data-create-filter
                  data-new-tag-input
                />
                <button type="button" class="create-tag-add" data-new-tag-add>
                  ＋追加
                </button>
              </div>
              <div class="create-suggestions" data-suggestions="tags"></div>
              <div class="create-suggestions" data-suggestions="newTags"></div>
              <div class="create-selected" data-create-selected></div>
              <div class="create-new-tags" data-new-tags></div>
              <div class="create-options create-options-scroll">
                {
                  createTags.map((tag) => (
                    <label class="create-option" data-create-choice={tag}>
                      <input type="checkbox" name="tags" value={tag} />
                      <span>{tag}</span>
                      <button
                        type="button"
                        class="tag-delete"
                        aria-label={`${tag} を定数から削除`}
                        data-tag-delete={tag}
                      >
                        ×
                      </button>
                    </label>
                  ))
                }
              </div>
            </fieldset>

            <details class="create-advanced">
              <summary class="create-advanced-summary">
                <Icon
                  name="octicon:chevron-right-16"
                  class="create-advanced-chevron"
                  aria-hidden="true"
                />
                <span class="create-advanced-title">
                  公開日、公開状態、執筆状態、優先度、サムネイル、GitHub URL
                </span>
                <span class="create-legend-hint">
                  開いて変更。閉じたままなら 非公開 / 未着手 / 優先度なし
                </span>
              </summary>
              <div class="create-grid">
                <label class="create-field">
                  <span class="create-label">公開日</span>
                  <input
                    type="date"
                    class="create-input"
                    value={today}
                    data-create-field="publishedAt"
                  />
                </label>

                <label class="create-field">
                  <span class="create-label">更新日</span>
                  <input
                    type="date"
                    class="create-input"
                    value={today}
                    data-create-field="updatedAt"
                  />
                </label>

                <label class="create-field">
                  <span class="create-label">公開状態</span>
                  <select class="create-input" data-create-field="status">
                    {
                      createPublishedStatuses.map((value) => (
                        <option
                          value={value}
                          selected={value === PUBLISHED_STATUS.PRIVATE}
                        >
                          {PUBLISHED_STATUS_LABELS[value]}
                        </option>
                      ))
                    }
                  </select>
                </label>

                <label class="create-field">
                  <span class="create-label">執筆状態</span>
                  <select
                    class="create-input"
                    data-create-field="writingStatus"
                  >
                    {
                      createWritingStatuses.map((value) => (
                        <option
                          value={value}
                          selected={value === WRITING_STATUS.TODO}
                        >
                          {WRITING_STATUS_LABELS[value]}
                        </option>
                      ))
                    }
                  </select>
                </label>

                <label class="create-field">
                  <span class="create-label">優先度</span>
                  <select class="create-input" data-create-field="priority">
                    {
                      createPriorities.map((value) => (
                        <option
                          value={value}
                          selected={value === POST_PRIORITY.NONE}
                        >
                          {POST_PRIORITY_LABELS[value]}
                        </option>
                      ))
                    }
                  </select>
                </label>

                <label class="create-field create-field-wide">
                  <span class="create-label">サムネイル</span>
                  <input
                    type="text"
                    class="create-input"
                    autocomplete="off"
                    data-create-field="thumbnail"
                  />
                </label>

                <label class="create-field create-field-wide">
                  <span class="create-label">GitHub URL</span>
                  <input
                    type="text"
                    class="create-input"
                    autocomplete="off"
                    data-create-field="githubUrl"
                  />
                </label>
              </div>
            </details>
          </div>
        </div>

        <footer class="create-actions">
          <button type="submit" class="create-submit">作成</button>
          <button type="button" class="create-cancel" data-create-close>
            キャンセル
          </button>
          <p class="create-status" data-create-status aria-live="polite"></p>
        </footer>
      </form>
    </dialog>

    <!--
      操作は役割で塊を分ける。一覧を減らす「絞る」と、並べ方とまとめ方を変える
      「表示」は効き方が違うので、同じ列に並べない（SCR-004）
    -->
    <form class="preview-tools" data-preview-controls>
      <div
        class="preview-tool-section preview-narrow"
        role="group"
        aria-labelledby="preview-narrow-title"
      >
        <p class="preview-section-title" id="preview-narrow-title">絞る</p>

        <label class="preview-search-control">
          <Icon name="octicon:search-16" class="preview-search-icon" />
          <input
            type="search"
            name="q"
            class="preview-search-input"
            placeholder="タイトル・分野・slug・本文"
            aria-label="検索"
            autocomplete="off"
            data-search-input
          />
        </label>

        <!-- 名前の列と中身の列を「表示」と同じグリッドで揃える（SCR-004） -->
        <div
          class="preview-filter-row"
          role="radiogroup"
          aria-labelledby="preview-period-label"
        >
          <span class="preview-field-label" id="preview-period-label">
            公開日
          </span>
          <div class="preview-period-options">
            <label class="preview-period-option">
              <input
                type="radio"
                name="recent"
                value="0"
                data-recent-option
                checked
              />
              <span>すべて</span>
            </label>
            {
              RECENT_DAY_OPTIONS.map((days) => (
                <label class="preview-period-option">
                  <input
                    type="radio"
                    name="recent"
                    value={days}
                    data-recent-option
                  />
                  <span>
                    {days}日
                    <span
                      class="preview-period-count"
                      data-recent-count={days}
                    />
                  </span>
                </label>
              ))
            }
          </div>
        </div>

        <div
          class="preview-filter-row"
          role="group"
          aria-labelledby="preview-facets-label"
        >
          <span class="preview-field-label" id="preview-facets-label">
            条件
          </span>
          <div class="preview-facets-cell">
            <!-- Narrow でだけ出す。条件のボタンを畳み、開くと全条件をその場に並べる -->
            <button
              type="button"
              class="preview-facets-toggle"
              aria-expanded="false"
              aria-controls="preview-facets"
              data-facets-toggle
            >
              絞り込み
              <span class="preview-facet-count" data-filter-count hidden></span>
              <Icon
                name="octicon:chevron-down-16"
                class="preview-facet-chevron"
                aria-hidden="true"
              />
            </button>

            <div class="preview-facets" id="preview-facets" data-facets>
              {
                filterFacets.map((facet) => (
                  <div class="preview-facet">
                    <button
                      type="button"
                      class="preview-facet-trigger"
                      popovertarget={`preview-facet-${facet.key}`}
                    >
                      {facet.label}
                      <span
                        class="preview-facet-count"
                        data-facet-count={facet.key}
                        hidden
                      />
                      <Icon
                        name="octicon:chevron-down-16"
                        class="preview-facet-chevron"
                        aria-hidden="true"
                      />
                    </button>
                    <div
                      id={`preview-facet-${facet.key}`}
                      class:list={["preview-facet-popover", { "is-wide": facet.wide }]}
                      popover
                      data-facet-popover
                    >
                      <fieldset class="preview-facet-group">
                        <legend>{facet.label}</legend>
                        <div class="preview-option-list">
                          {facet.options.map((option) => (
                            <label class="preview-option">
                              <input
                                type="checkbox"
                                name={facet.key}
                                value={option.value}
                                data-filter-key={facet.key}
                              />
                              <span>{option.label}</span>
                            </label>
                          ))}
                        </div>
                      </fieldset>
                    </div>
                  </div>
                ))
              }
            </div>
          </div>
        </div>
      </div>

      <div
        class="preview-tool-section preview-view"
        role="group"
        aria-labelledby="preview-view-title"
      >
        <p class="preview-section-title" id="preview-view-title">表示</p>

        <label class="preview-field">
          <span class="preview-field-label">並び順</span>
          <!--
            列見出しと同じ並べ替えを選べる。列見出しが隠れるカード表示でも並べ替える
            ための入口で、各列は標準の向きで選ばれる（SCR-004）
          -->
          <select name="sort" class="preview-select" data-sort-select>
            <option value="recommended">既定</option>
            {
              SORT_COLUMNS.map((column) => (
                <option value={column.value}>{column.label}</option>
              ))
            }
          </select>
        </label>

        <label class="preview-field">
          <span class="preview-field-label">グループ</span>
          <select name="group" class="preview-select" data-group-select>
            <option value="none">グループなし</option>
            <option value="priority">優先度</option>
            <option value="writing">執筆状態</option>
            <option value="publication">公開状態</option>
            <option value="recordType">型</option>
            <option value="category">分野</option>
          </select>
        </label>
      </div>
    </form>

    <!--
      保存した設定を反映するまで一覧を隠す間、その位置に行の形の罫線を置く。
      空白を見せず、一覧と同じ位置で入れ替える（SCR-004）
    -->
    <div class="preview-skeleton" role="status">
      <span class="sr-only">読み込み中</span>
      {
        Array.from({ length: 8 }, () => (
          <span class="preview-skeleton-row" aria-hidden="true" />
        ))
      }
    </div>

    <!--
      絞った結果の状態。条件があるときだけ外す操作を置き、その直下に件数を出す。
      件数は表の直前に置き、何件に絞れたかを一覧の頭で読ませる
    -->
    <div class="preview-result-bar">
      <div class="preview-active-filters" data-active-filters hidden>
        <ul class="preview-filter-chips" data-filter-chips></ul>
        <button type="button" class="preview-clear-all" data-clear-all>
          すべて解除
        </button>
      </div>
      <span class="preview-count" data-result-count aria-live="polite">
        表示中 {previewPosts.length} / {previewPosts.length}件
      </span>
    </div>

    <div class="preview-table-wrap" data-table-wrap>
      <table class="preview-table">
        <caption class="sr-only"> ローカルプレビュー用の記事管理一覧 </caption>
        <thead>
          <tr>
            {
              SORT_COLUMNS.map((column) => (
                <th
                  scope="col"
                  class:list={[
                    { "preview-priority-column": column.value === "priority" },
                  ]}
                  aria-sort="none"
                  data-sort-header
                >
                  <button
                    type="button"
                    class="preview-sort-button"
                    title={SORT_COLUMN_TITLES[column.value]}
                    data-sort-column={column.value}
                  >
                    {column.label}
                    <span class="preview-sort-indicator" aria-hidden="true" />
                  </button>
                </th>
              ))
            }
          </tr>
        </thead>
        <tbody class="preview-post-group" data-post-group="all">
          {
            previewPosts.map((previewPost) => {
              const rowKey = encodeURIComponent(previewPost.id).replaceAll(
                "%",
                "",
              );
              const categoryPopoverId = `preview-categories-${rowKey}`;
              return (
                <tr
                  class="preview-post-row"
                  data-post-row
                  data-entry-id={previewPost.id}
                  data-slug={previewPost.previewSlug}
                  data-pinned={String(previewPost.pinned)}
                  data-title={previewPost.data.title}
                  data-search={previewPost.searchText}
                  data-priority={previewPost.data.priority}
                  data-writing={previewPost.data.writingStatus}
                  data-publication={previewPost.data.status}
                  data-record-type={previewPost.data.recordType}
                  data-memo={previewPost.memoState}
                  data-categories={JSON.stringify(previewPost.data.categories)}
                  data-tags={JSON.stringify(previewPost.data.tags)}
                  data-published={previewPost.data.publishedAt
                    .toISOString()
                    .slice(0, 10)}
                  data-updated={previewPost.data.updatedAt
                    .toISOString()
                    .slice(0, 10)}
                  data-edited={previewPost.edited.toISOString()}
                >
                  <th
                    scope="row"
                    class="preview-title-cell"
                    data-label="タイトル"
                  >
                    <span class="preview-title-line">
                      <span class="preview-title-name">
                        <Icon
                          name="octicon:pin-16"
                          class="preview-pin-mark"
                          aria-hidden="true"
                        />
                        <a
                          href={`/preview/posts/${previewPost.previewSlug}`}
                          class="preview-post-link"
                          data-title-display
                        >
                          {previewPost.data.title}
                        </a>
                      </span>
                      <button
                        type="button"
                        class="preview-edit-trigger"
                        aria-label={`${previewPost.data.title} のタイトルを編集`}
                        data-title-trigger
                      >
                        <Icon
                          name="octicon:pencil-16"
                          class="preview-edit-icon"
                        />
                      </button>
                      <button
                        type="button"
                        class="preview-pin-toggle"
                        aria-pressed={String(previewPost.pinned)}
                        title={
                          previewPost.pinned
                            ? `${previewPost.data.title} の固定を外す`
                            : `${previewPost.data.title} を先頭に固定`
                        }
                        aria-label={
                          previewPost.pinned
                            ? `${previewPost.data.title} の固定を外す`
                            : `${previewPost.data.title} を先頭に固定`
                        }
                        data-pin-toggle={previewPost.previewSlug}
                      >
                        <Icon name="octicon:pin-16" class="preview-pin-icon" />
                      </button>
                      <CopyLinkButton
                        path={`/preview/posts/${previewPost.previewSlug}`}
                        class="preview-copy-link"
                      />
                      <button
                        type="button"
                        class="preview-row-delete"
                        title={`${previewPost.data.title} を削除`}
                        aria-label={`${previewPost.data.title} を削除`}
                        data-delete-post={previewPost.previewSlug}
                        data-post-title={previewPost.data.title}
                      >
                        <Icon name="octicon:trash-16" />
                      </button>
                      <input
                        type="text"
                        class="preview-title-input"
                        value={previewPost.data.title}
                        aria-label={`${previewPost.data.title} のタイトル`}
                        data-title-input
                        hidden
                      />
                      <span
                        class="preview-edit-status"
                        role="status"
                        aria-live="polite"
                        data-edit-status
                      />
                    </span>
                    <span class="preview-title-meta">
                      <code class="preview-slug">
                        {previewPost.previewSlug}
                      </code>
                      {previewPost.editedToday && (
                        <span
                          class="preview-status-badge preview-edited-chip"
                          title="最終編集。ファイル時刻による目安"
                        >
                          {previewPost.editedToday}
                        </span>
                      )}
                    </span>
                    <button
                      type="button"
                      class="preview-title-meta preview-category-trigger"
                      popovertarget={categoryPopoverId}
                      aria-label={`${previewPost.data.title} の分野を編集`}
                      data-category-trigger
                    >
                      <span data-category-label>
                        {previewPost.data.categories.join(" · ")}
                      </span>
                      <Icon
                        name="octicon:pencil-16"
                        class="preview-edit-icon"
                      />
                    </button>
                    <div
                      id={categoryPopoverId}
                      popover="auto"
                      class="preview-category-popover"
                      data-category-popover
                    >
                      {CATEGORIES.map((category) => (
                        <label class="preview-category-choice">
                          <input
                            type="checkbox"
                            value={category}
                            checked={previewPost.data.categories.includes(
                              category,
                            )}
                            data-category-input
                          />
                          <span>{category}</span>
                        </label>
                      ))}
                    </div>
                  </th>
                  <td class="preview-priority-column" data-label="優先度">
                    <span class="preview-priority">
                      <select
                        class="preview-cell-select"
                        aria-label={`${previewPost.data.title} の優先度`}
                        data-edit-select="priority"
                      >
                        {priorities.map((value) => (
                          <option
                            value={value}
                            selected={value === previewPost.data.priority}
                          >
                            {POST_PRIORITY_LABELS[value]}
                          </option>
                        ))}
                      </select>
                    </span>
                  </td>
                  <td data-label="執筆状態">
                    <select
                      class="preview-cell-select"
                      aria-label={`${previewPost.data.title} の執筆状態`}
                      data-edit-select="writingStatus"
                    >
                      {writingStatuses.map((value) => (
                        <option
                          value={value}
                          selected={value === previewPost.data.writingStatus}
                        >
                          {WRITING_STATUS_LABELS[value]}
                        </option>
                      ))}
                    </select>
                  </td>
                  <td data-label="公開状態">
                    <select
                      class="preview-cell-select"
                      aria-label={`${previewPost.data.title} の公開状態`}
                      data-edit-select="status"
                    >
                      {publishedStatuses.map((value) => (
                        <option
                          value={value}
                          selected={value === previewPost.data.status}
                        >
                          {PUBLISHED_STATUS_LABELS[value]}
                        </option>
                      ))}
                    </select>
                  </td>
                  <td data-label="記事の型">
                    <select
                      class="preview-cell-select"
                      aria-label={`${previewPost.data.title} の記事の型を変更`}
                      data-edit-select="recordType"
                    >
                      {recordTypes.map((value) => (
                        <option
                          value={value}
                          selected={value === previewPost.data.recordType}
                        >
                          {RECORD_TYPE_LABELS[value]}
                        </option>
                      ))}
                    </select>
                  </td>
                  <td data-label="メモ状態">
                    <span class="preview-status-badge preview-memo-badge">
                      {MEMO_STATE_LABELS[previewPost.memoState]}
                    </span>
                  </td>
                  <td class="preview-date-cell" data-label="更新日">
                    <input
                      type="date"
                      class="preview-cell-date"
                      value={previewPost.data.updatedAt
                        .toISOString()
                        .slice(0, 10)}
                      aria-label={`${previewPost.data.title} の更新日`}
                      data-edit-date
                    />
                  </td>
                  <td class="preview-date-cell" data-label="最終編集">
                    <time datetime={previewPost.edited.toISOString()}>
                      {previewPost.editedLabel}
                    </time>
                  </td>
                </tr>
              );
            })
          }
        </tbody>
      </table>
    </div>

    <p class="preview-empty" data-empty-state hidden>
      条件に合う記事がありません。
      <button type="button" data-clear-all>条件をすべて解除</button>
    </p>
  </main>
</preview-posts>

<style is:global>
  .preview-shell {
    width: 100%;
    max-width: var(--max-width-pc);
    margin: 0 auto;
    padding: 28px 16px 48px;
  }

  .preview-header {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 20px;
  }

  .preview-eyebrow {
    margin: 0 0 4px;
    color: var(--text-muted);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .preview-title {
    margin: 0;
    color: var(--text-primary);
    font-size: 28px;
    font-weight: 700;
  }

  .preview-header-meta {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .preview-count {
    color: var(--text-muted);
    font-family: var(--font-machine);
    font-size: 12px;
    font-variant-numeric: tabular-nums;
  }

  .preview-blog-link {
    padding: 6px 10px;
    color: var(--link);
    background: var(--bg-card);
    border-radius: var(--radius-label);
    font-size: 13px;
    font-weight: 500;
    text-decoration: none;
  }

  .preview-blog-link:hover {
    color: var(--link-hover);
    background: var(--bg-hover);
  }

  .preview-publication-warning {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 5px 9px;
    margin-bottom: 18px;
    padding: 10px 12px;
    color: var(--warning-text);
    background: var(--warning-bg);
    border-left: 2px solid var(--warning);
  }

  .preview-publication-warning-icon {
    margin-top: 2px;
    color: var(--warning);
  }

  .preview-publication-warning-copy h2,
  .preview-publication-warning-copy p {
    margin: 0;
  }

  .preview-publication-warning-copy h2 {
    font-size: 13px;
    font-weight: 600;
  }

  .preview-publication-warning-copy p {
    margin-top: 2px;
    color: var(--text-secondary);
    font-size: 12px;
  }

  .preview-publication-warning > a {
    grid-column: 2;
    justify-self: start;
    color: var(--link);
    font-size: 12px;
    text-underline-offset: 3px;
  }

  /* 狭い画面では「絞る」「表示」を縦に積み、罫線で段を分ける */
  .preview-tools {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 14px;
  }

  .preview-tool-section {
    display: grid;
    align-content: start;
    gap: 12px;
    min-width: 0;
  }

  /*
   * 区画の名前は公開側の「探す」と同じく機械の書体で置く。罫線は引かず、
   * 区切りは「絞る」と「表示」の間の縦線だけにする（SCR-004）
   */
  .preview-section-title {
    margin: 0;
    color: var(--text-muted);
    font-family: var(--font-machine);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  /*
   * 「絞る」も名前の列と中身の列のグリッドにする。題と検索欄は 2 列を通して置き、
   * 公開日と条件の行は subgrid で列を共有して中身の左端を揃える
   */
  .preview-narrow {
    grid-template-columns: max-content minmax(0, 1fr);
    column-gap: 16px;
    row-gap: 10px;
  }

  .preview-narrow > .preview-section-title,
  .preview-narrow > .preview-search-control {
    grid-column: 1 / -1;
  }

  .preview-filter-row {
    display: grid;
    grid-column: 1 / -1;
    grid-template-columns: subgrid;
    align-items: baseline;
  }

  .preview-facets-cell {
    min-width: 0;
  }

  /* 名前と値を 1 行に並べる。名前は値より一段控える */
  .preview-field {
    display: flex;
    align-items: center;
    gap: 12px;
    min-width: 0;
  }

  .preview-field-label {
    flex: none;
    color: var(--text-muted);
    font-size: 12px;
  }

  /*
   * 「表示」は名前の列と値の列を揃えた 2 列のグリッドにする。各行は subgrid で
   * 列を共有し、名前の長さが違っても値の左端が揃う
   */
  .preview-view {
    grid-template-columns: max-content minmax(0, 1fr);
    column-gap: 16px;
    row-gap: 8px;
  }

  .preview-view .preview-section-title {
    grid-column: 1 / -1;
  }

  .preview-view .preview-field {
    display: grid;
    grid-column: 1 / -1;
    grid-template-columns: subgrid;
    align-items: center;
  }

  /* 値の幅を右の列いっぱいに揃え、並び順とグループで長さが変わらないようにする */
  .preview-view .preview-select {
    width: 100%;
  }

  /* 既定のままのときは控えめな色にし、変えているかを色で見分けられるようにする */
  .preview-select[data-default] {
    color: var(--text-muted);
  }

  /* 主役の入力なので、箱を持つのはここだけにする */
  .preview-search-control {
    display: flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
    height: 40px;
    padding: 0 12px;
    background: var(--bg-base);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-label);
  }

  .preview-search-control:focus-within {
    border-color: var(--focus);
  }

  .preview-search-icon {
    flex: none;
    color: var(--text-muted);
  }

  .preview-search-input {
    flex: 1;
    min-width: 0;
    height: 100%;
    color: var(--text-primary);
    background: transparent;
    border: 0;
    outline: 0;
    font-size: 14px;
  }

  .preview-search-input::placeholder {
    color: var(--text-muted);
  }

  /*
   * 開閉の記号は octicon の chevron で統一する。OS 既定の矢印は形も位置も揃わない。
   * 枠は持たず、値を文字として置き、hover / focus で下線を出す。select の
   * 文字には text-decoration が描かれないので、下線は下端の罫線で引く
   */
  .preview-select {
    min-width: 0;
    min-height: 28px;
    padding: 0 20px 0 0;
    color: var(--text-primary);
    background: transparent var(--select-chevron) no-repeat right 0 center;
    background-size: 12px 12px;
    border: 0;
    border-bottom: 1px solid transparent;
    border-radius: 0;
    font-family: inherit;
    font-size: 13px;
    appearance: none;
    cursor: pointer;
  }

  .preview-select:hover,
  .preview-select:focus-visible {
    color: var(--link);
    border-bottom-color: currentColor;
  }

  .preview-select:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }

  /*
   * 条件ごとの開閉ボタン。面を持たず文字だけで置き、開いている間と hover は
   * 下線で示す（hig.md の hover.text）
   */
  .preview-facets {
    display: flex;
    flex-wrap: wrap;
    gap: 2px 18px;
  }

  .preview-facet-trigger,
  .preview-facets-toggle {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    min-height: 28px;
    padding: 0;
    color: var(--text-secondary);
    background: transparent;
    border: 0;
    font-family: inherit;
    font-size: 13px;
    text-decoration: underline transparent;
    text-decoration-thickness: 1px;
    text-underline-offset: 5px;
    cursor: pointer;
    transition: text-decoration-color var(--duration-feedback) ease;
  }

  .preview-facet-trigger:hover,
  .preview-facet-trigger:focus-visible,
  .preview-facets-toggle:hover,
  .preview-facets-toggle:focus-visible {
    color: var(--link);
    text-decoration-color: currentColor;
  }

  .preview-facet-trigger:focus-visible,
  .preview-facets-toggle:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }

  /* 開いている間と条件を選んでいる間は、選択中と同じ語彙で示す */
  .preview-facet:has(:popover-open) .preview-facet-trigger,
  .preview-facet-trigger:has(.preview-facet-count:not([hidden])) {
    color: var(--color-primary);
    font-weight: 700;
  }

  .preview-facet:has(:popover-open) .preview-facet-trigger {
    text-decoration-color: currentColor;
  }

  .preview-facet-count {
    font-family: var(--font-machine);
    font-size: 11px;
    font-variant-numeric: tabular-nums;
  }

  .preview-facet-chevron {
    flex: none;
    width: 12px;
    height: 12px;
    color: var(--text-muted);
    transition: transform var(--duration-feedback) var(--ease-trace);
  }

  .preview-facet:has(:popover-open) .preview-facet-chevron,
  .preview-facets-toggle[aria-expanded="true"] .preview-facet-chevron {
    transform: rotate(180deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .preview-facet-trigger,
    .preview-facets-toggle,
    .preview-facet-chevron {
      transition: none;
    }
  }

  /* Narrow 以外では条件のボタンが常に見えているので、畳むボタンは要らない */
  .preview-facets-toggle {
    display: none;
  }

  /*
   * 条件の選択肢。一覧に重ねて出すので、ここだけ面と影を持つ（tokens.md の
   * overlay）。位置は開いたときに開閉ボタンの直下へ JS で合わせる
   */
  .preview-facet-popover {
    position: fixed;
    inset: auto;
    width: max-content;
    min-width: 180px;
    max-width: min(240px, calc(100vw - 32px));
    margin: 0;
    padding: 12px 14px;
    color: var(--text-primary);
    background: var(--bg-base);
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    box-shadow: 0 12px 28px rgb(0 0 0 / 14%);
  }

  .preview-facet-popover.is-wide {
    width: min(480px, calc(100vw - 32px));
    max-width: none;
  }

  .preview-facet-group {
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  /* 吹き出しの中では開閉ボタンが名前を担うので、見出しは読み上げにだけ残す */
  .preview-facet-group legend {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .preview-option-list {
    display: grid;
    gap: 0 18px;
  }

  .is-wide .preview-option-list {
    grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
    max-height: 280px;
    overflow-y: auto;
  }

  /*
   * 選択肢は「探す」の分野一覧と同じく文字の列にする。複数選べる意味は
   * checkbox のまま持ち、見た目だけ選択中の語彙（Primary、太字、下線）で示す
   */
  .preview-option {
    position: relative;
    display: flex;
    align-items: center;
    min-height: 28px;
    color: var(--text-secondary);
    font-size: 13px;
    cursor: pointer;
  }

  .preview-option input {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }

  .preview-option span {
    text-decoration: underline transparent;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }

  .preview-option:hover span {
    color: var(--link);
    text-decoration-color: currentColor;
  }

  .preview-option:has(input:checked) span {
    color: var(--color-primary);
    font-weight: 700;
    text-decoration-color: currentColor;
  }

  .preview-option:has(input:focus-visible) {
    outline: 2px solid var(--focus);
    outline-offset: 1px;
  }

  /* 絞った結果の状態。罫線は引かず、操作と表の間の余白で区切る */
  .preview-result-bar {
    display: grid;
    gap: 10px;
    margin-top: 28px;
  }

  /*
   * 保存した設定を反映するまで、設定に左右される部分を隠す。JS が動かなくても
   * 隠れたままにならないよう、2秒で必ず出す（SCR-004、PRN-001 の 10）
   */
  preview-posts:not([data-ready]) :is(
      .preview-view,
      .preview-result-bar,
      .preview-table-wrap,
      .preview-empty
    ) {
    visibility: hidden;
    animation: preview-reveal 0s 2s forwards;
  }

  @keyframes preview-reveal {
    to {
      visibility: visible;
    }
  }

  /*
   * 隠している一覧の位置に、行の形の罫線を重ねる。器の高さを 0 にして下へ
   * はみ出させるので、一覧と入れ替わってもレイアウトは動かない。
   * 一覧と同じく 2 秒で引く
   */
  .preview-skeleton {
    display: none;
  }

  preview-posts:not([data-ready]) .preview-skeleton {
    position: relative;
    display: grid;
    height: 0;
    margin-top: 28px;
    overflow: visible;
    animation: preview-skeleton-out 0s 2s forwards;
  }

  @keyframes preview-skeleton-out {
    to {
      visibility: hidden;
    }
  }

  /* 1行ぶんの高さに、題名の位置の短い線と行の区切り線を引く */
  .preview-skeleton-row {
    position: relative;
    display: block;
    height: 52px;
    border-bottom: 1px solid var(--border);
    animation: preview-skeleton-pulse 1.4s ease-in-out infinite alternate;
  }

  .preview-skeleton-row::before {
    content: "";
    position: absolute;
    top: 50%;
    left: 4px;
    width: min(40%, 320px);
    height: 1px;
    background: var(--border-strong);
  }

  .preview-skeleton-row:nth-child(3n)::before {
    width: min(28%, 220px);
  }

  .preview-skeleton-row:nth-child(3n + 1)::before {
    width: min(34%, 270px);
  }

  @keyframes preview-skeleton-pulse {
    from {
      opacity: 1;
    }
    to {
      opacity: 0.45;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .preview-skeleton-row {
      animation: none;
    }
  }

  .preview-active-filters {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 16px;
    min-width: 0;
  }

  .preview-active-filters[hidden] {
    display: none;
  }

  .preview-filter-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /*
   * 外せる条件（components.md の CMP-016 Removable Chip）。カプセル型で薄い面と
   * 細い枠を持ち、hover / focus で枠を Secondary にする
   */
  .preview-filter-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 26px;
    padding: 0 8px 0 11px;
    color: var(--text-secondary);
    background: var(--bg-subtle);
    border: 1px solid var(--border);
    border-radius: 999px;
    font-family: inherit;
    font-size: 12px;
    cursor: pointer;
    transition:
      color var(--duration-feedback) ease,
      border-color var(--duration-feedback) ease;
  }

  .preview-filter-chip:hover,
  .preview-filter-chip:focus-visible {
    color: var(--text-primary);
    border-color: var(--focus);
  }

  @media (prefers-reduced-motion: reduce) {
    .preview-filter-chip {
      transition: none;
    }
  }

  .preview-filter-chip:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }

  .preview-filter-chip-remove {
    color: var(--text-muted);
    line-height: 1;
  }

  .preview-clear-all {
    min-height: 24px;
    padding: 0;
    color: var(--link);
    background: transparent;
    border: 0;
    font-family: inherit;
    font-size: 12px;
    text-decoration: underline;
    text-underline-offset: 4px;
    cursor: pointer;
  }

  .preview-table-wrap {
    margin-top: 16px;
  }

  .preview-table-wrap[hidden] {
    display: none;
  }

  .preview-table {
    width: 100%;
    min-width: 760px;
    border-collapse: separate;
    border-spacing: 0;
    color: var(--text-primary);
    font-size: 13px;
    text-align: left;
  }

  .preview-table thead th {
    position: sticky;
    top: 0;
    z-index: 2;
    padding: 0;
    color: var(--text-muted);
    background: var(--bg-base);
    border-bottom: 1px solid var(--border-strong);
    font-size: 12px;
    font-weight: 600;
  }

  .preview-sort-button {
    display: flex;
    align-items: center;
    gap: 4px;
    width: 100%;
    padding: 9px 10px;
    color: inherit;
    background: none;
    border: 0;
    font-size: inherit;
    font-weight: inherit;
    font-family: inherit;
    text-align: left;
    cursor: pointer;
  }

  .preview-sort-button:hover {
    color: var(--text-primary);
    background: var(--bg-hover);
  }

  .preview-sort-button:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: -2px;
  }

  .preview-sort-indicator::before {
    content: "↕";
    opacity: 0.35;
  }

  .preview-sort-button:hover .preview-sort-indicator::before {
    opacity: 0.6;
  }

  [aria-sort="ascending"] .preview-sort-button,
  [aria-sort="descending"] .preview-sort-button {
    color: var(--text-primary);
  }

  [aria-sort="ascending"] .preview-sort-indicator::before {
    content: "↑";
    opacity: 1;
  }

  [aria-sort="descending"] .preview-sort-indicator::before {
    content: "↓";
    opacity: 1;
  }

  .preview-post-row > th,
  .preview-post-row > td {
    padding: 11px 10px;
    vertical-align: top;
  }

  .preview-post-row:hover > th,
  .preview-post-row:hover > td {
    background: var(--bg-hover);
  }

  /* ピン留めは通常の一覧と別の塊なので、間を罫線で切る */
  .preview-post-group[data-post-group="pinned"] > tr:last-child > th,
  .preview-post-group[data-post-group="pinned"] > tr:last-child > td {
    padding-bottom: 18px;
    border-bottom: 1px solid var(--border-strong);
  }

  /* 続きがグループ見出しなら、その余白があるので足さない */
  .preview-post-group[data-post-group="pinned"]
    + tbody
    > tr.preview-post-row:first-child
    > th,
  .preview-post-group[data-post-group="pinned"]
    + tbody
    > tr.preview-post-row:first-child
    > td {
    padding-top: 18px;
  }

  /* 行のどこを押しても記事へ移れるので、行全体を押せる場所として示す */
  .preview-post-row {
    cursor: pointer;
  }

  .preview-post-row:hover > th,
  .preview-post-row:hover > td {
    background: var(--bg-hover);
  }

  .preview-title-cell {
    min-width: 340px;
    font-weight: 500;
  }

  .preview-post-link {
    color: var(--link);
    text-decoration: none;
    text-underline-offset: 3px;
  }

  .preview-post-link:hover {
    color: var(--link-hover);
    text-decoration: underline;
  }

  .preview-title-meta {
    display: block;
    margin-top: 3px;
    color: var(--text-muted);
    font-size: 11px;
    font-weight: 400;
  }

  .preview-title-line {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 7px;
  }

  /* ピンはタイトルに属する印なので、行の操作ボタンより内側に寄せる */
  .preview-title-name {
    display: inline-flex;
    align-items: baseline;
    gap: 0.4em;
    min-width: 0;
  }

  /* 固定していない記事でも押せるよう、印ではなく操作として置く。
     普段は薄く、行に触れたときとfocus時に見せる */
  .preview-pin-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 24px;
    min-height: 24px;
    padding: 2px;
    color: var(--text-muted);
    background: transparent;
    border: 0;
    border-radius: var(--radius-label);
    opacity: 0;
    /* 見えない間は当たり判定も消す。行のクリックを奪わないため */
    pointer-events: none;
    cursor: pointer;
    transition:
      color var(--duration-feedback) var(--ease-trace),
      opacity var(--duration-feedback) var(--ease-trace);
  }

  /* 他の行操作と同じく、ポインタが乗った行にだけ出す。
     固定されているかどうかはタイトル左の印が示す */
  .preview-post-row:hover .preview-pin-toggle,
  .preview-post-row:focus-within .preview-pin-toggle,
  .preview-pin-toggle:focus-visible {
    opacity: 1;
    pointer-events: auto;
  }

  /* 固定済みの印。操作ではないので、固定グループの中でだけ出す */
  .preview-pin-mark {
    display: none;
    width: 0.95em;
    height: 0.95em;
    flex: 0 0 auto;
    color: var(--color-primary);
    /* 下辺がベースラインに載ると高く見えるので、文字の中心へ下ろす */
    translate: 0 0.1em;
  }

  .preview-post-group[data-post-group="pinned"] .preview-pin-mark {
    display: inline-flex;
  }

  .preview-pin-toggle[aria-pressed="true"] {
    color: var(--color-primary);
  }

  .preview-pin-toggle:hover {
    color: var(--text-primary);
  }

  .preview-pin-toggle[data-busy] {
    opacity: 0.5;
    pointer-events: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .preview-pin-toggle {
      transition: none;
    }
  }

  .preview-pin-icon {
    width: 0.95em;
    height: 0.95em;
    flex: 0 0 auto;
  }

  .preview-slug {
    color: var(--text-muted);
    background: none;
    font-family: var(--font-mono);
    font-size: 11px;
    word-break: break-all;
  }

  /* 編集ボタンと同じく、行にホバーしたときだけ見せる */
  .preview-title-line .preview-copy-link {
    padding: 2px;
    opacity: 0;
    pointer-events: none;
  }

  .preview-create-launch {
    margin-bottom: 16px;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--border);
  }

  .preview-create-open {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 12px;
    color: var(--color-primary);
    background: var(--bg-base);
    border: 1px solid var(--color-primary);
    border-radius: var(--radius-label);
    font-size: var(--text-sm);
    font-family: inherit;
    font-weight: 700;
    cursor: pointer;
  }

  .preview-create-open svg {
    width: 14px;
    height: 14px;
  }

  .create-dialog {
    /* Tailwind の preflight が全要素の margin を 0 にするため、
       dialog 既定の margin: auto が消えて中央に来ない。ここで戻す */
    margin: auto;
    width: min(1060px, calc(100vw - 32px));
    max-height: min(880px, calc(100vh - 48px));
    /* dialog の既定は overflow: auto。送るのは中身の側だけにする */
    overflow: hidden;
    padding: 0;
    color: var(--text-primary);
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
  }

  .create-dialog::backdrop {
    background: rgb(0 0 0 / 0.45);
  }

  /* ダイアログを開いている間は背面を固定する。dialog 単体では止まらない */
  :global(html:has(dialog[open])) {
    overflow: hidden;
  }

  .create-form {
    display: flex;
    flex-direction: column;
    max-height: inherit;
  }

  .create-head {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 16px;
    border-bottom: 1px solid var(--border);
  }

  .create-title {
    margin: 0;
    margin-right: auto;
    font-size: var(--text-base);
    font-weight: 700;
  }

  /* AI はフォームの途中ではなく、見出しの隣の 1 アクションとして置く */
  .create-ai {
    position: relative;
  }

  .create-ai-summary {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 5px 12px;
    color: var(--color-primary);
    background: var(--bg-base);
    border: 1px solid var(--color-primary);
    border-radius: var(--radius-label);
    font-size: var(--text-sm);
    cursor: pointer;
    list-style: none;
  }

  .create-ai-summary::-webkit-details-marker {
    display: none;
  }

  .create-ai-chevron {
    width: 12px;
    height: 12px;
    transition: transform var(--duration-feedback) var(--ease-trace);
  }

  .create-ai[open] .create-ai-chevron {
    transform: rotate(180deg);
  }

  .create-ai-summary svg {
    flex: 0 0 auto;
  }

  @media (prefers-reduced-motion: reduce) {
    .create-ai-chevron {
      transition: none;
    }
  }

  .create-ai-panel {
    position: absolute;
    top: calc(100% + 6px);
    right: 0;
    z-index: 1;
    display: grid;
    gap: 8px;
    width: min(320px, 70vw);
    padding: 12px;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-label);
    box-shadow: 0 6px 24px rgb(0 0 0 / 0.12);
  }

  .create-ai-note {
    margin: 0;
    color: var(--text-muted);
    font-size: var(--text-xs);
    line-height: 1.6;
  }

  .create-ai-instruction {
    resize: vertical;
    line-height: 1.6;
  }

  .create-ai-run {
    justify-self: start;
    padding: 6px 14px;
    color: var(--bg-base);
    background: var(--color-primary);
    border: 1px solid var(--color-primary);
    border-radius: var(--radius-label);
    font-size: var(--text-sm);
    font-family: inherit;
    font-weight: 600;
    cursor: pointer;
  }

  .create-ai-run:disabled {
    opacity: 0.6;
    cursor: progress;
  }

  .create-close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 28px;
    min-height: 28px;
    color: var(--text-muted);
    background: none;
    border: 0;
    border-radius: var(--radius-label);
    cursor: pointer;
  }

  .create-close:hover {
    color: var(--text-primary);
    background: var(--bg-hover);
  }

  .create-close svg {
    width: 14px;
    height: 14px;
  }

  .create-body {
    display: grid;
    flex: 1;
    min-height: 0;
    gap: 20px 32px;
    padding: 16px;
    overflow-y: auto;
    /* 端まで送っても背面へスクロールを渡さない */
    overscroll-behavior: contain;
    /* ダイアログとタグ一覧で棒が二本立つので、どちらも見せない */
    scrollbar-width: none;
  }

  .create-body::-webkit-scrollbar {
    display: none;
  }

  /* 縦へ伸ばさず横に使う。左は書くもの、右は決めるもの */
  @media (min-width: 900px) {
    .create-body {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
      align-items: start;
    }
  }

  .create-column {
    display: grid;
    align-content: start;
    gap: 18px;
    min-width: 0;
  }

  .create-field {
    display: grid;
    gap: 4px;
    min-width: 0;
  }

  .create-field-body {
    gap: 6px;
  }

  .create-label {
    color: var(--text-muted);
    font-size: var(--text-xs);
  }

  select.create-input {
    padding-right: 28px;
    background: var(--bg-base) var(--select-chevron) no-repeat right 8px center;
    background-size: 12px 12px;
    appearance: none;
  }

  .create-input {
    width: 100%;
    padding: 6px 8px;
    color: var(--text-primary);
    background: var(--bg-base);
    border: 1px solid var(--border);
    border-radius: var(--radius-label);
    font-size: var(--text-sm);
    font-family: inherit;
  }

  .create-input:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 1px;
  }

  /* 主役。他の入力より一段大きく置く */
  .create-title-input {
    padding: 8px 10px;
    font-size: var(--text-md);
  }

  /* slug は機械側の識別子（design/foundations.md Typography） */
  .create-slug {
    font-family: var(--font-machine);
  }

  .create-body-input {
    min-height: 260px;
    resize: vertical;
    line-height: 1.7;
    font-family: var(--font-machine);
  }

  .create-body-modes {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 14px;
  }

  .create-hint {
    margin: 0;
    color: var(--text-muted);
    font-family: var(--font-machine);
    font-size: 11px;
  }

  .create-suggestions {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .create-suggestions:empty {
    display: none;
  }

  .create-choices {
    display: grid;
    gap: 8px;
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  /*
   * 群の見出しは語 + Line。面や枠で囲わず、位置と線で階層を作る。
   * legend は grid の gap が効かないので、線と中身の間隔は margin で持つ
   */
  .create-legend,
  .create-field-ruled .create-label {
    display: flex;
    align-items: center;
    gap: 10px;
    width: 100%;
    margin-bottom: 8px;
    padding: 0;
    color: var(--text-secondary);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  .create-legend::after,
  .create-field-ruled .create-label::after {
    content: "";
    flex: 1;
    height: 1px;
    background: var(--border);
  }

  .create-legend-hint {
    opacity: 0.8;
  }

  /* 絞り込みと新規追加は同じ入力で兼ねる。打てば絞り込まれ、無ければ足せる */
  .create-tag-input {
    display: flex;
    gap: 8px;
    min-width: 0;
  }

  .create-tag-add {
    flex: none;
    padding: 6px 12px;
    color: var(--color-primary);
    background: var(--bg-base);
    border: 1px solid var(--border);
    border-radius: var(--radius-label);
    font-size: var(--text-sm);
    font-family: inherit;
    cursor: pointer;
  }

  .create-tag-add:hover {
    background: var(--bg-hover);
  }

  .create-selected,
  .create-new-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .create-selected:empty,
  .create-new-tags:empty {
    display: none;
  }

  .create-options {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 10px;
    padding: 8px;
    background: var(--bg-base);
    border: 1px solid var(--border);
    border-radius: var(--radius-label);
  }

  .create-options-scroll {
    max-height: 200px;
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: none;
  }

  .create-options-scroll::-webkit-scrollbar {
    display: none;
  }

  .create-option {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    color: var(--text-primary);
    font-size: var(--text-sm);
    cursor: pointer;
  }

  .create-option[hidden] {
    display: none;
  }

  /* 常に見えていると 150 件ぶんの × が並んで邪魔になる。触れたときだけ出す */
  .tag-delete {
    padding: 0 2px;
    color: var(--text-muted);
    background: none;
    border: 0;
    font-size: var(--text-xs);
    line-height: 1;
    cursor: pointer;
    opacity: 0;
  }

  .tag-delete:focus-visible,
  label:hover > .tag-delete {
    opacity: 1;
  }

  .tag-delete:hover {
    color: var(--danger);
  }

  .create-option input:disabled + span {
    color: var(--text-muted);
    opacity: 0.55;
  }

  /* 既定のまま作ることが多いので、開いた人だけが触る */
  /* 何が隠れているかを閉じた状態でも読めるようにし、開くものだと印で示す。
     見た目は群の見出し（語 + Line）へ揃える */
  .create-advanced-summary {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 8px;
    color: var(--text-muted);
    font-size: var(--text-xs);
    cursor: pointer;
    list-style: none;
  }

  .create-advanced-summary::-webkit-details-marker {
    display: none;
  }

  .create-advanced-summary::after {
    content: "";
    flex: 1;
    min-width: 24px;
    height: 1px;
    background: var(--border);
  }

  .create-advanced-summary:hover,
  .create-advanced-summary:focus-visible {
    color: var(--text-primary);
  }

  .create-advanced-title {
    color: var(--text-secondary);
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  .create-advanced-chevron {
    width: 12px;
    height: 12px;
    transition: transform var(--duration-feedback) var(--ease-trace);
  }

  .create-advanced[open] .create-advanced-chevron {
    transform: rotate(90deg);
  }

  .create-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 12px;
    margin-top: 10px;
  }

  .create-field-wide {
    grid-column: 1 / -1;
  }

  .create-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    padding: 12px 16px;
    border-top: 1px solid var(--border);
  }

  .create-submit,
  .create-cancel {
    padding: 7px 18px;
    border: 1px solid var(--border);
    border-radius: var(--radius-label);
    font-size: var(--text-sm);
    font-family: inherit;
    cursor: pointer;
  }

  .create-submit {
    color: var(--bg-base);
    background: var(--color-primary);
    border-color: var(--color-primary);
    font-weight: 600;
  }

  .create-submit:disabled {
    opacity: 0.6;
    cursor: progress;
  }

  .create-cancel {
    color: var(--text-primary);
    background: var(--bg-base);
  }

  .create-cancel:hover {
    background: var(--bg-hover);
  }

  .create-status {
    margin: 0;
    color: var(--text-muted);
    font-size: var(--text-xs);
  }

  .create-status[data-tone="error"] {
    color: var(--danger-text);
  }

  /*
   * 行の削除も不可逆。design/hig.md `button.destructive` に従い、
   * 現れている間は面を透明のまま文字と枠を danger にする
   */
  .preview-row-delete {
    display: inline-flex;
    min-width: 24px;
    min-height: 24px;
    align-items: center;
    justify-content: center;
    padding: 2px;
    border: 1px solid var(--danger-border);
    border-radius: var(--radius-label);
    background: transparent;
    color: var(--danger);
    opacity: 0;
    pointer-events: none;
    cursor: pointer;
    transition:
      color var(--duration-feedback) var(--ease-trace),
      opacity var(--duration-feedback) var(--ease-trace);
  }

  .preview-row-delete svg {
    width: 14px;
    height: 14px;
  }

  .preview-row-delete:hover,
  .preview-row-delete:focus-visible {
    background: var(--danger-tint);
  }

  /* 押している最中だけ面を濃くする。色は変えない */
  .preview-row-delete:active {
    background: color-mix(in srgb, var(--danger) 22%, var(--color-background));
  }

  .preview-row-delete:disabled {
    opacity: 0.55;
    cursor: not-allowed;
  }

  .preview-post-row:hover .preview-copy-link,
  .preview-post-row:focus-within .preview-copy-link,
  .preview-post-row:hover .preview-row-delete,
  .preview-post-row:focus-within .preview-row-delete,
  .preview-title-line .preview-copy-link[data-copy-state] {
    opacity: 1;
    pointer-events: auto;
  }

  .preview-edit-trigger {
    display: inline-flex;
    padding: 2px;
    color: var(--text-muted);
    background: none;
    border: 0;
    border-radius: var(--radius-label);
    opacity: 0;
    cursor: pointer;
  }

  .preview-post-row:hover .preview-edit-trigger,
  .preview-edit-trigger:focus-visible {
    opacity: 1;
  }

  .preview-edit-trigger:hover {
    color: var(--link);
    background: var(--bg-hover);
  }

  .preview-edit-trigger:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 1px;
  }

  .preview-edit-icon {
    width: 12px;
    height: 12px;
  }

  .preview-title-input {
    flex: 1 1 240px;
    min-width: 0;
    padding: 3px 6px;
    color: var(--text-primary);
    background: var(--bg-base);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-label);
    font-size: inherit;
    font-family: inherit;
  }

  .preview-title-input[hidden] {
    display: none;
  }

  .preview-edit-status {
    color: var(--text-muted);
    font-size: 11px;
    font-weight: 400;
  }

  .preview-edit-status[data-tone="error"] {
    color: var(--danger-text);
  }

  .preview-cell-select,
  .preview-cell-date,
  .preview-status-badge {
    max-width: 100%;
    padding: 2px 7px;
    color: var(--text-secondary);
    background: var(--bg-subtle);
    border: 1px solid transparent;
    border-radius: var(--radius-label);
    font-size: inherit;
    font-family: inherit;
  }

  .preview-status-badge {
    display: inline-block;
    white-space: nowrap;
  }

  .preview-cell-select {
    appearance: none;
  }

  .preview-cell-date {
    background: none;
  }

  .preview-post-row:hover .preview-cell-date,
  .preview-cell-date:focus-visible {
    background: var(--bg-base);
    border-color: var(--border);
  }

  .preview-post-row:hover .preview-cell-select,
  .preview-cell-select:focus-visible {
    border-color: var(--border-strong);
  }

  .preview-cell-select:focus-visible,
  .preview-cell-date:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 1px;
  }

  preview-posts {
    /* 薄い赤は共通の役割 token を使う（design/tokens.md 破壊操作） */
    --tint-danger: var(--danger-tint);
    --tint-warning: color-mix(in oklab, var(--warning) 13%, var(--bg-base));
    --tint-active: color-mix(in oklab, var(--link) 13%, var(--bg-base));
    --tint-done: color-mix(in oklab, var(--accent-warm) 55%, var(--bg-base));
    /* 最終編集は改訂の痕跡として Accent に寄せ、完了の印より一段淡くする */
    --tint-edited: color-mix(in oklab, var(--accent-warm) 30%, var(--bg-base));
  }

  .preview-post-row[data-priority="high"] [data-edit-select="priority"] {
    color: var(--danger);
    background: var(--tint-danger);
  }

  .preview-post-row[data-priority="medium"] [data-edit-select="priority"],
  .preview-post-row[data-publication="draft"] [data-edit-select="status"],
  .preview-post-row[data-writing="planned"] [data-edit-select="writingStatus"] {
    color: var(--warning);
    background: var(--tint-warning);
  }

  .preview-post-row[data-priority="low"] [data-edit-select="priority"],
  .preview-post-row[data-writing="writing"] [data-edit-select="writingStatus"] {
    color: var(--link);
    background: var(--tint-active);
  }

  .preview-post-row[data-publication="published"] [data-edit-select="status"],
  .preview-post-row[data-writing="done"] [data-edit-select="writingStatus"] {
    color: var(--text-primary);
    background: var(--tint-done);
  }

  .preview-post-row[data-memo="HAS_MEMO"] .preview-memo-badge {
    color: var(--warning);
    background: var(--tint-warning);
  }

  .preview-post-row[data-memo="BROKEN_MEMO"] .preview-memo-badge {
    color: var(--danger);
    background: var(--tint-danger);
  }

  .preview-post-row[data-memo="NO_MEMO"] .preview-memo-badge {
    color: var(--text-muted);
    background: none;
  }

  .preview-post-row[data-writing="on_hold"] > th,
  .preview-post-row[data-writing="on_hold"] > td {
    background: var(--bg-subtle);
  }

  .preview-period-options {
    display: flex;
    flex-wrap: wrap;
    gap: 2px 16px;
  }

  /*
   * 1つだけ選ぶ期間なので radio で持ち、見た目は文字だけにする。選択中は
   * 「探す」の年の軸と同じく Primary、太字、下線で示す
   */
  .preview-period-option {
    position: relative;
    display: inline-flex;
    align-items: baseline;
    min-height: 28px;
    padding-top: 5px;
    color: var(--text-secondary);
    font-size: 13px;
    white-space: nowrap;
    text-decoration: underline transparent;
    text-decoration-thickness: 2px;
    text-underline-offset: 6px;
    cursor: pointer;
  }

  .preview-period-option input {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }

  .preview-period-option:hover {
    color: var(--link);
  }

  .preview-period-option:has(input:checked) {
    color: var(--color-primary);
    font-weight: 700;
    text-decoration-color: currentColor;
  }

  .preview-period-option:has(input:focus-visible) {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }

  .preview-period-count {
    margin-left: 5px;
    color: var(--text-muted);
    font-family: var(--font-machine);
    font-size: 11px;
    font-weight: 400;
    font-variant-numeric: tabular-nums;
  }

  .preview-period-count:empty {
    display: none;
  }

  .preview-edited-chip {
    margin-left: 6px;
    padding: 0 5px;
    background: var(--tint-edited);
    font-variant-numeric: tabular-nums;
  }

  .preview-category-trigger {
    display: flex;
    align-items: center;
    gap: 5px;
    padding: 0;
    background: none;
    border: 0;
    cursor: pointer;
  }

  .preview-category-trigger:hover {
    color: var(--link);
  }

  .preview-category-trigger:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }

  .preview-category-popover {
    position: fixed;
    margin: 0;
    padding: 8px;
    color: var(--text-primary);
    background: var(--bg-card);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-card);
    font-size: 12px;
    font-weight: 400;
  }

  .preview-category-choice {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 3px 4px;
    cursor: pointer;
  }

  .preview-category-choice input:disabled + span {
    color: var(--text-muted);
    opacity: 0.55;
  }

  .preview-priority,
  .preview-status-text {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    color: var(--text-secondary);
    white-space: nowrap;
  }

  preview-posts[data-group="priority"] .preview-priority-column {
    display: none;
  }

  .preview-date-cell {
    color: var(--text-secondary);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .preview-group-row th {
    padding: 18px 4px 4px;
    background: var(--bg-base);
  }

  .preview-group-toggle {
    display: flex;
    align-items: center;
    gap: 7px;
    width: 100%;
    padding: 0 2px 7px;
    color: var(--text-primary);
    background: transparent;
    border: 0;
    border-bottom: 1px solid var(--border);
    /* 表の本文（13px）より一段大きくし、見出しとして読ませる */
    font-size: 15px;
    font-weight: 600;
    text-align: left;
  }

  .preview-group-toggle:hover {
    color: var(--link-hover);
  }

  .preview-group-chevron {
    flex: none;
    width: 16px;
    height: 16px;
    color: var(--text-muted);
    transition: transform var(--duration-feedback) var(--ease-trace);
  }

  .preview-group-toggle[aria-expanded="false"] .preview-group-chevron {
    transform: rotate(-90deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .preview-group-chevron {
      transition: none;
    }
  }

  .preview-group-count {
    margin-left: auto;
    color: var(--text-muted);
    font-family: var(--font-machine);
    font-size: 12px;
    font-weight: 400;
    font-variant-numeric: tabular-nums;
  }

  .preview-empty {
    margin: 20px 0 0;
    padding: 36px 20px;
    color: var(--text-secondary);
    border: 1px dashed var(--border);
    border-radius: var(--radius-card);
    font-size: 14px;
    text-align: center;
  }

  .preview-empty[hidden] {
    display: none;
  }

  .preview-empty button {
    margin-left: 8px;
    padding: 0;
    color: var(--link);
    background: transparent;
    border: 0;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /*
   * Narrow では条件のボタンを「絞り込み」1つに畳む。開くと吹き出しを使わず、
   * 全条件の選択肢をその場に並べる。吹き出しは画面幅に対して小さすぎるため
   */
  @media (max-width: 639px) {
    .preview-facets-toggle {
      display: inline-flex;
    }

    .preview-facets {
      display: none;
    }

    .preview-facets.is-expanded {
      display: grid;
      gap: 16px;
      padding-top: 4px;
    }

    .preview-facet-trigger {
      display: none;
    }

    /* 開閉の状態によらず中身を出す。UA の popover の配置と面も外す */
    .preview-facets.is-expanded .preview-facet-popover {
      position: static;
      display: block;
      width: auto;
      min-width: 0;
      max-width: none;
      padding: 0;
      background: none;
      border: 0;
      box-shadow: none;
    }

    .preview-facets.is-expanded .preview-facet-group legend {
      position: static;
      width: auto;
      height: auto;
      margin-bottom: 2px;
      overflow: visible;
      clip-path: none;
      color: var(--text-muted);
      font-size: 12px;
    }

    .preview-facets.is-expanded .preview-option-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 900px) {
    .preview-shell {
      padding: 36px 24px 56px;
    }

    /* 「絞る」を主に広く取り、「表示」は右に縦線で区切って添える */
    .preview-tools {
      /* 「最終編集が新しい順」「列: タイトル ↑」が詰まらずに収まる幅 */
      grid-template-columns: minmax(0, 1fr) 280px;
      gap: 28px;
    }

    .preview-view {
      padding-left: 28px;
      border-left: 1px solid var(--border);
    }
  }

  @media (max-width: 767px) {
    .preview-table {
      display: block;
      min-width: 0;
    }

    .preview-table thead {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }

    .preview-post-group {
      display: grid;
      gap: 2px;
      margin-bottom: 18px;
    }

    /* セルの罫線を外しているので、塊そのものを線で切る */
    .preview-post-group[data-post-group="pinned"] {
      padding-bottom: 18px;
      border-bottom: 1px solid var(--border-strong);
    }

    .preview-group-row,
    .preview-group-row th {
      display: block;
      padding: 0;
    }

    .preview-post-row {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 10px 12px;
      padding: 10px 4px;
    }

    .preview-post-row > th,
    .preview-post-row > td {
      display: grid;
      gap: 4px;
      width: auto;
      max-width: none;
      padding: 0;
      border: 0;
    }

    .preview-post-row > td::before {
      content: attr(data-label);
      color: var(--text-muted);
      font-size: 10px;
      font-weight: 600;
    }

    .preview-post-row:hover > th,
    .preview-post-row:hover > td {
      background: transparent;
    }

    .preview-title-cell {
      grid-column: 1 / -1;
    }

    .preview-title-cell {
      min-width: 0;
      padding-bottom: 3px;
    }
  }

  .preview-icon-sprites {
    display: none;
  }

  .preview-post-row[hidden],
  .preview-post-group[hidden] {
    display: none;
  }
</style>

<script>
  import { initPreviewPosts } from "~/scripts/previewPosts";
  import { initPreviewPinToggle } from "~/scripts/previewPinToggle";
  import { onPageLoad } from "~/scripts/pageLifecycle";

  onPageLoad(() => {
    initPreviewPosts();
    initPreviewPinToggle();
  });
</script>
