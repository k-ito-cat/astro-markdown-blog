---
import type { CollectionEntry } from "astro:content";
import { Icon } from "astro-icon/components";
import CopyLinkButton from "~/components/CopyLinkButton.astro";
import { CATEGORIES, MAX_CATEGORIES_PER_POST } from "~/constants/categories";
import { TAGS } from "~/constants/tags";
import {
  POST_PRIORITY,
  POST_PRIORITY_LABELS,
  POST_PRIORITY_ORDER,
} from "~/constants/postPriority";
import {
  PUBLISHED_STATUS,
  PUBLISHED_STATUS_LABELS,
  PUBLISHED_STATUS_ORDER,
} from "~/constants/publishedStatus";
import {
  WRITING_STATUS,
  WRITING_STATUS_LABELS,
  WRITING_STATUS_ORDER,
} from "~/constants/writingStatus";
import { detectMemoState } from "~/utils/postMemo.js";
import {
  normalizeSearchText,
  MEMO_STATE_LABELS,
  type MemoState,
} from "~/utils/previewPost";
import { normalizePostSlug } from "~/utils/postSlug";
import { isPreviewPinned } from "~/constants/previewPinned";

type Props = {
  posts: CollectionEntry<"posts">[];
};

const { posts } = Astro.props;

const RECENT_DAY_OPTIONS = [1, 3, 7] as const;

const SORT_COLUMNS = [
  { value: "title", label: "タイトル" },
  { value: "priority", label: "優先度" },
  { value: "writing", label: "執筆状態" },
  { value: "publication", label: "公開状態" },
  { value: "memo", label: "メモ状態" },
  { value: "updated", label: "更新日" },
] as const;

const previewPosts = posts
  .map((post) => {
    const memoState = detectMemoState(post.body ?? "") as MemoState;
    const previewSlug = normalizePostSlug(post.id);

    return {
      ...post,
      previewSlug,
      memoState,
      pinned: isPreviewPinned(previewSlug),
      searchText: normalizeSearchText(
        [
          post.data.title,
          previewSlug,
          ...post.data.categories,
          ...post.data.tags,
          // 本文も対象にして、書いた内容から記事を引けるようにする
          post.body ?? "",
        ].join(" "),
      ),
    };
  })
  .sort((a, b) => {
    const priorityDiff =
      POST_PRIORITY_ORDER[a.data.priority] -
      POST_PRIORITY_ORDER[b.data.priority];
    if (priorityDiff !== 0) return priorityDiff;

    const writingStatusDiff =
      WRITING_STATUS_ORDER[a.data.writingStatus] -
      WRITING_STATUS_ORDER[b.data.writingStatus];
    if (writingStatusDiff !== 0) return writingStatusDiff;

    return a.data.title.localeCompare(b.data.title, "ja");
  });

const priorities = Object.values(POST_PRIORITY).sort(
  (a, b) => POST_PRIORITY_ORDER[a] - POST_PRIORITY_ORDER[b],
);

const writingStatuses = Object.values(WRITING_STATUS).sort(
  (a, b) => WRITING_STATUS_ORDER[a] - WRITING_STATUS_ORDER[b],
);

const publishedStatuses = Object.values(PUBLISHED_STATUS).sort(
  (a, b) => PUBLISHED_STATUS_ORDER[a] - PUBLISHED_STATUS_ORDER[b],
);

const categories = Array.from(
  new Set(previewPosts.flatMap((post) => post.data.categories)),
).sort((a, b) => a.localeCompare(b, "ja"));

const tags = Array.from(
  new Set(previewPosts.flatMap((post) => post.data.tags)),
).sort((a, b) => a.localeCompare(b, "ja"));

// 作成フォームは正本の定数から出す。まだ使われていない選択肢も選べる必要がある
const createCategories = [...CATEGORIES].sort((a, b) =>
  a.localeCompare(b, "ja"),
);
const createTags = [...TAGS].sort((a, b) => a.localeCompare(b, "ja"));

const today = new Date().toISOString().slice(0, 10);
const createPublishedStatuses = Object.values(PUBLISHED_STATUS).sort(
  (a, b) => PUBLISHED_STATUS_ORDER[a] - PUBLISHED_STATUS_ORDER[b],
);
const createWritingStatuses = Object.values(WRITING_STATUS).sort(
  (a, b) => WRITING_STATUS_ORDER[a] - WRITING_STATUS_ORDER[b],
);
const createPriorities = Object.values(POST_PRIORITY).sort(
  (a, b) => POST_PRIORITY_ORDER[a] - POST_PRIORITY_ORDER[b],
);

const publishedMemoCount = previewPosts.filter(
  (post) =>
    post.data.status === PUBLISHED_STATUS.PUBLISHED &&
    post.memoState !== "NO_MEMO",
).length;
const publishedMemoFilterParams = new URLSearchParams({
  publication: PUBLISHED_STATUS.PUBLISHED,
});
["HAS_MEMO", "EMPTY_MEMO", "BROKEN_MEMO"].forEach((memoState) => {
  publishedMemoFilterParams.append("memo", memoState);
});
---

<preview-posts
  class="preview-posts"
  data-total={previewPosts.length}
  data-group="none"
  data-max-categories={MAX_CATEGORIES_PER_POST}
>
  <main class="preview-shell">
    <header class="preview-header">
      <div>
        <p class="preview-eyebrow">Local Preview</p>
        <h1 class="preview-title">記事プレビュー</h1>
      </div>
      <div class="preview-header-meta">
        <span class="preview-count" data-result-count aria-live="polite">
          表示中 {previewPosts.length} / 全{previewPosts.length}件
        </span>
        <a href="/blog" class="preview-blog-link">ブログ一覧</a>
      </div>
    </header>

    {
      publishedMemoCount > 0 && (
        <section
          class="preview-publication-warning"
          aria-labelledby="preview-publication-warning-title"
        >
          <Icon
            name="octicon:alert-16"
            class="preview-publication-warning-icon"
          />
          <div class="preview-publication-warning-copy">
            <h2 id="preview-publication-warning-title">
              公開済みの記事{publishedMemoCount}件にメモ欄が残っています
            </h2>
            <p>メモは本番ページにも表示されます。</p>
          </div>
          <a href={`/preview/posts?${publishedMemoFilterParams.toString()}`}>
            対象を表示
          </a>
        </section>
      )
    }

    <div class="preview-create-launch">
      <button type="button" class="preview-create-open" data-create-open>
        <Icon name="octicon:plus-16" />
        新しい記事
      </button>
    </div>

    <dialog
      class="create-dialog"
      closedby="any"
      aria-labelledby="create-dialog-title"
      data-create-dialog
    >
      <form class="create-form" data-create-form>
        <header class="create-head">
          <h2 class="create-title" id="create-dialog-title">新しい記事</h2>

          <details class="create-ai">
            <summary class="create-ai-summary">AI 候補</summary>
            <div class="create-ai-panel">
              <p class="create-ai-note">
                タイトルをもとに、タイトル・スラッグ・カテゴリ・タグの候補を出します。
              </p>
              <textarea
                class="create-input create-ai-instruction"
                rows="3"
                placeholder="指示（任意）例: もっと短く、専門用語を避けて"
                data-create-instruction></textarea>
              <button type="button" class="create-ai-run" data-create-suggest>
                候補を出す
              </button>
            </div>
          </details>

          <button
            type="button"
            class="create-close"
            aria-label="閉じる"
            data-create-close
          >
            <Icon name="octicon:x-16" />
          </button>
        </header>

        <div class="create-body">
          <div class="create-column">
            <div class="create-field">
              <label class="create-label" for="create-title">タイトル</label>
              <input
                type="text"
                id="create-title"
                class="create-input create-title-input"
                autocomplete="off"
                required
                data-create-title
              />
              <div class="create-suggestions" data-suggestions="titles"></div>
            </div>

            <div class="create-field">
              <label class="create-label" for="create-slug">スラッグ</label>
              <input
                type="text"
                id="create-slug"
                class="create-input create-slug"
                placeholder="my-new-article"
                pattern="[a-z0-9]+(-[a-z0-9]+)*"
                autocomplete="off"
                spellcheck="false"
                required
                data-create-slug
              />
              <div class="create-suggestions" data-suggestions="slugs"></div>
              <p class="create-hint">
                src/content/posts/blog/<span data-create-preview>slug</span>.md
              </p>
            </div>

            <div class="create-field create-field-body">
              <label class="create-label" for="create-body">本文</label>
              <textarea
                id="create-body"
                class="create-input create-body-input"
                placeholder="空のままなら「ここに本文を書く」と「## メモ」で作ります"
                data-create-body></textarea>
              <div
                class="create-body-modes"
                role="radiogroup"
                aria-label="入力の扱い"
              >
                <label class="create-option">
                  <input
                    type="radio"
                    name="bodyMode"
                    value="body"
                    checked
                    data-create-body-mode
                  />
                  <span>本文にする</span>
                </label>
                <label class="create-option">
                  <input
                    type="radio"
                    name="bodyMode"
                    value="memo"
                    data-create-body-mode
                  />
                  <span>メモに入れる</span>
                </label>
              </div>
            </div>
          </div>

          <div class="create-column">
            <fieldset
              class="create-choices"
              data-create-group="categories"
              data-create-max={MAX_CATEGORIES_PER_POST}
            >
              <legend class="create-legend">
                カテゴリ
                <span class="create-legend-hint">
                  1〜{MAX_CATEGORIES_PER_POST}件
                </span>
              </legend>
              <div class="create-suggestions" data-suggestions="categories">
              </div>
              <div class="create-options">
                {
                  createCategories.map((category) => (
                    <label class="create-option" data-create-choice={category}>
                      <input
                        type="checkbox"
                        name="categories"
                        value={category}
                      />
                      <span>{category}</span>
                    </label>
                  ))
                }
              </div>
            </fieldset>

            <fieldset class="create-choices" data-create-group="tags">
              <legend class="create-legend">
                タグ
                <span class="create-legend-hint">1件以上</span>
              </legend>
              <div class="create-tag-input">
                <input
                  type="search"
                  class="create-input"
                  placeholder="絞り込む・無ければ追加"
                  autocomplete="off"
                  data-create-filter
                  data-new-tag-input
                />
                <button type="button" class="create-tag-add" data-new-tag-add>
                  ＋追加
                </button>
              </div>
              <div class="create-suggestions" data-suggestions="tags"></div>
              <div class="create-suggestions" data-suggestions="newTags"></div>
              <div class="create-selected" data-create-selected></div>
              <div class="create-new-tags" data-new-tags></div>
              <div class="create-options create-options-scroll">
                {
                  createTags.map((tag) => (
                    <label class="create-option" data-create-choice={tag}>
                      <input type="checkbox" name="tags" value={tag} />
                      <span>{tag}</span>
                      <button
                        type="button"
                        class="tag-delete"
                        aria-label={`${tag} を定数から削除`}
                        data-tag-delete={tag}
                      >
                        ×
                      </button>
                    </label>
                  ))
                }
              </div>
            </fieldset>

            <details class="create-advanced">
              <summary class="create-advanced-summary">
                公開設定
                <span class="create-legend-hint">既定のままで作れます</span>
              </summary>
              <div class="create-grid">
                <label class="create-field">
                  <span class="create-label">公開日</span>
                  <input
                    type="date"
                    class="create-input"
                    value={today}
                    data-create-field="publishedAt"
                  />
                </label>

                <label class="create-field">
                  <span class="create-label">更新日</span>
                  <input
                    type="date"
                    class="create-input"
                    value={today}
                    data-create-field="updatedAt"
                  />
                </label>

                <label class="create-field">
                  <span class="create-label">公開状態</span>
                  <select class="create-input" data-create-field="status">
                    {
                      createPublishedStatuses.map((value) => (
                        <option
                          value={value}
                          selected={value === PUBLISHED_STATUS.PRIVATE}
                        >
                          {PUBLISHED_STATUS_LABELS[value]}
                        </option>
                      ))
                    }
                  </select>
                </label>

                <label class="create-field">
                  <span class="create-label">執筆状態</span>
                  <select
                    class="create-input"
                    data-create-field="writingStatus"
                  >
                    {
                      createWritingStatuses.map((value) => (
                        <option
                          value={value}
                          selected={value === WRITING_STATUS.TODO}
                        >
                          {WRITING_STATUS_LABELS[value]}
                        </option>
                      ))
                    }
                  </select>
                </label>

                <label class="create-field">
                  <span class="create-label">優先度</span>
                  <select class="create-input" data-create-field="priority">
                    {
                      createPriorities.map((value) => (
                        <option
                          value={value}
                          selected={value === POST_PRIORITY.NONE}
                        >
                          {POST_PRIORITY_LABELS[value]}
                        </option>
                      ))
                    }
                  </select>
                </label>

                <label class="create-field create-field-wide">
                  <span class="create-label">サムネイル</span>
                  <input
                    type="text"
                    class="create-input"
                    autocomplete="off"
                    data-create-field="thumbnail"
                  />
                </label>

                <label class="create-field create-field-wide">
                  <span class="create-label">GitHub URL</span>
                  <input
                    type="text"
                    class="create-input"
                    autocomplete="off"
                    data-create-field="githubUrl"
                  />
                </label>
              </div>
            </details>
          </div>
        </div>

        <footer class="create-actions">
          <button type="submit" class="create-submit">作成</button>
          <button type="button" class="create-cancel" data-create-close>
            キャンセル
          </button>
          <p class="create-status" data-create-status aria-live="polite"></p>
        </footer>
      </form>
    </dialog>

    <form class="preview-tools" data-preview-controls>
      <label class="preview-field preview-search-field">
        <span class="preview-field-label">検索</span>
        <span class="preview-search-control">
          <Icon name="octicon:search-16" class="preview-search-icon" />
          <input
            type="search"
            name="q"
            class="preview-search-input"
            placeholder="タイトル・カテゴリ・slug・本文"
            autocomplete="off"
            data-search-input
          />
        </span>
      </label>

      <label class="preview-field">
        <span class="preview-field-label">グループ</span>
        <select name="group" class="preview-select" data-group-select>
          <option value="none">グループなし</option>
          <option value="priority">優先度</option>
          <option value="writing">執筆状態</option>
          <option value="publication">公開状態</option>
        </select>
      </label>

      <div class="preview-field" role="group" aria-label="最近の記事で絞り込み">
        <span class="preview-field-label">最近の記事</span>
        <div class="preview-recent-options">
          {
            RECENT_DAY_OPTIONS.map((days) => (
              <button
                type="button"
                class="preview-recent-button"
                aria-pressed="false"
                data-recent-button={days}
              >
                {days}日
                <span class="preview-recent-count" data-recent-count={days} />
              </button>
            ))
          }
        </div>
      </div>

      <details class="preview-filters" data-filter-details>
        <summary class="preview-filter-summary">
          絞り込み
          <span class="preview-filter-count" data-filter-count hidden></span>
        </summary>
        <div class="preview-filter-panel">
          <fieldset class="preview-filter-group">
            <legend>優先度</legend>
            <div class="preview-checkbox-list">
              {
                priorities.map((priority) => (
                  <label>
                    <input
                      type="checkbox"
                      name="priority"
                      value={priority}
                      data-filter-key="priority"
                    />
                    <span>{POST_PRIORITY_LABELS[priority]}</span>
                  </label>
                ))
              }
            </div>
          </fieldset>

          <fieldset class="preview-filter-group">
            <legend>執筆状態</legend>
            <div class="preview-checkbox-list">
              {
                Object.values(WRITING_STATUS).map((writingStatus) => (
                  <label>
                    <input
                      type="checkbox"
                      name="writing"
                      value={writingStatus}
                      data-filter-key="writing"
                    />
                    <span>{WRITING_STATUS_LABELS[writingStatus]}</span>
                  </label>
                ))
              }
            </div>
          </fieldset>

          <fieldset class="preview-filter-group">
            <legend>公開状態</legend>
            <div class="preview-checkbox-list">
              {
                Object.values(PUBLISHED_STATUS).map((status) => (
                  <label>
                    <input
                      type="checkbox"
                      name="publication"
                      value={status}
                      data-filter-key="publication"
                    />
                    <span>{PUBLISHED_STATUS_LABELS[status]}</span>
                  </label>
                ))
              }
            </div>
          </fieldset>

          <fieldset class="preview-filter-group">
            <legend>メモ状態</legend>
            <div class="preview-checkbox-list">
              {
                Object.entries(MEMO_STATE_LABELS).map(([memoState, label]) => (
                  <label>
                    <input
                      type="checkbox"
                      name="memo"
                      value={memoState}
                      data-filter-key="memo"
                    />
                    <span>{label}</span>
                  </label>
                ))
              }
            </div>
          </fieldset>

          <fieldset class="preview-filter-group preview-category-filter">
            <legend>カテゴリ</legend>
            <div class="preview-checkbox-list preview-category-list">
              {
                categories.map((category) => (
                  <label>
                    <input
                      type="checkbox"
                      name="category"
                      value={category}
                      data-filter-key="category"
                    />
                    <span>{category}</span>
                  </label>
                ))
              }
            </div>
          </fieldset>

          <fieldset class="preview-filter-group preview-category-filter">
            <legend>タグ</legend>
            <div class="preview-checkbox-list preview-category-list">
              {
                tags.map((tag) => (
                  <label>
                    <input
                      type="checkbox"
                      name="tag"
                      value={tag}
                      data-filter-key="tag"
                    />
                    <span>{tag}</span>
                  </label>
                ))
              }
            </div>
          </fieldset>

          <button type="button" class="preview-filter-clear" data-filter-clear>
            絞り込みを解除
          </button>
        </div>
      </details>
    </form>

    <div class="preview-active-filters" data-active-filters hidden>
      <div class="preview-filter-chips" data-filter-chips></div>
      <button type="button" class="preview-clear-all" data-clear-all>
        条件をすべて解除
      </button>
    </div>

    <div class="preview-table-wrap" data-table-wrap>
      <table class="preview-table">
        <caption class="sr-only"> ローカルプレビュー用の記事管理一覧 </caption>
        <thead>
          <tr>
            {
              SORT_COLUMNS.map((column) => (
                <th
                  scope="col"
                  class:list={[
                    { "preview-priority-column": column.value === "priority" },
                  ]}
                  aria-sort="none"
                  data-sort-header
                >
                  <button
                    type="button"
                    class="preview-sort-button"
                    data-sort-column={column.value}
                  >
                    {column.label}
                    <span class="preview-sort-indicator" aria-hidden="true" />
                  </button>
                </th>
              ))
            }
          </tr>
        </thead>
        <tbody class="preview-post-group" data-post-group="all">
          {
            previewPosts.map((previewPost) => {
              const rowKey = encodeURIComponent(previewPost.id).replaceAll(
                "%",
                "",
              );
              const categoryPopoverId = `preview-categories-${rowKey}`;
              return (
                <tr
                  class="preview-post-row"
                  data-post-row
                  data-entry-id={previewPost.id}
                  data-slug={previewPost.previewSlug}
                  data-pinned={String(previewPost.pinned)}
                  data-title={previewPost.data.title}
                  data-search={previewPost.searchText}
                  data-priority={previewPost.data.priority}
                  data-writing={previewPost.data.writingStatus}
                  data-publication={previewPost.data.status}
                  data-memo={previewPost.memoState}
                  data-categories={JSON.stringify(previewPost.data.categories)}
                  data-tags={JSON.stringify(previewPost.data.tags)}
                  data-published={previewPost.data.publishedAt
                    .toISOString()
                    .slice(0, 10)}
                  data-updated={previewPost.data.updatedAt
                    .toISOString()
                    .slice(0, 10)}
                >
                  <th
                    scope="row"
                    class="preview-title-cell"
                    data-label="タイトル"
                  >
                    <span class="preview-title-line">
                      <span class="preview-title-name">
                        {previewPost.pinned && (
                          <Icon
                            name="octicon:pin-16"
                            class="preview-pin-icon"
                            title="一覧の先頭に固定している記事"
                          />
                        )}
                        <a
                          href={`/preview/posts/${previewPost.previewSlug}`}
                          class="preview-post-link"
                          data-title-display
                        >
                          {previewPost.data.title}
                        </a>
                      </span>
                      <button
                        type="button"
                        class="preview-edit-trigger"
                        aria-label={`${previewPost.data.title} のタイトルを編集`}
                        data-title-trigger
                      >
                        <Icon
                          name="octicon:pencil-16"
                          class="preview-edit-icon"
                        />
                      </button>
                      <CopyLinkButton
                        path={`/preview/posts/${previewPost.previewSlug}`}
                        class="preview-copy-link"
                      />
                      <button
                        type="button"
                        class="preview-row-delete"
                        title={`${previewPost.data.title} を削除`}
                        aria-label={`${previewPost.data.title} を削除`}
                        data-delete-post={previewPost.previewSlug}
                        data-post-title={previewPost.data.title}
                      >
                        <Icon name="octicon:trash-16" />
                      </button>
                      <input
                        type="text"
                        class="preview-title-input"
                        value={previewPost.data.title}
                        aria-label={`${previewPost.data.title} のタイトル`}
                        data-title-input
                        hidden
                      />
                      <span
                        class="preview-edit-status"
                        role="status"
                        aria-live="polite"
                        data-edit-status
                      />
                    </span>
                    <span class="preview-title-meta">
                      <code class="preview-slug">
                        {previewPost.previewSlug}
                      </code>
                    </span>
                    <button
                      type="button"
                      class="preview-title-meta preview-category-trigger"
                      popovertarget={categoryPopoverId}
                      aria-label={`${previewPost.data.title} のカテゴリを編集`}
                      data-category-trigger
                    >
                      <span data-category-label>
                        {previewPost.data.categories.join(" · ")}
                      </span>
                      <Icon
                        name="octicon:pencil-16"
                        class="preview-edit-icon"
                      />
                    </button>
                    <div
                      id={categoryPopoverId}
                      popover="auto"
                      class="preview-category-popover"
                      data-category-popover
                    >
                      {CATEGORIES.map((category) => (
                        <label class="preview-category-choice">
                          <input
                            type="checkbox"
                            value={category}
                            checked={previewPost.data.categories.includes(
                              category,
                            )}
                            data-category-input
                          />
                          <span>{category}</span>
                        </label>
                      ))}
                    </div>
                  </th>
                  <td class="preview-priority-column" data-label="優先度">
                    <span class="preview-priority">
                      <select
                        class="preview-cell-select"
                        aria-label={`${previewPost.data.title} の優先度`}
                        data-edit-select="priority"
                      >
                        {priorities.map((value) => (
