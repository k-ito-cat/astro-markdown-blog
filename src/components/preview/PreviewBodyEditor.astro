---
import { Icon } from "astro-icon/components";

type Props = {
  entryId: string;
  body: string;
};

const { entryId, body } = Astro.props;

// `</script>` で JSON が閉じられないようにエスケープする
const serializedBody = JSON.stringify(body).replace(/</g, "\\u003c");

type SnippetVariant = { label: string; code: string };

/**
 * 表示例の一覧。追加指定が互いに排他のものは、雛形の該当箇所を差し替えて作る。
 *
 * 表示例のためだけの見本は持たない。雛形を書き換えれば表示例もそのまま追従し、
 * 差し替える場所が無くなれば、切り替えを出さず 1 つだけ出す。
 */
const variantsOf = (item: {
  code: string;
  previewCode?: string;
  options?: readonly { label: string; code: string }[];
  variantPattern?: string;
}): SnippetVariant[] => {
  const base = item.previewCode ?? item.code;
  if (!item.variantPattern || !item.options || item.options.length < 2) {
    return [{ label: "既定", code: base }];
  }

  const pattern = new RegExp(item.variantPattern);
  const matched = pattern.exec(base);
  if (!matched) return [{ label: "既定", code: base }];

  const replaced = item.options.map((option) => ({
    label: option.label,
    code: base.replace(pattern, option.code),
  }));
  // 雛形自体が追加指定のどれかなら、同じものを二度出さない
  return item.options.some((option) => option.code === matched[0])
    ? replaced
    : [{ label: "既定", code: base }, ...replaced];
};

// 記法ヘルプ。雛形はそのまま貼って使えるものだけを載せる
const SNIPPET_GROUPS = [
  {
    title: "文字",
    items: [
      { label: "太字", code: "**太字**", note: "⌘B / Ctrl+B" },
      { label: "斜体", code: "*斜体*", note: "⌘I / Ctrl+I" },
      { label: "打ち消し", code: "~~打ち消し~~" },
      {
        label: "マーカー",
        code: "==マーカー==",
        // 追加指定は互いに排他。表示例は先頭の記号を差し替えて作る
        variantPattern: "^==",
        options: [
          { label: "緑", code: "=g=" },
          { label: "青", code: "=b=" },
          { label: "赤", code: "=r=" },
        ],
        note: "⌘⇧M / Ctrl+Shift+M。色の指定は先頭に付ける",
      },
      { label: "マーカー（色）", code: "=g=緑のマーカー==" },
      { label: "インラインコード", code: "`code`" },
      {
        label: "脚注",
        code: "主張[^1]。\n\n[^1]: 補足。[出典タイトル](https://example.com), 発行者, 2026-09-18 参照",
        note: "語ではなく主張に付ける。番号は出現順の自動採番で、末尾に一覧が出る。語の意味を出すのは用語の注釈、こちらは根拠と補足。定義行は本文のどこに書いてもよいが、参照の近くに置くと編集しやすい",
      },
      {
        label: "用語の注釈",
        code: "?[用語][説明。[出典](https://example.com)]",
        note: "出典リンクは必須。その説明で合っているか読者が確かめられるよう、一次情報へ繋ぐ。語にはてなマークが付き、押すかホバーで吹き出しが出る。表・リスト・トグル・注釈カードの中でも使える。リンクの中と画像キャプションでは使えない。説明は最初の裸の `]` で閉じるので、角括弧は対にする",
      },
    ],
  },
  {
    title: "構造",
    items: [
      {
        label: "見出し",
        code: "## 見出し2\n\n### 見出し3",
        note: "目次に載るのは h2 と h3",
      },
      { label: "箇条書き", code: "- 項目\n  - 入れ子" },
      {
        label: "ファイル構成",
        code: "- src/\n  - components/\n    - Prose.astro\n  - index.ts",
        note: "`/` で終わる項目をフォルダ、拡張子の付いた項目をファイルの icon で表す。`/` で終わる項目を 1 つ以上含むリストだけが対象なので、技術名を並べた箇条書きは中黒のまま。項目がパスだけのときに効き、説明を書き足した項目は中黒に戻る",
      },
      { label: "番号付き", code: "1. 一つ目\n2. 二つ目" },
      {
        label: "チェックリスト",
        code: "- [ ] 未完了\n- [x] 完了",
        note: "表示のみでクリックはできない",
      },
      { label: "引用", code: "> 引用文" },
      {
        label: "区切り線（節）",
        code: "---",
        note: "話題が変わるところ。全幅の細い線",
      },
      {
        label: "区切り線（章）",
        code: "***",
        note: "場面の切れ目。短く太い線と大きめの余白",
      },
      {
        label: "参考",
        code: "## 参考\n\n- [タイトル](https://example.com) — 発行者, 2026-09-18 参照。この記事での位置づけ\n- 『書名』著者名, 発行年。URL が無いものはこの形",
        note: "記事全体の土台になった資料を置く。一文の根拠は脚注、語の意味は用語の注釈が担うので、そちらで挙げた出典は重ねて置かない。1 行 1 件で、タイトル・発行者・参照日の順。脚注の一覧は自動で最後に付くため、参考はその手前に出る",
      },
      {
        label: "区切り線（ラベル付き）",
        code: "補足 ---",
        note: "メモ欄の見出しと同じ形。ハイフンは 3 つ以上（線の長さは表示側で伸ばす）。前後を空行で挟む",
      },
    ],
  },
  {
    title: "表とトグル",
    items: [
      {
        label: "テーブル（上ヘッダ）",
        code: "| 項目 | 説明 | 数 |\n| --- | :---: | ---: |\n| left | center | right |\n| a | b | c |",
        options: [
          { label: "左寄せ", code: "---" },
          { label: "中央寄せ", code: ":---:" },
          { label: "右寄せ", code: "---:" },
        ],
        note: "同じ観点の項目が 3 つ以上並ぶときに使う。2 つなら文のままでよい",
      },
      {
        label: "テーブル（左ヘッダ）",
        code: '<table>\n<tr><th scope="row">項目</th><td>説明</td></tr>\n<tr><th scope="row">項目</th><td>説明</td></tr>\n</table>',
        note: "Markdown のテーブルは上ヘッダのみ。左ヘッダは HTML で書く",
      },
      {
        label: "トグル",
        code: "<details>\n<summary>クリックで開く</summary>\n\n中身は **Markdown** として書ける\n\n</details>",
        options: [{ label: "デフォルトで開く", code: "open" }],
        note: "summary の次の空行が必須。入れ子にもでき、内側も同じで summary の次に空行を置く。閉じタグは連続でも空行を挟んでもよい。長いログや、読み飛ばしても本筋を追える補助情報に使う",
      },
      {
        label: "トグル（フォルダ）",
        code: '<details data-icon="folder">\n<summary>src/</summary>\n\n- components/\n- index.ts\n\n</details>',
        options: [
          { label: "フォルダ表示", code: 'data-icon="folder"' },
          { label: "デフォルトで開く", code: "open" },
        ],
        note: "三角がフォルダの icon になり、開くと開いたフォルダに変わる。入れ子にすると階層をそのまま表せる。必要なのは内側の summary の次の空行だけで、details の前後の空行は要らない。ファイル構成をたたんで見せるときに使う",
      },
    ],
  },
  {
    title: "コード",
    items: [
      {
        label: "コードブロック",
        code: "```ts\nconst a = 1;\n```",
        options: [{ label: "言語", code: "ts" }],
        note: "⌘⇧` / Ctrl+Shift+` で選択範囲を囲める。地の文に混ざったコマンド、キー、設定値、ファイル名はインラインコードへ移す",
      },
      {
        label: "ファイル名タブ",
        code: '```ts title="src/example.ts"\nconst a = 1;\n```',
        options: [{ label: "ファイル名", code: 'title="src/example.ts"' }],
        note: "1 行目のコメント（// src/example.ts）でもタブになる",
      },
      {
        label: "差分",
        code: '```diff lang="ts"\n-const a = 1;\n+const a = 2;\n```',
        options: [{ label: "色付けする言語", code: 'lang="ts"' }],
        note: "lang を付けると差分のまま色も付く",
      },
      {
        label: "追加・削除した行",
        code: "```ts ins={2} del={3-4}\nconst a = 1;\nconst b = 2;\nconst c = 3;\nconst d = 4;\n```",
        options: [
          { label: "追加した行", code: "ins={2}" },
          { label: "削除した行", code: "del={3-4}" },
        ],
        note: "行番号で指定する。{2,4} や {2-4} も使える",
      },
      {
        label: "行のハイライト",
        code: "```ts {2-3}\nconst a = 1;\nconst b = 2;\nconst c = 3;\n```",
        options: [{ label: "対象行", code: "{2-3}" }],
      },
      {
        label: "語句のマーク",
        // 指定した語が本文に無いと何も起きない。雛形の中に3つとも置いておく
        code: '```ts "const" ins="足した語" del="消した語"\nconst a = "足した語";\nconst b = "消した語";\n```',
        options: [
          { label: "ハイライト", code: '"const"' },
          { label: "追加した語", code: 'ins="足した語"' },
          { label: "削除した語", code: 'del="消した語"' },
          { label: "正規表現", code: "/const [ab]/" },
        ],
      },
      {
        label: "枠の指定",
        code: '```sh frame="none"\necho "枠なし"\n```',
        // 追加指定は互いに排他。表示例は frame の値を差し替えて作る
        variantPattern: 'frame="[^"]*"',
        options: [
          { label: "枠なし", code: 'frame="none"' },
          { label: "コード", code: 'frame="code"' },
          { label: "ターミナル", code: 'frame="terminal"' },
          { label: "自動", code: 'frame="auto"' },
        ],
      },
    ],
  },
  {
    title: "リンク",
    items: [
      { label: "リンク", code: "[表示テキスト](https://example.com)" },
      {
        label: "ページ内リンク",
        code: "[この記事の別の節](#見出しの文字)",
        note: "同じページの見出しへ飛ぶ。`#` の後ろは見出しの文字で、空白はハイフンに変わり、記号は落ちる（例：`### bug ― 最初の一匹は、本当に虫だった` → `#bug--最初の一匹は本当に虫だった`）。鎖の印が付く。その見出しが無いときは印を出さないので、綴りの間違いに気づける",
      },
      {
        label: "リンクカード",
        code: "https://example.com",
        note: "URL だけの行がカードになる。リスト内は対象外。記事の主題そのものを指す URL に使い、末尾の一覧には並べない",
      },
    ],
  },
  {
    title: "画像",
    items: [
      {
        label: "画像",
        code: "![画像の説明](../images/example.png)",
        previewCode: "![画像の説明](/favicon.png)",
        note: "角括弧の中は alt。画面に出ず、読み上げと代替表示に使う。空のままにしない。編集欄へのドラッグ＆ドロップ／貼り付けでも入る",
      },
      {
        label: "画像（キャプション付き）",
        code: '![画像の説明](../images/example.png "キャプション")',
        previewCode: '![画像の説明](/favicon.png "キャプション")',
        options: [{ label: "キャプション", code: '"キャプション"' }],
        note: "引用符の中がキャプション。画像の下に出る。alt とは役割が違うので両方書く",
      },
    ],
  },
  {
    title: "アラート",
    items: [
      {
        label: "NOTE（情報）",
        code: "> [!NOTE]\n> これは情報メッセージです",
        note: "流し読みでも目に留めてほしい補足。アラートは全種あわせて一記事に 2〜3 個まで",
      },
      {
        label: "TIP（ヒント）",
        code: "> [!TIP]\n> これは便利なヒントです",
        note: "より簡単に、より良くやる方法",
      },
      {
        label: "IMPORTANT（重要）",
        code: "> [!IMPORTANT]\n> これは重要な情報です",
        note: "目的の達成に欠かせない前提",
      },
      {
        label: "WARNING（警告）",
        code: "> [!WARNING]\n> これは警告メッセージです",
        note: "問題を避けるため今すぐ注意が要る",
      },
      {
        label: "CAUTION（危険）",
        code: "> [!CAUTION]\n> これは危険メッセージです",
        note: "操作に伴う危険や望ましくない結果",
      },
    ],
  },
  {
    title: "添削",
    items: [
      {
        label: "REVIEW（一文への指摘）",
        code: "> [!REVIEW]\n> 指摘の内容",
        note: "原稿へ一時的に書き込む指摘。対象のブロックの直下へ置く。公開のビルドでは節ごと落ちるので、消し忘れても本番には出ない",
      },
      {
        label: "OUTLINE（構成への指摘）",
        code: "> [!OUTLINE]\n> 構成に対する指摘",
        note: "一文ではなく記事全体の組み立てに対する指摘。REVIEW と同じく公開のビルドでは落ちる",
      },
    ],
  },
] as const;
---

<script is:inline data-astro-rerun>
  // 再読み込み直後のスクロール位置復元を見せないため、描画前に覆いを出す。
  // 万一解除されなくても白いままにならないよう保険の時限解除を置く。
  try {
    if (!sessionStorage.getItem("preview-body-edit:reloading")) throw 0;
    document.documentElement.dataset.previewReloading = "";
    // 位置は編集したブロックに合わせるので、ブラウザ任せの復元は止める
    history.scrollRestoration = "manual";
    setTimeout(() => {
      delete document.documentElement.dataset.previewReloading;
      history.scrollRestoration = "auto";
      sessionStorage.removeItem("preview-body-edit:reloading");
      sessionStorage.removeItem("preview-body-edit:focus");
      sessionStorage.removeItem("preview-body-edit:stale-body");
    }, 5000);
  } catch {
    /* 覆いを出せないだけなので何もしない */
  }
</script>

<body-editor class="body-editor" data-entry-id={entryId}>
  <script type="application/json" data-post-body set:html={serializedBody} />
  <p class="body-editor-hint" data-hint></p>
  <div class="body-editor-bar">
    <div class="body-editor-state">
      <slot name="state" />
      <p class="body-editor-status" data-status aria-live="polite"></p>
      <span class="body-editor-count" data-count hidden></span>
      <button
        type="button"
        data-diff
        aria-pressed="true"
        title="追加・変更・削除を色で示す"
        hidden>差分</button
      >
      <button type="button" data-discard disabled>破棄</button>
    </div>
    <div class="body-editor-tools">
      <details class="body-editor-guide" data-preview-pane>
        <summary aria-label="ヘルプ">
          <Icon name="octicon:question-16" aria-hidden="true" />
          <span>ヘルプ</span>
        </summary>
        <div class="body-editor-pane-body">
          <section class="help-group">
            <h2>本文の編集</h2>
            <p class="help-text">
              ブロックをクリックして編集。フォーカスを外すと下書きへ反映し、保存でMarkdownへ書き込みます。
            </p>
            <p class="help-text">
              下書きは記事ごとに残るため、開き直しても続きから編集できます。
            </p>
          </section>

          <section class="help-group">
            <h2>保存と取り消し</h2>
            <ul class="help-list">
              <li><kbd>⌘S</kbd> / <kbd>Ctrl S</kbd>：Markdown へ書き込む</li>
              <li>破棄：下書きを捨てて、ファイルの内容へ戻す</li>
              <li>差分：下書きとファイルの違いを色で示す</li>
            </ul>
          </section>

          <section class="help-group">
            <h2>編集中のキー</h2>
            <ul class="help-list">
              <li><kbd>⌘B</kbd> 太字、<kbd>⌘I</kbd> 斜体</li>
              <li><kbd>⌘⇧M</kbd> マーカー、<kbd>⌘⇧`</kbd> コード</li>
              <li><kbd>Shift Enter</kbd> そのブロックを確定</li>
              <li><kbd>Esc</kbd> 編集を取り消して閉じる</li>
            </ul>
          </section>

          <section class="help-group">
            <h2>ブロックの操作</h2>
            <ul class="help-list">
              <li>左脇の掴み手をドラッグして並べ替える</li>
              <li>
                ブロックの脇の道具から、編集、上下へ移動、前後に追加、画像を追加、削除
              </li>
              <li>画像は編集欄へドラッグ＆ドロップ、または貼り付けでも入る</li>
            </ul>
          </section>

          <section class="help-group">
            <h2>右のペイン</h2>
            <ul class="help-list">
              <li>記法：使える書き方の一覧。雛形をコピーできる</li>
              <li>フロントマター：タイトル、日付、状態、分野、タグ</li>
              <li>
                <kbd>Esc</kbd> かペインの外を押すと閉じる。同時に開くのは一つ
              </li>
            </ul>
          </section>

          <section class="help-group">
            <h2>添削</h2>
            <ul class="help-list">
              <li>
                <code>&gt; [!REVIEW]</code> は一文への指摘、<code
                  >&gt; [!OUTLINE]</code
                > は記事全体への指摘
              </li>
              <li>どちらも公開ビルドでは取り除かれる</li>
            </ul>
          </section>
        </div>
      </details>
      <slot name="tools" />
      <details class="body-editor-help" data-preview-pane>
        <summary aria-label="記法">
          <Icon name="octicon:book-16" aria-hidden="true" />
          <span>記法</span>
        </summary>
        <div class="body-editor-help-body">
          <div class="syntax-help-toolbar">
            <button
              type="button"
              class="help-preview-toggle"
              data-preview-toggle
              aria-pressed="false"
            >
              <span>表示例</span>
              <span class="help-preview-toggle-state" aria-hidden="true"
                >OFF</span
              >
            </button>
          </div>
          {
            SNIPPET_GROUPS.map((group) => (
              <section class="help-group">
                <h2>{group.title}</h2>
                <ul>
                  {group.items.map((item) => (
                    <li class="help-item">
                      <p class="help-label">{item.label}</p>
                      <div
                        class="help-switch"
                        role="group"
                        aria-label={`${item.label}の見せ方`}
                      >
                        <button
                          type="button"
                          class="help-switch-item"
                          data-help-view="code"
                          aria-pressed="true"
                        >
                          コード
                        </button>
                        <button
                          type="button"
                          class="help-switch-item"
                          data-help-view="preview"
                          aria-pressed="false"
                        >
                          表示例
                        </button>
                      </div>
                      <div class="help-code-wrap" data-help-pane="code">
                        <pre class="help-code">{item.code}</pre>
                        <button
                          type="button"
                          class="help-copy"
                          data-copy-snippet={item.code}
                          title={`${item.label}の雛形をコピー`}
                          aria-label={`${item.label}の雛形をコピー`}
                        >
                          <Icon name="octicon:copy-16" class="help-copy-icon" />
                          <Icon
                            name="octicon:check-16"
                            class="help-copy-done"
                          />
                        </button>
                      </div>
                      <figure
                        class="help-preview"
                        data-help-preview
                        data-help-pane="preview"
                        hidden
                      >
                        {variantsOf(item).length > 1 && (
                          <div
                            class="help-variants"
                            role="group"
                            aria-label={`${item.label}の表示例を切り替える`}
                          >
                            {variantsOf(item).map((variant, index) => (
                              <button
                                type="button"
                                class="help-variant"
                                data-variant-index={index}
                                aria-pressed={index === 0 ? "true" : "false"}
                              >
                                {variant.label}
                              </button>
                            ))}
                          </div>
                        )}
                        {variantsOf(item).map((variant, index) => (
                          <div
                            class="help-preview-content prose"
                            data-syntax-preview
                            data-preview-snippet={variant.code}
                            hidden={index > 0}
                          />
                        ))}
                      </figure>
                      {"options" in item && (
                        <div class="help-options">
                          <p class="help-options-label">追加指定</p>
                          <ul>
                            {item.options.map((option) => (
                              <li>
                                <span>{option.label}</span>
                                <code>{option.code}</code>
                                <button
                                  type="button"
                                  class="help-option-copy"
                                  data-copy-snippet={option.code}
                                  title={`${option.label}をコピー`}
                                  aria-label={`${option.label}をコピー`}
                                >
                                  <Icon
                                    name="octicon:copy-16"
                                    class="help-copy-icon"
                                  />
                                  <Icon
                                    name="octicon:check-16"
                                    class="help-copy-done"
                                  />
                                </button>
                              </li>
                            ))}
                          </ul>
                        </div>
                      )}
                      {"note" in item && <p class="help-note">{item.note}</p>}
                    </li>
                  ))}
                </ul>
              </section>
            ))
          }
        </div>
      </details>
      <slot name="tools-end" />
      <button
        type="button"
        class="body-editor-save"
        data-save
        aria-keyshortcuts="Meta+S Control+S"
        disabled
      >
        <span>保存</span>
        <span class="body-editor-save-count" data-save-count hidden></span>
      </button>
      <details class="body-editor-more" data-body-editor-more>
        <summary title="その他">
          <Icon name="octicon:kebab-horizontal-16" aria-hidden="true" />
          <span class="sr-only">その他</span>
        </summary>
        <div class="body-editor-more-menu">
          <button type="button" data-mobile-pane=".body-editor-guide">
            <Icon name="octicon:question-16" aria-hidden="true" />
            <span>ヘルプ</span>
          </button>
          <slot name="more" />
          <button
            type="button"
            class="body-editor-more-narrow"
            data-mobile-pane=".body-editor-help"
          >
            <Icon name="octicon:book-16" aria-hidden="true" />
            <span>記法</span>
          </button>
          <button
            type="button"
            class="body-editor-more-narrow"
            data-diff-mobile
            aria-pressed="true"
            hidden>差分</button
          >
          <button
            type="button"
            class="body-editor-more-narrow"
            data-discard-mobile
            disabled>破棄</button
          >
        </div>
      </details>
    </div>
  </div>
  <template data-block-toolbar-icon="help">
    <Icon name="octicon:book-16" aria-hidden="true" />
  </template>
  <template data-block-toolbar-icon="image">
    <Icon name="octicon:image-16" aria-hidden="true" />
  </template>
  <template data-block-toolbar-icon="delete">
    <Icon name="octicon:trash-16" aria-hidden="true" />
  </template>
</body-editor>

<style>
  /*
   * 箱を持たせない。sticky は親の箱の中しか動けず、この要素の中身は
   * ヒントとバーだけで記事本文は兄弟にある。箱を消して .preview-detail を
   * 親にすることで、バーが本文の長さぶん追従できる。
   */
  .body-editor {
    display: contents;
  }

  /*
   * ページのどこにいても保存できるよう追従させる。
   * ここがスタッキングコンテキストの境界になるので、中から出る右ペインの
   * 重なりもこの値で決まる。本文脇の道具（.block-toolbar ほか、10〜12）と
   * 追従中の目次（20）より上、メニューのスクリム（25）とヘッダー（30）
   * より下に置く。上に出すと、メニューを開いてもバーが暗まず手前に残り、
   * 開いたメニュー自体を覆ってしまう。
   */
  .body-editor-bar {
    position: sticky;
    top: 0;
    z-index: 24;
    isolation: isolate;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 12px;
    padding: 10px 0;
    background: var(--bg-base);
  }

  /* 説明はヘルプへ移したので、普段は空。異常時だけ文言が入る */
  .body-editor-hint:empty {
    display: none;
  }

  .help-text {
    margin: 0 0 8px;
    color: var(--text-secondary);
    font-size: var(--text-sm);
    line-height: 1.8;
  }

  .help-list {
    margin: 0;
    padding-left: 1.2em;
    color: var(--text-secondary);
    font-size: var(--text-sm);
    line-height: 1.9;
  }

  .help-list code {
    font-family: var(--font-mono);
    font-size: 0.9em;
  }

  .help-list kbd {
    padding: 1px 5px;
    color: var(--text-primary);
    background: var(--bg-subtle);
    border: 1px solid var(--border);
    border-radius: var(--radius-label);
    font-family: var(--font-mono);
    font-size: 0.85em;
  }

  .body-editor-hint,
  .body-editor-status {
    margin: 0;
    color: var(--text-muted);
    font-size: var(--text-sm);
  }

  /* 操作の説明はバーの外に置き、バーは状態と操作だけにする */
  .body-editor-hint {
    margin-bottom: 6px;
  }

  /* 道具の側へ移したので、行の余白を埋める役目はもう持たせない */
  .body-editor-status {
    flex: 0 1 auto;
    min-width: 0;
  }

  .body-editor-status[data-tone="error"] {
    color: var(--danger-text);
  }

  .body-editor-count {
    color: var(--warning);
    font-size: var(--text-sm);
    font-weight: 600;
    white-space: nowrap;
  }

  .body-editor button {
    height: 30px;
    padding: 0 14px;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-label);
    background: var(--bg-base);
    color: var(--text-secondary);
    font-size: var(--text-sm);
    line-height: 1;
    cursor: pointer;
  }

  .body-editor button:hover:not(:disabled) {
    background: var(--bg-subtle);
    color: var(--text-primary);
  }

  .body-editor button:disabled {
    opacity: 0.4;
    cursor: default;
  }

  .body-editor .body-editor-save:not(:disabled) {
    border-color: var(--color-primary);
    color: var(--color-primary);
    font-weight: 600;
  }

  .body-editor-save {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .body-editor-save-count {
    display: none;
  }

  /* 狭い画面だけで要る控えは、広い画面では「その他」の中からも外す */
  .body-editor-more-menu .body-editor-more-narrow {
    display: none;
  }

  /* 開いてもバーの高さを変えないよう、中身はバーの下へ浮かせる */
  /* 状態と道具を行の両端へ寄せる。折り返して一行に一つになっても右端に残す */
  .body-editor-tools {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    margin-left: auto;
  }

  /*
   * 追従に入ったら、面と下線だけを画面の端まで開く。道具の並びは動かさない。
   * 見せ方は記事冒頭の目次（Article の .article-structure）と同じにする
   */
  .body-editor-bar::before {
    position: absolute;
    z-index: -1;
    inset-block: 0;
    inset-inline-start: calc(-1 * var(--bar-bleed-start, 0px));
    inset-inline-end: calc(-1 * var(--bar-bleed-end, 0px));
    pointer-events: none;
    content: "";
    background: var(--bg-base);
    border-bottom: 1px solid var(--border);
    clip-path: inset(0 var(--bar-bleed-end, 0px) 0 var(--bar-bleed-start, 0px));
    transition:
      border-color var(--duration-feedback) ease,
      box-shadow var(--duration-state) var(--ease-trace),
      clip-path var(--duration-state) var(--ease-trace);
  }

  .body-editor-bar[data-stuck]::before {
    border-bottom-color: var(--border-strong);
    box-shadow: 0 6px 12px -6px rgb(0 0 0 / 18%);
    clip-path: inset(0);
  }

  /* 追従の合図を取るためだけの目印。高さも面も持たない */
  .body-editor-bar-sentinel {
    height: 0;
  }

  /* 状態と、変更があるときだけ出るものを一続きに読ませる */
  .body-editor-state {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    min-width: 0;
  }

  .body-editor-state > button:hover:not(:disabled),
  .body-editor-state > button:focus-visible,
  .body-editor-tools > button:hover:not(:disabled),
  .body-editor-tools > button:focus-visible,
  .body-editor-help > summary:hover,
  .body-editor-help > summary:focus-visible,
  .body-editor-more > summary:hover,
  .body-editor-more > summary:focus-visible,
  .body-editor-tools :global(.preview-sidebar-filter-open):hover,
  .body-editor-tools :global(.preview-sidebar-filter-open):focus-visible,
  .body-editor-tools :global(.viewport-open):hover,
  .body-editor-tools :global(.viewport-open):focus-visible,
  .body-editor-tools :global(.fm-summary):hover,
  .body-editor-tools :global(.fm-summary):focus-visible {
    background: transparent;
    color: var(--text-primary);
    text-decoration-color: currentColor;
  }

  .body-editor-help,
  .body-editor-guide,
  .body-editor-more {
    position: relative;
  }

  /*
   * 追従領域の道具は面を持たない（design/hig.md `hover.surface`）。
   * 下線の場所は常に確保し、hover / focus で色だけを付けて行を動かさない
   */
  .body-editor-state > button,
  .body-editor-tools > button,
  .body-editor-help > summary,
  .body-editor-more > summary,
  .body-editor-tools :global(.preview-sidebar-filter-open),
  .body-editor-tools :global(.viewport-open),
  .body-editor-tools :global(.fm-summary) {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: auto;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    color: var(--text-secondary);
    font-family: inherit;
    font-size: var(--text-sm);
    line-height: 1;
    list-style: none;
    text-decoration: underline 1px transparent;
    text-underline-offset: 4px;
    cursor: pointer;
  }

  /*
   * 道具の切れ目を細い Line で示す。先頭の「記事」だけは左に置かない。
   * 面を持たない並びなので、間隔だけでは語の切れ目が読み取りにくい
   */
  .body-editor-tools > button,
  .body-editor-help > summary,
  .body-editor-more > summary,
  .body-editor-tools :global(.viewport-open),
  .body-editor-tools :global(.fm-summary) {
    border-inline-start: 1px solid var(--border);
    padding-inline-start: 12px;
  }

  /*
   * ヘルプは「その他」から開く。ペイン本体は残して引き金だけ畳む。
   * 幅 0 の器が並びに残ると gap を 1 つ分余計に食うため、流れから外す。
   * display: contents だと details の閉じた状態が壊れるので位置指定で外す
   */
  .body-editor-guide {
    position: absolute;
  }

  .body-editor-guide > summary {
    display: none;
  }

  /*
   * 不可逆な削除のトリガー。design/hig.md `button.destructive` に従い、
   * 面は透明のまま文字だけを danger にする。塗りつぶしは確認面が持つ。
   * 主要操作と隣接させないため、置き場所は「その他」の中にする
   */
  .body-editor-more-menu :global(.preview-toolbar-delete) {
    color: var(--danger);
  }

  .body-editor-more-menu :global(.preview-toolbar-delete):hover,
  .body-editor-more-menu :global(.preview-toolbar-delete):focus-visible {
    background: var(--danger-tint);
    color: var(--danger);
  }

  /* 押している最中だけ面を濃くする。色は変えない */
  .body-editor-more-menu :global(.preview-toolbar-delete):active {
    background: color-mix(in srgb, var(--danger) 22%, var(--color-background));
  }

  .body-editor-more-menu :global(.preview-toolbar-delete):disabled {
    opacity: 0.55;
    cursor: not-allowed;
  }

  .body-editor-help > summary::-webkit-details-marker,
  .body-editor-guide > summary::-webkit-details-marker,
  .body-editor-more > summary::-webkit-details-marker {
    display: none;
  }

  .body-editor-help[open] > summary,
  .body-editor-more[open] > summary {
    color: var(--color-primary);
    text-decoration-color: currentColor;
  }

  .body-editor-help svg,
  .body-editor-guide svg,
  .body-editor-more svg,
  .body-editor-tools :global(.preview-sidebar-filter-open) svg,
  .body-editor-tools :global(.viewport-open) svg {
    width: 14px;
    height: 14px;
    flex: 0 0 auto;
  }

  /* 本文を見ながら引けるよう、画面の右端へ寄せて立てる */
  .body-editor-help-body,
  .body-editor-pane-body {
    position: fixed;
    top: var(--preview-pane-top, 52px);
    right: 0;
    z-index: 20;
    width: min(440px, 92vw);
    height: calc(100dvh - var(--preview-pane-top, 52px));
    padding: 0 20px 24px;
    overflow-y: auto;
    border-left: 1px solid var(--border-strong);
    background: var(--bg-base);
  }

  .body-editor-help-body {
    --syntax-help-toolbar-height: 43px;
  }

  /* 左に塊への案内、右に表示例の切り替えを置く */
  .syntax-help-toolbar {
    position: sticky;
    top: 0;
    z-index: 3;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    height: var(--syntax-help-toolbar-height);
    background: var(--bg-base);
    border-bottom: 1px solid var(--border);
  }

  .body-editor .help-preview-toggle {
    display: inline-flex;
    /* 案内が伸びても、切り替えは縮ませない */
    flex: 0 0 auto;
    align-items: center;
    gap: 8px;
    white-space: nowrap;
    height: 30px;
    padding: 0 10px;
    border-color: var(--border);
    background: transparent;
  }

  .body-editor .help-preview-toggle[aria-pressed="true"] {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }

  /* 雛形と表示例の切り替え。面を持たない小さな文字の並びにする */
  .body-editor .help-switch {
    display: flex;
    gap: 12px;
    margin-block: 8px 6px;
  }

  .body-editor .help-switch-item {
    height: auto;
    padding: 2px 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    color: var(--text-muted);
    font-size: 11px;
    line-height: 1.4;
    cursor: pointer;
  }

  .body-editor .help-switch-item:hover {
    color: var(--text-primary);
  }

  .body-editor .help-switch-item[aria-pressed="true"] {
    color: var(--color-primary);
    font-weight: 700;
  }

  /* 表示例の切り替え。面を持たない小さな文字の並びにする */
  .body-editor .help-variants {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 8px;
  }

  .body-editor .help-variant {
    height: auto;
    padding: 2px 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    color: var(--text-muted);
    font-size: 11px;
    line-height: 1.4;
    cursor: pointer;
  }

  .body-editor .help-variant:hover {
    color: var(--text-primary);
  }

  .body-editor .help-variant[aria-pressed="true"] {
    color: var(--color-primary);
    font-weight: 700;
    box-shadow: inset 0 -1px 0 0 var(--color-primary);
  }

  .help-preview-toggle-state {
    min-width: 2.6em;
    padding-left: 8px;
    border-left: 1px solid currentColor;
    font-family: var(--font-mono);
    font-size: 11px;
    text-align: center;
  }

  .body-editor-more-menu {
    position: absolute;
    top: calc(100% + 6px);
    right: 0;
    display: grid;
    width: 168px;
    padding: 4px;
    background: var(--bg-base);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-label);
    box-shadow: 0 6px 24px rgb(0 0 0 / 0.12);
  }

  .body-editor-more-menu button {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 8px;
    width: 100%;
    border-color: transparent;
  }

  /* 差し込まれた削除は別componentの scope を持つため、個別に形を合わせる */
  .body-editor-more-menu :global(.preview-toolbar-delete) {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 8px;
    width: 100%;
    height: 30px;
    padding: 0 14px;
    border: 1px solid transparent;
    border-radius: var(--radius-label);
    background: transparent;
    font-family: inherit;
    font-size: var(--text-sm);
    line-height: 1;
    cursor: pointer;
  }

  .body-editor-more-menu button[hidden] {
    display: none;
  }

  /* 破棄はやり直せるので、危険の色を使わない（hig.md button.destructive） */
  .body-editor-more-menu button[data-discard-mobile] {
    color: var(--text-secondary);
  }

  @media (max-width: 959px) {
    /*
     * ヘッダーを指で引いている間は、バーも一緒に画面外まで送る。
     * ヘッダーや目次は transform で動かしているが、バーは吸着位置そのものを
     * 動かす。バーの中には画面右端へ貼る fixed のペインがあり、transform を
     * 掛けるとその基準がバーになって画面端へ届かなくなるため。
     * ヘッダーの分と自身の分を合わせ、さらに 1px 余分に送って罫線を残さない。
     */
    .body-editor-bar {
      --chrome-hidden-shift: calc(
        -1px - 52px - var(--preview-editor-bar-height, 0px)
      );
      --chrome-shift: 0px;

      top: calc(
        52px +
          clamp(
            var(--chrome-hidden-shift),
            calc(var(--chrome-shift) + var(--chrome-drag-y, 0px)),
            var(--chrome-rubber-max, 0px)
          )
      );
      /* 状態と道具を一段に収める。道具の側だけが縮む */
      display: grid;
      grid-template-columns: auto minmax(0, 1fr);
      gap: 8px;
      padding: 8px 0;
    }

    :global(:root[data-chrome-hidden]) .body-editor-bar {
      --chrome-shift: var(--chrome-hidden-shift);
    }

    .body-editor-state {
      grid-column: 1;
      justify-self: start;
    }

    .body-editor-tools {
      grid-column: 2;
      justify-self: end;
      margin-left: 0;
      justify-content: flex-end;
      gap: 8px;
    }
  }

  /*
   * タブレットでは状態と操作を意図して二段に分ける。状態の長さによって
   * 操作群が偶発的に折り返されると、追従バーとペインの開始位置が不安定になる。
   */
  @media (min-width: 720px) and (max-width: 959px) {
    .body-editor-tools > button,
    .body-editor-tools > details > summary,
    .body-editor-tools :global(.fm-summary) {
      min-height: 44px;
    }
  }

  /*
   * 小さな画面では、編集に直結するフロントマターと保存だけを常設する。
   * 補助操作は「その他」に集約し、どの幅でも 44px のタップ領域を確保する。
   */
  @media (max-width: 719px) {
    .body-editor-bar {
      min-height: 52px;
      gap: 8px;
      padding: 4px 0;
    }

    /*
     * この幅では記事状態をバーの外で見せる（screens.md の Preview / Admin）。
     * 器を残すと中身が無いまま 1 行を占めるので、枠から外して一段に収める
     */
    .body-editor-state {
      display: contents;
    }

    .body-editor-tools {
      flex-wrap: nowrap;
      gap: 8px;
      width: 100%;
    }

    .body-editor-status:empty {
      display: none;
    }

    .body-editor-status:not(:empty) {
      position: absolute;
      top: 100%;
      left: 0;
      width: 100%;
      padding: 6px 8px;
      overflow: hidden;
      background: var(--bg-base);
      border-bottom: 1px solid var(--border);
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .body-editor-count,
    .body-editor-help > summary,
    .body-editor-state > button {
      display: none;
    }

    /* 記法もここでは「その他」から開くので、器を並びから外す */
    .body-editor-help {
      position: absolute;
    }

    /* 道具の列から外したものを、ここでは「その他」から開けるようにする */
    .body-editor-more-menu .body-editor-more-narrow {
      display: flex;
    }

    .body-editor-more-menu .body-editor-more-narrow[hidden] {
      display: none;
    }

    /*
     * 指が届く範囲は 44px 要るが、その寸法のまま枠を描くと、本文の上に
     * 大きな箱が並んで編集の道具のほうが主役に見える。見た目は 34px に
     * 抑え、足りない分は当たり判定だけを広げて補う。
     */
    .body-editor-tools :global(.fm-summary),
    .body-editor-tools > .body-editor-save,
    .body-editor-more > summary {
      position: relative;
      min-width: 34px;
      height: 34px;
    }

    .body-editor-tools :global(.fm-summary)::before,
    .body-editor-tools > .body-editor-save::before,
    .body-editor-more > summary::before {
      position: absolute;
      inset: -5px;
      content: "";
    }

    /* 枠も一段弱める。並ぶ数が多いので、線が強いと縞に見える */
    .body-editor-tools :global(.fm-summary),
    .body-editor-more > summary {
      border-color: var(--border);
    }

    .body-editor-tools :global(.fm-summary) {
      justify-content: center;
      padding: 0;
    }

    .body-editor-tools :global(.fm-summary span) {
      display: none;
    }

    .body-editor-tools > .body-editor-save {
      margin-left: auto;
      padding: 0 12px;
    }

    .body-editor-save-count {
      display: inline;
    }

    .body-editor-save-count[hidden] {
      display: none;
    }

    .body-editor-more > summary {
      padding: 0 10px;
    }

    .body-editor-more-menu button {
      height: 44px;
      padding: 0 12px;
    }

    .body-editor-help-body,
    .body-editor-pane-body {
      inset-inline: 0;
      width: auto;
      border-left: 0;
    }
  }

  /*
   * 狭幅では目次がこのバーの直下に積み上がる。目次は背景をページの左右余白ごと
   * 画面端まで伸ばしているので、バーだけ本文カラム幅のままだと帯の幅が揃わず
   * 段差に見える。余白ぶんのはみ出しを ::before で描いて端まで届かせる。
   * 中身の位置は動かさないので、幅ごとの padding 指定には触れない。
   */
  @media (max-width: 1023px) {
    .body-editor-bar {
      --preview-bar-side-inset: 16px;

      /* 指で触る操作子なので、なぞりや長押しで選択が割り込まないようにする */
      -webkit-touch-callout: none;
      user-select: none;
    }

    /* 保存状態はバーの下にぶら下がるので、同じ幅で出す */
    .body-editor-status:not(:empty) {
      inset-inline: calc(-1 * var(--preview-bar-side-inset));
      width: auto;
    }
  }

  /* ページの左右余白が広がる幅では、はみ出し量もそれに合わせる */
  @media (min-width: 640px) and (max-width: 1023px) {
    .body-editor-bar {
      --preview-bar-side-inset: 24px;
    }
  }

  /* 本文のラベル付き罫線（メモ欄の見出し）と同じ「語 + Line」の形にする */
  /* 塊の頭は見出しとして読ませる。本文の h3 と同じくらいの大きさにする */
  .help-group h2 {
    position: sticky;
    top: 0;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0;
    padding: 10px 0 12px;
    background: var(--bg-base);
    color: var(--text-primary);
    font-size: 16px;
    font-weight: 700;
  }

  .body-editor-help-body .help-group h2 {
    top: var(--syntax-help-toolbar-height);
  }

  /* 塊の切れ目は余白で示す。見出しに罫線は引かない */
  .help-group + .help-group {
    margin-top: 30px;
  }

  .help-group ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .help-item {
    padding: 10px 0;
    border-top: 1px solid var(--border);
  }

  /* 見出しのすぐ下に線が来ると窮屈なので、先頭の項目は線を持たない */
  .help-group li:first-child {
    border-top: 0;
  }

  .help-label {
    margin: 0;
    color: var(--text-primary);
    font-size: var(--text-sm);
    font-weight: 600;
  }

  /* コピーは雛形の右上に重ねる。コードブロックと同じ位置関係にする */
  .help-code-wrap {
    position: relative;
    margin-top: 4px;
  }

  .help-code {
    margin: 0;
    /* ボタンと文字が重ならない幅を空ける */
    padding: 8px 40px 8px 10px;
    overflow-x: auto;
    border-radius: 2px;
    background: var(--bg-subtle);
    color: var(--text-primary);
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: var(--leading-body);
    white-space: pre;
  }

  .help-note {
    margin: 6px 0 0;
    color: var(--text-muted);
    font-size: var(--text-sm);
  }

  .help-options {
    display: grid;
    gap: 4px;
    margin-top: 8px;
  }

  .help-options-label {
    margin: 0;
    color: var(--text-muted);
    font-size: 11px;
    font-weight: 600;
  }

  .help-options ul {
    display: grid;
    gap: 4px;
  }

  .help-options li {
    display: grid;
    grid-template-columns: minmax(7.5em, auto) minmax(0, 1fr) 26px;
    align-items: center;
    gap: 8px;
    min-height: 30px;
    color: var(--text-secondary);
    font-size: 12px;
  }

  .help-options code {
    min-width: 0;
    padding: 2px 5px;
    overflow-x: auto;
    background: var(--bg-subtle);
    color: var(--text-primary);
    font-family: var(--font-mono);
    white-space: nowrap;
  }

  .body-editor .help-option-copy {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 26px;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--text-muted);
  }

  .body-editor .help-option-copy:hover:not(:disabled),
  .body-editor .help-option-copy:focus-visible {
    background: var(--bg-subtle);
    color: var(--color-interaction-text);
  }

  .help-preview {
    margin: 12px 0 0;
    padding: 10px 12px 12px;
    border: 1px solid var(--border);
    border-radius: 2px;
    background: var(--bg-base);
  }

  .help-preview figcaption {
    margin-bottom: 8px;
    color: var(--text-muted);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  .help-preview[hidden] {
    display: none;
  }

  .body-editor .help-copy {
    position: absolute;
    top: 5px;
    right: 5px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 26px;
    padding: 0;
    border: 0;
    border-radius: var(--radius-label);
    background: transparent;
    color: var(--text-muted);
  }

  .body-editor .help-copy:hover:not(:disabled),
  .body-editor .help-copy:focus-visible {
    background: var(--bg-base);
    color: var(--color-interaction-text);
  }

  .body-editor .help-copy svg,
  .body-editor .help-option-copy svg {
    width: 14px;
    height: 14px;
  }

  .help-copy-done {
    display: none;
  }

  .body-editor [data-copy-state="copied"] {
    color: var(--success);
  }

  .body-editor [data-copy-state="copied"] .help-copy-icon {
    display: none;
  }

  .body-editor [data-copy-state="copied"] .help-copy-done {
    display: inline-block;
  }

  .body-editor [data-copy-state="failed"] {
    color: var(--danger);
  }
</style>

<style is:global>
  /*
   * 塊への案内。JS で作るためグローバル側に置く。
   * 面を持たない文字だけの行にし、入りきらない幅では横へ送る
   */
  .body-editor .help-group-nav {
    display: flex;
    flex: 1 1 auto;
    align-items: center;
    gap: 12px;
    min-width: 0;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .body-editor .help-group-nav::-webkit-scrollbar {
    display: none;
  }

  .body-editor .help-group-nav-item {
    height: auto;
    padding: 2px 0;
    border: 0;
    background: transparent;
    color: var(--text-muted);
    font-size: 12px;
    line-height: 1.4;
    white-space: nowrap;
    cursor: pointer;
  }

  .body-editor .help-group-nav-item:hover {
    color: var(--text-primary);
  }

  /* 現在地は色・太さ・Line の 3 つで示す（design/hig.md の nav.current） */
  .body-editor .help-group-nav-item.is-current {
    color: var(--color-primary);
    font-weight: 700;
    box-shadow: inset 0 -1px 0 0 var(--color-primary);
  }
  /* 保存から再読み込み完了までの間、画面の揺れを覆い隠す */
  :root[data-preview-reloading]::after {
    content: "";
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: var(--bg-base);
  }

  :root[data-preview-reloading]::before {
    content: "";
    position: fixed;
    z-index: 10000;
    top: 50%;
    left: 50%;
    width: 28px;
    height: 28px;
    margin: -14px 0 0 -14px;
    border: 2px solid var(--border);
    border-top-color: var(--color-primary);
    border-radius: 50%;
    animation: preview-reloading-spin 700ms linear infinite;
  }

  @keyframes preview-reloading-spin {
    to {
      transform: rotate(1turn);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :root[data-preview-reloading]::before {
      animation: none;
    }
  }

  /* script で .prose 内に差し込むため global に置く */
  .preview-detail .prose [data-md-index] {
    border-radius: 2px;
    transition: background-color 120ms ease-out;
  }

  .preview-detail .prose [data-md-index]:hover {
    background: var(--bg-subtle);
    cursor: text;
  }

  .preview-detail .prose [data-md-index][hidden] {
    display: none;
  }

  /* hr は高さを持たないためクリックできない。線の位置は保ったまま当たり判定を作る */
  .preview-detail .prose hr {
    position: relative;
    height: 18px;
    border-top: 0;
    /* 当たり判定の分だけ外の余白を減らし、見た目の間隔は本文と揃える */
    margin-block: 31px;
  }

  .preview-detail .prose hr::before {
    content: "";
    position: absolute;
    inset-inline: 0;
    top: 50%;
    border-top: 1px solid var(--border);
  }

  .preview-detail .prose hr[data-divider="chapter"] {
    margin-block: 63px;
  }

  .preview-detail .prose hr[data-divider="chapter"]::before {
    border-top: 2px solid var(--border-strong);
  }

  /* 戻ってきた位置を一瞬示す */
  .preview-detail .prose .block-restored {
    animation: block-restored-flash 1200ms ease-out;
  }

  @keyframes block-restored-flash {
    from {
      background: var(--bg-subtle);
    }
    to {
      background: transparent;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .preview-detail .prose .block-restored {
      animation: none;
    }
  }

  /* 保存前のブロックは描画できないので、生 Markdown のまま示す */
  .preview-detail .prose .block-pending {
    margin: 24px 0;
    padding: 10px 12px;
    border-left: 2px solid var(--warning);
    border-radius: 0 2px 2px 0;
    background: var(--color-annotation-warning-surface);
    cursor: text;
  }

  .preview-detail .prose .block-pending-text {
    overflow-x: auto;
    color: var(--text-primary);
    font-family: var(--font-mono);
    font-size: 14px;
    line-height: var(--leading-body);
    white-space: pre-wrap;
    word-break: break-word;
  }

  /* 「戻す」を右上へ重ねるので、本文と重ならない余白を取る */
  .preview-detail .prose .block-pending,
  .preview-detail .prose .block-removed {
    position: relative;
    padding-right: 60px;
  }

  .preview-detail .prose .block-undo {
    position: absolute;
    top: 6px;
    right: 8px;
    padding: 2px 8px;
    border: 1px solid var(--border);
    border-radius: var(--radius-label);
    background: var(--bg-base);
    color: var(--text-muted);
    font-size: 11px;
    line-height: 1.6;
    cursor: pointer;
  }

  .preview-detail .prose .block-undo:hover {
    border-color: var(--border-strong);
    color: var(--text-primary);
  }

  /* 移動したブロックは中身が変わらないので、描画を保ったまま変更と同じ印を付ける */
  .preview-detail .prose .block-moved {
    padding: 10px 12px;
    border-left: 2px solid var(--warning);
    border-radius: 0 2px 2px 0;
    background: var(--color-annotation-warning-surface);
  }

  /* 差分表示を切ると、種別によらず変更と同じ見た目に戻す */
  .preview-detail .prose[data-diff="on"] .block-pending[data-kind="insert"] {
    border-left-color: var(--success);
    background: var(--success-bg);
  }

  /* 削除したブロックは本文から消さず、差分として残す */
  .preview-detail .prose .block-removed {
    margin: 24px 0;
    padding: 10px 12px;
    border-left: 2px solid var(--danger);
    border-radius: 0 2px 2px 0;
    background: var(--color-annotation-caution-surface);
  }

  /* prose 側の display 指定に負けないよう明示する */
  .preview-detail .prose .block-removed[hidden] {
    display: none;
  }

  .preview-detail .prose .block-removed-text {
    overflow-x: auto;
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 14px;
    line-height: var(--leading-body);
    text-decoration: line-through;
    white-space: pre-wrap;
    word-break: break-word;
  }

  .preview-detail .prose .block-editor-wrap {
    margin: 24px 0;
  }

  /* 入力欄の内側右下に操作の手がかりを置く */
  .preview-detail .prose .block-editor-field {
    position: relative;
  }

  /* 入力欄の右上。押しても編集は閉じない */
  .preview-detail .prose .block-editor-help {
    position: absolute;
    top: 6px;
    right: 8px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 26px;
    padding: 0;
    border: 0;
    border-radius: var(--radius-label);
    background: transparent;
    color: var(--text-muted);
    cursor: pointer;
  }

  .preview-detail .prose .block-editor-help:hover,
  .preview-detail .prose .block-editor-help:focus-visible {
    background: var(--bg-base);
    color: var(--color-interaction-text);
  }

  .preview-detail .prose .block-editor-help svg {
    width: 15px;
    height: 15px;
  }

  .preview-detail .prose .block-editor-hint {
    position: absolute;
    right: 10px;
    bottom: 6px;
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 2px 10px;
    max-width: calc(100% - 20px);
    padding: 1px 6px;
    border-radius: var(--radius-label);
    background: var(--bg-base);
    color: var(--text-muted);
    font-size: 11px;
    line-height: 1.6;
    pointer-events: none;
  }

  .preview-detail .prose .block-editor-hint > span {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    white-space: nowrap;
  }

  .preview-detail .prose .block-editor-hint kbd {
    padding: 1px 4px;
    border: 1px solid var(--border);
    border-radius: 2px;
    background: var(--bg-subtle);
    font-family: var(--font-mono);
    font-size: 10px;
    line-height: 1.4;
  }

  .preview-detail .prose .block-editor {
    display: block;
    width: 100%;
    margin: 0;
    padding: 12px 14px;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-card);
    background: var(--bg-subtle);
    color: var(--text-primary);
    font-family: var(--font-mono);
    font-size: 14px;
    line-height: var(--leading-body);
    resize: none;
    overflow: hidden;
    tab-size: 2;
    /* 手がかりと文字が重ならないよう下に余白を取る */
    padding-bottom: 28px;
  }

  /* 編集中のメッセージは、対象のブロックの真下に出す */
  .preview-detail .prose .block-editor-status {
    margin: 0;
    min-height: 1.5em;
    color: var(--text-muted);
    font-size: var(--text-sm);
    line-height: 1.5;
  }

  .preview-detail .prose .block-editor-status[data-tone="error"] {
    color: var(--danger);
  }

  .block-toolbar {
    position: absolute;
    z-index: 10;
    display: flex;
    gap: 2px;
    /* 少し外れても閉じないよう、当たり判定を外側に広げる */
    padding: 10px;
    margin: -10px;
    border-radius: calc(var(--radius-label) + 10px);
  }

  .block-toolbar[hidden] {
    display: none;
  }

  /* 本文の左脇に置く掴み手。幅は HANDLE_SIZE と一致させること */
  .block-drag-handle {
    position: absolute;
    z-index: 10;
    display: grid;
    place-items: center;
    width: 20px;
    height: 20px;
    padding: 0;
    border: none;
    border-radius: var(--radius-label);
    background: transparent;
    color: var(--text-muted);
    font-size: 13px;
    line-height: 1;
    cursor: grab;
    touch-action: none;
  }

  .block-drag-handle:hover {
    background: var(--bg-subtle);
    color: var(--text-primary);
  }

  .block-drag-handle[hidden] {
    display: none;
  }

  .block-drop-marker {
    position: absolute;
    z-index: 11;
    height: 2px;
    background: var(--color-primary);
    pointer-events: none;
  }

  .block-drop-marker[hidden] {
    display: none;
  }

  /* 範囲選択したブロックは、消える範囲が見えるよう枠で囲う */
  .preview-detail .prose .block-selected {
    outline: 2px solid var(--danger);
    outline-offset: 4px;
    border-radius: 2px;
  }

  .block-bulk-action {
    position: absolute;
    z-index: 12;
    padding: 4px 10px;
    border: 1px solid var(--danger);
    border-radius: var(--radius-label);
    background: var(--bg-base);
    color: var(--danger);
    font-size: 12px;
    line-height: 1.6;
    cursor: pointer;
  }

  .block-bulk-action[hidden] {
    display: none;
  }

  /* ドラッグ中は本文の選択が始まらないようにする */
  body.is-block-dragging {
    cursor: grabbing;
    user-select: none;
  }

  .preview-detail .prose .block-dragging {
    opacity: 0.5;
  }

  .block-toolbar button {
    min-width: 32px;
    height: 32px;
    padding: 0 6px;
    border: 1px solid var(--border);
    border-radius: var(--radius-label);
    background: var(--bg-base);
    color: var(--text-secondary);
    font-size: 15px;
    line-height: 1;
    cursor: pointer;
  }

  .block-toolbar button + button {
    margin-left: -1px;
  }

  .block-toolbar button:hover:not(:disabled) {
    background: var(--bg-subtle);
    color: var(--text-primary);
  }

  .block-toolbar button:disabled {
    opacity: 0.3;
    cursor: default;
  }

  .block-toolbar button[hidden] {
    display: none;
  }
</style>

<script>
  import { onPageLoad, pageSignal } from "~/scripts/pageLifecycle";

  onPageLoad(async () => {
    const signal = pageSignal();
    // dev 専用機能なので、本番バンドルに含めない
    if (import.meta.env.DEV) {
      const { initPreviewBodyEdit } = await import("~/scripts/previewBodyEdit");
      if (signal.aborted) return;
      initPreviewBodyEdit();

      const { initPreviewSyntaxHelp } =
        await import("~/scripts/previewSyntaxHelp");
      if (signal.aborted) return;
      initPreviewSyntaxHelp();

      const { initPreviewBarMetrics } =
        await import("~/scripts/previewBarMetrics");
      if (signal.aborted) return;
      initPreviewBarMetrics();
    }
  });
</script>
