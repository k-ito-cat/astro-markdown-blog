---
import type { CollectionEntry } from "astro:content";
import { CATEGORIES, MAX_CATEGORIES_PER_POST } from "~/constants/categories";
import {
  POST_PRIORITY,
  POST_PRIORITY_LABELS,
  POST_PRIORITY_ORDER,
} from "~/constants/postPriority";
import {
  PUBLISHED_STATUS,
  PUBLISHED_STATUS_LABELS,
  PUBLISHED_STATUS_ORDER,
} from "~/constants/publishedStatus";
import { TAGS } from "~/constants/tags";
import {
  WRITING_STATUS,
  WRITING_STATUS_LABELS,
  WRITING_STATUS_ORDER,
} from "~/constants/writingStatus";
import { toIsoDate } from "~/utils/formatDate";
import { normalizePostSlug } from "~/utils/postSlug";

type Props = {
  entryId: string;
  data: CollectionEntry<"posts">["data"];
};

const { entryId, data } = Astro.props;

// slug の正体はファイル名なので、フロントマターの保存とは別の操作として扱う
const slug = normalizePostSlug(entryId);

const publishedStatuses = Object.values(PUBLISHED_STATUS).sort(
  (a, b) => PUBLISHED_STATUS_ORDER[a] - PUBLISHED_STATUS_ORDER[b],
);
const writingStatuses = Object.values(WRITING_STATUS).sort(
  (a, b) => WRITING_STATUS_ORDER[a] - WRITING_STATUS_ORDER[b],
);
const priorities = Object.values(POST_PRIORITY).sort(
  (a, b) => POST_PRIORITY_ORDER[a] - POST_PRIORITY_ORDER[b],
);
const sortedTags = [...TAGS].sort((a, b) => a.localeCompare(b, "ja"));
---

<frontmatter-editor
  class="fm-editor"
  data-entry-id={entryId}
  data-max-categories={MAX_CATEGORIES_PER_POST}
>
  <details class="fm-details">
    <summary class="fm-summary">
      <span>フロントマターを編集</span>
      <span class="fm-summary-hint">相関・改訂履歴はファイルを直接編集</span>
    </summary>

    <form class="fm-form" data-fm-form>
      <div class="fm-toolbar">
        <details class="fm-ai">
          <summary class="fm-ai-summary">AI 候補</summary>
          <div class="fm-ai-panel">
            <p class="fm-ai-note">
              タイトル・スラッグ・カテゴリ・タグの候補を出します。
            </p>
            <textarea
              class="fm-input fm-ai-instruction"
              rows="3"
              placeholder="指示（任意）例: もっと短く、専門用語を避けて"
              data-fm-instruction></textarea>
            <label class="fm-ai-option">
              <input type="checkbox" data-fm-suggest-body />
              <span>本文も読む（10秒ほど長くなります）</span>
            </label>
            <button type="button" class="fm-ai-run" data-fm-suggest>
              候補を出す
            </button>
          </div>
        </details>
        <p
          class="fm-suggest-status"
          data-fm-suggest-status
          role="status"
          aria-live="polite"
        >
        </p>
      </div>

      <div class="fm-body">
        <div class="fm-column">
          <div class="fm-field">
            <label class="fm-label" for="fm-title">タイトル</label>
            <input
              type="text"
              id="fm-title"
              name="title"
              class="fm-input fm-title-input"
              value={data.title}
              required
            />
            <div class="fm-suggestions" data-suggestions="titles"></div>
          </div>

          <div class="fm-field" data-fm-slug={slug}>
            <label class="fm-label" for="fm-slug">スラッグ</label>
            <input
              type="text"
              id="fm-slug"
              class="fm-input fm-slug-input"
              value={slug}
              autocomplete="off"
              spellcheck="false"
              data-fm-slug-input
            />
            <div class="fm-suggestions" data-suggestions="slugs"></div>
            <p class="fm-hint">
              変更すると、保存時にファイル名を変えて新しい URL へ移ります
            </p>
          </div>

          <div class="fm-grid">
            <label class="fm-field">
              <span class="fm-label">公開日</span>
              <input
                type="date"
                name="publishedAt"
                class="fm-input"
                value={toIsoDate(data.publishedAt)}
                required
              />
            </label>

            <label class="fm-field">
              <span class="fm-label">更新日</span>
              <input
                type="date"
                name="updatedAt"
                class="fm-input"
                value={toIsoDate(data.updatedAt)}
                required
              />
            </label>

            <label class="fm-field">
              <span class="fm-label">公開状態</span>
              <select name="status" class="fm-input">
                {
                  publishedStatuses.map((value) => (
                    <option value={value} selected={value === data.status}>
                      {PUBLISHED_STATUS_LABELS[value]}
                    </option>
                  ))
                }
              </select>
            </label>

            <label class="fm-field">
              <span class="fm-label">執筆状態</span>
              <select name="writingStatus" class="fm-input">
                {
                  writingStatuses.map((value) => (
                    <option
                      value={value}
                      selected={value === data.writingStatus}
                    >
                      {WRITING_STATUS_LABELS[value]}
                    </option>
                  ))
                }
              </select>
            </label>

            <label class="fm-field">
              <span class="fm-label">優先度</span>
              <select name="priority" class="fm-input">
                {
                  priorities.map((value) => (
                    <option value={value} selected={value === data.priority}>
                      {POST_PRIORITY_LABELS[value]}
                    </option>
                  ))
                }
              </select>
            </label>

            <label class="fm-field fm-field-wide">
              <span class="fm-label">サムネイル</span>
              <input
                type="text"
                name="thumbnail"
                class="fm-input"
                value={data.thumbnail ?? ""}
              />
            </label>

            <label class="fm-field fm-field-wide">
              <span class="fm-label">GitHub URL</span>
              <input
                type="text"
                name="githubUrl"
                class="fm-input"
                value={data.githubUrl ?? ""}
              />
            </label>
          </div>
        </div>

        <div class="fm-column">
          <fieldset class="fm-fieldset">
            <legend class="fm-legend">
              カテゴリ
              <span class="fm-legend-hint">
                1〜{MAX_CATEGORIES_PER_POST}件
              </span>
            </legend>
            <div class="fm-suggestions" data-suggestions="categories"></div>
            <div class="fm-choices">
              {
                CATEGORIES.map((category) => (
                  <label class="fm-choice">
                    <input
                      type="checkbox"
                      name="categories"
                      value={category}
                      checked={data.categories.includes(category)}
                      data-fm-category
                    />
                    <span>{category}</span>
                  </label>
                ))
              }
            </div>
          </fieldset>

          <fieldset class="fm-fieldset">
            <legend class="fm-legend">
              タグ
              <span class="fm-legend-hint">1件以上</span>
            </legend>
            <div class="fm-tag-input">
              <input
                type="search"
                class="fm-input"
                placeholder="絞り込む・無ければ追加"
                autocomplete="off"
                data-fm-tag-filter
                data-new-tag-input
              />
              <button type="button" class="fm-tag-add" data-new-tag-add>
                ＋追加
              </button>
            </div>
            <div class="fm-suggestions" data-suggestions="tags"></div>
            <div class="fm-suggestions" data-suggestions="newTags"></div>
            <div class="fm-new-tags" data-new-tags></div>
            <div class="fm-choices fm-choices-scroll">
              {
                sortedTags.map((tag) => (
                  <label class="fm-choice" data-fm-tag-choice={tag}>
                    <input
                      type="checkbox"
                      name="tags"
                      value={tag}
                      checked={data.tags.includes(tag)}
                    />
                    <span>{tag}</span>
                    <button
                      type="button"
                      class="tag-delete"
                      aria-label={`${tag} を定数から削除`}
                      data-tag-delete={tag}
                    >
                      ×
                    </button>
                  </label>
                ))
              }
            </div>
          </fieldset>
        </div>
      </div>

      <footer class="fm-actions">
        <button type="submit" class="fm-submit" data-fm-submit>保存</button>
        <button type="button" class="fm-reset" data-fm-reset>入力を戻す</button>
        <p class="fm-status" data-fm-status role="status" aria-live="polite">
        </p>
      </footer>
    </form>
  </details>
</frontmatter-editor>

<style>
  .fm-editor {
    display: block;
    margin-bottom: 28px;
  }

  .fm-details {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
  }

  .fm-summary {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 10px;
    padding: 10px 14px;
    color: var(--text-primary);
    font-size: var(--text-sm);
    font-weight: 600;
    cursor: pointer;
  }

  .fm-summary-hint {
    color: var(--text-muted);
    font-size: var(--text-xs);
    font-weight: 400;
  }

  .fm-form {
    display: grid;
    gap: 16px;
    padding: 14px;
    border-top: 1px solid var(--border);
  }

  /* AI は項目の途中ではなく、フォームの入口に 1 アクションとして置く */
  .fm-toolbar {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .fm-ai {
    position: relative;
  }

  .fm-ai-summary {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 5px 12px;
    color: var(--color-primary);
    background: var(--bg-base);
    border: 1px solid var(--color-primary);
    border-radius: var(--radius-label);
    font-size: var(--text-sm);
    cursor: pointer;
    list-style: none;
  }

  .fm-ai-summary::-webkit-details-marker {
    display: none;
  }

  .fm-ai-summary::before {
    content: "✦";
  }

  .fm-ai-panel {
    position: absolute;
    top: calc(100% + 6px);
    left: 0;
    z-index: 1;
    display: grid;
    gap: 8px;
    width: min(320px, 80vw);
    padding: 12px;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-label);
    box-shadow: 0 6px 24px rgb(0 0 0 / 0.12);
  }

  .fm-ai-note {
    margin: 0;
    color: var(--text-muted);
    font-size: var(--text-xs);
    line-height: 1.6;
  }

  .fm-ai-instruction {
    resize: vertical;
    line-height: 1.6;
  }

  .fm-ai-option {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: var(--text-sm);
    cursor: pointer;
  }

  .fm-ai-run {
    justify-self: start;
    padding: 6px 14px;
    color: var(--bg-base);
    background: var(--color-primary);
    border: 1px solid var(--color-primary);
    border-radius: var(--radius-label);
    font-size: var(--text-sm);
    font-family: inherit;
    font-weight: 600;
    cursor: pointer;
  }

  .fm-ai-run:disabled {
    opacity: 0.6;
    cursor: progress;
  }

  .fm-suggest-status {
    margin: 0;
    color: var(--text-muted);
    font-size: var(--text-xs);
  }

  .fm-suggest-status[data-tone="error"] {
    color: var(--danger-text);
  }

  .fm-body {
    display: grid;
    gap: 18px 32px;
  }

  /* 左は記事そのもの、右は分類 */
  @media (min-width: 900px) {
    .fm-body {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
      align-items: start;
    }
  }

  .fm-column {
    display: grid;
    align-content: start;
    gap: 16px;
    min-width: 0;
  }

  .fm-field {
    display: grid;
    gap: 4px;
    min-width: 0;
  }

  .fm-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 12px;
  }

  .fm-field-wide {
    grid-column: 1 / -1;
  }

  .fm-label {
    color: var(--text-muted);
    font-size: var(--text-xs);
  }

  .fm-input {
    width: 100%;
    padding: 6px 8px;
    color: var(--text-primary);
    background: var(--bg-base);
    border: 1px solid var(--border);
    border-radius: var(--radius-label);
    font-size: var(--text-sm);
    font-family: inherit;
  }

  .fm-input:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 1px;
  }

  /* 主役。他の入力より一段大きく置く */
  .fm-title-input {
    padding: 8px 10px;
    font-size: var(--text-md);
  }

  /* slug は機械側の識別子（design/foundations.md Typography） */
  .fm-slug-input {
    font-family: var(--font-machine);
  }

  .fm-hint {
    margin: 0;
    color: var(--text-muted);
    font-size: var(--text-xs);
  }

  .fm-suggestions {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .fm-suggestions:empty {
    display: none;
  }

  .fm-fieldset {
    display: grid;
    gap: 8px;
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .fm-legend {
    display: flex;
    align-items: baseline;
    gap: 8px;
    padding: 0;
    color: var(--text-muted);
    font-size: var(--text-xs);
  }

  .fm-legend-hint {
    opacity: 0.8;
  }

  /* 絞り込みと新規追加は同じ入力で兼ねる。打てば絞り込まれ、無ければ足せる */
  .fm-tag-input {
    display: flex;
    gap: 8px;
    min-width: 0;
  }

  .fm-tag-add {
    flex: none;
    padding: 6px 12px;
    color: var(--color-primary);
    background: var(--bg-base);
    border: 1px solid var(--border);
    border-radius: var(--radius-label);
    font-size: var(--text-sm);
    font-family: inherit;
    cursor: pointer;
  }

  .fm-tag-add:hover {
    background: var(--bg-hover);
  }

  .fm-new-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .fm-new-tags:empty {
    display: none;
  }

  .fm-choices {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 10px;
    padding: 8px;
    background: var(--bg-base);
    border: 1px solid var(--border);
    border-radius: var(--radius-label);
  }

  .fm-choices-scroll {
    max-height: 200px;
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .fm-choice {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    color: var(--text-primary);
    font-size: var(--text-sm);
    cursor: pointer;
  }

  .fm-choice[hidden] {
    display: none;
  }

  /* 常に見えていると 150 件ぶんの × が並んで邪魔になる。触れたときだけ出す */
  .tag-delete {
    padding: 0 2px;
    color: var(--text-muted);
    background: none;
    border: 0;
    font-size: var(--text-xs);
    line-height: 1;
    cursor: pointer;
    opacity: 0;
  }

  .tag-delete:focus-visible,
  label:hover > .tag-delete {
    opacity: 1;
  }

  .tag-delete:hover {
    color: var(--danger);
  }

  .fm-choice input:disabled + span {
    color: var(--text-muted);
    opacity: 0.55;
  }

  .fm-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    padding-top: 4px;
  }

  .fm-submit,
  .fm-reset {
    padding: 7px 18px;
    border: 1px solid var(--border);
    border-radius: var(--radius-label);
    font-size: var(--text-sm);
    font-family: inherit;
    cursor: pointer;
  }

  .fm-submit {
    color: var(--bg-base);
    background: var(--color-primary);
    border-color: var(--color-primary);
    font-weight: 600;
  }

  .fm-submit:disabled {
    opacity: 0.6;
    cursor: progress;
  }

  .fm-reset {
    color: var(--text-primary);
    background: var(--bg-base);
  }

  .fm-reset:hover {
    background: var(--bg-hover);
  }

  .fm-status {
    margin: 0;
    color: var(--text-muted);
    font-size: var(--text-xs);
  }

  .fm-status[data-tone="success"] {
    color: var(--success-text);
  }

  .fm-status[data-tone="error"] {
    color: var(--danger-text);
  }
</style>

<script>
  import { initPreviewFrontmatter } from "~/scripts/previewFrontmatter";

  initPreviewFrontmatter();
</script>
