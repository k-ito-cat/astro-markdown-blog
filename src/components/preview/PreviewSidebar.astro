---
import type { CollectionEntry } from "astro:content";
import { Icon } from "astro-icon/components";
import {
  POST_PRIORITY,
  POST_PRIORITY_LABELS,
  POST_PRIORITY_ORDER,
} from "~/constants/postPriority";
import {
  PUBLISHED_STATUS,
  PUBLISHED_STATUS_LABELS,
  PUBLISHED_STATUS_ORDER,
} from "~/constants/publishedStatus";
import {
  WRITING_STATUS,
  WRITING_STATUS_LABELS,
  WRITING_STATUS_ORDER,
} from "~/constants/writingStatus";
import { normalizeSearchText } from "~/utils/search";
import { normalizePostSlug } from "~/utils/postSlug";
import { isPreviewPinned } from "~/constants/previewPinned";

type Props = {
  posts: CollectionEntry<"posts">[];
  currentId: string;
};

const { posts, currentId } = Astro.props;

// 並びはボードの推奨順に合わせる（書きかけが上に来る）
const items = posts
  .map((post) => {
    const slug = normalizePostSlug(post.id);
    return {
      id: post.id,
      slug,
      pinned: isPreviewPinned(slug),
      title: post.data.title,
      priority: post.data.priority,
      writingStatus: post.data.writingStatus,
      status: post.data.status,
      // 本文は含めない。全記事ページに載せると重くなるため、本文検索は一覧側の役割
      searchText: normalizeSearchText(
        [post.data.title, slug, ...post.data.tags].join(" "),
      ),
    };
  })
  .sort((a, b) => {
    // ピン留めは推奨順より前に置く
    if (a.pinned !== b.pinned) return a.pinned ? -1 : 1;

    const priorityDiff =
      POST_PRIORITY_ORDER[a.priority] - POST_PRIORITY_ORDER[b.priority];
    if (priorityDiff !== 0) return priorityDiff;

    const writingDiff =
      WRITING_STATUS_ORDER[a.writingStatus] -
      WRITING_STATUS_ORDER[b.writingStatus];
    if (writingDiff !== 0) return writingDiff;

    return a.title.localeCompare(b.title, "ja");
  });

const FILTERS = [
  {
    key: "priority",
    label: "優先度",
    options: Object.values(POST_PRIORITY)
      .sort((a, b) => POST_PRIORITY_ORDER[a] - POST_PRIORITY_ORDER[b])
      .map((value) => ({ value, label: POST_PRIORITY_LABELS[value] })),
  },
  {
    key: "writing",
    label: "執筆状態",
    options: Object.values(WRITING_STATUS)
      .sort((a, b) => WRITING_STATUS_ORDER[a] - WRITING_STATUS_ORDER[b])
      .map((value) => ({ value, label: WRITING_STATUS_LABELS[value] })),
  },
  {
    key: "publication",
    label: "公開状態",
    options: Object.values(PUBLISHED_STATUS)
      .sort((a, b) => PUBLISHED_STATUS_ORDER[a] - PUBLISHED_STATUS_ORDER[b])
      .map((value) => ({ value, label: PUBLISHED_STATUS_LABELS[value] })),
  },
] as const;
---

<script is:inline data-astro-rerun>
  // 開閉状態は記事を移動しても保つ。描画前に当てないと開閉がちらつく
  try {
    if (sessionStorage.getItem("preview-sidebar:collapsed")) {
      document.documentElement.dataset.previewSidebar = "collapsed";
    }
  } catch {
    /* 状態を引き継げないだけなので何もしない */
  }
</script>

<preview-sidebar class="preview-sidebar" data-current={currentId}>
  <button
    type="button"
    class="preview-sidebar-filter-open"
    aria-label="記事一覧"
    title="記事一覧"
    data-sidebar-filter-open
  >
    <Icon name="octicon:search-16" aria-hidden="true" />
    <span>記事</span>
    <span class="preview-sidebar-count" data-sidebar-count aria-live="polite"
    ></span>
  </button>

  {
    /*
    一覧そのものを面へ入れる。絞り込みは下の一覧へ直接効くので、
    記事内検索と同じく「語を入れる欄 ＋ その結果」の二段で足りる
  */
  }
  <dialog
    class="sidebar-filter-dialog"
    aria-label="記事一覧"
    data-sidebar-filter-dialog
  >
    <div class="sidebar-filter-panel">
      <div class="sidebar-filter-field">
        <Icon name="octicon:search-16" aria-hidden="true" />
        <label class="sr-only" for="preview-sidebar-search"
          >記事を絞り込む</label
        >
        <input
          id="preview-sidebar-search"
          type="search"
          class="preview-sidebar-input"
          placeholder="絞り込む"
          autocomplete="off"
          data-sidebar-search
        />
        <button
          type="button"
          class="sidebar-filter-close"
          aria-label="閉じる"
          data-sidebar-filter-close
        >
          <Icon name="octicon:x-16" aria-hidden="true" />
        </button>
      </div>

      <div class="preview-sidebar-filters">
        {
          FILTERS.map((filter) => (
            <select
              class="preview-sidebar-select"
              aria-label={filter.label}
              data-sidebar-filter={filter.key}
            >
              <option value="">{filter.label}</option>
              {filter.options.map((option) => (
                <option value={option.value}>{option.label}</option>
              ))}
            </select>
          ))
        }
        <button
          type="button"
          class="preview-sidebar-clear"
          data-sidebar-clear
          hidden
        >
          解除
        </button>
      </div>

      <p class="preview-sidebar-empty" data-sidebar-empty hidden>
        該当する記事がありません
      </p>

      <nav class="preview-sidebar-list" aria-label="記事一覧">
        <ul>
          {
            items.map((item) => (
              <li
                data-sidebar-item
                data-pinned={String(item.pinned)}
                data-search={item.searchText}
                data-priority={item.priority}
                data-writing={item.writingStatus}
                data-publication={item.status}
              >
                <a
                  href={`/preview/posts/${item.slug}`}
                  aria-current={item.id === currentId ? "page" : undefined}
                >
                  <span class="preview-sidebar-title">
                    {item.pinned && (
                      <Icon
                        name="octicon:pin-16"
                        class="preview-sidebar-pin"
                        aria-hidden="true"
                      />
                    )}
                    {item.title}
                  </span>
                  <span class="preview-sidebar-meta">
                    {WRITING_STATUS_LABELS[item.writingStatus]}
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </dialog>
</preview-sidebar>

<style>
  /* 列ではなくなったので、入口ボタンの置き場所としてだけ振る舞う */
  .preview-sidebar {
    display: contents;
  }

  /* 一覧への入口。記事内検索の虫眼鏡と同じ扱いにする */
  .preview-sidebar-filter-open {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    /* 面と寸法は編集バーの道具に合わせる（PreviewBodyEditor 側で指定） */
    color: var(--text-secondary);
    font-family: inherit;
    cursor: pointer;
    transition: color var(--duration-feedback) var(--ease-trace);
  }

  .preview-sidebar-filter-open:hover,
  .preview-sidebar-filter-open:focus-visible {
    color: var(--color-interaction-text);
  }

  /* 絞り込み中は入口の色で示す（hig.md button.toggle-state） */
  .preview-sidebar-filter-open[data-active] {
    color: var(--color-primary);
  }

  .preview-sidebar-filter-open svg {
    width: 14px;
    height: 14px;
  }

  /*
   * 記事内検索のダイアログと同じ立ち方にする。結果を持たないぶん丈は低く、
   * 背後の一覧が絞られるのが見えるよう backdrop は薄く敷く
   */
  .sidebar-filter-dialog {
    --list-top: 12vh;

    position: fixed;
    inset-block-start: var(--list-top);
    inset-inline: 0;
    display: flex;
    flex-direction: column;
    width: min(520px, calc(100vw - 32px));
    /* 語を入れる前も面として立ち、背の高い画面で伸び切らない高さにする */
    min-height: min(260px, calc(100dvh - var(--list-top) - 16px));
    max-height: min(calc(100dvh - var(--list-top) - 16px), 620px);
    margin-inline: auto;
    overflow: hidden;
    padding: 0;
    color: var(--color-text);
    background: var(--color-background);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    box-shadow: 0 18px 48px rgb(31 41 55 / 18%);
  }

  .sidebar-filter-dialog:not([open]) {
    display: none;
  }

  .sidebar-filter-dialog::backdrop {
    background: rgb(17 24 39 / 18%);
  }

  .sidebar-filter-panel {
    /* 送る領域は一覧だけにする。ここで高さを受け取り、余りを一覧へ渡す */
    flex: 1;
    display: flex;
    flex-direction: column;
    min-height: 0;
    padding: 14px 16px 16px;
  }

  .sidebar-filter-field {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 10px;
    padding-bottom: 6px;
    border-bottom: 1px solid var(--color-border);
    color: var(--text-muted);
    transition: border-color var(--duration-feedback) var(--ease-trace);
  }

  .sidebar-filter-field:focus-within {
    border-bottom-color: var(--color-secondary);
    color: var(--color-interaction-text);
  }

  .sidebar-filter-field > svg {
    width: 15px;
    height: 15px;
  }

  .sidebar-filter-close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 24px;
    min-height: 24px;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--text-muted);
    cursor: pointer;
    transition: color var(--duration-feedback) var(--ease-trace);
  }

  .sidebar-filter-close:hover,
  .sidebar-filter-close:focus-visible {
    color: var(--color-interaction-text);
  }

  .sidebar-filter-close svg {
    width: 14px;
    height: 14px;
  }

  .preview-sidebar-input {
    width: 100%;
    min-width: 0;
    height: 26px;
    border: 0;
    background: transparent;
    color: var(--text-primary);
    font-size: var(--text-sm);
  }

  .preview-sidebar-input:focus {
    outline: none;
  }

  /* 絞り込みも検索と同じ面に置く（design/ui-patterns.md Search Transformation） */
  .preview-sidebar-filters {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    margin-top: 10px;
  }

  .preview-sidebar-select {
    min-width: 0;
    height: 24px;
    padding: 0 2px;
    border: 0;
    border-bottom: 1px solid var(--color-border);
    border-radius: 0;
    background: transparent;
    color: var(--text-secondary);
    font-size: 11px;
    transition: border-color var(--duration-feedback) var(--ease-trace);
  }

  .preview-sidebar-select:hover,
  .preview-sidebar-select:focus-visible {
    color: var(--color-interaction-text);
    border-bottom-color: var(--color-secondary);
  }

  /* 選択中は Line と文字色で示す */
  .preview-sidebar-select[data-active] {
    border-bottom-color: var(--color-primary);
    color: var(--color-primary);
  }

  .preview-sidebar-clear {
    min-height: 24px;
    padding: 0 4px;
    border: 0;
    background: transparent;
    color: var(--text-muted);
    font-size: 11px;
    cursor: pointer;
  }

  .preview-sidebar-clear:hover,
  .preview-sidebar-clear:focus-visible {
    color: var(--color-interaction-text);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* 件数が無いときは、隙間だけが残らないよう器ごと畳む */
  .preview-sidebar-count:empty {
    display: none;
  }

  .preview-sidebar-count {
    margin-left: 6px;
    color: var(--text-muted);
    font-family: var(--font-machine);
    font-size: 11px;
    font-weight: 400;
  }

  .preview-sidebar-empty {
    margin: 14px 0 0;
    color: var(--text-muted);
    font-size: var(--text-sm);
  }

  .preview-sidebar-list {
    flex: 1;
    min-height: 0;
    margin-top: 6px;
    overflow-y: auto;
    overscroll-behavior: contain;
    /* 一覧の内側の scrollbar は情報ではないため隠す（page の scrollbar は残す） */
    scrollbar-width: none;
  }

  .preview-sidebar-list::-webkit-scrollbar {
    display: none;
  }

  .preview-sidebar-list ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* 重ねると折り返したタイトルとぶつかるため、行の中に場所を確保する */
  .preview-sidebar-list li {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .preview-sidebar-list a {
    flex: 1;
    min-width: 0;
    padding: 9px 0 9px 14px;
    /* 現在位置以外も同じ位置に文字を並べるため、透明の構造線で桁を合わせる */
    border-left: 2px solid transparent;
    color: var(--text-secondary);
    text-decoration: none;
    line-height: 1.6;
    transition: color var(--duration-feedback) var(--ease-trace);
  }

  .preview-sidebar-list a:hover .preview-sidebar-title,
  .preview-sidebar-list a:focus-visible .preview-sidebar-title {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .preview-sidebar-list a:hover,
  .preview-sidebar-list a:focus-visible {
    color: var(--color-interaction-text);
  }

  /* 現在位置は構造線と Primary で示す（design/ui-patterns.md Line） */
  .preview-sidebar-list a[aria-current="page"] {
    border-left-color: var(--color-primary);
    color: var(--color-primary);
  }

  .preview-sidebar-list a[aria-current="page"] .preview-sidebar-title {
    font-weight: 700;
  }

  .preview-sidebar-title {
    display: block;
    font-size: var(--text-sm);
    overflow-wrap: anywhere;
  }

  /* ピンとタイトルは横並びにして、上下の中心を合わせる */
  .preview-sidebar-list li[data-pinned="true"] .preview-sidebar-title {
    display: flex;
    align-items: center;
    gap: 0.4em;
  }

  /* 行送りを崩さない大きさに留める */
  .preview-sidebar-pin {
    width: 0.9em;
    height: 0.9em;
    flex: 0 0 auto;
    color: var(--text-muted);
  }

  .preview-sidebar-list a:hover .preview-sidebar-pin,
  .preview-sidebar-list a:focus-visible .preview-sidebar-pin,
  .preview-sidebar-list a[aria-current="page"] .preview-sidebar-pin {
    color: currentColor;
  }

  .preview-sidebar-meta {
    display: block;
    margin-top: 3px;
    color: var(--text-muted);
    font-size: 11px;
  }

  .preview-sidebar-list li[hidden] {
    display: none;
  }
</style>

<script>
  import { initPreviewSidebar } from "~/scripts/previewSidebar";
  import { onPageLoad } from "~/scripts/pageLifecycle";

  onPageLoad(() => {
    initPreviewSidebar();
  });
</script>
