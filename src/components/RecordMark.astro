---
import { Icon } from "astro-icon/components";

type Props = {
  slug: string;
  title: string;
};

const { slug, title } = Astro.props;
---

<button
  type="button"
  class="record-mark"
  data-record-mark
  data-record-slug={slug}
  data-record-title={title}
  aria-pressed="false"
  aria-label={`${title}をこの端末でMarkする`}
  title="この端末で後から読み返す"
>
  <Icon name="octicon:bookmark-16" aria-hidden="true" />
  <span class="record-mark-label">Mark</span>
</button>

<style>
  .record-mark {
    position: relative;
    isolation: isolate;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 5px;
    min-width: 44px;
    min-height: 32px;
    padding: 0 6px;
    color: var(--color-text-muted);
    background: transparent;
    border: 0;
    cursor: pointer;
  }

  .record-mark-label {
    font-family: var(--font-machine);
    font-size: 10px;
  }

  .record-mark[aria-pressed="true"] {
    color: var(--color-primary);
  }

  .record-mark[aria-pressed="true"]::before {
    content: "";
    position: absolute;
    z-index: -1;
    right: 4px;
    bottom: 7px;
    left: 4px;
    height: 8px;
    background: color-mix(in srgb, var(--color-accent) 75%, transparent);
    transform: skewX(-7deg);
  }

  @media (max-width: 639px) {
    .record-mark[aria-pressed="true"]::before {
      right: 11px;
      left: 11px;
    }

    .record-mark-label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
    }
  }
</style>

<script>
  const STORAGE_KEY = "amb:record-marks:v1";

  const readMarks = (): string[] => {
    try {
      const value = JSON.parse(localStorage.getItem(STORAGE_KEY) ?? "[]");
      return Array.isArray(value)
        ? value.filter((item) => typeof item === "string")
        : [];
    } catch {
      return [];
    }
  };

  const writeMarks = (marks: string[]) => {
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(marks));
    } catch {
      // Mark is progressive enhancement. Reading remains available without storage.
    }
  };

  const updateButton = (button: HTMLButtonElement, marked: boolean) => {
    const title = button.dataset.recordTitle ?? "この記録";
    button.setAttribute("aria-pressed", String(marked));
    button.setAttribute(
      "aria-label",
      marked ? `${title}のMarkを外す` : `${title}をこの端末でMarkする`,
    );
    button
      .closest("[data-record-entry]")
      ?.classList.toggle("is-marked", marked);
  };

  const initRecordMarks = () => {
    const buttons = Array.from(
      document.querySelectorAll<HTMLButtonElement>("[data-record-mark]"),
    );
    let marks = readMarks();

    buttons.forEach((button) => {
      const slug = button.dataset.recordSlug;
      if (!slug) return;
      updateButton(button, marks.includes(slug));
      button.addEventListener("click", () => {
        marks = marks.includes(slug)
          ? marks.filter((mark) => mark !== slug)
          : [...marks, slug];
        writeMarks(marks);
        updateButton(button, marks.includes(slug));
      });
    });
  };

  initRecordMarks();
  document.addEventListener("astro:page-load", initRecordMarks);
</script>
