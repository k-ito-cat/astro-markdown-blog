---
import { Icon } from "astro-icon/components";
import { formatJapaneseDate, toIsoDate } from "~/utils/formatDate";

type Props = {
  publishedAt: Date;
  updatedAt: Date;
};

const { publishedAt, updatedAt } = Astro.props;
const isRevised = updatedAt.getTime() > publishedAt.getTime();
---

<dl class="record-meta">
  <div>
    <dt><Icon name="octicon:pencil-16" aria-hidden="true" />記録日</dt>
    <dd>
      <time datetime={toIsoDate(publishedAt)}
        >{formatJapaneseDate(publishedAt)}</time
      >
    </dd>
  </div>
  {
    isRevised && (
      <div>
        <dt>
          <Icon name="octicon:history-16" aria-hidden="true" />
          最終改訂
        </dt>
        <dd>
          <time datetime={toIsoDate(updatedAt)}>
            {formatJapaneseDate(updatedAt)}
          </time>
        </dd>
      </div>
    )
  }
</dl>

<style>
  .record-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 22px;
    margin: 0;
  }

  .record-meta div {
    display: grid;
    gap: 2px;
  }

  .record-meta dt {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    color: var(--color-text-muted);
    font-size: 11px;
  }

  .record-meta dd {
    margin: 0;
    color: var(--color-text-sub);
    font-size: var(--text-sm);
  }
</style>
