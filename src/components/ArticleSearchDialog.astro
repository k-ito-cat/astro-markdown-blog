---
import { Icon } from "astro-icon/components";

/*
 * 記事内検索の本体。ページに一つだけ置き、欄外と目次の入口、
 * ハンバーガーメニューの項目、Cmd / Ctrl+F のどれからも同じものを開く。
 *
 * 打っている最中は本文を送らない。1文字ごとに飛ぶと、2文字目を打つ前に
 * 画面が動いて語を入れ切れない。件数とヒットの一文を先に見せ、
 * 一覧で選んで段落を確かめてから、Enter か「本文へ移る」で送る。
 * 一覧を押しただけでは送らない。Touch では押すまで段落を確かめる手が無く、
 * 押した途端に閉じると、選び直す機会が無くなる。
 */
---

<dialog
  class="article-search-dialog"
  aria-label="記事内を検索"
  data-article-search-dialog
>
  <div class="article-search-panel" data-idle>
    <div class="article-search-field">
      <Icon name="octicon:search-16" aria-hidden="true" />
      <label class="sr-only" for="article-search-input">記事内の語</label>
      <input
        id="article-search-input"
        class="article-search-input"
        type="search"
        autocomplete="off"
        spellcheck="false"
        placeholder="記事内の語"
        data-article-search-input
      />
      <span
        class="article-search-count"
        aria-live="polite"
        data-article-search-count></span>
      <button
        type="button"
        class="article-search-clear"
        data-article-search-clear
        hidden
      >
        クリア
      </button>
      <button
        type="button"
        class="article-search-close"
        aria-label="閉じる"
        data-article-search-close
      >
        <Icon name="octicon:x-16" aria-hidden="true" />
      </button>
    </div>

    <div class="article-search-results" data-article-search-results hidden>
      <div class="article-search-list">
        <ol class="article-search-hits" data-article-search-hits></ol>
        <p class="article-search-rest" data-article-search-rest hidden></p>
      </div>
      <div class="article-search-preview" data-article-search-preview>
        <p
          class="preview-body"
          aria-live="polite"
          data-article-search-preview-body
        >
        </p>
        <p class="preview-idle">候補を選ぶと、その段落が出る</p>
        <button type="button" class="article-search-go" data-article-search-go>
          本文へ移る
          <Icon name="octicon:arrow-right-16" aria-hidden="true" />
        </button>
      </div>
    </div>

    <p class="article-search-idle">記事の中を探す</p>

    <p class="article-search-hint">
      <span><kbd>↑</kbd><kbd>↓</kbd> 選ぶ</span>
      <span><kbd>Enter</kbd> 本文へ移る</span>
      <span><kbd>⌘F</kbd> / <kbd>Ctrl F</kbd> 語を入れ直す</span>
      <span><kbd>Esc</kbd> クリア / 閉じる</span>
    </p>
  </div>
</dialog>

<style>
  /*
   * dialog は画面全体の透明な層にして、面はその中に置く。背景のスクロールは
   * 止めない（Lightbox と同じく、iOS で読んでいた位置が潰れるため）。
   * 面の外を触って背後が送られないことは、この層の touch-action と
   * overscroll-behavior で担保する。一覧とプレビューは自前で送る領域なので、
   * そこでの縦送りは妨げない
   */
  .article-search-dialog {
    --search-top: 12vh;
    --search-shift: 0px;
    --search-viewport: 100dvh;
    /* 背の高い画面で一覧20件ぶん伸びないよう、画面とは別に上限を持つ */
    --search-height: 600px;
    --search-idle-height: 240px;

    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: 0;
    overflow: hidden;
    overscroll-behavior: contain;
    touch-action: none;
    background: transparent;
    border: 0;
  }

  /* 本文のヒットが透けて見える濃さに留める。どこにあるかは背景でも追える */
  .article-search-dialog::backdrop {
    background: rgb(17 24 39 / 18%);
  }

  /*
   * 高さは「今見えている画面」に合わせる。狭幅ではソフトキーボードが画面の
   * 半分近くを占めるが、vh も dvh もキーボードでは縮まないため、一覧の下が
   * キーボードの裏へ回る。実寸は script が visualViewport から流し込み、
   * 取れない環境は dvh に落ちる。
   *
   * 送る領域は一覧とプレビューだけにする。ここは overflow: hidden にして、
   * 余った高さを一覧が受け取る。面と一覧で縦スクロールバーが二重に出ない。
   *
   * 入力欄の下には罫線を引かない。語が無い状態では下の罫線と近接して並び、
   * 区切るものが無いのに区切って見える
   */
  .article-search-panel {
    position: absolute;
    inset-block-start: calc(var(--search-shift) + var(--search-top));
    inset-inline: 0;
    display: flex;
    flex-direction: column;
    width: min(1040px, calc(100vw - 32px));
    /*
     * 高さは件数によらず固定する。打つたびに面の下端が伸び縮みすると、
     * 一覧とプレビューの位置が揺れて読めない。画面が低いときは画面に収める
     */
    height: min(
      calc(var(--search-viewport) - var(--search-top) - 16px),
      var(--search-height)
    );
    margin-inline: auto;
    overflow: hidden;
    padding: 0;
    color: var(--color-text);
    background: var(--color-background);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    box-shadow: 0 18px 48px rgb(31 41 55 / 18%);
    /*
     * 入力欄のほかは選べなくする。iOS では、選んだ文字を script が差し替えると
     * 選択の塗りだけが画面に残る。一覧とプレビューは確かめる面で、写す元は本文にある
     */
    -webkit-user-select: none;
    user-select: none;
  }

  /*
   * 語が無いうちは、何をする面かを一言置くだけなので低く留める。語が入ったら
   * 件数によらず同じ高さにし、以降は打つたびに揺らさない。狭幅の sheet は
   * 常に同じ高さなので対象にしない
   */
  @media (min-width: 900px) {
    .article-search-panel[data-idle] {
      height: min(
        calc(var(--search-viewport) - var(--search-top) - 16px),
        var(--search-idle-height)
      );
    }
  }

  /* 入力欄はダイアログの幅いっぱいに置く */
  .article-search-field {
    flex: none;
    display: grid;
    /* 後ろの件数、クリア、閉じるは、出ている分だけ列を取る */
    grid-template-columns: auto minmax(0, 1fr);
    grid-auto-columns: auto;
    grid-auto-flow: column;
    align-items: center;
    gap: 10px;
    padding: 14px 16px;
  }

  .article-search-field > :global(svg) {
    width: 15px;
    height: 15px;
    color: var(--color-text-muted);
  }

  .article-search-input {
    min-width: 0;
    padding: 2px 0;
    color: var(--color-text);
    font-family: inherit;
    font-size: var(--text-md);
    background: none;
    border: 0;
    border-radius: 0;
    appearance: none;
    -webkit-user-select: text;
    user-select: text;
  }

  .article-search-input::-webkit-search-cancel-button {
    display: none;
  }

  .article-search-count {
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  /* hig.md hover.text。語があるときだけ出す */
  .article-search-clear {
    padding: 0;
    color: var(--color-text-muted);
    font-family: inherit;
    font-size: var(--text-xs);
    white-space: nowrap;
    background: none;
    border: 0;
    cursor: pointer;
    transition: color var(--duration-feedback) ease;
  }

  .article-search-clear[hidden] {
    display: none;
  }

  .article-search-clear:hover,
  .article-search-clear:focus-visible {
    color: var(--color-interaction-text);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .article-search-close {
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    padding: 0;
    color: var(--color-text-muted);
    background: none;
    border: 0;
    cursor: pointer;
    transition: color var(--duration-feedback) ease;
  }

  .article-search-close:hover,
  .article-search-close:focus-visible {
    color: var(--color-primary);
  }

  .article-search-close :global(svg) {
    width: 14px;
    height: 14px;
  }

  /*
   * ヒットの一覧。行の頭に細い線を引き、選んだ行だけ線と文字を濃くする。
   * 面（card）は作らない
   */
  /*
   * 一覧とプレビュー。選んだヒットの段落を丸ごと出す。一覧の一行では前後が
   * 足りず、飛ぶ前にそこで合っているか判断できない。狭幅では一覧の下、
   * 広幅では右に置く
   */
  .article-search-results {
    flex: 1 1 auto;
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto;
    min-height: 0;
  }

  .article-search-results[hidden] {
    display: none;
  }

  .article-search-list {
    display: flex;
    flex-direction: column;
    min-height: 0;
  }

  .article-search-hits {
    flex: 1 1 auto;
    min-height: 0;
    margin: 0;
    /*
     * 左右は 8px。行の面と罫線をここまで広げ、文字の頭は項目側の padding で
     * 入力欄の 16px へ揃える。負マージンで外へ出すと、罫線だけ内側に残る
     */
    padding: 0 8px 12px;
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;
    list-style: none;
  }

  .article-search-preview {
    display: flex;
    flex-direction: column;
    min-height: 0;
    padding: 10px 16px 0;
    border-block-start: 1px solid var(--color-border);
  }

  /* 狭幅では選ぶまで出さず、一覧に高さを残す */
  .article-search-preview[data-empty] {
    display: none;
  }

  .preview-body {
    /* ヒットの位置を、この段落の中で測る基準にする */
    position: relative;
    /*
     * 3行に絞り、ヒットの行を2行目に置く（script）。段落を丸ごと読ませる
     * 面ではなく、飛ぶ先が合っているかを確かめる面として扱う
     */
    max-block-size: 3lh;
    margin: 0;
    overflow-y: hidden;
    color: var(--color-text-sub);
    font-size: var(--text-sm);
    line-height: var(--leading-body);
    overflow-wrap: break-word;
  }

  .preview-body :global(mark) {
    padding: 0 0.15em;
    color: var(--color-text);
    font-weight: 600;
    background: color-mix(in srgb, var(--color-accent) 62%, transparent);
    border-radius: 1px;
  }

  .preview-idle {
    display: none;
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  /* hig.md hover.text。面は敷かず、色と underline で示す */
  .article-search-go {
    flex: none;
    align-self: flex-end;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-block-size: 44px;
    padding: 0;
    color: var(--color-primary);
    font-family: inherit;
    font-size: var(--text-sm);
    font-weight: 600;
    background: none;
    border: 0;
    cursor: pointer;
    transition: color var(--duration-feedback) ease;
  }

  .article-search-go:hover,
  .article-search-go:focus-visible {
    color: var(--color-interaction-text);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .article-search-go :global(svg) {
    width: 14px;
    height: 14px;
  }

  @media (min-width: 900px) {
    .article-search-results {
      grid-template-columns: minmax(0, 43fr) minmax(0, 57fr);
      grid-template-rows: minmax(0, 1fr);
    }

    .article-search-preview {
      padding: 2px 16px 0;
      border-block-start: 0;
      border-inline-start: 1px solid var(--color-border);
    }

    /* 広幅は欄を常に置く。空のまま置くと、何の欄か読めない */
    .article-search-preview[data-empty] {
      display: flex;
    }

    .article-search-preview[data-empty] .preview-body,
    .article-search-preview[data-empty] .article-search-go {
      display: none;
    }

    .article-search-preview[data-empty] .preview-idle {
      display: block;
    }
  }

  /*
   * 一件は折り返して全文を見せる。行が高くなるぶん、区切りは余白と
   * 項目間の線で作る。選んでいる行は面と番号の色で示し、行の脇に線は引かない
   */
  /* 1件が2行になることがあるので、どこで切れるかを線で示す */
  .article-search-hits :global(li + li) {
    border-block-start: 1px solid var(--color-border);
  }

  .article-search-hits :global(button) {
    display: grid;
    grid-template-columns: 2.5ch minmax(0, 1fr);
    gap: 12px;
    /* 選んでいる面が行いっぱいに広がるよう、行の幅を取る */
    width: 100%;
    padding: 9px 8px;
    color: var(--color-text-muted);
    font-family: inherit;
    font-size: var(--text-sm);
    line-height: 1.7;
    text-align: start;
    background: none;
    border: 0;
    border-radius: var(--radius-label);
    cursor: pointer;
    transition:
      color var(--duration-feedback) ease,
      background-color var(--duration-feedback) ease;
  }

  /* hig.md hover.text。面は敷かず、色と underline で示す */
  .article-search-hits :global(button:hover) .hit-text,
  .article-search-hits :global(button:focus-visible) .hit-text {
    color: var(--color-interaction-text);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /*
   * 選んでいる候補。現在地（hig.md nav.current）ではなく候補の選択なので、
   * Lineではなく薄い面で示す。色と太さは同じに保つ
   */
  .article-search-hits :global(button[aria-current="true"]) {
    color: var(--color-primary);
    font-weight: 700;
    background: var(--bg-subtle);
  }

  .article-search-hits :global(.hit-index) {
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    font-variant-numeric: tabular-nums;
    text-align: end;
  }

  .article-search-hits :global(button[aria-current="true"] .hit-index) {
    color: var(--color-primary);
  }

  /*
   * 狭幅で、選んでいる行の右端に置く送りの矢印。プレビューの下まで指を
   * 運ばずに、選んだその場で送れる。行の button の中に button は入れられない
   * ので、隣に置いて行の面の上へ重ねる
   */
  .article-search-hits :global(li) {
    position: relative;
  }

  .article-search-hits :global(.hit-go) {
    position: absolute;
    inset-block: 0;
    inset-inline-end: 0;
    display: none;
    place-items: center;
    width: 44px;
    padding: 0;
    color: var(--color-primary);
    background: none;
    border: 0;
    cursor: pointer;
    transition: color var(--duration-feedback) ease;
  }

  /* hig.md hover.icon-only */
  .article-search-hits :global(.hit-go:hover),
  .article-search-hits :global(.hit-go:focus-visible) {
    color: var(--color-interaction-text);
  }

  .article-search-hits :global(.hit-go svg) {
    width: 16px;
    height: 16px;
  }

  @media (max-width: 899px) {
    .article-search-hits :global([aria-current="true"] + .hit-go) {
      display: grid;
    }

    /* 矢印の下に文字が潜らないよう、選んでいる行だけ右を空ける */
    .article-search-hits :global(button[aria-current="true"]) {
      padding-inline-end: 44px;
    }

    /* 送る操作は行の矢印が持つ。プレビューは確かめるだけの面にする */
    .article-search-preview {
      padding-block-end: 10px;
    }

    .article-search-go {
      display: none;
    }
  }

  /*
   * 一文をそのまま出し、行に収まらない分だけ省略する。前後の文脈は沈め、
   * 探している語だけを本文の濃さで立てる
   */
  .article-search-hits :global(.hit-text) {
    min-width: 0;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .article-search-hits :global(.hit-text mark) {
    padding: 0 0.15em;
    color: var(--color-text);
    font-weight: 600;
    background: color-mix(in srgb, var(--color-accent) 62%, transparent);
    border-radius: 1px;
  }

  .article-search-rest {
    flex: none;
    margin: 0;
    padding: 2px 16px 12px;
    color: var(--color-text-muted);
    font-size: var(--text-xs);
  }

  .article-search-rest[hidden] {
    display: none;
  }

  /* キーの案内。読むものではないので、線の下に薄く置くだけにする */
  /* 語を入れる前の空き。何をする面かを一言だけ置く */
  .article-search-idle {
    display: grid;
    flex: 1;
    place-items: center;
    margin: 0;
    padding: 24px 16px;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  /* 結果が出たら引っ込む */
  .article-search-results:not([hidden]) ~ .article-search-idle {
    display: none;
  }

  /* コマンドの説明は面の下端に留める */
  .article-search-hint {
    flex: none;
    margin-top: auto;
    display: flex;
    flex-wrap: wrap;
    gap: 4px 14px;
    margin: 0;
    padding: 10px 16px;
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    border-top: 1px solid var(--color-border);
  }

  .article-search-hint kbd {
    padding: 0 3px;
    font-family: var(--font-machine);
    font-size: 0.95em;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-label);
  }

  .article-search-hint kbd + kbd {
    margin-inline-start: 2px;
  }

  /*
   * Touch が主の端末では、案内するキーそのものが手元に無い。判定は幅ではなく
   * hover の有無で行う（layouts.md）
   */
  @media (hover: none) {
    .article-search-hint {
      display: none;
    }
  }

  /*
   * 狭幅は modal bottom sheet にする。寸法、縁、出入りは探すページの
   * 簡易検索（.filter-sheet）に揃える。語を入れる面なので、下端は画面では
   * なくソフトキーボードの上端に置く。見えている範囲の下端は script が
   * visualViewport から渡す
   */
  @media (max-width: 899px) {
    .article-search-dialog {
      transition-property: display, overlay;
      transition-duration: var(--duration-state);
      transition-behavior: allow-discrete;
    }

    .article-search-dialog::backdrop {
      background-color: transparent;
      transition-property: background-color, display, overlay;
      transition-duration: var(--duration-state);
      transition-timing-function: var(--ease-trace);
      transition-behavior: allow-discrete;
    }

    .article-search-dialog[open]::backdrop {
      background-color: color-mix(in srgb, var(--color-text) 22%, transparent);
    }

    @starting-style {
      .article-search-dialog[open]::backdrop {
        background-color: transparent;
      }
    }

    .article-search-panel {
      inset-block: auto
        calc(100% - var(--search-shift) - var(--search-viewport));
      width: 100%;
      /* キーボードが出ている間は、見えている範囲の上端近くまで伸ばす */
      height: min(70dvh, calc(var(--search-viewport) - 24px));
      padding-block-end: env(safe-area-inset-bottom);
      border: 1px solid var(--color-border-strong);
      border-inline: 0;
      border-block-end: 0;
      /* 画面の端に貼り付くので、丸めるのは上の両端だけ */
      border-radius: 16px 16px 0 0;
      box-shadow: none;
      opacity: 0;
      transform: translateY(100%);
      transition-property: opacity, transform;
      transition-duration: var(--duration-state);
      transition-timing-function: var(--ease-trace);
    }

    .article-search-dialog[open] .article-search-panel {
      opacity: 1;
      transform: translateY(0);
    }

    @starting-style {
      .article-search-dialog[open] .article-search-panel {
        opacity: 0;
        transform: translateY(100%);
      }
    }

    /* sheet の見出しにあたる行。探すページの sheet と同じく下に罫線を引く */
    .article-search-field {
      border-block-end: 1px solid var(--color-border);
    }

    .article-search-close {
      width: 32px;
      height: 32px;
    }

    /* 指で押す前提の幅なので、文字の外まで当たり判定を広げる */
    .article-search-clear {
      min-block-size: 44px;
      padding-inline: 8px;
    }

    .article-search-close :global(svg) {
      width: 16px;
      height: 16px;
    }
  }

  @media (max-width: 899px) and (prefers-reduced-motion: reduce) {
    .article-search-dialog,
    .article-search-dialog::backdrop,
    .article-search-panel {
      transition-duration: 1ms;
    }

    .article-search-panel {
      transform: none;
    }

    @starting-style {
