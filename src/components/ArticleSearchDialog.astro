---
import { Icon } from "astro-icon/components";

/*
 * 記事内検索の本体。ページに一つだけ置き、欄外と目次の入口、
 * ハンバーガーメニューの項目、Cmd / Ctrl+F のどれからも同じものを開く。
 *
 * 打っている最中は本文を送らない。1文字ごとに飛ぶと、2文字目を打つ前に
 * 画面が動いて語を入れ切れない。件数とヒットの一文を先に見せ、
 * どこへ行くかは Enter か一覧で決める。
 */
---

<dialog
  class="article-search-dialog"
  aria-label="記事内を検索"
  data-article-search-dialog
>
  <div class="article-search-panel">
    <div class="article-search-field">
      <Icon name="octicon:search-16" aria-hidden="true" />
      <label class="sr-only" for="article-search-input">記事内の語</label>
      <input
        id="article-search-input"
        class="article-search-input"
        type="search"
        autocomplete="off"
        spellcheck="false"
        placeholder="記事内の語"
        data-article-search-input
      />
      <span
        class="article-search-count"
        aria-live="polite"
        data-article-search-count></span>
      <button
        type="button"
        class="article-search-close"
        aria-label="閉じる"
        data-article-search-close
      >
        <Icon name="octicon:x-16" aria-hidden="true" />
      </button>
    </div>

    <div class="article-search-results" data-article-search-results hidden>
      <div class="article-search-list">
        <ol class="article-search-hits" data-article-search-hits></ol>
        <p class="article-search-rest" data-article-search-rest hidden></p>
      </div>
      <div
        class="article-search-preview"
        aria-live="polite"
        data-article-search-preview
      >
        <p class="preview-body" data-article-search-preview-body></p>
      </div>
    </div>

    <p class="article-search-hint">
      <span><kbd>↑</kbd><kbd>↓</kbd> 選ぶ</span>
      <span><kbd>Enter</kbd> 本文へ移る</span>
      <span><kbd>Esc</kbd> 閉じる</span>
    </p>
  </div>
</dialog>

<style>
  /*
   * 高さは「今見えている画面」に合わせる。狭幅ではソフトキーボードが画面の
   * 半分近くを占めるが、vh も dvh もキーボードでは縮まないため、一覧の下が
   * キーボードの裏へ回る。実寸は script が visualViewport から流し込み、
   * 取れない環境は dvh に落ちる。
   *
   * 送る領域は一覧だけにする。ここは overflow: hidden にして、余った高さを
   * 一覧が受け取る。ダイアログと一覧で縦スクロールバーが二重に出ない
   */
  .article-search-dialog {
    --search-top: 12vh;
    --search-shift: 0px;
    --search-viewport: 100dvh;
    /* 背の高い画面で一覧20件ぶん伸びないよう、画面とは別に上限を持つ */
    --search-height: 600px;

    position: fixed;
    inset-block-start: calc(var(--search-shift) + var(--search-top));
    inset-inline: 0;
    display: flex;
    flex-direction: column;
    width: min(1040px, calc(100vw - 32px));
    max-height: min(
      calc(var(--search-viewport) - var(--search-top) - 16px),
      var(--search-height)
    );
    margin-inline: auto;
    overflow: hidden;
    padding: 0;
    color: var(--color-text);
    background: var(--color-background);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    box-shadow: 0 18px 48px rgb(31 41 55 / 18%);
  }

  /* display を持たせたので、閉じているときの既定の非表示を自分で書く */
  .article-search-dialog:not([open]) {
    display: none;
  }

  /* 本文のヒットが透けて見える濃さに留める。どこにあるかは背景でも追える */
  .article-search-dialog::backdrop {
    background: rgb(17 24 39 / 18%);
  }

  /*
   * 罫線はキーの案内の上の一本だけにする。入力欄にも線を引くと、語が無い
   * 状態では二本が近接して並び、区切るものが無いのに区切って見える
   */
  .article-search-panel {
    display: flex;
    flex-direction: column;
    min-height: 0;
    padding: 0;
  }

  /* 入力欄はダイアログの幅いっぱいに置く */
  .article-search-field {
    flex: none;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto auto;
    align-items: center;
    gap: 10px;
    padding: 14px 16px;
  }

  .article-search-field > :global(svg) {
    width: 15px;
    height: 15px;
    color: var(--color-text-muted);
  }

  .article-search-input {
    min-width: 0;
    padding: 2px 0;
    color: var(--color-text);
    font-family: inherit;
    font-size: var(--text-md);
    background: none;
    border: 0;
    border-radius: 0;
    appearance: none;
  }

  .article-search-input::-webkit-search-cancel-button {
    display: none;
  }

  .article-search-count {
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .article-search-close {
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    padding: 0;
    color: var(--color-text-muted);
    background: none;
    border: 0;
    cursor: pointer;
    transition: color var(--duration-feedback) ease;
  }

  .article-search-close:hover,
  .article-search-close:focus-visible {
    color: var(--color-primary);
  }

  .article-search-close :global(svg) {
    width: 14px;
    height: 14px;
  }

  /*
   * ヒットの一覧。行の頭に細い線を引き、選んだ行だけ線と文字を濃くする。
   * 面（card）は作らない
   */
  /*
   * 一覧とプレビューの二段組。広幅では右に、選んだヒットの段落を丸ごと出す。
   * 一覧の一行では前後が足りず、飛ぶ前にそこで合っているか判断できない
   */
  .article-search-results {
    flex: 1 1 auto;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    min-height: 0;
  }

  .article-search-results[hidden] {
    display: none;
  }

  .article-search-list {
    display: flex;
    flex-direction: column;
    min-height: 0;
  }

  .article-search-hits {
    flex: 1 1 auto;
    min-height: 0;
    margin: 0;
    /*
     * 左右は 8px。行の面と罫線をここまで広げ、文字の頭は項目側の padding で
     * 入力欄の 16px へ揃える。負マージンで外へ出すと、罫線だけ内側に残る
     */
    padding: 0 8px 12px;
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;
    list-style: none;
  }

  /* 幅が足りないうちはプレビューを出さない。一覧の一行だけで選ぶ */
  .article-search-preview {
    display: none;
  }

  @media (min-width: 900px) {
    .article-search-results {
      grid-template-columns: minmax(0, 43fr) minmax(0, 57fr);
    }

    .article-search-preview {
      display: block;
      min-height: 0;
      padding: 2px 16px 12px;
      overflow-y: auto;
      overscroll-behavior: contain;
      scrollbar-width: thin;
      border-inline-start: 1px solid var(--color-border);
    }

    .article-search-preview :global(.preview-body) {
      margin: 0;
      color: var(--color-text-sub);
      font-size: var(--text-sm);
      line-height: var(--leading-body);
      line-break: strict;
      overflow-wrap: break-word;
      text-wrap: pretty;
    }

    .article-search-preview :global(.preview-body mark) {
      padding: 0 0.15em;
      color: var(--color-text);
      font-weight: 600;
      background: color-mix(in srgb, var(--color-accent) 62%, transparent);
      border-radius: 1px;
    }
  }

  /*
   * 一件は折り返して全文を見せる。行が高くなるぶん、区切りは余白と
   * 項目間の線で作る。選んでいる行は面と番号の色で示し、行の脇に線は引かない
   */
  /* 1件が2行になることがあるので、どこで切れるかを線で示す */
  .article-search-hits :global(li + li) {
    border-block-start: 1px solid var(--color-border);
  }

  .article-search-hits :global(button) {
    display: grid;
    grid-template-columns: 2.5ch minmax(0, 1fr);
    gap: 12px;
    padding: 9px 8px;
    color: var(--color-text-muted);
    font-family: inherit;
    font-size: var(--text-sm);
    line-height: 1.7;
    text-align: start;
    background: none;
    border: 0;
    border-radius: var(--radius-label);
    cursor: pointer;
    transition:
      color var(--duration-feedback) ease,
      background-color var(--duration-feedback) ease;
  }

  /* hig.md hover.text。面は敷かず、色と underline で示す */
  .article-search-hits :global(button:hover) .hit-text,
  .article-search-hits :global(button:focus-visible) .hit-text {
    color: var(--color-interaction-text);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* hig.md nav.current。色と太さと Line で示す */
  .article-search-hits :global(button[aria-current="true"]) {
    color: var(--color-primary);
    font-weight: 700;
    box-shadow: inset 2px 0 0 var(--color-primary);
  }

  .article-search-hits :global(.hit-index) {
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    font-variant-numeric: tabular-nums;
    text-align: end;
  }

  .article-search-hits :global(button[aria-current="true"] .hit-index) {
    color: var(--color-primary);
  }

  /*
   * 一文をそのまま出し、行に収まらない分だけ省略する。前後の文脈は沈め、
   * 探している語だけを本文の濃さで立てる
   */
  .article-search-hits :global(.hit-text) {
    min-width: 0;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .article-search-hits :global(.hit-text mark) {
    padding: 0 0.15em;
    color: var(--color-text);
    font-weight: 600;
    background: color-mix(in srgb, var(--color-accent) 62%, transparent);
    border-radius: 1px;
  }

  .article-search-rest {
    flex: none;
    margin: 0;
    padding: 2px 16px 12px;
    color: var(--color-text-muted);
    font-size: var(--text-xs);
  }

  .article-search-rest[hidden] {
    display: none;
  }

  /* キーの案内。読むものではないので、線の下に薄く置くだけにする */
  .article-search-hint {
    flex: none;
    display: flex;
    flex-wrap: wrap;
    gap: 4px 14px;
    margin: 0;
    padding: 10px 16px;
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    border-top: 1px solid var(--color-border);
  }

  .article-search-hint kbd {
    padding: 0 3px;
    font-family: var(--font-machine);
    font-size: 0.95em;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-label);
  }

  .article-search-hint kbd + kbd {
    margin-inline-start: 2px;
  }

  @media (max-width: 639px) {
    .article-search-dialog {
      --search-top: 8vh;
    }

    .article-search-field {
      padding: 12px 14px;
    }

    .article-search-hits {
      padding: 0 6px 10px;
    }

    .article-search-rest {
      padding: 2px 14px 10px;
    }

    .article-search-hint {
      padding: 10px 14px;
    }
  }
</style>

<script>
  import { onPageLoad, pageSignal } from "~/scripts/pageLifecycle";
  import { initArticleSearch } from "~/scripts/articleSearch";

  onPageLoad(() => initArticleSearch(pageSignal()));
</script>
