---
import type { Category } from "~/constants/categories";
import type { Tag } from "~/constants/tags";

type Props = {
  categories: Category[];
  tags?: Tag[];
};
const { categories, tags = [] } = Astro.props;
const toSearchHref = (term: string, kind: "categories" | "tags") =>
  `/blog?q=${encodeURIComponent(term)}&kind=${kind}`;
---

{
  (categories.length > 0 || tags.length > 0) && (
    <div class="classification">
      {categories.length > 0 && (
        <ul class="category-list">
          {categories.map((category: Category) => (
            <li>
              <a
                href={toSearchHref(category, "categories")}
                class="category-label"
              >
                {category}
              </a>
            </li>
          ))}
        </ul>
      )}
      {tags.length > 0 && (
        <ul class="tag-list">
          {tags.map((tag: Tag) => (
            <li>
              <a href={toSearchHref(tag, "tags")} class="tag-label">
                {tag}
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>
  )
}

<style>
  /* 分野とタグは種類が違うので、行を分けて重ねる */
  .classification {
    display: grid;
    gap: 6px;
  }

  .category-list,
  .tag-list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tag-list {
    gap: 4px 12px;
  }

  .category-label {
    display: inline-flex;
    align-items: center;
    padding: 2px 0;
    font-size: 12px;
    color: var(--text-secondary);
    border: 0;
    text-decoration: none;
    transition: color var(--duration-feedback) ease;
  }

  .category-label:hover {
    color: var(--color-interaction-text);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .tag-label {
    display: inline-flex;
    align-items: center;
    padding: 2px 0;
    font-size: 12px;
    color: var(--color-text-muted);
    text-decoration: none;
    border: 0;
    transition: color var(--duration-feedback) ease;
  }

  .tag-label::before {
    content: "#";
    margin-right: 1px;
    opacity: 0.6;
  }

  .tag-label:hover {
    color: var(--color-interaction-text);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
