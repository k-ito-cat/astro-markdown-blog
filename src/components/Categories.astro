---
import type { Category } from "~/constants/categories";

type Props = {
  categories: Category[];
};
const { categories } = Astro.props;
---

{
  categories && categories.length > 0 && (
    <ul class="category-list">
      {categories.map((category: Category) => (
        <li>
          <a
            href={
              category === "すべて"
                ? "/blog"
                : `/blog?category=${encodeURIComponent(category)}`
            }
            class="category-label"
          >
            {category}
          </a>
        </li>
      ))}
    </ul>
  )
}

<style>
  .category-list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .category-label {
    display: inline-flex;
    align-items: center;
    padding: 2px 0;
    font-size: 12px;
    color: var(--text-secondary);
    background: linear-gradient(transparent 58%, color-mix(in srgb, var(--color-accent) 58%, transparent) 58%);
    border: 0;
    text-decoration: none;
    transition:
      color var(--duration-feedback) ease;
  }

  .category-label:hover {
    color: var(--text-primary);
    background: linear-gradient(transparent 58%, var(--color-accent) 58%);
    text-decoration: none;
  }
</style>
